#!/usr/bin/env bash
set -euo pipefail

# usage: scripts/release vMAJOR.MINOR.PATCH
# builds, signs and verifies one release of the clean tip of canonical main, then
# creates it as a github draft. publication, the pins and published-release follow.
# scripts run from this reviewed checkout; everything built or shipped comes from a
# fresh clone of the same SHA.
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
repo='NielsdaWheelz/skidbladnir'
refuse() {
  printf '%s\n' "$1" >&2
  exit 1
}

[[ "$#" -eq 1 ]] || {
  printf 'usage: %s vMAJOR.MINOR.PATCH\n' "$0" >&2
  exit 64
}
tag="$1"
[[ "$(uname -s)/$(uname -m)" == Darwin/arm64 && "${SKIDBLADNIR_MAC_SIGNING_IDENTITY:-}" =~ ^[0-9A-Fa-f]{40}$ ]] ||
  refuse 'release requires the native Darwin arm64 signing host and SKIDBLADNIR_MAC_SIGNING_IDENTITY'
version="$("$repo_dir/scripts/check-release" --android-version "$tag")"
read -r version_name version_code <<<"$version"
key="${SKIDBLADNIR_RELEASE_SIGNING_KEY:-$HOME/.config/skidbladnir/release-signing.pem}"
public_key="$(openssl pkey -in "$key" -pubout)"
[[ "$public_key" == "$(<"$repo_dir/internal/install/release-public-key.pem")" ]] ||
  refuse 'release private key differs from the pinned public key'
export JAVA_HOME="${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"

# source: the clean, unreleased tip of canonical main with hosted verify evidence.
# the immutable check is the first gh call, so broken auth fails here and never
# reaches the fail-open `gh release view` below.
cd "$repo_dir"
case "$(git remote get-url origin)" in
  git@github.com:NielsdaWheelz/skidbladnir.git | https://github.com/NielsdaWheelz/skidbladnir.git) ;;
  *) refuse "Release origin does not identify $repo" ;;
esac
[[ -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || refuse 'Release requires a clean worktree and index'
"$repo_dir/scripts/check-release-repository" immutable
git fetch --quiet origin main --tags
sha="$(git rev-parse HEAD)"
[[ "$sha" == "$(git rev-parse origin/main)" ]] || refuse 'Release HEAD is not exact origin/main'
# the fetch imported every origin tag (or failed), so this loop also refuses $tag
# itself, local or on origin. a draft has no tag yet; only github knows it. the
# highest existing code is the previous release, where the notes' changes start.
previous_tag=''
previous_code=0
while IFS= read -r existing_tag; do
  existing_version="$("$repo_dir/scripts/check-release" --android-version "$existing_tag" 2>/dev/null)" || continue
  ((${existing_version#* } < version_code)) ||
    refuse "Release tag $tag does not increase the Android version code beyond $existing_tag"
  if ((${existing_version#* } > previous_code)); then
    previous_tag="$existing_tag"
    previous_code="${existing_version#* }"
  fi
done < <(git tag --list 'v*')
if gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then
  refuse "Release already exists and will not be replaced: $tag"
fi
run_id="$("$repo_dir/scripts/check-release-repository" run "$sha")"

# build from a fresh clone of sha, never the checkout: its ignored files must not ship.
# staging is private and removed on every exit; -f because git objects are read-only.
staging="$(mktemp -d /tmp/skidbladnir-release.XXXXXX)"
cleanup() {
  local status=$?
  rm -Rf -- "$staging" || ((status)) || status=1
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
source_dir="$staging/source"
assets="$staging/assets"
git clone --quiet --no-checkout "$repo_dir" "$source_dir"
git -C "$source_dir" checkout --quiet --detach "$sha"
mkdir -m 0700 "$assets"

for platform in linux-amd64 darwin-arm64; do
  root="$staging/$platform"
  install -d -m 0755 "$root/providers"
  "$repo_dir/scripts/build-host-binary" "$source_dir" "$tag" "$sha" "$platform" ./cmd/skidbladnir "$root/skidbladnir"
  jq -n --arg platform "$platform" --arg sha "$sha" --arg version "$tag" \
    '{platform:$platform,sourceSha:$sha,version:$version}' >"$root/release.json"
  chmod 0644 "$root/release.json"
  install -m 0644 "$source_dir/deployment/providers/shell-init" \
    "$source_dir/deployment/providers/terminal-context-init" "$root/providers"
  members=(skidbladnir release.json providers third-party-notices.txt)
  binaries=("$root/skidbladnir")
  if [[ "$platform" == darwin-arm64 ]]; then
    app="$root/Skid.app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    "$repo_dir/scripts/build-host-binary" "$source_dir" "$tag" "$sha" darwin-arm64 ./cmd/skid-notifications \
      "$app/Contents/MacOS/skid-notifications"
    binaries+=("$app/Contents/MacOS/skid-notifications")
    install -m 0644 "$source_dir/macos/Info.plist" "$app/Contents/Info.plist"
    /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString ${tag#v}" -c "Set :CFBundleVersion ${tag#v}" \
      -c "Add :SkidSourceSHA string $sha" "$app/Contents/Info.plist"
    chmod 0644 "$app/Contents/Info.plist"
    "$repo_dir/scripts/build-mac-icon" "$source_dir" "$app/Contents/Resources/skid.icns"
    find "$app" -type d -exec chmod 0755 {} +
    codesign --force --sign "$SKIDBLADNIR_MAC_SIGNING_IDENTITY" --timestamp=none --options runtime \
      --entitlements "$source_dir/macos/entitlements.plist" "$app"
    chmod 0755 "$app/Contents/_CodeSignature"
    chmod 0644 "$app/Contents/_CodeSignature/CodeResources"
    members+=(Skid.app)
  fi
  # the binaries link the go standard library, whose license is the go distribution's
  # (golang.org/toolchain for this darwin arm64 host), and the modules go version -m names.
  # each one's license and notice files ship in the archive; one without a license stops the release.
  modules="$(go version -m "${binaries[@]}" |
    awk '!/^\t/ { print "golang.org/toolchain@v0.0.1-" $NF ".darwin-arm64" } $1 == "dep" { print $2 "@" $3 }' |
    LC_ALL=C sort -u)"
  {
    printf "Third-party notices for skid's %s archive: the license and notice files of the Go distribution,\n" "$platform"
    printf 'whose standard library its binaries link, and of every Go module they link.\n'
    while IFS= read -r module; do
      dir="$(cd "$staging" && go mod download -json "$module" | jq -er .Dir)"
      files="$(find "$dir" -maxdepth 1 -type f \( -iname 'licen[cs]e*' -o -iname 'copying*' -o -iname 'notice*' \
        -o -iname 'patents*' \) | LC_ALL=C sort)"
      grep -Eiq '/(licen[cs]e|copying)[^/]*$' <<<"$files" || refuse "Go module $module has no license file"
      while IFS= read -r file; do
        printf '\n== %s/%s\n\n' "$module" "${file##*/}"
        cat "$file"
      done <<<"$files"
    done <<<"$modules"
  } >"$root/third-party-notices.txt"
  chmod 0644 "$root/third-party-notices.txt"
  archive="$assets/skidbladnir-$platform.tar.gz"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$root" -czf "$archive" "${members[@]}"
  openssl dgst -sha256 -binary "$archive" >"$staging/digest"
  openssl pkeyutl -sign -rawin -inkey "$key" -in "$staging/digest" -out "$archive.sig"
done

(cd "$source_dir/android" &&
  SKIDBLADNIR_ANDROID_SIGNING_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/skidbladnir/android-signing.properties" \
    ./gradlew -Pskidbladnir.versionName="$version_name" -Pskidbladnir.versionCode="$version_code" \
    :app:assembleRelease --no-daemon)
install -m 0644 "$source_dir/android/app/build/outputs/apk/release/app-release.apk" "$assets/skidbladnir-android.apk"
install -m 0644 "$source_dir/android/app-signing-cert.sha256" "$assets/android-signing-cert.sha256"
install -m 0755 "$source_dir/scripts/install" "$assets/install"
(cd "$assets" && shasum -a 256 android-signing-cert.sha256 install skidbladnir-android.apk \
  skidbladnir-darwin-arm64.tar.gz skidbladnir-linux-amd64.tar.gz >SHA256SUMS)
# the release key signs the checksums too, so every asset verifies against the pinned public key.
openssl dgst -sha256 -binary "$assets/SHA256SUMS" >"$staging/digest"
openssl pkeyutl -sign -rawin -inkey "$key" -in "$staging/digest" -out "$assets/SHA256SUMS.sig"

# the one release-directory verifier; published-release runs it again on the public bytes.
"$repo_dir/scripts/check-release" --source "$source_dir" "$assets" "$tag" "$sha"

notes="$staging/notes.md"
# shellcheck disable=SC2016 # markdown code spans are literal.
{
  printf '# Skíðblaðnir %s\n\n' "$tag"
  printf -- '- Source: `%s`\n- Verify run: `%s`\n' "$sha" "$run_id"
  printf -- '- Android signer SHA-256: `%s`\n' "$(<"$assets/android-signing-cert.sha256")"
  printf -- '- macOS app signer SHA-256: `%s`\n\n' "$(<"$source_dir/macos/app-signing-cert.sha256")"
  # github merges carry the pull request's title as their body; first-parent keeps main's own merges.
  printf '## Changes\n\n'
  git log --first-parent --merges --format='%s%x09%b' "${previous_tag:+$previous_tag..}$sha" |
    awk -F '\t' '$1 ~ /^Merge pull request #[0-9]+ from / { split($1, words, " "); printf "- %s (%s)\n", $2, words[4] }'
  printf '\n## Install\n\nDownload `install` from this release, inspect it, then run `bash install %s`.\n' "$tag"
  printf 'The [README](https://github.com/%s/blob/%s/README.md#install) covers hosts, the phone and updates.\n\n' "$repo" "$sha"
  printf '## Assets\n\n| Asset | SHA-256 |\n| --- | --- |\n'
  for name in skidbladnir-android.apk skidbladnir-linux-amd64.tar.gz skidbladnir-darwin-arm64.tar.gz android-signing-cert.sha256 install; do
    printf '| `%s` | `%s` |\n' "$name" "$(awk -v name="$name" '$2 == name { print $1 }' "$assets/SHA256SUMS")"
  done
  printf '| `SHA256SUMS` | `%s` |\n' "$(shasum -a 256 <"$assets/SHA256SUMS" | awk '{ print $1 }')"
} >"$notes"

gh release create "$tag" \
  "$assets/skidbladnir-android.apk" \
  "$assets/skidbladnir-linux-amd64.tar.gz" \
  "$assets/skidbladnir-darwin-arm64.tar.gz" \
  "$assets/skidbladnir-linux-amd64.tar.gz.sig" \
  "$assets/skidbladnir-darwin-arm64.tar.gz.sig" \
  "$assets/install" \
  "$assets/SHA256SUMS" \
  "$assets/SHA256SUMS.sig" \
  "$assets/android-signing-cert.sha256" \
  --repo "$repo" \
  --draft \
  --target "$sha" \
  --title "Skíðblaðnir $tag" \
  --notes-file "$notes"
printf 'Draft release created: %s at %s (verify run %s)\n' "$tag" "$sha" "$run_id"
