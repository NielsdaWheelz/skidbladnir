#!/usr/bin/env python3
"""Verify the vendored terminal assets against the repository lock."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
LOCK_PATH = ROOT / "android" / "terminal.lock"
VENDOR_PATH = ROOT / "android" / "app" / "src" / "main" / "assets" / "terminal" / "vendor"


def main() -> int:
    try:
        lock = json.loads(LOCK_PATH.read_text(encoding="utf-8"))
        files = lock["files"]
        if not isinstance(files, dict) or not files:
            raise ValueError("terminal lock has no files")
        expected_paths = {ROOT / relative for relative in files}
        observed_paths = {path for path in VENDOR_PATH.iterdir() if path.is_file()}
        if observed_paths != expected_paths:
            raise ValueError("terminal lock and vendored file set differ")
        for relative, expected_digest in files.items():
            if not isinstance(relative, str) or not isinstance(expected_digest, str):
                raise ValueError("terminal lock file entry is invalid")
            observed_digest = hashlib.sha256((ROOT / relative).read_bytes()).hexdigest()
            if observed_digest != expected_digest:
                raise ValueError(f"terminal asset digest differs: {relative}")
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        print(f"terminal asset check failed: {error}", file=sys.stderr)
        return 1
    print(f"terminal asset check passed: {len(files)} files")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
