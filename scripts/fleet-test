if [[ "$status" == 0 || "$output" != *'service state could not be observed'* ||
  "$(<"$devbox_home/service.state")" != active ]] ||
  grep -Eq '^systemctl devbox (start|stop)$' "$log_file"; then
  fail 'devbox outage treated an observation error as inactivity'
fi
/bin/unlink "$devbox_home/service-observation-error"
printf 'transitional\n' >"$devbox_home/service.state"
capture "$fleet" outage devbox --allow-service-lifecycle
if [[ "$status" == 0 || "$output" != *'service state could not be observed'* ||
  "$(<"$devbox_home/service.state")" != transitional ]] ||
  grep -Eq '^systemctl devbox (start|stop)$' "$log_file"; then
  fail 'devbox outage treated a transitional service as inactive'
