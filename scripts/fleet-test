jq '.sourceSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"' \
  "$pin_valid" >"$pin"
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'tracked and byte-exact at checkout HEAD'* ]] ||
  fail 'verify trusted a dirty dev-server release pin'
git -C "$pin_checkout" add assets/skidbladnir/release-pin.json
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'tracked and byte-exact at checkout HEAD'* ]] ||
  fail 'verify trusted a staged dev-server release pin that differed from HEAD'

cp "$pin_valid" "$pin"
git -C "$pin_checkout" add assets/skidbladnir/release-pin.json
printf '%5000s' '' >>"$pin"
git -C "$pin_checkout" add assets/skidbladnir/release-pin.json
git -C "$pin_checkout" commit -qm 'oversized pin fixture'
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'release pin is not bounded'* ]] ||
  fail 'verify measured the parsed pin instead of its exact file bytes'

cp "$pin_valid" "$pin"
git -C "$pin_checkout" add assets/skidbladnir/release-pin.json
git -C "$pin_checkout" commit -qm 'restore pin fixture'
jq '.sourceSha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"' \
  "$pin_valid" >"$pin"
git -C "$pin_checkout" add assets/skidbladnir/release-pin.json
