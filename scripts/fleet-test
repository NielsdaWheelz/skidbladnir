  SKIDBLADNIR_ALLOW_HOST_ACCEPTANCE=host-acceptance-v1 \
  "$fleet" _host accept Linux arch --allow-host-apply --allow-inventory-reconciliation \
  --candidate-commit aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  --release-identity aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
[[ "$status" == 64 && ! -s "$log_file" ]] ||
  fail 'legacy streamed host acceptance remained reachable'
capture env HOME="$arch_home" FLEET_TEST_UNAME=Linux \
  SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
