[[ "$status" != 0 && ! -e "$qr_file" && "$output" == *'Nothing was displayed.'* ]] ||
  fail 'invitation accepted a gateway identity other than the verified host'
mv "$devbox_home/invite.valid.json" "$devbox_home/invite.json"

