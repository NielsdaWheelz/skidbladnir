printf '%s\n' "$output" | awk '
  BEGIN { valid = 1 }
  NR == 1 && NF == 2 && $1 == "macbook" && $2 ~ /^[0-9a-f]{64}$/ { next }
  NR == 2 && NF == 2 && $1 == "devbox" && $2 ~ /^[0-9a-f]{64}$/ { next }
  NR == 3 && NF == 2 && $1 == "arch" && $2 ~ /^[0-9a-f]{64}$/ { next }
  { valid = 0 }
  END { exit valid && NR == 3 ? 0 : 1 }
' || fail 'lifetime reconciliation did not return only the ordered digest contract'

