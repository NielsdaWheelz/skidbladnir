[[ "$status" == 64 && ! -s "$log_file" ]] ||
  fail 'direct reboot verification ran without the reboot capability'
capture env HOME="$arch_home" FLEET_TEST_UNAME=Linux \
  SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
  "$fleet" _host outage Linux arch --allow-service-lifecycle
[[ "$status" == 64 && "$(<"$arch_home/service.state")" == active && ! -s "$log_file" ]] ||
  fail 'direct host outage ran without the lifecycle capability'
capture env HOME="$arch_home" FLEET_TEST_UNAME=Linux \
  SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
  "$fleet" _host recover Linux arch --allow-service-lifecycle
[[ "$status" == 64 && "$(<"$arch_home/service.state")" == active && ! -s "$log_file" ]] ||
  fail 'direct host recovery ran without the lifecycle capability'

if grep -Eq '(^| )(doctor|converge)( |$)' "$log_file"; then
  fail 'fleet operator invoked a removed dev-server interface'
fi

printf 'fleet operator behavior passed: fixed hosts, private credentials, apply acceptance, reboot, and bounded outage\n'
