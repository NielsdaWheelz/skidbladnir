capture "$fleet" outage macbook --allow-service-lifecycle
[[ "$status" != 0 && "$output" == *'does not match durable installer intent'* &&
  "$(<"$local_home/service.state")" == active && ! -s "$log_file" ]] ||
  fail 'macbook lifecycle mutated a service before validating durable installer intent'
/bin/unlink "$mac_definition"
mv "$local_home/service-definition.valid" "$mac_definition"
touch "$local_home/service-observation-error"
capture "$fleet" outage macbook --allow-service-lifecycle
[[ "$status" != 0 && "$output" == *'service state could not be observed'* &&
  "$(<"$local_home/service.state")" == active && ! -s "$log_file" ]] ||
  fail 'macbook outage treated an observation error as inactivity'
/bin/unlink "$local_home/service-observation-error"
printf 'transitional\n' >"$local_home/service.state"
capture "$fleet" outage macbook --allow-service-lifecycle
[[ "$status" != 0 && "$output" == *'service state could not be observed'* &&
  "$(<"$local_home/service.state")" == transitional && ! -s "$log_file" ]] ||
  fail 'macbook outage treated a transitional service as inactive'
printf 'loaded\n' >"$local_home/service.state"
capture "$fleet" recover macbook --allow-service-lifecycle
[[ "$status" == 0 && "$(<"$local_home/service.state")" == active &&
  "$(grep -c '^launchctl kickstart$' "$log_file")" == 1 &&
  "$(grep -c '^launchctl bootstrap$' "$log_file" || true)" == 0 ]] ||
  fail 'macbook recovery bootstrapped an already loaded gateway'
capture "$fleet" outage macbook --allow-service-lifecycle
[[ "$status" == 0 && "$(<"$local_home/service.state")" == inactive ]] ||
  fail 'macbook outage did not stop exactly the gateway'
capture "$fleet" outage macbook --allow-service-lifecycle
[[ "$status" == 0 && "$(<"$local_home/service.state")" == inactive ]] ||
  fail 'repeated macbook outage was not convergent'
capture "$fleet" recover macbook --allow-service-lifecycle
[[ "$status" == 0 && "$(<"$local_home/service.state")" == active ]] ||
  fail 'macbook recovery did not restore the gateway'
capture "$fleet" recover macbook --allow-service-lifecycle
[[ "$status" == 0 && "$(<"$local_home/service.state")" == active ]] ||
  fail 'repeated macbook recovery was not convergent'
[[ "$(grep -c '^launchctl bootout$' "$log_file")" == 1 &&
  "$(grep -c '^launchctl bootstrap$' "$log_file")" == 1 &&
  "$(grep -c '^launchctl kickstart$' "$log_file")" == 1 ]] ||
  fail 'macbook outage/recovery used an unexpected lifecycle boundary'
! grep -Eiq 'tmux|tailscale' "$log_file" ||
  fail 'outage/recovery touched tmux or Tailscale'

