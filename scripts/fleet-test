  fail 'devbox outage did not stop its fixed gateway service'
capture "$fleet" recover devbox --allow-service-lifecycle
[[ "$status" == 0 && "$(<"$devbox_home/service.state")" == active ]] ||
  fail 'devbox recovery did not restore its fixed gateway service'

export SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE=reboot-acceptance-v1
capture "$fleet" prepare-reboot macbook --allow-reboot-acceptance
checkpoint="$local_home/.local/state/skidbladnir/fleet-reboot.json"
[[ "$status" == 0 && -f "$checkpoint" && ! -L "$checkpoint" ]] ||
  fail 'reboot preparation did not create its digest checkpoint'
[[ "$(stat -f '%Lp' "$checkpoint")" == 600 ]] || fail 'reboot checkpoint mode is not 0600'
! grep -Eq 'mh-|A{20}|Bearer' "$checkpoint" || fail 'reboot checkpoint contains credential material'
capture "$fleet" verify-reboot macbook --allow-reboot-acceptance
[[ "$status" == 2 && -f "$checkpoint" && "$output" == *'boot identity has not changed'* ]] ||
  fail 'reboot verification accepted the original boot'
printf '200\n' >"$local_home/boot-id"
capture "$fleet" verify-reboot macbook --allow-reboot-acceptance
[[ "$status" == 0 && ! -e "$checkpoint" && "$output" == *'reboot persistence preserved'* ]] ||
  fail 'reboot verification did not consume a valid checkpoint'

capture "$fleet" prepare-reboot devbox --allow-reboot-acceptance
remote_checkpoint="$devbox_home/.local/state/skidbladnir/fleet-reboot.json"
[[ "$status" == 0 && -f "$remote_checkpoint" && ! -L "$remote_checkpoint" ]] ||
  fail 'remote Linux reboot preparation did not create its digest checkpoint'
capture "$fleet" verify-reboot devbox --allow-reboot-acceptance
[[ "$status" == 2 && -f "$remote_checkpoint" && "$output" == *'boot identity has not changed'* ]] ||
  fail 'remote Linux reboot verification accepted the original boot'
printf '00000000-0000-0000-0000-000000000200\n' >"$devbox_home/linux-boot-id"
capture "$fleet" verify-reboot devbox --allow-reboot-acceptance
[[ "$status" == 0 && ! -e "$remote_checkpoint" &&
  "$output" == *'reboot persistence preserved'* ]] ||
  fail 'remote Linux reboot verification did not consume a valid changed-boot checkpoint'
unset SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE
unset SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE

: >"$log_file"
capture "$fleet" outage arbitrary-host --allow-service-lifecycle
[[ "$status" == 64 && ! -s "$log_file" ]] ||
  fail 'an arbitrary host reached a command boundary'
capture "$fleet" accept-host macbook --allow-inventory-reconciliation --allow-host-apply
[[ "$status" == 64 && ! -s "$log_file" ]] ||
  fail 'reordered acceptance capabilities were accepted'

# The streamed host protocol is read-only except for the separately capability-
# guarded reboot and service lifecycle actions. Host apply is never exposed
# through a streamed internal route because Arch sudo is operator-interactive.
: >"$log_file"
capture env HOME="$arch_home" FLEET_TEST_UNAME=Linux \
  "$fleet" _host accept Linux arch --allow-host-apply --allow-inventory-reconciliation \
  --candidate-commit aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  --release-identity aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
[[ "$status" == 64 && ! -s "$log_file" ]] ||
  fail 'direct host acceptance ran without the internal transport capability'
