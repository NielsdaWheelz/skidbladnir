: >"$log_file"
capture "$fleet" invite
[[ "$status" == 0 && "$output" == *'Fleet invite ready.'* && "$output" == *'[fleet QR]'* ]] ||
  fail "fleet invitation did not render the bounded QR flow: status=$status output=$output"
for secret in "$local_token" "$devbox_token" "$arch_token"; do
  [[ "$output" != *"$secret"* ]] || fail 'fleet invitation printed a token outside the QR'
  ! grep -Fq "$secret" "$log_file" || fail 'fleet invitation placed a token in an invoked command'
done
jq -e '
  type == "object" and keys == ["kind", "machines"] and
  .kind == "skidbladnir.fleet-invite.v1" and
  [.machines[].label] == ["Arch", "Devbox", "MacBook"] and
  (.machines | length) == 3 and
  ([.machines[].origin] | unique | length) == 3 and
  ([.machines[].machineHandle] | unique | length) == 3 and
  ([.machines[].pairingInviteToken] | unique | length) == 3
' "$qr_file" >/dev/null || fail 'fleet invitation QR payload was not the strict fixed fleet'
jq -e '[.machines[].origin] == [
  "https://arch.example.ts.net:8443/",
  "https://devbox.example.ts.net:8443/",
  "https://macbook.example.ts.net:8443/"
]' "$qr_file" >/dev/null || fail 'fleet invitation did not use verified Serve origins'
[[ "$(grep -c '^qrencode stdin-only$' "$log_file")" == 1 ]] ||
  fail 'fleet invitation did not pass one complete payload through qrencode stdin'

for host_home in "$local_home" "$devbox_home"; do
  installed_bin="$host_home/.local/bin/skidbladnir"
  /bin/unlink "$installed_bin"
  printf '#!/bin/sh\nexit 99\n' >"$installed_bin"
  chmod 0755 "$installed_bin"
  /bin/unlink "$qr_file"
  capture "$fleet" invite
  [[ "$status" == 0 && -f "$qr_file" && "$output" == *'Fleet invite ready.'* ]] ||
    fail 'fleet invitation executed an unvalidated convenience launcher'
  /bin/unlink "$installed_bin"
  ln -s '../share/skidbladnir/current/skidbladnir' "$installed_bin"
done

for host_home in "$local_home" "$devbox_home"; do
  touch "$host_home/invite-oversized"
  [[ ! -e "$qr_file" && ! -L "$qr_file" ]] || /bin/unlink "$qr_file"
  capture "$fleet" invite
  [[ "$status" != 0 && ! -e "$qr_file" && "$output" == *'Nothing was displayed.'* &&
    "${#output}" -lt 4096 ]] ||
    fail 'fleet invitation did not stream-bound an oversized host response'
  /bin/unlink "$host_home/invite-oversized"
done

