#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
fleet="$repo_dir/scripts/fleet"

fail() {
  printf 'fleet test failed: %s\n' "$1" >&2
  exit 1
}

[[ -x "$fleet" ]] || fail 'scripts/fleet is missing or not executable'

test_root="$(mktemp -d "${TMPDIR:-/tmp}/skidbladnir-fleet-test.XXXXXX")"
case "$test_root" in
"${TMPDIR:-/tmp}"/skidbladnir-fleet-test.*) ;;
*) fail 'temporary test boundary is invalid' ;;
esac
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  /bin/rm -R -- "$test_root" || status=1
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fake_bin="$test_root/bin"
local_home="$test_root/local"
devbox_home="$test_root/devbox"
arch_home="$test_root/arch"
checkout="$test_root/dev-server"
log_file="$test_root/actions.log"
qr_file="$test_root/qr-input.json"
install -d -m 0700 "$fake_bin" "$local_home" "$devbox_home" "$arch_home" "$checkout"
: >"$log_file"

cat >"$fake_bin/uname" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${FLEET_TEST_UNAME:-Darwin}"
EOF

cat >"$fake_bin/stat" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$(/usr/bin/uname -s)" == Darwin ]]; then
  if [[ "${1:-}" == -c && "${2:-}" == %a && $# -eq 3 ]]; then
    exec /usr/bin/stat -f %Lp "$3"
  fi
  exec /usr/bin/stat "$@"
fi
if [[ "${1:-}" == -f && "${2:-}" == %Lp && $# -eq 3 ]]; then
  exec /usr/bin/stat -c %a "$3"
fi
exec /usr/bin/stat "$@"
EOF

cat >"$fake_bin/date" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == '-u +%s' ]]; then
  printf '1893456000\n'
  exit 0
fi
exec /bin/date "$@"
EOF

cat >"$fake_bin/cat" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == /proc/sys/kernel/random/boot_id &&
  "${FLEET_TEST_UNAME:-}" == Linux ]]; then
  exec /bin/cat "$HOME/linux-boot-id"
fi
exec /bin/cat "$@"
EOF

cat >"$fake_bin/sysctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$*" == '-n kern.boottime' ]]
printf '{ sec = %s, usec = 0 } Mon Jan  1 00:00:00 2030\n' "$(<"$HOME/boot-id")"
EOF

cat >"$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
request="$(cat)"
bearer="$(<"$HOME/.config/skidbladnir/bearer")"
handle="$(<"$HOME/.config/skidbladnir/machine-handle")"
[[ "$request" == *"Authorization: Bearer $bearer"* ]]
[[ "$request" == *"Skidbladnir-Machine: $handle"* ]]
case "$request" in
*'/v1/pressure'*)
  grep -Fqx 'max-filesize = 262144' <<<"$request"
  [[ ! -e "$HOME/oversized-pressure" ]] || exit 63
  printf 'curl %s pressure\n' "$(basename "$HOME")" >>"$FLEET_TEST_LOG"
  cat "$HOME/pressure.json"
  ;;
*'/v1/sessions'*)
  grep -Fqx 'max-filesize = 1048576' <<<"$request"
  [[ ! -e "$HOME/oversized-sessions" ]] || exit 63
  printf 'curl %s sessions\n' "$(basename "$HOME")" >>"$FLEET_TEST_LOG"
  cat "$HOME/sessions.json"
  ;;
*) exit 64 ;;
esac
EOF

cat >"$fake_bin/launchctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
print)
  [[ ! -e "$HOME/service-observation-error" ]] || {
    printf 'launchd transport unavailable\n' >&2
    exit 75
  }
  case "$(<"$HOME/service.state")" in
  active)
    printf '    path = %s/Library/LaunchAgents/dev.niels.skidbladnir.plist\n' "$HOME"
    printf '    state = running\n'
    ;;
  loaded)
    printf '    path = %s/Library/LaunchAgents/dev.niels.skidbladnir.plist\n' "$HOME"
    printf '    state = waiting\n'
    ;;
  inactive)
    printf 'Could not find service "dev.niels.skidbladnir" in domain for user gui: %s\n' "$(id -u)" >&2
    exit 113
    ;;
  transitional)
    printf '    path = %s/Library/LaunchAgents/dev.niels.skidbladnir.plist\n' "$HOME"
    printf '    state = spawning\n'
    ;;
  *) exit 64 ;;
  esac
  ;;
bootout)
  [[ "${2:-}" == "gui/$(id -u)/dev.niels.skidbladnir" && $# -eq 2 ]]
  printf 'inactive\n' >"$HOME/service.state"
  printf 'launchctl bootout\n' >>"$FLEET_TEST_LOG"
  ;;
bootstrap)
  [[ "${2:-}" == "gui/$(id -u)" && "${3:-}" == "$HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist" && $# -eq 3 ]]
  printf 'active\n' >"$HOME/service.state"
  printf 'launchctl bootstrap\n' >>"$FLEET_TEST_LOG"
  ;;
kickstart)
  [[ "${2:-}" == "gui/$(id -u)/dev.niels.skidbladnir" && $# -eq 2 ]]
  printf 'active\n' >"$HOME/service.state"
  printf 'launchctl kickstart\n' >>"$FLEET_TEST_LOG"
  ;;
*) exit 64 ;;
esac
EOF

cat >"$fake_bin/systemctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == --user ]]
shift
case "${1:-}" in
is-enabled)
  [[ "${2:-}" == --quiet && "${3:-}" == skidbladnir.service && $# -eq 3 ]]
  ;;
show)
  case "$*" in
  'show skidbladnir.service --property=FragmentPath --value')
    if [[ -e "$HOME/service-fragment-drift" ]]; then
      printf '%s/.config/systemd/user/other.service\n' "$HOME"
    else
      printf '%s/.config/systemd/user/skidbladnir.service\n' "$HOME"
    fi
    ;;
  'show skidbladnir.service --property=LoadState --property=ActiveState')
    [[ ! -e "$HOME/service-observation-error" ]] || {
      printf 'systemd user manager unavailable\n' >&2
      exit 75
    }
    printf 'LoadState=loaded\n'
    case "$(<"$HOME/service.state")" in
    active) printf 'ActiveState=active\n' ;;
    inactive) printf 'ActiveState=inactive\n' ;;
    failed) printf 'ActiveState=failed\n' ;;
    transitional) printf 'ActiveState=activating\n' ;;
    *) exit 64 ;;
    esac
    ;;
  *) exit 64 ;;
  esac
  ;;
start)
  [[ "${2:-}" == skidbladnir.service && $# -eq 2 ]]
  printf 'active\n' >"$HOME/service.state"
  printf 'systemctl %s start\n' "$(basename "$HOME")" >>"$FLEET_TEST_LOG"
  ;;
stop)
  [[ "${2:-}" == skidbladnir.service && $# -eq 2 ]]
  printf 'inactive\n' >"$HOME/service.state"
  printf 'systemctl %s stop\n' "$(basename "$HOME")" >>"$FLEET_TEST_LOG"
  ;;
*) exit 64 ;;
esac
EOF

cat >"$fake_bin/loginctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == show-user && "${3:-}" == -p && "${4:-}" == Linger &&
  "${5:-}" == --value && $# -eq 5 ]]
printf 'yes\n'
EOF

cat >"$fake_bin/tailscale" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "$(basename "$HOME")" in
local) dns='macbook.example.ts.net' ;;
devbox) dns='devbox.example.ts.net' ;;
arch) dns='arch.example.ts.net' ;;
*) exit 64 ;;
esac
[[ ! -e "$HOME/dns-name" ]] || dns="$(<"$HOME/dns-name")"
case "$*" in
'status --json')
  printf '{"BackendState":"Running","Self":{"DNSName":"%s."}}\n' "$dns"
  ;;
'serve status --json')
  funnel=false
  [[ ! -e "$HOME/public-funnel" ]] || funnel=true
  tcp_extra=''
  [[ ! -e "$HOME/serve-extra" ]] || tcp_extra=',"unexpected":true'
  alternate=''
  [[ ! -e "$HOME/alternate-funnel" ]] || alternate=',"other.example.ts.net:8443":true'
  printf '{"TCP":{"8443":{"HTTPS":true%s}},"Web":{"%s:8443":{"Handlers":{"/v1":{"Proxy":"http://127.0.0.1:7341/v1"}}}},"AllowFunnel":{"%s:8443":%s%s}}\n' \
    "$tcp_extra" "$dns" "$dns" "$funnel" "$alternate"
  ;;
*) exit 64 ;;
esac
EOF

cat >"$fake_bin/qrencode" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$*" == '-t ANSIUTF8' ]]
cat >"$FLEET_TEST_QR"
printf 'qrencode stdin-only\n' >>"$FLEET_TEST_LOG"
printf '[fleet QR]\n'
EOF

cat >"$fake_bin/shlock" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == -f && -n "${2:-}" && "${3:-}" == -p &&
  "${4:-}" =~ ^[1-9][0-9]*$ && $# -eq 4 ]]
(
  set -o noclobber
  printf '%s\n' "$4" >"$2"
) 2>/dev/null
EOF

cat >"$fake_bin/ssh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
config=''
tty_mode=none
while [[ "${1:-}" == -* ]]; do
  case "$1" in
  -F)
    config="${2:-}"
    shift 2
    ;;
  -t)
    tty_mode=request
    shift
    ;;
  -tt)
    tty_mode=force
    shift
    ;;
  -T)
    tty_mode=disabled
    shift
    ;;
  -o) shift 2 ;;
  *) shift ;;
  esac
done
target="${1:-}"
shift || true
case "$target" in
dev-server)
  [[ "$config" == "$FLEET_TEST_LOCAL_HOME/.ssh/config.d/dev-server" ]]
  export HOME="$FLEET_TEST_DEVBOX_HOME" FLEET_TEST_UNAME=Linux
  ;;
nnandal@arch) export HOME="$FLEET_TEST_ARCH_HOME" FLEET_TEST_UNAME=Linux ;;
*) exit 64 ;;
esac
printf 'ssh %s tty=%s\n' "$target" "$tty_mode" >>"$FLEET_TEST_LOG"
if [[ $# -eq 1 && "$1" == '$HOME/.local/share/skidbladnir/current/skidbladnir pairing-invite create' ]]; then
  exec "$HOME/.local/share/skidbladnir/current/skidbladnir" pairing-invite create
fi
if [[ $# -eq 1 ]]; then
  exec bash -c "$1"
fi
exec "$@"
EOF

chmod 0700 "$fake_bin"/*

for host_home in "$local_home" "$devbox_home" "$arch_home"; do
  install -d -m 0700 \
    "$host_home/.config/skidbladnir" \
    "$host_home/.config/systemd/user" \
    "$host_home/.local/bin" \
    "$host_home/.local/state/skidbladnir" \
    "$host_home/Library/LaunchAgents"
  printf 'active\n' >"$host_home/service.state"
  printf '100\n' >"$host_home/boot-id"
  printf '00000000-0000-0000-0000-000000000100\n' >"$host_home/linux-boot-id"
  printf '{"unsupported":[],"current":{"sampledAt":"2030-01-01T00:00:00Z","level":"Normal","phase":"Steady","reasons":[],"signals":{},"missing":[]},"history":[]}\n' >"$host_home/pressure.json"
done
cat >"$local_home/Library/LaunchAgents/dev.niels.skidbladnir.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>Label</key><string>dev.niels.skidbladnir</string></dict></plist>
EOF
chmod 0644 "$local_home/Library/LaunchAgents/dev.niels.skidbladnir.plist"
for host_home in "$devbox_home" "$arch_home"; do
  printf '[Service]\nExecStart=%%h/.local/bin/skidbladnir-launch gateway\n' \
    >"$host_home/.config/systemd/user/skidbladnir.service"
  chmod 0644 "$host_home/.config/systemd/user/skidbladnir.service"
done
install -d -m 0700 "$local_home/.ssh/config.d"
cat >"$local_home/.ssh/config.d/dev-server" <<'EOF'
Host dev-server
  HostName devbox.example.ts.net
  User niels
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HostKeyAlias dev-server
  StrictHostKeyChecking yes
  ForwardAgent no
EOF
chmod 0600 "$local_home/.ssh/config.d/dev-server"

local_token='AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
devbox_token='BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBE'
arch_token='CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCI'
local_handle='mh-11111111111111111111111111111111'
devbox_handle='mh-22222222222222222222222222222222'
arch_handle='mh-33333333333333333333333333333333'
for host_spec in \
  "$local_home|$local_token|$local_handle" \
  "$devbox_home|$devbox_token|$devbox_handle" \
  "$arch_home|$arch_token|$arch_handle"; do
  IFS='|' read -r host_home token handle <<<"$host_spec"
  printf '%s\n' "$token" >"$host_home/.config/skidbladnir/bearer"
  printf '%s\n' "$handle" >"$host_home/.config/skidbladnir/machine-handle"
  chmod 0600 "$host_home/.config/skidbladnir/bearer" \
    "$host_home/.config/skidbladnir/machine-handle"
done

cat >"$local_home/sessions.json" <<EOF
{"machine":{"handle":"$local_handle","platform":"Darwin"},"observedAt":"2030-01-01T00:00:00Z","profiles":[],"sessions":[{"attachedClients":0,"activity":"Quiet","character":{"displayName":"Dwarf","key":"dwarf"},"identityToken":"v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.10.20.1","tmuxId":"\u00241","tmuxName":"local"}]}
EOF
cat >"$devbox_home/sessions.json" <<EOF
{"machine":{"handle":"$devbox_handle","platform":"Linux"},"observedAt":"2030-01-01T00:00:00Z","profiles":[],"sessions":[{"attachedClients":0,"activity":"Active","character":{"displayName":"Dwarf","key":"dwarf"},"identityToken":"v1-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.11.21.2","tmuxId":"\u00242","tmuxName":"devbox"}]}
EOF
cat >"$arch_home/sessions.json" <<EOF
{"machine":{"handle":"$arch_handle","platform":"Linux"},"observedAt":"2030-01-01T00:00:00Z","profiles":[],"sessions":[]}
EOF

cat >"$test_root/fake-skidbladnir" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
version)
  [[ $# -eq 1 ]]
  if [[ -e "$HOME/release-drift" ]]; then
    printf 'v1.2.4 bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n'
  else
    printf 'v1.2.3 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
  fi
  ;;
pairing-invite)
  [[ "${2:-}" == create && $# -eq 2 ]]
  [[ ! -e "$HOME/invite-fail" ]]
  if [[ -e "$HOME/invite-oversized" ]]; then
    printf '%05000d' 0
    exit 0
  fi
  cat "$HOME/invite.json"
  ;;
*) exit 64 ;;
esac
EOF
chmod 0700 "$test_root/fake-skidbladnir"
fixture_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}
fixture_sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    shasum -a 256 | awk '{print $1}'
  fi
}
for host_home in "$local_home" "$devbox_home" "$arch_home"; do
  if [[ "$(basename "$host_home")" == local ]]; then
    artifact='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
    release_platform=darwin-arm64
  else
    artifact='bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
    release_platform=linux-amd64
  fi
  generation="$host_home/.local/share/skidbladnir/releases/v1.2.3-$artifact"
  install -d -m 0700 "$generation" "$host_home/.local/state/dev-server/active"
  cp "$test_root/fake-skidbladnir" "$generation/skidbladnir"
  printf '#!/bin/sh\nexit 64\n' >"$host_home/.local/bin/skidbladnir-launch"
  printf '{}\n' >"$generation/characters.json"
  jq -cn --arg platform "$release_platform" \
    '{platform:$platform,sourceSha:"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",version:"v1.2.3"}' \
    >"$generation/release.json"
  printf '{}\n' >"$generation/host-config.json"
  chmod 0755 "$generation/skidbladnir"
  chmod 0755 "$host_home/.local/bin/skidbladnir-launch"
  chmod 0644 "$generation/characters.json" "$generation/release.json"
  chmod 0600 "$generation/host-config.json"
  ln -s "releases/v1.2.3-$artifact" \
    "$host_home/.local/share/skidbladnir/current"
  ln -s '../share/skidbladnir/current/skidbladnir' "$host_home/.local/bin/skidbladnir"
  runtime_identity="$({
    for name in skidbladnir characters.json release.json host-config.json; do
      printf '%s\0%s\n' "$name" "$(fixture_sha256 "$generation/$name")"
    done
  } | fixture_sha256_stream)"
  printf '%s\n' "$runtime_identity" >"$host_home/.local/state/dev-server/active/skid.runtime.sha256"
  chmod 0600 "$host_home/.local/state/dev-server/active/skid.runtime.sha256"
  if [[ "$(basename "$host_home")" == local ]]; then
    service_definition="$host_home/Library/LaunchAgents/dev.niels.skidbladnir.plist"
  else
    service_definition="$host_home/.config/systemd/user/skidbladnir.service"
  fi
  unit_identity="$({
    printf 'launcher\0%s\nunit\0%s\n' \
      "$(fixture_sha256 "$host_home/.local/bin/skidbladnir-launch")" \
      "$(fixture_sha256 "$service_definition")"
  } | fixture_sha256_stream)"
  printf '%s\n' "$unit_identity" >"$host_home/.local/state/dev-server/active/skid.unit.sha256"
  chmod 0600 "$host_home/.local/state/dev-server/active/skid.unit.sha256"
done
cat >"$local_home/invite.json" <<EOF
{"expiresAt":"2030-01-01T00:04:00Z","machine":{"handle":"$local_handle","platform":"Darwin"},"pairingInviteToken":"$local_token"}
EOF
cat >"$devbox_home/invite.json" <<EOF
{"expiresAt":"2030-01-01T00:04:00Z","machine":{"handle":"$devbox_handle","platform":"Linux"},"pairingInviteToken":"$devbox_token"}
EOF
cat >"$arch_home/invite.json" <<EOF
{"expiresAt":"2030-01-01T00:04:00Z","machine":{"handle":"$arch_handle","platform":"Linux"},"pairingInviteToken":"$arch_token"}
EOF

cat >"$checkout/workstation" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == apply && $# -eq 1 ]]
printf 'apply %s workstation apply\n' "$(basename "$HOME")" >>"$FLEET_TEST_LOG"
if [[ -e "$FLEET_TEST_ROOT/mutate-local-credential" ]]; then
  printf 'DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDM\n' >"$FLEET_TEST_LOCAL_HOME/.config/skidbladnir/bearer"
fi
case "$(basename "$HOME")" in
local) target=macbook ;;
arch) target=arch ;;
*) exit 64 ;;
esac
if [[ -e "$FLEET_TEST_ROOT/second-apply-mutates" ]]; then
  printf 'RESTARTED  skid.runtime: injected drift\n'
else
  printf 'UP TO DATE  %s\n' "$target"
fi
EOF
cat >"$checkout/devbox" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${1:-}" == apply && $# -eq 1 ]]
printf 'apply devbox devbox apply\n' >>"$FLEET_TEST_LOG"
printf 'UP TO DATE  devbox\n'
EOF
install -d -m 0700 "$checkout/assets/skidbladnir" "$arch_home/src/personal"
cat >"$checkout/assets/skidbladnir/release-pin.json" <<'EOF'
{
  "schemaVersion": 1,
  "version": "v1.2.3",
  "sourceSha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "artifacts": {
    "darwin-arm64": {"url": "https://github.com/NielsdaWheelz/skidbladnir/releases/download/v1.2.3/skidbladnir-darwin-arm64.tar.gz", "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    "linux-amd64": {"url": "https://github.com/NielsdaWheelz/skidbladnir/releases/download/v1.2.3/skidbladnir-linux-amd64.tar.gz", "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}
  }
}
EOF
chmod 0700 "$checkout/workstation" "$checkout/devbox"
git -C "$checkout" init -q
git -C "$checkout" config user.name 'Fleet Test'
git -C "$checkout" config user.email fleet-test@example.test
git -C "$checkout" add workstation devbox assets/skidbladnir/release-pin.json
git -C "$checkout" commit -qm fixture
git clone -q "$checkout" "$arch_home/src/personal/dev-server"
pin_checkout="$test_root/dev-server-pin-cases"
git clone -q "$checkout" "$pin_checkout"
git -C "$pin_checkout" config user.name 'Fleet Test'
git -C "$pin_checkout" config user.email fleet-test@example.test

export HOME="$local_home"
export PATH="$fake_bin:$PATH"
export FLEET_TEST_ROOT="$test_root"
export FLEET_TEST_LOG="$log_file"
export FLEET_TEST_QR="$qr_file"
export FLEET_TEST_LOCAL_HOME="$local_home"
export FLEET_TEST_DEVBOX_HOME="$devbox_home"
export FLEET_TEST_ARCH_HOME="$arch_home"

output=''
status=0
capture() {
  set +e
  output="$("$@" 2>&1)"
  status=$?
  set -e
}

capture "$fleet"
[[ "$status" == 64 && "$output" == *'Usage: scripts/fleet <command>'* ]] ||
  fail 'empty invocation did not return usage 64'
capture "$fleet" converge
[[ "$status" == 64 ]] || fail 'legacy converge command was accepted'
capture "$fleet" verify extra
[[ "$status" == 64 && "$output" == Usage:* && "$output" != error:* ]] ||
  fail "invalid command shape crossed the preflight boundary: status=$status output=$output"

unset SKIDBLADNIR_DEV_SERVER_CHECKOUT
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'SKIDBLADNIR_DEV_SERVER_CHECKOUT'* ]] ||
  fail 'release-bound verification ran without an explicit dev-server checkout'
export SKIDBLADNIR_DEV_SERVER_CHECKOUT="$checkout"
capture "$fleet" verify
[[ "$status" == 0 && "$output" == *'Fleet gateway verification: pass.'* ]] ||
  fail "fixed-fleet verification did not pass: status=$status output=$output"
[[ "$(grep -c '^curl .* pressure$' "$log_file")" == 3 ]] ||
  fail 'verify did not inspect exactly three authenticated pressure endpoints'

printf '%s\n' "$local_handle" >"$arch_home/.config/skidbladnir/machine-handle"
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'machine handles are not unique'* ]] ||
  fail 'verify accepted duplicate fixed-fleet identities'
printf '%s\n' "$arch_handle" >"$arch_home/.config/skidbladnir/machine-handle"

touch "$arch_home/public-funnel"
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'private Tailscale Serve mapping is invalid'* ]] ||
  fail 'verify accepted public or invalid Tailscale ingress'
/bin/unlink "$arch_home/public-funnel"

touch "$arch_home/serve-extra"
capture "$fleet" verify
[[ "$status" != 0 && "$output" == *'private Tailscale Serve mapping is invalid'* ]] ||
  fail 'verify accepted unknown state on the owned Serve port'
/bin/unlink "$arch_home/serve-extra"

touch "$arch_home/alternate-funnel"
capture "$fleet" verify
