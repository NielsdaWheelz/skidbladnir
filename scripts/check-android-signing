#!/usr/bin/env bash
set -euo pipefail

# usage: ANDROID_HOME=SDK scripts/check-android-signing APK
# accept an apk only when it verifies and its one signer is the pinned certificate.
[[ "$#" -eq 1 ]] || {
  printf 'usage: %s APK\n' "$0" >&2
  exit 64
}
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
apksigner="${ANDROID_HOME:?set ANDROID_HOME to the android sdk}/build-tools/36.1.0/apksigner"
if [[ "$(uname -s)" == Darwin ]]; then
  export JAVA_HOME="${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}"
fi
signer="$("$apksigner" verify --print-certs "$1" |
  awk 'index($0, "Signer #") == 1 && index($0, " certificate SHA-256 digest: ") { count++; digest = $NF }
    END { if (count != 1 || length(digest) != 64 || digest !~ /^[0-9a-f]+$/) exit 1; print digest }')" || {
  printf 'APK signature verification failed\n' >&2
  exit 1
}
[[ "$signer" == "$(cat "$repo_dir/android/app-signing-cert.sha256")" ]] || {
  printf 'APK signing certificate does not match the repository pin\n' >&2
  exit 1
}
printf 'Android signing certificate accepted\n'
