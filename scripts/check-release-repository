#!/usr/bin/env bash
set -euo pipefail

# usage: check-release-repository {immutable | run SOURCE_SHA}
# proves the github side of a release: the original public repository, then either
# immutable releases or a successful push verify run on main for exactly SOURCE_SHA,
# whose id `run` prints.
repo='NielsdaWheelz/skidbladnir'
repo_id=1386409483
[[ "${1:-}" == immutable || "${1:-}" == run ]] || {
  printf 'usage: %s {immutable|run SOURCE_SHA}\n' "$0" >&2
  exit 64
}

gh api --method GET "repos/$repo" |
  jq -e --arg name "$repo" --argjson id "$repo_id" \
    '.id == $id and .full_name == $name and .private == false and .archived == false' \
    >/dev/null || {
  printf 'GitHub repository name does not identify the original public Skidbladnir repository (id %s)\n' "$repo_id" >&2
  exit 1
}

if [[ "$1" == immutable ]]; then
  gh api --method GET \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2026-03-10' \
    "repos/$repo/immutable-releases" | jq -e '.enabled == true' >/dev/null || {
    printf 'GitHub immutable releases are not enabled for repository id %s\n' "$repo_id" >&2
    exit 1
  }
else
  run_id="$(gh run list --repo "$repo" --workflow verify.yml --branch main --event push --commit "$2" \
    --status success --limit 1 --json databaseId --jq '.[0].databaseId // empty')"
  [[ "$run_id" =~ ^[1-9][0-9]*$ ]] || {
    printf 'No successful verify run exists for source SHA %s\n' "$2" >&2
    exit 1
  }
  gh api --method GET "repos/$repo/actions/runs/$run_id" |
    jq -e --arg sha "$2" --argjson id "$repo_id" '
      .repository.id == $id and .head_repository.id == $id and
      .head_sha == $sha and .head_branch == "main" and
      .event == "push" and .status == "completed" and
      .conclusion == "success" and
      (.path | test("(^|/)\\.github/workflows/verify\\.yml(@.*)?$"))
    ' >/dev/null || {
    printf 'Hosted verify run does not belong to the exact source in repository id %s\n' "$repo_id" >&2
    exit 1
  }
  printf '%s\n' "$run_id"
fi
