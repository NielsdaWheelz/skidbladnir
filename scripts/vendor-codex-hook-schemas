#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source_commit='ff29a44391deccde0aba0f8390337d7f3c319ea4'
source_base="https://raw.githubusercontent.com/openai/codex/$source_commit/codex-rs/hooks/schema/generated"
destination="$repo_dir/schemas/codex/0.149.1/hooks"
temporary="$(mktemp -d /tmp/skidbladnir-codex-hooks.XXXXXX)"

cleanup() {
  if [[ "$temporary" == /tmp/skidbladnir-codex-hooks.* && -d "$temporary" ]]; then
    rm -rf -- "$temporary"
  fi
}
trap cleanup EXIT

schemas=(
  session-start
  user-prompt-submit
  post-tool-use
  subagent-start
  subagent-stop
  stop
  session-end
)

for schema in "${schemas[@]}"; do
  file="$schema.command.input.schema.json"
  curl --fail --location --silent --show-error "$source_base/$file" --output "$temporary/$file"
done

mkdir -p "$destination"
for schema in "${schemas[@]}"; do
  file="$schema.command.input.schema.json"
  install -m 0644 "$temporary/$file" "$destination/$file"
done
