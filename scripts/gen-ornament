#!/usr/bin/env python3
"""Deterministically generate the frozen Niðavellir ornament geometry.

Owned by docs/ornament-pipeline.md; the family rules are design-language.md
§7 (fret construction) and §8 (the valknut, the launcher mark), and the mark's
own geometry is frozen by docs/launcher-mark.md. This script is a pure function
of the constants defined below: no clock, no randomness, no filesystem reads
beyond its own source. `scripts/check-ornament` imports `build_outputs()` and
byte-compares its result against the checked-in files, so drift between this
generator and the committed output fails the static gate.

Two marks ship here, plus the launcher icon:
  * Fret cell: one chevron unit for the Forge title band (monoline, 45° turns).
  * Valknut: three interlocked equilateral triangles (tricursal, Borromean
    topology), same baked-gap technique at all six crossings.
  * Launcher mark: Skíðblaðnir under sail — hull, sail, yard, vane and shield
    row — authored as straight-edged polygons, never traced.

Fret and valknut geometry is emitted as `OrnamentSegment` unit-box constants in
Ornament.kt; the launcher mark stays generator-internal and is emitted as the
whole adaptive-icon resource set.
"""

from __future__ import annotations

import argparse
import math
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ORNAMENT_KT = "android/app/src/main/java/dev/niels/skidbladnir/Ornament.kt"
ICON_BACKGROUND_XML = "android/app/src/main/res/drawable/ic_launcher_background.xml"
ICON_FOREGROUND_XML = "android/app/src/main/res/drawable/ic_launcher_foreground.xml"
ICON_MONOCHROME_XML = "android/app/src/main/res/drawable/ic_launcher_monochrome.xml"
ICON_DESCRIPTOR_XML = "android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml"

# Android's documented adaptive-icon canvas.
_ICON_VIEWPORT = 108.0


def _fmt_f(value: float) -> str:
    """A Kotlin Float literal for `value`, minimal and deterministic."""
    rounded = round(value, 6) + 0.0  # +0.0 folds -0.0 to 0.0
    text = f"{rounded:.6f}".rstrip("0").rstrip(".")
    return f"{text or '0'}f"


def _fmt_n(value: float) -> str:
    """A VectorDrawable pathData number for `value`."""
    rounded = round(value, 3) + 0.0
    text = f"{rounded:.3f}".rstrip("0").rstrip(".")
    return text or "0"


# --- Fret cell ---------------------------------------------------------


def _fret_cell() -> list[tuple[float, float, float, float]]:
    """One chevron unit in a 1:1 unit box: a "V" from (0,1) down to the apex
    at (0.5,0) and back up to (1,1). Both ends sit at y=1, so placing whole
    copies side by side (x -> x+1) continues the zigzag with no seam."""
    return [
        (0.0, 1.0, 0.5, 0.0),
        (0.5, 0.0, 1.0, 1.0),
    ]


# --- Weave helper (valknut baked gaps) ----------------------------------


def _split_with_gaps(
    p0: tuple[float, float],
    p1: tuple[float, float],
    cut_centers: list[float],
    gap: float,
) -> list[tuple[float, float, float, float]]:
    """Split the segment p0->p1 (parametrized t in [0,1]) around each center
    in `cut_centers`, removing a `gap`-wide window at every center. Overlapping
    windows merge. Returns the surviving pieces as absolute-coordinate
    segments; an empty `cut_centers` returns the segment whole."""
    windows = sorted((c - gap / 2, c + gap / 2) for c in cut_centers)
    merged: list[list[float]] = []
    for lo, hi in windows:
        if merged and lo <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], hi)
        else:
            merged.append([lo, hi])
    cuts = sorted({0.0, 1.0} | {max(0.0, min(1.0, v)) for w in merged for v in w})

    def point_at(t: float) -> tuple[float, float]:
        return (p0[0] + (p1[0] - p0[0]) * t, p0[1] + (p1[1] - p0[1]) * t)

    pieces = []
    for a, b in zip(cuts, cuts[1:]):
        mid = (a + b) / 2
        if any(lo <= mid <= hi for lo, hi in merged):
            continue
        if b - a < 1e-9:
            continue
        pieces.append(point_at(a) + point_at(b))
    return pieces


# --- Valknut --------------------------------------------------------------


def _rotate(p: tuple[float, float], degrees: float) -> tuple[float, float]:
    a = math.radians(degrees)
    x, y = p
    return (x * math.cos(a) - y * math.sin(a), x * math.sin(a) + y * math.cos(a))


def _triangle(centroid: tuple[float, float], radius: float, phi0: float) -> list[tuple[float, float]]:
    cx, cy = centroid
    return [
        (cx + radius * math.cos(math.radians(phi0 + 120 * k)), cy + radius * math.sin(math.radians(phi0 + 120 * k)))
        for k in range(3)
    ]


def _seg_intersect_t(p1, p2, p3, p4) -> tuple[float, float] | None:
    (x1, y1), (x2, y2), (x3, y3), (x4, y4) = p1, p2, p3, p4
    d = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
    if abs(d) < 1e-9:
        return None
    t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / d
    u = ((x1 - x3) * (y1 - y2) - (y1 - y3) * (x1 - x2)) / d
    if 1e-9 < t < 1 - 1e-9 and 1e-9 < u < 1 - 1e-9:
        return (t, u)
    return None


def _valknut(gap: float = 0.10) -> list[tuple[float, float, float, float]]:
    """The tricursal valknut (design-language.md §8): three congruent
    equilateral triangles, each the previous rotated 120° about the shared
    center, with each triangle's own centroid itself offset from that center
    — the offset is what keeps the three from simply coinciding, giving the
    interlocked Borromean silhouette. Straight lines only. The six crossings
    are ordered by angle around the center; the over triangle alternates
    strictly walking that ring, and the losing triangle's edge is split with
    a gap at that crossing (`_split_with_gaps`), baking the weave into the
    data with no runtime over/under logic."""
    offset, radius, phi0, centroid_angle = 0.6, 1.0, 90.0, 135.0
    base_centroid = (offset * math.cos(math.radians(centroid_angle)), offset * math.sin(math.radians(centroid_angle)))
    base = _triangle(base_centroid, radius, phi0)
    triangles = [base, [_rotate(p, 120) for p in base], [_rotate(p, 240) for p in base]]
    edges = [[(t[i], t[(i + 1) % 3]) for i in range(3)] for t in triangles]

    crossings = []
    for a, b in ((0, 1), (1, 2), (0, 2)):
        for ea_idx, (pa0, pa1) in enumerate(edges[a]):
            for eb_idx, (pb0, pb1) in enumerate(edges[b]):
                hit = _seg_intersect_t(pa0, pa1, pb0, pb1)
                if hit is None:
                    continue
                t_a, t_b = hit
                x = pa0[0] + t_a * (pa1[0] - pa0[0])
                y = pa0[1] + t_a * (pa1[1] - pa0[1])
                crossings.append(
                    {"tri_a": a, "edge_a": ea_idx, "t_a": t_a, "tri_b": b, "edge_b": eb_idx, "t_b": t_b, "x": x, "y": y}
                )
    crossings.sort(key=lambda c: math.atan2(c["y"], c["x"]))
    for i, c in enumerate(crossings):
        c["over"] = c["tri_a"] if i % 2 == 0 else c["tri_b"]

    all_points = [p for t in triangles for p in t]
    half_span = max(max(abs(p[0]) for p in all_points), max(abs(p[1]) for p in all_points)) * 1.08

    def normalize(p: tuple[float, float]) -> tuple[float, float]:
        return (0.5 + p[0] / (2 * half_span), 0.5 - p[1] / (2 * half_span))

    segments = []
    for tri_idx in range(3):
        for edge_idx, (p0, p1) in enumerate(edges[tri_idx]):
            cut_centers = []
            for c in crossings:
                if c["over"] == tri_idx:
                    continue
                if c["tri_a"] == tri_idx and c["edge_a"] == edge_idx:
                    cut_centers.append(c["t_a"])
                elif c["tri_b"] == tri_idx and c["edge_b"] == edge_idx:
                    cut_centers.append(c["t_b"])
            for seg in _split_with_gaps(p0, p1, cut_centers, gap):
                segments.append((*normalize(seg[0:2]), *normalize(seg[2:4])))
    return segments


# --- Launcher mark ----------------------------------------------------------
#
# Every value below is frozen by docs/launcher-mark.md's geometry table:
# straight edges only, authored rather than traced, and sized so the mark
# clears both invariants build_outputs() checks before it emits anything.

STROKE_FLOOR_DP = 2.0   # one 2dp stroke / one 2dp gap
LAUNCHER_MIN_DP = 48.0  # smallest launcher size the mark must survive
ICON_ENVELOPE = 34.0    # units from centre; Android's circular mask clips at 36

# A launcher icon shown at S dp maps the 108-unit canvas onto 1.5*S dp, so at
# LAUNCHER_MIN_DP one unit is 0.667dp and STROKE_FLOOR_DP is 3.0 units.
_MIN_FEATURE = STROKE_FLOOR_DP * _ICON_VIEWPORT / (1.5 * LAUNCHER_MIN_DP)

_GOLD, _BRONZE, _GARNET = "#D6A85F", "#CD7F32", "#830E0D"
_INK, _DEEP_SURFACE = "#0C0D0F", "#15171A"

_MARK_CENTRE = _ICON_VIEWPORT / 2

# Yard, stated as `y = 31.5, x = 33.5...74.5, stroke 5`: a 5-wide stroke with
# square caps, emitted as the rectangle those caps describe, so it runs half a
# stroke past each stated end. Its two outer top corners are the mark's
# farthest points from centre and set the measured envelope.
_YARD_Y, _YARD_HALF, _YARD_W = 31.5, 20.5, 5.0

# Mast, stated as `x = 54, y = 23...67.5, stroke 5`: square-capped likewise, so
# the cap above y = 23 is the masthead the vane is rooted on and the cap below
# lands on the sheer. It runs the mark's whole height on purpose — a mast that
# stops above the sail leaves the yard, the sail and the hull as three
# unattached masses, which read as a lidded crate over a jewelled band rather
# than as a ship.
_MAST_TOP, _MAST_BOTTOM, _MAST_W = 23.0, 67.5, 5.0

# The vane clears the yard by 3.27 units rather than sitting on it: at 25.75 its
# trailing edge left a 0.99-unit wedge against the yard's top, which closes
# under antialiasing and fuses the two into one mass.
_VANE = [(54.0, 23.0), (68.0, 24.5), (54.0, 26.0)]

_SAIL_X0, _SAIL_Y0, _SAIL_X1, _SAIL_Y1 = 36.0, 37.0, 72.0, 62.0
_SAIL_FOOT_CUT = 8.0
# The gore seams, symmetric about the sail's centre.
_SEAM_T = (0.27, 0.73)

_HULL_TIP, _HULL_ITIP = (21.0, 53.0), (33.0, 65.0)
_HULL_SHEER, _HULL_KEEL = (37.0, 70.0), (34.0, 79.0)

_SHIELD_CX = (43.5, 54.0, 64.5)
_SHIELD_CY, _SHIELD_RY = 70.5, 4.5
_SHIELD_RX, _SHIELD_RX_MONO = 4.4, 3.5

_SEAM_X = tuple(_SAIL_X0 + t * (_SAIL_X1 - _SAIL_X0) for t in _SEAM_T)

# The slit between gores is derived, not chosen: each outer gore ends exactly
# where the sail's own 45° foot cut begins, which closes it as a clean
# quadrilateral. Any other width leaves a needle of gore between the seam and
# the cut — 0.12 units at a slit of 3.2 — or folds the gore into a bowtie.
_SLIT_W = 2 * (_SEAM_X[0] - _SAIL_X0 - _SAIL_FOOT_CUT)


def _require_legible(features: dict[str, float]) -> None:
    """Raise ValueError naming the first clearance below the floor."""
    for name, units in features.items():
        if units < _MIN_FEATURE:
            dp = units * 1.5 * LAUNCHER_MIN_DP / _ICON_VIEWPORT
            raise ValueError(
                f"{name} is {units:.2f} units = {dp:.2f}dp at {LAUNCHER_MIN_DP:.0f}dp, "
                f"below the {STROKE_FLOOR_DP:.0f}dp floor"
            )


def _require_within_envelope(polygons: list[list[tuple[float, float]]]) -> None:
    """Raise ValueError if any point exceeds ICON_ENVELOPE from centre."""
    for ring in polygons:
        for x, y in ring:
            radius = math.hypot(x - _MARK_CENTRE, y - _MARK_CENTRE)
            if radius > ICON_ENVELOPE:
                raise ValueError(
                    f"({_fmt_n(x)},{_fmt_n(y)}) sits at r={radius:.3f}, "
                    f"outside the {ICON_ENVELOPE:.0f}-unit mask envelope"
                )


def _vane_edge_at(x: float) -> float:
    """y of the vane's trailing edge at `x` — the edge that faces the yard."""
    (root_x, root_y), (tip_x, tip_y) = _VANE[2], _VANE[1]
    return root_y + (x - root_x) / (tip_x - root_x) * (tip_y - root_y)


def _rect(x0: float, y0: float, x1: float, y1: float) -> list[tuple[float, float]]:
    return [(x0, y0), (x1, y0), (x1, y1), (x0, y1)]


def _sail_gores() -> list[list[tuple[float, float]]]:
    """The sail's three gores, separated by `_SLIT_W` of daylight. Both layers
    use the same three solids: colour bands the gores where the launcher has
    colour, and the slits keep them apart where it does not, so the sail reads
    as panelled canvas under one flat tint instead of one chamfered block."""
    x0, y0, x1, y1 = _SAIL_X0, _SAIL_Y0, _SAIL_X1, _SAIL_Y1
    luff_seam, leech_seam = _SEAM_X[0] - _SLIT_W / 2, _SEAM_X[1] + _SLIT_W / 2
    return [
        [(x0, y0), (luff_seam, y0), (luff_seam, y1), (x0, y1 - _SAIL_FOOT_CUT)],
        _rect(_SEAM_X[0] + _SLIT_W / 2, y0, _SEAM_X[1] - _SLIT_W / 2, y1),
        [(leech_seam, y0), (x1, y0), (x1, y1 - _SAIL_FOOT_CUT), (leech_seam, y1)],
    ]


def _sheer_notch(cx: float) -> list[tuple[float, float]]:
    """One monochrome shield, re-cut as a dip in the sheer and walked
    right-to-left. The shield straddles the sheer, and only the half below it
    is inside the hull — a cut above the sheer would remove nothing and leave a
    floating speck. So the notch is the widest-at-the-mouth triangle that fits
    the shield below the sheer: widening inwards would undercut the deck and
    leave an overhanging lip at each shoulder."""
    return [
        (cx + _SHIELD_RX_MONO, _HULL_SHEER[1]),
        (cx, _SHIELD_CY + _SHIELD_RY),
        (cx - _SHIELD_RX_MONO, _HULL_SHEER[1]),
    ]


def _hull(sheer_notches: list[list[tuple[float, float]]]) -> list[tuple[float, float]]:
    """The hull as one ring: keel, both cut stems mirrored about x = 54, and the
    sheer, which the ring walks right-to-left. `sheer_notches` is spliced into
    that walk, so its runs arrive in decreasing x."""
    tip_x, tip_y = _HULL_TIP
    itip_x, itip_y = _HULL_ITIP
    sheer_x, sheer_y = _HULL_SHEER
    keel_x, keel_y = _HULL_KEEL
    return [
        (tip_x, tip_y), (keel_x, keel_y),
        (_ICON_VIEWPORT - keel_x, keel_y), (_ICON_VIEWPORT - tip_x, tip_y),
        (_ICON_VIEWPORT - itip_x, itip_y), (_ICON_VIEWPORT - sheer_x, sheer_y),
        *[point for notch in sheer_notches for point in notch],
        (sheer_x, sheer_y), (itip_x, itip_y),
    ]


def _mark_layers() -> tuple[list, list, list]:
    """(background, foreground, monochrome), each a list of (rings, colour).
    Every ring is a solid and rings sharing a path are disjoint, so nothing here
    depends on a fill's winding rule."""
    rig = [
        ([_rect(_MARK_CENTRE - _MAST_W / 2, _MAST_TOP - _MAST_W / 2,
                _MARK_CENTRE + _MAST_W / 2, _MAST_BOTTOM + _MAST_W / 2)], _GOLD),
        ([_VANE], _GOLD),
        ([_rect(_MARK_CENTRE - _YARD_HALF - _YARD_W / 2, _YARD_Y - _YARD_W / 2,
                _MARK_CENTRE + _YARD_HALF + _YARD_W / 2, _YARD_Y + _YARD_W / 2)], _GOLD),
    ]
    background = [
        ([_rect(0.0, 0.0, _ICON_VIEWPORT, _ICON_VIEWPORT)], _INK),
        ([[(0.0, 0.0), (_ICON_VIEWPORT, 0.0), (0.0, _ICON_VIEWPORT)]], _DEEP_SURFACE),
    ]
    foreground = rig + [
        ([gore], colour) for gore, colour in zip(_sail_gores(), (_BRONZE, _GOLD, _BRONZE))
    ] + [
        ([_hull([])], _GOLD),
        ([[(cx, _SHIELD_CY - _SHIELD_RY), (cx + _SHIELD_RX, _SHIELD_CY),
           (cx, _SHIELD_CY + _SHIELD_RY), (cx - _SHIELD_RX, _SHIELD_CY)]
          for cx in _SHIELD_CX], _GARNET),
    ]
    monochrome = rig + [
        (_sail_gores(), _GOLD),
        ([_hull([_sheer_notch(cx) for cx in reversed(_SHIELD_CX)])], _GOLD),
    ]
    return background, foreground, monochrome


# --- Kotlin + XML rendering -------------------------------------------------

_XML_HEADER = (
    '<?xml version="1.0" encoding="utf-8"?>\n'
    "<!-- GENERATED BY scripts/gen-ornament — DO NOT EDIT (drift-gated by scripts/check-ornament) -->\n"
)


def _kotlin_segments(name: str, segments: list[tuple[float, float, float, float]]) -> str:
    lines = ",\n".join(
        f"    OrnamentSegment({_fmt_f(x1)}, {_fmt_f(y1)}, {_fmt_f(x2)}, {_fmt_f(y2)})" for x1, y1, x2, y2 in segments
    )
    return f"internal val {name}: List<OrnamentSegment> = listOf(\n{lines},\n)\n"


def _path_data(polygons: list[list[tuple[float, float]]]) -> str:
    """M/L/Z path data, one closed ring per polygon."""
    return "".join(
        f"M{_fmt_n(ring[0][0])},{_fmt_n(ring[0][1])}"
        + "".join(f"L{_fmt_n(x)},{_fmt_n(y)}" for x, y in ring[1:])
        + "Z"
        for ring in polygons
    )


def _vector(paths: list[tuple[str, str]], comment: str) -> bytes:
    """One VectorDrawable on the adaptive-icon canvas, one <path> per
    (colour, pathData) pair."""
    body = "\n".join(
        f"    <path\n"
        f'        android:fillColor="{colour}"\n'
        f'        android:pathData="{data}" />'
        for colour, data in paths
    )
    return (
        _XML_HEADER + f"<!-- {comment} -->\n"
        '<vector xmlns:android="http://schemas.android.com/apk/res/android"\n'
        f'    android:width="{_fmt_n(_ICON_VIEWPORT)}dp"\n'
        f'    android:height="{_fmt_n(_ICON_VIEWPORT)}dp"\n'
        f'    android:viewportWidth="{_fmt_n(_ICON_VIEWPORT)}"\n'
        f'    android:viewportHeight="{_fmt_n(_ICON_VIEWPORT)}">\n'
        f"{body}\n"
        "</vector>\n"
    ).encode("utf-8")


def build_outputs() -> dict[str, bytes]:
    """The full generated-output set, keyed by repo-relative path. Pure
    function of this module's constants; called twice by
    `scripts/check-ornament` to prove determinism, and once per checked-in
    path to prove no drift."""
    kotlin = "".join(
        [
            "package dev.niels.skidbladnir\n",
            "\n",
            "// GENERATED BY scripts/gen-ornament — DO NOT EDIT (drift-gated by scripts/check-ornament)\n",
            "//\n",
            "// Frozen ornament geometry (design-language.md §7 §8, ornament-pipeline.md).\n",
            "// Every List<OrnamentSegment> below is monoline stroke data in a unit box;\n",
            "// topology is computed on-device — the app only draws these constants.\n",
            "\n",
            "internal data class OrnamentSegment(val x1: Float, val y1: Float, val x2: Float, val y2: Float)\n",
            "\n",
            "// One chevron unit (design-language.md §7): 45° turns only, unit box aspect\n",
            "// 1:1. Tiles horizontally with no seam — every copy starts and ends at y=1.\n",
            _kotlin_segments("FretCell", _fret_cell()),
            "\n",
            "// The tricursal valknut (design-language.md §8): three interlocked\n",
            "// equilateral triangles, Borromean topology, straight lines only, unit box\n",
            "// aspect 1:1. All six over/under crossings are baked as gaps.\n",
            _kotlin_segments("Valknut", _valknut()),
        ]
    )

    background, foreground, monochrome = _mark_layers()
    # The background is a full-canvas plane the launcher's mask is meant to
    # clip, so only the mark itself is measured against the envelope.
    _require_within_envelope([ring for layer in (foreground, monochrome) for rings, _ in layer for ring in rings])
    _require_legible(
        {
            "yard bottom -> sail head": _SAIL_Y0 - (_YARD_Y + _YARD_W / 2),
            # Measured where the vane leaves the mast's flank, which is the
            # narrowest point of the wedge between the two.
            "vane -> yard": (_YARD_Y - _YARD_W / 2) - _vane_edge_at(_MARK_CENTRE + _MAST_W / 2),
            "gore-slit width": _SLIT_W,
            "outer gore width": _SEAM_X[0] - _SLIT_W / 2 - _SAIL_X0,
            "sail foot -> hull sheer": _HULL_SHEER[1] - _SAIL_Y1,
            # The sail's foot cut and the stem's inner edge are both 45°, so
            # they are parallel and their separation is constant: the distance
            # between the two lines x - y = c, not a horizontal reach at one
            # height. Measuring horizontally at the foot understated it as 6.
            "sail cut -> stem": abs(
                (_SAIL_X0 - (_SAIL_Y1 - _SAIL_FOOT_CUT)) - (_HULL_TIP[0] - _HULL_TIP[1])
            ) / math.sqrt(2),
            "shield-notch web": _SHIELD_CX[1] - _SHIELD_CX[0] - 2 * _SHIELD_RX_MONO,
            "notch -> sheer end": _SHIELD_CX[0] - _SHIELD_RX_MONO - _HULL_SHEER[0],
        }
    )

    descriptor = (
        _XML_HEADER + "<!-- The launcher identity is Skíðblaðnir under sail (docs/launcher-mark.md).\n"
        "     monochrome is its own drawable: the launcher paints that layer in one\n"
        "     flat tint, so the foreground's colour-carried structure cannot survive\n"
        "     there and the geometry is cut differently. -->\n"
        '<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">\n'
        '    <background android:drawable="@drawable/ic_launcher_background" />\n'
        '    <foreground android:drawable="@drawable/ic_launcher_foreground" />\n'
        '    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />\n'
        "</adaptive-icon>\n"
    )

    return {
        ORNAMENT_KT: kotlin.encode("utf-8"),
        ICON_BACKGROUND_XML: _vector(
            [(colour, _path_data(rings)) for rings, colour in background],
            "Ink, cut once on the canvas diagonal by a DeepSurface facet plane.",
        ),
        ICON_FOREGROUND_XML: _vector(
            [(colour, _path_data(rings)) for rings, colour in foreground],
            "Skíðblaðnir under sail: Gold rig and hull, Bronze/Gold gores, a Garnet shield row.",
        ),
        ICON_MONOCHROME_XML: _vector(
            [(colour, _path_data(rings)) for rings, colour in monochrome],
            "Cut for one flat tint: the shield row survives as notches in the sheer, because colour cannot carry it here.",
        ),
        ICON_DESCRIPTOR_XML: descriptor.encode("utf-8"),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--out-root",
        type=Path,
        default=ROOT,
        help="Write generated files under this root instead of the repo root (default: repo root).",
    )
    args = parser.parse_args()
    for relative, content in build_outputs().items():
        destination = args.out_root / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(content)
        print(f"wrote {relative} ({len(content)} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
