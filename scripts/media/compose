#!/usr/bin/env python3
"""Composes the continuity video and the stills from record's files in $MEDIA_WORK into $MEDIA_WORK/assets,
then prints their sizes and fails if one is over its limit. Offline; needs ffmpeg."""
import os
import re
import subprocess
import sys

WORK = os.environ.get('MEDIA_WORK') or os.path.expanduser('~/.cache/skid-media')
OUT = os.path.join(WORK, 'assets')
# desktop.tape detaches this far into its video: 3 s, Enter, 2 s, git log typed, 0.3 s, Enter, 3 s, ctrl-] d.
DESKTOP_DETACH = 9.7
# A cut is the strongest scene change within this many seconds of its estimate. VHS's timeline drifts about 10%
# from the wall clock, so the desktop's is known only to a second or so.
REACH = 1.5
STILL_LIMIT = 200_000
VIDEO_LIMIT = 4_000_000


def ffmpeg(*args):
    subprocess.run(['ffmpeg', '-v', 'error', '-y', *args], check=True)


def scene_scores(video):
    """Every frame's (time, scene score) after the first."""
    printed = subprocess.run(
        ['ffmpeg', '-v', 'error', '-i', video, '-vf', "scale=320:-2,select='gte(scene,0)',metadata=print:file=-",
         '-an', '-f', 'null', '-'],
        capture_output=True, text=True, check=True).stdout
    times = [float(t) for t in re.findall(r'pts_time:(\S+)', printed)]
    scores = [float(s) for s in re.findall(r'lavfi\.scene_score=(\S+)', printed)]
    return list(zip(times, scores))


def cut(scores, near, name):
    score, at = max(((s, t) for t, s in scores if abs(t - near) <= REACH), default=(None, None))
    if at is None:
        sys.exit(f'compose: no frame within {REACH} s of {near:.2f} s, where the {name} should be')
    print(f'{name}: estimated at {near:.2f} s, cut at {at:.2f} s (scene score {score:.2f})')
    return at


def still(source, name, width=None, at=None):
    """Writes one frame of source as a 256-colour PNG."""
    scale = f'scale={width}:-2:flags=lanczos,' if width else ''
    seek = ['-ss', f'{at:.3f}'] if at is not None else []
    # palettegen emits its palette only at the end of its input, so the input stops after one frame.
    ffmpeg(*seek, '-i', source, '-vf',
           f'trim=end_frame=1,{scale}split[a][b];[a]palettegen=max_colors=256:reserve_transparent=0[p];'
           '[b][p]paletteuse=dither=none', os.path.join(OUT, name))


def main():
    events = {name: float(at) for name, at in (line.split() for line in open(os.path.join(WORK, 'events.txt')))}
    desktop, phone = os.path.join(WORK, 'desktop.mp4'), os.path.join(WORK, 'phone.mp4')
    os.makedirs(OUT, exist_ok=True)

    detach = cut(scene_scores(desktop), DESKTOP_DETACH, 'desktop detach')
    phone_scores = scene_scores(phone)
    end = phone_scores[-1][0]

    def phone_time(event):
        # scrcpy records in real time until it is stopped, so its video ends at scrcpy_stop.
        return end - (events['scrcpy_stop'] - events[event])

    opened = cut(phone_scores, phone_time('phone_open'), 'phone open')
    # Composite time is desktop time. The phone opens api as long after the desktop detaches as it did on the clock.
    offset = detach + events['phone_open'] - events['desktop_detached'] - opened
    print(f'phone video offset: {offset:+.2f} s')

    video = os.path.join(OUT, 'continuity.mp4')
    # The phone holds its first frame until it starts and its last frame once it ends; the desktop sets the length.
    graph = (
        '[0:v]scale=1315:-2:flags=lanczos,setsar=1[desktop];'
        f'[1:v]fps=30,trim=start={max(0, -offset):.3f},setpts=PTS-STARTPTS,'
        f'tpad=start_mode=clone:start_duration={max(0, offset):.3f}:stop_mode=clone:stop=-1,'
        'scale=-2:1000:flags=lanczos,setsar=1[phone];'
        'color=c=0x0c0d0f:s=1920x1080:r=30[ground];'
        '[ground][desktop]overlay=48:(H-h)/2:shortest=1[left];'
        '[left][phone]overlay=W-w-48:(H-h)/2:shortest=1[out]'
    )
    ffmpeg('-i', desktop, '-i', phone, '-filter_complex', graph, '-map', '[out]', '-an', '-c:v', 'libx264',
           '-crf', '27', '-preset', 'slow', '-pix_fmt', 'yuv420p', '-movflags', '+faststart', video)
    # The poster shows the phone just after ls, keyboard still up.
    still(video, 'continuity.png', 1600, phone_time('phone_ls') + 1 + offset)
    still(desktop, 'desktop-browser.png', at=1.5)
    for name in ('dashboard', 'terminal', 'forge'):
        still(os.path.join(WORK, f'{name}.png'), f'phone-{name}.png', 720)

    over = []
    for name in ('continuity.mp4', 'continuity.png', 'desktop-browser.png',
                 'phone-dashboard.png', 'phone-terminal.png', 'phone-forge.png'):
        size = os.path.getsize(os.path.join(OUT, name))
        limit = VIDEO_LIMIT if name.endswith('.mp4') else STILL_LIMIT
        print(f'{name}: {size / 1000:.0f} KB of {limit / 1000:.0f} KB')
        if size > limit:
            over.append(name)
    if over:
        sys.exit(f'compose: over the limit: {", ".join(over)}')


if __name__ == '__main__':
    main()
