#!/usr/bin/env bash
# Stages the demo on the owner's fleet: stub providers, painted frames and fake
# repositories in ~/demo on every host, then nine sessions in the demo groups.
# Live; each run needs the owner's approval. cleanup undoes it.
set -euo pipefail
# shellcheck source=kit.sh
source "$(dirname "${BASH_SOURCE[0]}")/kit.sh"

# Name, host, group (also its repository), the stub's provider and state, and
# the frame's size. api is a plain terminal.
sessions="review dev-server atlas claude permission 80 30
migrate dev-server atlas codex idle 60 12
api macbook atlas - - - -
routes macbook atlas codex working 60 12
schema arch atlas claude working 80 13
dashboard macbook beacon claude working 80 13
build dev-server beacon codex idle 60 12
docs dev-server cobalt claude idle 80 12
deploy dev-server cobalt codex permission 80 16"

mkdir -p "$work"
[[ ! -e $work/sessions.tsv ]] || fail "$work/sessions.tsv exists; run cleanup first"
cd "$repo"

# Offline: what ~/demo will hold, one tree per platform.
staged=$work/staged
rm -rf "$staged"
mkdir -p "$staged/common/frames"
touch "$staged/common/.skid-media" # cleanup removes only a ~/demo that carries this
frames=internal/agentcontrol/testdata/frames
paint() { python3 "$frames/paint.py" "$frames/$1.txt" "$2" >"$staged/common/frames/$1-$3.ansi"; }
paint codex codex-f01-status-row working
paint codex codex-f10-permission-exec permission
paint codex codex-f06-ready-empty idle
paint claude F02_full_working_default working
paint claude F12_full_permission_bash permission
paint claude F01_full_idle_default idle

# The demo repositories take nothing from the owner's git configuration.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
commits=0
# commit REPO MESSAGE commits the repository's tree as a neutral author, at a
# fixed time so its hashes repeat from run to run.
commit() {
  local at
  commits=$((commits + 1))
  at=2026-10-20T09:$((10 + commits)):00Z
  git -C "$staged/common/$1" add -A
  GIT_AUTHOR_DATE=$at GIT_COMMITTER_DATE=$at git -C "$staged/common/$1" \
    -c user.name=Demo -c user.email=demo@example.invalid -c commit.gpgsign=false -c core.hooksPath=/dev/null \
    commit -q -m "$2"
}
for name in "${groups[@]}"; do
  git init -q -b main "$staged/common/$name"
done
cd "$staged/common/atlas"
printf 'module example.invalid/atlas\n\ngo 1.26\n' >go.mod
cat >main.go <<'EOF'
package main

import "net/http"

func main() { http.ListenAndServe(":8080", nil) }
EOF
commit atlas 'start atlas'
mkdir -p internal/health
cat >internal/health/health.go <<'EOF'
package health

import "net/http"

func Route(w http.ResponseWriter, _ *http.Request) { w.Write([]byte("ok")) }
EOF
commit atlas 'add the health route'
printf 'test:\n\tgo test ./...\n' >Makefile
commit atlas 'add make test'
cat >README.md <<'EOF'
# atlas

Run `make test` before you push.
EOF
commit atlas 'document make test'
cd "$staged/common/beacon"
printf '{ "name": "beacon", "private": true }\n' >package.json
mkdir src
cat >src/panel.js <<'EOF'
export function panel(status) {
  return `<p>${status}</p>`;
}
EOF
commit beacon 'start beacon'
printf '# beacon\n\nThe status panel.\n' >README.md
commit beacon 'describe the status panel'
cd "$staged/common/cobalt"
printf '#!/bin/sh\nset -eu\necho deploying\n' >deploy.sh
printf '# cobalt\n\nDeploys with ./deploy.sh.\n' >README.md
commit cobalt 'start cobalt'
mkdir docs
printf '# Runbook\n\n1. Run ./deploy.sh.\n2. Watch the logs.\n' >docs/runbook.md
commit cobalt 'write the deploy runbook'
cd "$repo"
for platform in darwin/arm64 linux/amd64; do
  tree=$staged/${platform/\//-}
  cp -R "$staged/common" "$tree"
  mkdir "$tree/bin"
  GOOS=${platform%/*} GOARCH=${platform#*/} CGO_ENABLED=0 go build -o "$tree/bin/codex" ./scripts/media/stub
  cp "$tree/bin/codex" "$tree/bin/claude"
done

# Live from here. Refuse unless every host lists and the demo's sessions and
# groups are free. The listing reaches python on stdin: it can be 1 MiB, as
# large as macOS allows a command's arguments to be.
skid list --json | python3 -c '
import json, sys
text = sys.stdin.read()
if not text:
    sys.exit("skid list printed nothing; it prints nothing over 1 MiB")
document = json.loads(text)
if not document["ok"]:
    sys.exit("skid list failed: " + document["error"]["code"])
peers = document["result"]["peers"]
failing = ["%s (%s)" % (p["label"], p["error"]["code"]) for p in peers if not p["ok"]]
if failing:
    sys.exit("unavailable: " + ", ".join(failing))
demo = sys.argv[2:]
wanted = {tuple(row.split()[:2]) for row in sys.argv[1].splitlines()}
taken = sorted("%s on %s" % pair for pair in wanted & {(s["name"], p["label"]) for p in peers for s in p["sessions"]})
labels = {s["group"] for p in peers for s in p["sessions"] if s.get("group")}
used = sorted(labels & set(demo))
# group.Compare folds ASCII case only. desktop.tape steps from all to the first group.
early = sorted(label for label in labels - set(demo) if label.encode().lower() < max(demo).encode())
if taken or used or early:
    sys.exit("sessions that exist: %s; demo groups in use: %s; groups that sort before them: %s" % (taken, used, early))
' "$sessions" "${groups[@]}" || fail 'every host must list, with the demo sessions and groups free and first'
while read -r -u 3 host _; do
  on "$host" 'test ! -e ~/demo' || fail "$host has a ~/demo already, or is unreachable"
done 3<<<"$hosts"

while read -r -u 3 host platform _; do
  printf 'copying ~/demo to %s\n' "$host"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$staged/${platform/\//-}" -cf - . | on "$host" 'mkdir ~/demo && tar -xf - -C ~/demo'
done 3<<<"$hosts"

# Columns: handle, host, tmux session id, name, group. A row is written as soon
# as its session exists, so cleanup can close it even if stage stops early.
: >"$work/sessions.tsv"
while read -r -u 3 name host group provider state width height; do
  # shellcheck disable=SC2088 # skid expands ~ on the host
  result=$(skid start "$name" --machine "$host" --terminal --cwd "~/demo/$group" --group "$group" --json) || true
  read -r creation handle tmux <<<"$(python3 -c '
import base64, json, sys
result = json.loads(sys.argv[1]).get("result") or {}
target = result.get("target", "")
tmux = json.loads(base64.urlsafe_b64decode(target + "=" * (-len(target) % 4)))["tmuxId"] if target else "-"
print(result.get("creation", "-"), result.get("handle") or "-", tmux)
' "$result")"
  if [[ $handle == t-* ]]; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$handle" "$host" "$tmux" "$name" "$group" >>"$work/sessions.tsv"
  fi
  [[ $creation == created ]] || fail "starting $name on $host: $result"
  target=$(printf %q "$tmux")
  [[ $(on "$host" "tmux display -p -t $target '#{session_name}'") == "$name" ]] ||
    fail "tmux $tmux on $host is not $name; left untouched"
  printf '%s on %s: %s %s\n' "$name" "$host" "$handle" "$tmux"
  if [[ $provider == - ]]; then
    # The owner's status line names the host; keep it out of the shot.
    on "$host" "tmux set-option -t $target status off"
    # A bare shell: no rc files, history or login prompt, on screen or in
    # tmux's scrollback, and a fixed prompt that desktop.tape waits for.
    skid text "$handle" --machine "$host" "clear; printf '\033[3J'; exec env -i HOME=\$HOME TERM=\$TERM PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin HISTFILE=/dev/null BASH_SILENCE_DEPRECATION_WARNING=1 PS1='atlas \$ ' bash --norc --noprofile" >/dev/null
    continue
  fi
  on "$host" "tmux resize-window -t $target -x $width -y $height"
  skid text "$handle" --machine "$host" "clear; ~/demo/bin/$provider ~/demo/frames/$provider-$state.ansi" >/dev/null
  deadline=$((SECONDS + 30))
  until reading=$(skid info "$handle" --machine "$host" --json | python3 -c '
import json, sys
provider, state = sys.argv[1:]
session = (json.load(sys.stdin).get("result") or {}).get("session") or {}
seen = ((session.get("agent") or {}).get("provider") or "no-provider").lower()
status = session.get("terminalStatus") or {}
print(seen, status.get("activity"), status.get("interaction"))
sys.exit(seen != provider or status.get("interaction" if state == "permission" else "activity") != state)
' "$provider" "$state" 2>&1); do
    ((SECONDS < deadline)) || fail "$name on $host reads as \"$reading\", not $provider $state"
    sleep 1
  done
done 3<<<"$sessions"
printf 'staged; sessions are listed in %s\n' "$work/sessions.tsv"
