#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

compatible_toolchain() {
  local required="$1"
  local resolved="$2"
  local required_major
  local required_minor
  local required_patch
  local resolved_major
  local resolved_minor
  local resolved_patch
  if [[ ! "$required" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    return 1
  fi
  required_major="${BASH_REMATCH[1]}"
  required_minor="${BASH_REMATCH[2]}"
  required_patch="${BASH_REMATCH[3]}"
  if [[ ! "$resolved" =~ ^go(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    return 1
  fi
  resolved_major="${BASH_REMATCH[1]}"
  resolved_minor="${BASH_REMATCH[2]}"
  resolved_patch="${BASH_REMATCH[3]}"
  ((${#required_major} <= 9 && ${#required_minor} <= 9 && ${#required_patch} <= 9)) || return 1
  ((${#resolved_major} <= 9 && ${#resolved_minor} <= 9 && ${#resolved_patch} <= 9)) || return 1
  [[ "$resolved_major" == "$required_major" && "$resolved_minor" == "$required_minor" ]] || return 1
  ((10#$resolved_patch >= 10#$required_patch))
}

if [[ "$#" -ne 0 ]]; then
  printf 'usage: %s\n' "$0" >&2
  exit 64
fi

required_version="$(
  /usr/bin/awk '$1 == "go" && NF == 2 { version = $2; count++ }
    END { if (count != 1) exit 1; print version }' "$repo_dir/go.mod"
)" || {
  printf 'go.mod must contain exactly one canonical go directive\n' >&2
  exit 1
}
resolved_version="$(go env GOVERSION)"
if ! compatible_toolchain "$required_version" "$resolved_version"; then
  printf 'resolved Go toolchain %s is outside supported family %s at or above its patch floor\n' \
    "$resolved_version" "$required_version" >&2
  exit 1
fi
printf 'Go toolchain accepted: required=%s resolved=%s\n' "$required_version" "$resolved_version"
