#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
target="${1:-all}"
android_dir="$repo_dir/android"

case "$(uname -s)" in
  Darwin)
    android_signing_config='/Users/nnandal/.config/skidbladnir/android-signing.properties'
    digest_command=(shasum -a 256)
    ;;
  Linux)
    android_signing_config='/home/niels/.config/skidbladnir/android-signing.properties'
    digest_command=(sha256sum)
    ;;
esac

case "$(uname -s)" in
  Darwin)
    android_sdk="${ANDROID_HOME:-/Users/nnandal/Library/Android/sdk}"
    if [[ -z "${JAVA_HOME:-}" ]]; then
      export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    fi
    ;;
  Linux)
    android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
    ;;
  *)
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Only Linux and Darwin hosts are supported"}\n' "$target"
    exit 2
    ;;
esac

android_gradle() {
  if [[ ! -d "$android_sdk" ]]; then
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Android SDK is unavailable at %s"}\n' "$target" "$android_sdk"
    exit 2
  fi
  if [[ -n "${JAVA_HOME:-}" && ! -x "${JAVA_HOME}/bin/java" ]]; then
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Java is unavailable at %s"}\n' "$target" "$JAVA_HOME"
    exit 2
  fi
  cd "$android_dir"
  ANDROID_HOME="$android_sdk" ./gradlew "$@" --no-daemon
}

require_android_signing() {
  SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
    "$repo_dir/scripts/check-android-signing" --config-only
  export SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config"
}

case "$target" in
  android-static)
    cd "$repo_dir"
    node --check android/app/src/main/assets/terminal/terminal.js
    android_gradle :app:compileDebugKotlin :app:compileDebugAndroidTestKotlin lintDebug
    ;;
  android-unit)
    android_gradle :app:testDebugUnitTest
    ;;
  release-assets)
    [[ "$#" -eq 4 ]] || {
      printf 'usage: %s release-assets TAG SOURCE_SHA OUTPUT_DIRECTORY\n' "$0" >&2
      exit 64
    }
    tag="$2"
    sha="$3"
    output_dir="$4"
    [[ "$(uname -s)/$(uname -m)" == 'Darwin/arm64' ]] || {
      printf 'Release assets require the native Darwin arm64 signing host\n' >&2
      exit 1
    }
    export GOTOOLCHAIN=local
    "$repo_dir/scripts/check-go-toolchain" >/dev/null
    read -r version_name version_code < <("$repo_dir/scripts/check-release" --android-version "$tag")
    [[ "$sha" == "$(git -C "$repo_dir" rev-parse HEAD)" && "$sha" =~ ^[0-9a-f]{40}$ ]] || {
      printf 'Release source SHA must equal the current exact HEAD\n' >&2
      exit 1
    }
    [[ ! -e "$output_dir" ]] || {
      printf 'Release output path must not already exist\n' >&2
      exit 1
    }
    mkdir -m 0700 "$output_dir"
    require_android_signing
    SKIDBLADNIR_VERSION_NAME="$version_name" SKIDBLADNIR_VERSION_CODE="$version_code" \
      android_gradle \
        -Pskidbladnir.versionName="$version_name" \
        -Pskidbladnir.versionCode="$version_code" \
        :app:assembleRelease
    install -m 0644 \
      "$repo_dir/android/app/build/outputs/apk/release/app-release.apk" \
      "$output_dir/skidbladnir-android.apk"
    install -m 0644 \
      "$repo_dir/android/app-signing-cert.sha256" \
      "$output_dir/android-signing-cert.sha256"
    cd "$repo_dir"
    "$repo_dir/scripts/build-host-archive" "$repo_dir" \
      "$tag" "$sha" linux amd64 linux-amd64 \
      "$output_dir/skidbladnir-linux-amd64.tar.gz"
    "$repo_dir/scripts/build-host-archive" "$repo_dir" \
      "$tag" "$sha" darwin arm64 darwin-arm64 \
      "$output_dir/skidbladnir-darwin-arm64.tar.gz"
    (
      cd "$output_dir"
      "${digest_command[@]}" \
        android-signing-cert.sha256 \
        skidbladnir-android.apk \
        skidbladnir-darwin-arm64.tar.gz \
        skidbladnir-linux-amd64.tar.gz > SHA256SUMS
    )
    "$repo_dir/scripts/check-release" "$output_dir" "$tag" "$sha"
    ;;
  all)
    cd "$repo_dir"
    go build ./...
    android_gradle :app:assembleDebug
    ;;
  *)
    printf 'unknown build target: %s\n' "$target" >&2
    exit 64
    ;;
esac
