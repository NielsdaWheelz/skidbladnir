#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

case "$(uname -s)" in
  Darwin) digest_command=(shasum -a 256) ;;
  Linux) digest_command=(sha256sum) ;;
  *) printf 'Release notes support only Linux and Darwin\n' >&2; exit 1 ;;
esac

manifest_digest() {
  local manifest="$1"
  local asset="$2"
  local observed
  observed="$(awk -v asset="$asset" '$2 == asset && NF == 2 { print $1 }' "$manifest")" || return 1
  [[ "$observed" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$observed"
}

render_notes() {
  local tag="$1"
  local sha="$2"
  local run_id="$3"
  local release_dir="$4"
  local manifest="$release_dir/SHA256SUMS"
  local signer_file="$release_dir/android-signing-cert.sha256"
  local signer
  local signer_asset_digest
  local apk_digest
  local darwin_digest
  local linux_digest
  local checksums_digest
  "$repo_dir/scripts/check-release" --android-version "$tag" >/dev/null 2>&1 || return 1
  [[ "$sha" =~ ^[0-9a-f]{40}$ && "$run_id" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -f "$manifest" && ! -L "$manifest" && -f "$signer_file" && ! -L "$signer_file" ]] || return 1
  [[ "$(wc -l <"$signer_file" | tr -d ' ')" == 1 ]] || return 1
  signer="$(sed -n '1p' "$signer_file")"
  [[ "$signer" =~ ^[0-9a-f]{64}$ ]] || return 1
  signer_asset_digest="$(manifest_digest "$manifest" android-signing-cert.sha256)" || return 1
  apk_digest="$(manifest_digest "$manifest" skidbladnir-android.apk)" || return 1
  darwin_digest="$(manifest_digest "$manifest" skidbladnir-darwin-arm64.tar.gz)" || return 1
  linux_digest="$(manifest_digest "$manifest" skidbladnir-linux-amd64.tar.gz)" || return 1
  [[ "$(wc -l <"$manifest" | tr -d ' ')" == 4 ]] || return 1
  checksums_digest="$("${digest_command[@]}" <"$manifest" | awk 'NF == 2 { print $1 }')" || return 1
  [[ "$checksums_digest" =~ ^[0-9a-f]{64}$ ]] || return 1

  # shellcheck disable=SC2016 # Literal Markdown code spans must not invoke shell expansion.
  printf '%s\n' "# Skíðblaðnir $tag" "" \
    "- Source: \`$sha\`" \
    "- Verify run: \`$run_id\`" \
    "- Android signer SHA-256: \`$signer\`" "" \
    "## Install" "" \
    '1. In a separate post-publication pin-control checkout, confirm its' \
    '   tracked `release-pin.json` owns the exact tag, source, and all five asset digests.' \
    '   Pin the same tag, source, and two host-bundle' \
    '   digests in `dev-server`, then apply Devbox, Arch, and MacBook.' \
    '2. From that pin-control checkout on the MacBook, run' \
    '   `scripts/fleet provision-clients` to configure the desktop client on all three hosts, then' \
    '   `SKIDBLADNIR_DEV_SERVER_CHECKOUT=/absolute/path/to/dev-server scripts/fleet verify`.' \
    '3. On the phone, download `skidbladnir-android.apk` from this release and' \
    '   approve installation from the browser when Android asks. Or, with USB debugging' \
    '   already authorized, run `scripts/install-android /path/to/skidbladnir-android.apk`.' \
    '   The script installs in place without prompts and preserves app data.' \
    '   When replacing the former herdr-backed build under this package, first' \
    '   install and pair herdr-mobile separately. Force-stop Skíðblaðnir and clear only its app data' \
    '   before this installation, then pair Skíðblaðnir with a fresh invitation.' \
    '4. Install Tailscale from Google Play, sign into the fleet tailnet, and leave' \
    '   Tailscale connected.' \
    '5. Open Skíðblaðnir and tap **Connect**.' \
    '6. On a computer configured for `skid`, run `scripts/fleet invite`,' \
    '   then scan the fresh QR within five minutes. It works once.' "" \
    '## Update order' "" \
    'Apply and verify all three hosts first; update the phone second. Mixed' \
    'versions and ordinary APK downgrade are not supported. Same-version reinstall' \
    'is supported. Updates retain pairing; use **Reconnect fleet** and a fresh' \
    '`scripts/fleet invite` only when reconnection is wanted.' "" \
    '## Assets' "" \
    '| Asset | SHA-256 |' \
    '|---|---|' \
    "| \`skidbladnir-android.apk\` | \`$apk_digest\` |" \
    "| \`skidbladnir-linux-amd64.tar.gz\` | \`$linux_digest\` |" \
    "| \`skidbladnir-darwin-arm64.tar.gz\` | \`$darwin_digest\` |" \
    "| \`android-signing-cert.sha256\` | \`$signer_asset_digest\` |" \
    "| \`SHA256SUMS\` | \`$checksums_digest\` |" "" \
    '## Known limits' "" \
    'Android 16/API 36, Linux amd64, and Darwin arm64 only. Phone enrollment is' \
    'fixed to three owner-managed hosts in one tailnet and two trusted phones.' \
    'The CLI supports explicit configurable peers. There are four launch profiles.' \
    'There is no app store, automatic update, downgrade, mixed-version compatibility,' \
    'public ingress, fleet discovery, or embedded Tailscale login. GitHub is used' \
    'for installation and updates, never at runtime.'
}

if [[ "$#" -ne 4 ]]; then
  printf 'usage: %s TAG SOURCE_SHA VERIFY_RUN_ID RELEASE_DIRECTORY\n' "$0" >&2
  exit 64
fi

render_notes "$1" "$2" "$3" "$4" || {
  printf 'Release-note inputs are invalid\n' >&2
  exit 1
}
