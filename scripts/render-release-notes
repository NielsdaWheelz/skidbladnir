#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

case "$(uname -s)" in
  Darwin) digest_command=(shasum -a 256) ;;
  Linux) digest_command=(sha256sum) ;;
  *) printf 'Release notes support only Linux and Darwin\n' >&2; exit 1 ;;
esac

manifest_digest() {
  local manifest="$1"
  local asset="$2"
  local observed
  observed="$(awk -v asset="$asset" '$2 == asset && NF == 2 { print $1 }' "$manifest")" || return 1
  [[ "$observed" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$observed"
}

render_notes() {
  local tag="$1"
  local sha="$2"
  local run_id="$3"
  local release_dir="$4"
  local manifest="$release_dir/SHA256SUMS"
  local signer_file="$release_dir/android-signing-cert.sha256"
  local signer
  local mac_signer
  local signer_asset_digest
  local apk_digest
  local darwin_digest
  local linux_digest
  local checksums_digest
  "$repo_dir/scripts/check-release" --android-version "$tag" >/dev/null 2>&1 || return 1
  [[ "$sha" =~ ^[0-9a-f]{40}$ && "$run_id" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -f "$manifest" && ! -L "$manifest" && -f "$signer_file" && ! -L "$signer_file" ]] || return 1
  [[ "$(wc -l <"$signer_file" | tr -d ' ')" == 1 ]] || return 1
  signer="$(sed -n '1p' "$signer_file")"
  [[ "$signer" =~ ^[0-9a-f]{64}$ ]] || return 1
  mac_signer="$(cat "$repo_dir/macos/app-signing-cert.sha256")" || return 1
  [[ "$mac_signer" =~ ^[0-9a-f]{64}$ ]] || return 1
  signer_asset_digest="$(manifest_digest "$manifest" android-signing-cert.sha256)" || return 1
  apk_digest="$(manifest_digest "$manifest" skidbladnir-android.apk)" || return 1
  darwin_digest="$(manifest_digest "$manifest" skidbladnir-darwin-arm64.tar.gz)" || return 1
  linux_digest="$(manifest_digest "$manifest" skidbladnir-linux-amd64.tar.gz)" || return 1
  [[ "$(wc -l <"$manifest" | tr -d ' ')" == 4 ]] || return 1
  checksums_digest="$("${digest_command[@]}" <"$manifest" | awk 'NF == 2 { print $1 }')" || return 1
  [[ "$checksums_digest" =~ ^[0-9a-f]{64}$ ]] || return 1

  # shellcheck disable=SC2016 # Markdown code spans are literal.
  printf '%s\n' "# skíðblaðnir $tag" "" \
    "- source: \`$sha\`" \
    "- verify run: \`$run_id\`" \
    "- android signer sha256: \`$signer\`" \
    "- mac app signer sha256: \`$mac_signer\`" "" \
    '## install' "" \
    "download \`install\` from this release, inspect it, then run \`bash install $tag\`." \
    'the installer verifies the signed host archive before executing it, installs' \
    'missing tmux/tailscale dependencies, and registers skid services.' \
    'mac requires macos 26+ arm64 and homebrew; linux supports ubuntu 24.04+' \
    'and arch amd64 with systemd. package tools may request administrator permission.' "" \
    'edit `~/.config/skidbladnir/config.yaml` to add your own commands.' \
    'empty profiles support ordinary terminal sessions. provider tools, accounts' \
    'and daemon lifetimes remain yours. run `skid` to open the desktop browser.' "" \
    '## connect' "" \
    'for remote access, sign into tailscale on both devices and enable tailnet https.' \
    'install the matching android apk, then run `skid connect`' \
    'on a computer and scan its five-minute qr. google play services support qr scanning.' \
    'android background notifications are optional. configure your own firebase project' \
    'and private sending credential on the hub; no custom apk or additional server.' \
    'allow notifications on the phone. desktop notifications work independently.' \
    'for another computer, install skid there and paste the invitation into' \
    '`skid join --name NAME`. enrolled machines appear automatically.' "" \
    '## update and removal' "" \
    'run `skid update` and install the matching phone apk. mixed versions and' \
    'ordinary downgrade are unsupported. `skid uninstall` removes recorded skid' \
    'runtime resources and retains settings, private state, provider data, tmux' \
    'sessions and shared packages. see the generalization cutover instructions' \
    'before upgrading an installation from the preceding private fleet release.' "" \
    '## assets' "" \
    '| asset | sha256 |' \
    '| --- | --- |' \
    "| \`skidbladnir-android.apk\` | \`$apk_digest\` |" \
    "| \`skidbladnir-linux-amd64.tar.gz\` | \`$linux_digest\` |" \
    "| \`skidbladnir-darwin-arm64.tar.gz\` | \`$darwin_digest\` |" \
    "| \`android-signing-cert.sha256\` | \`$signer_asset_digest\` |" \
    "| \`SHA256SUMS\` | \`$checksums_digest\` |" "" \
    'host archives also carry detached ed25519 signatures. the reviewed bootstrap' \
    'contains the public trust key; it never trusts a key fetched beside an archive.' "" \
    '## limits' "" \
    'android 13+ with google play services; macos 26+ arm64; ubuntu 24.04+ and arch amd64.' \
    'remote access requires tailscale. the configured hub owns edits and notification' \
    'observation; its absence leaves cached direct terminal access available.' \
    'optional google push is a content-free wake-up; devices fetch and admit current state.' \
    'provider accounts/history and terminal traffic never pass through google push.'

}

if [[ "$#" -ne 4 ]]; then
  printf 'usage: %s TAG SOURCE_SHA VERIFY_RUN_ID RELEASE_DIRECTORY\n' "$0" >&2
  exit 64
fi

render_notes "$1" "$2" "$3" "$4" || {
  printf 'Release-note inputs are invalid\n' >&2
  exit 1
}
