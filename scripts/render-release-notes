#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

case "$(uname -s)" in
  Darwin) digest_command=(shasum -a 256) ;;
  Linux) digest_command=(sha256sum) ;;
  *) printf 'Release notes support only Linux and Darwin\n' >&2; exit 1 ;;
esac

manifest_digest() {
  local manifest="$1"
  local asset="$2"
  local observed
  observed="$(awk -v asset="$asset" '$2 == asset && NF == 2 { print $1 }' "$manifest")" || return 1
  [[ "$observed" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$observed"
}

render_notes() {
  local tag="$1"
  local sha="$2"
  local run_id="$3"
  local release_dir="$4"
  local manifest="$release_dir/SHA256SUMS"
  local signer_file="$release_dir/android-signing-cert.sha256"
  local signer
  local mac_signer
  local signer_asset_digest
  local apk_digest
  local darwin_digest
  local linux_digest
  local checksums_digest
  "$repo_dir/scripts/check-release" --android-version "$tag" >/dev/null 2>&1 || return 1
  [[ "$sha" =~ ^[0-9a-f]{40}$ && "$run_id" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -f "$manifest" && ! -L "$manifest" && -f "$signer_file" && ! -L "$signer_file" ]] || return 1
  [[ "$(wc -l <"$signer_file" | tr -d ' ')" == 1 ]] || return 1
  signer="$(sed -n '1p' "$signer_file")"
  [[ "$signer" =~ ^[0-9a-f]{64}$ ]] || return 1
  mac_signer="$(cat "$repo_dir/macos/app-signing-cert.sha256")" || return 1
  [[ "$mac_signer" =~ ^[0-9a-f]{64}$ ]] || return 1
  signer_asset_digest="$(manifest_digest "$manifest" android-signing-cert.sha256)" || return 1
  apk_digest="$(manifest_digest "$manifest" skidbladnir-android.apk)" || return 1
  darwin_digest="$(manifest_digest "$manifest" skidbladnir-darwin-arm64.tar.gz)" || return 1
  linux_digest="$(manifest_digest "$manifest" skidbladnir-linux-amd64.tar.gz)" || return 1
  [[ "$(wc -l <"$manifest" | tr -d ' ')" == 4 ]] || return 1
  checksums_digest="$("${digest_command[@]}" <"$manifest" | awk 'NF == 2 { print $1 }')" || return 1
  [[ "$checksums_digest" =~ ^[0-9a-f]{64}$ ]] || return 1

  # shellcheck disable=SC2016 # Literal Markdown code spans must not invoke shell expansion.
  printf '%s\n' "# Skíðblaðnir $tag" "" \
    "- Source: \`$sha\`" \
    "- Verify run: \`$run_id\`" \
    "- Android signer SHA-256: \`$signer\`" \
    "- mac app signer SHA-256: \`$mac_signer\`" "" \
    "## Install" "" \
    'for a new installation, complete client provisioning in **first setup only** step 1 before step 2 verification.' "" \
    '1. In a separate post-publication pin-control checkout, confirm its' \
    '   tracked `release-pin.json` owns the exact tag, source, and all five asset digests.' \
    '   Pin the same tag, source, and two host-bundle' \
    '   digests in `dev-server`. run `./workstation gateway apply skidbladnir` on' \
    '   macbook and arch, and `./devbox gateway apply skidbladnir` from dev-server.' \
    '   the darwin bundle includes the signed `Skid.app`; dev-server owns its login launch.' \
    '2. with the existing fleet client configuration, run from the pin-control checkout' \
    '   on macbook:' \
    '   `SKIDBLADNIR_DEV_SERVER_CHECKOUT=/absolute/path/to/dev-server scripts/fleet verify`.' \
    '3. On the phone, download `skidbladnir-android.apk` from this release and' \
    '   approve installation from the browser when Android asks. Or, with USB debugging' \
    '   already authorized, run `scripts/install-android /path/to/skidbladnir-android.apk`.' \
    '   The script installs in place without prompts and preserves app data and existing pairings.' "" \
    '## first setup only' "" \
    'for a new installation, configure the fleet and enroll notifications once.' \
    '1. on macbook, run `scripts/fleet provision-clients` from the pin-control checkout' \
    '   to configure the desktop client on all three hosts. from dev-server, run' \
    '   `./devbox gateway apply skidbladnir` to activate the observer after provisioning.' \
    '2. Install Tailscale from Google Play, sign into the fleet tailnet, and leave' \
    '   Tailscale connected.' \
    '3. for first enrollment, open skid and tap **Connect**.' \
    '   On a computer configured for `skid`, run `scripts/fleet invite`,' \
    '   then scan the fresh qr within five minutes. it works once.' \
    '4. configure the qualified ntfy android distributor with the private devbox `:8444`' \
    '   origin and its read-only phone account. keep ntfy and tailscale running in' \
    '   the background. allow skid notifications; run `skid notifications setup` for mac setup.' \
    '   retrieve phone credentials locally from the private dev-server configuration;' \
    '   never share the publisher token.' "" \
    '## Update order' "" \
    'Apply and verify all three hosts first; update the phone second. Mixed' \
    'versions and ordinary APK downgrade are not supported. Same-version reinstall' \
    'is supported. in-place updates preserve installed credentials, pairings, client and notification' \
    'configuration, and attention state. devbox owns readiness.' \
    'respect platform focus/do-not-disturb; all alert reasons use default sound.' "" \
    '## rollback' "" \
    "before updating the phone, follow dev-server's rollback procedure for the selected" \
    'previous release: repin that release and return all three hosts to its admitted' \
    'runtime/unit pair; leave hosts already on that release unchanged.' \
    'preserve unchanged credentials, client configuration, notification ingress and' \
    'workspace recovery state. gateway rollback alone does not qualify a compatible fleet.' \
    'after the phone advances, recover with a forward release; ordinary apk downgrade' \
    'is unsupported. notification activation follows gateway activation, so a failure' \
    'can leave the new gateway active. repair by managed reapply, or use the selected' \
    'rollback procedure before the phone advances.' "" \
    '## Assets' "" \
    '| Asset | SHA-256 |' \
    '|---|---|' \
    "| \`skidbladnir-android.apk\` | \`$apk_digest\` |" \
    "| \`skidbladnir-linux-amd64.tar.gz\` | \`$linux_digest\` |" \
    "| \`skidbladnir-darwin-arm64.tar.gz\` | \`$darwin_digest\` |" \
    "| \`android-signing-cert.sha256\` | \`$signer_asset_digest\` |" \
    "| \`SHA256SUMS\` | \`$checksums_digest\` |" "" \
    '## Known limits' "" \
    'Android 16/API 36, Linux amd64, and Darwin arm64 only. Phone enrollment is' \
    'fixed to three owner-managed hosts in one tailnet and two trusted phones.' \
    'The CLI supports explicit configurable peers.' \
    'There is no app store, automatic update, downgrade, mixed-version compatibility,' \
    'public ingress, fleet discovery, or embedded Tailscale login. GitHub is used' \
    'for installation and updates, never at runtime.'
}

if [[ "$#" -ne 4 ]]; then
  printf 'usage: %s TAG SOURCE_SHA VERIFY_RUN_ID RELEASE_DIRECTORY\n' "$0" >&2
  exit 64
fi

render_notes "$1" "$2" "$3" "$4" || {
  printf 'Release-note inputs are invalid\n' >&2
  exit 1
}
