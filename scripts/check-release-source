#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
repo_name='NielsdaWheelz/skidbladnir'

immutable_release_policy_file_enabled() {
  local policy_file="$1"
  local policy_bytes
  local observed_keys
  [[ -f "$policy_file" && ! -L "$policy_file" ]] || return 1
  policy_bytes="$(LC_ALL=C wc -c <"$policy_file" | tr -d '[:space:]')" || return 1
  [[ "$policy_bytes" =~ ^[1-9][0-9]{0,3}$ && "$policy_bytes" -le 4096 ]] || return 1
  observed_keys="$(
    jq --stream -er '
      if length == 1 then empty
      elif length == 2 and (.[0] | length) == 1 then .[0][0]
      else "__SKIDBLADNIR_INVALID_NESTING__"
      end
    ' "$policy_file" 2>/dev/null | LC_ALL=C sort
  )" || return 1
  [[ "$observed_keys" == $'enabled\nenforced_by_owner' ]] || return 1
  jq -e '
    type == "object" and
    .enabled == true and
    (.enforced_by_owner | type == "boolean")
  ' "$policy_file" >/dev/null 2>&1
}

immutable_release_policy_enabled() (
  set -euo pipefail
  local fixture_dir
  local policy_file
  fixture_dir="$(mktemp -d /tmp/skidbladnir-release-policy-self-test.XXXXXX)"
  case "$fixture_dir" in
    /tmp/skidbladnir-release-policy-self-test.* | /private/tmp/skidbladnir-release-policy-self-test.*) ;;
    *) return 1 ;;
  esac
  trap 'rm -R -- "$fixture_dir"' EXIT HUP INT TERM
  policy_file="$fixture_dir/policy.json"
  umask 077
  head -c 4097 >"$policy_file"
  immutable_release_policy_file_enabled "$policy_file"
)

self_test() {
  if printf '%s\n' '{"enabled":false,"enforced_by_owner":false}' |
    immutable_release_policy_enabled; then
    printf 'Disabled immutable-release policy was accepted\n' >&2
    return 1
  fi
  if printf '%s\n' '{"enforced_by_owner":false}' | immutable_release_policy_enabled; then
    printf 'Missing immutable-release policy state was accepted\n' >&2
    return 1
  fi
  if printf '%s\n' '{"enabled":false,"enabled":true,"enforced_by_owner":false}' |
    immutable_release_policy_enabled; then
    printf 'Duplicate immutable-release policy field was accepted\n' >&2
    return 1
  fi
  if printf '%s\n' \
    '{"enabled":{"nested":false},"enabled":true,"enforced_by_owner":false}' |
    immutable_release_policy_enabled; then
    printf 'Object-valued duplicate immutable-release policy field was accepted\n' >&2
    return 1
  fi
  if printf '%s\n' \
    '{"enabled":false,"enforced_by_owner":false}{"enabled":true,"enforced_by_owner":false}' |
    immutable_release_policy_enabled; then
    printf 'Concatenated immutable-release policy documents were accepted\n' >&2
    return 1
  fi
  if printf '%s\n' \
    '{"enabled":{"nested":false},"enforced_by_owner":{"nested":false}}' \
    '{"enabled":true,"enforced_by_owner":false}' |
    immutable_release_policy_enabled; then
    printf 'Nested invalid immutable-release policy followed by valid policy was accepted\n' >&2
    return 1
  fi
  if printf '%s\0' '{"enabled":true,"enforced_by_owner":false}' |
    immutable_release_policy_enabled; then
    printf 'NUL-bearing immutable-release policy was normalized and accepted\n' >&2
    return 1
  fi
  printf '%s\n' '{"enabled":true,"enforced_by_owner":false}' |
    immutable_release_policy_enabled || return 1
  printf 'Immutable-release source policy passed\n'
}

if [[ "${1:-}" == '--self-test' && "$#" -eq 1 ]]; then
  self_test
  exit
fi

if [[ "$#" -ne 1 ]]; then
  printf 'usage: %s vMAJOR.MINOR.PATCH\n' "$0" >&2
  exit 64
fi

tag="$1"
"$repo_dir/scripts/check-release" --android-version "$tag" >/dev/null
for command in gh git jq; do
  command -v "$command" >/dev/null || {
    printf 'Required release command is unavailable: %s\n' "$command" >&2
    exit 1
  }
done

cd "$repo_dir"
[[ "$(git branch --show-current)" == main ]] || {
  printf 'Release must run from main\n' >&2
  exit 1
}
origin_url="$(git remote get-url origin)" || {
  printf 'Release requires the canonical GitHub origin remote\n' >&2
  exit 1
}
case "$origin_url" in
  git@github.com:NielsdaWheelz/skidbladnir.git | https://github.com/NielsdaWheelz/skidbladnir.git) ;;
  *)
    printf 'Release origin does not identify %s\n' "$repo_name" >&2
    exit 1
    ;;
esac
[[ -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || {
  printf 'Release requires a clean worktree and index\n' >&2
  exit 1
}
gh auth status >/dev/null 2>&1
repo_identity="$(gh repo view "$repo_name" --json nameWithOwner,visibility \
  --jq '[.nameWithOwner,.visibility] | join(" ")')"
[[ "$repo_identity" == "$repo_name PUBLIC" ]] || {
  printf 'Release requires the public %s repository\n' "$repo_name" >&2
  exit 1
}
immutable_release_policy_dir="$(mktemp -d /tmp/skidbladnir-release-policy.XXXXXX)"
case "$immutable_release_policy_dir" in
  /tmp/skidbladnir-release-policy.* | /private/tmp/skidbladnir-release-policy.*) ;;
  *)
    printf 'Could not create a private immutable-release policy directory\n' >&2
    exit 1
    ;;
esac
trap 'rm -R -- "$immutable_release_policy_dir"' EXIT HUP INT TERM
immutable_release_policy_file="$immutable_release_policy_dir/policy.json"
install -m 0600 /dev/null "$immutable_release_policy_file"
gh api --method GET \
  -H 'Accept: application/vnd.github+json' \
  -H 'X-GitHub-Api-Version: 2026-03-10' \
  "repos/$repo_name/immutable-releases" | head -c 4097 >"$immutable_release_policy_file" || {
  printf 'GitHub immutable-release policy is unavailable for %s\n' "$repo_name" >&2
  exit 1
}
immutable_release_policy_file_enabled "$immutable_release_policy_file" || {
  printf 'Release requires GitHub immutable releases to be enabled for %s\n' "$repo_name" >&2
  exit 1
}
rm -R -- "$immutable_release_policy_dir"
trap - EXIT HUP INT TERM

git fetch --quiet origin main --tags
sha="$(git rev-parse HEAD)"
[[ "$sha" =~ ^[0-9a-f]{40}$ && "$sha" == "$(git rev-parse origin/main)" ]] || {
  printf 'Release HEAD is not exact origin/main\n' >&2
  exit 1
}
read -r _ candidate_version_code < <("$repo_dir/scripts/check-release" --android-version "$tag")
while IFS= read -r existing_tag; do
  if read -r _ existing_version_code < <(
    "$repo_dir/scripts/check-release" --android-version "$existing_tag" 2>/dev/null
  ) && ((existing_version_code >= candidate_version_code)); then
    printf 'Release tag %s does not increase the Android version code beyond %s\n' \
      "$tag" "$existing_tag" >&2
    exit 1
  fi
done < <(git tag --list 'v*')
if git show-ref --verify --quiet "refs/tags/$tag" ||
  git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1 ||
  gh release view "$tag" --repo "$repo_name" >/dev/null 2>&1; then
  printf 'Release tag already exists and will not be replaced: %s\n' "$tag" >&2
  exit 1
fi

run_id="$(
  gh run list \
    --repo "$repo_name" \
    --workflow verify.yml \
    --branch main \
    --commit "$sha" \
    --status success \
    --limit 20 \
    --json databaseId,headSha,conclusion \
    --jq 'map(select(.headSha == "'"$sha"'" and .conclusion == "success")) | first | .databaseId // empty'
)"
[[ "$run_id" =~ ^[0-9]+$ ]] || {
  printf 'No successful verify run exists for exact origin/main SHA %s\n' "$sha" >&2
  exit 1
}

printf '%s\t%s\n' "$sha" "$run_id"
