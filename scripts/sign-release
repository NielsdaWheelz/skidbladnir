#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
[[ $# -eq 1 && -d "$1" ]] || { printf 'usage: %s RELEASE_DIRECTORY\n' "$0" >&2; exit 64; }
release_dir="$(cd "$1" && pwd -P)"
key="${SKIDBLADNIR_RELEASE_SIGNING_KEY:-$HOME/.config/skidbladnir/release-signing.pem}"
[[ -f "$key" && ! -L "$key" ]] || { printf 'set SKIDBLADNIR_RELEASE_SIGNING_KEY to the private ed25519 key\n' >&2; exit 1; }
openssl_bin="$(command -v openssl)"
stage="$(mktemp -d /tmp/skid-release-sign.XXXXXX)"
trap 'rm -R -- "$stage"' EXIT HUP INT TERM
"$openssl_bin" pkey -in "$key" -pubout -out "$stage/public.pem"
cmp -s "$stage/public.pem" "$repo_dir/internal/install/release-public-key.pem" || { printf 'release private key differs from the pinned public key\n' >&2; exit 1; }
for name in skidbladnir-linux-amd64.tar.gz skidbladnir-darwin-arm64.tar.gz; do
  [[ -f "$release_dir/$name" && ! -e "$release_dir/$name.sig" ]] || { printf 'missing archive or existing signature\n' >&2; exit 1; }
  "$openssl_bin" dgst -sha256 -binary "$release_dir/$name" > "$stage/digest"
  "$openssl_bin" pkeyutl -sign -rawin -inkey "$key" -in "$stage/digest" -out "$release_dir/$name.sig"
  "$openssl_bin" pkeyutl -verify -rawin -pubin -inkey "$repo_dir/internal/install/release-public-key.pem" -in "$stage/digest" -sigfile "$release_dir/$name.sig" >/dev/null
  chmod 0644 "$release_dir/$name.sig"
done
install -m 0755 "$repo_dir/scripts/install" "$release_dir/install"
