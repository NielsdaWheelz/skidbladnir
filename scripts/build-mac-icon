#!/usr/bin/env bash
set -euo pipefail

# usage: build-mac-icon SOURCE_DIR OUTPUT_ICNS
# renders the two android launcher drawables into skid.icns; scripts/release and
# check-release --reproduce share this recipe.
staging="$(mktemp -d /tmp/skidbladnir-icon.XXXXXX)"
trap 'rm -R -- "$staging"' EXIT HUP INT TERM
mkdir "$staging/skid.iconset"
clang -fobjc-arc -framework AppKit "$1/macos/render-icon.m" -o "$staging/render-icon"
"$staging/render-icon" \
  "$1/android/app/src/main/res/drawable/ic_launcher_background.xml" \
  "$1/android/app/src/main/res/drawable/ic_launcher_foreground.xml" \
  "$staging/skid.iconset"
iconutil --convert icns --output "$2" "$staging/skid.iconset"
chmod 0644 "$2"
