    run_exact_product_test() {
      local proof_name="$1"
      local selector="$2"
      shift 2
      local instrumentation_status=0
      local output_file
      output_file="$(mktemp -t skidbladnir-product-exact.XXXXXX)"
      run_bounded_to_file "$android_instrumentation_timeout_seconds" "$output_file" \
        "$adb" -s "$serial" shell am instrument -r -w \
        -e class "$selector" \
        "$@" \
        "${test_package}/androidx.test.runner.AndroidJUnitRunner" || instrumentation_status=$?
      cat "$output_file"
      if [[ "$instrumentation_status" -ne 0 ]] || ! assert_one_executed_test "$proof_name" "$output_file"; then
        rm -f "$output_file"
        printf '%s failed (instrumentation status %s)\n' "$proof_name" "$instrumentation_status" >&2
        return 1
      fi
      rm -f "$output_file"
    }

    wait_for_instrumentation() {
      local child_pid="$instrumentation_pid"
      local child_status=0
      [[ -n "$child_pid" ]] || return 125
      if wait "$child_pid"; then
        child_status=0
      else
        child_status=$?
      fi
      instrumentation_pid=''
      return "$child_status"
    }

    bootout_macbook_service() {
      # launchctl reports EINPROGRESS (36) while the plist's graceful ExitTimeOut shutdown is still
      # running and ESRCH (3) or 113 once the job is already gone, so its exit status cannot stand in
      # for teardown; wait_for_macbook_gateway owns that fact. Any other status is a real failure.
      local bootout_status=0
      local bootout_output
      bootout_output="$(launchctl bootout "${launch_domain}/${launch_label}" 2>&1)" || bootout_status=$?
      case "$bootout_status" in
        0 | 3 | 36 | 113) ;;
        *)
          printf 'could not boot out the MacBook LaunchAgent (status %s): %s\n' \
            "$bootout_status" "$bootout_output" >&2
          return 1
          ;;
      esac
    }

    restore_macbook_product_service() {
      if ! launchctl print "${launch_domain}/${launch_label}" >/dev/null 2>&1; then
        launchctl bootstrap "$launch_domain" "$launch_plist" || return 1
      fi
      launchctl kickstart -k "${launch_domain}/${launch_label}" || return 1
      wait_for_macbook_gateway up
    }

    run_coordinated_outage_test() {
      local proof_name='isolated-macbook-outage'
      local selector='dev.niels.skidbladnir.MultiMachineUiInstrumentedTest#genuinelyUnavailablePairingDisablesMachineMutations'
      local readiness_path='cache/skidbladnir-multi-machine-outage-ready'
      local ready=''
      local attempt
      local instrumentation_status=0
      "$adb" -s "$serial" shell run-as "$app_package" rm -f "$readiness_path"
      instrumentation_output_file="$(mktemp -t skidbladnir-product.XXXXXX)"
      python3 -c "$bounded_runner_source" \
        "$android_instrumentation_timeout_seconds" \
        "$android_process_termination_grace_seconds" \
        "$android_process_reap_timeout_seconds" \
        "$instrumentation_output_file" \
        "$adb" -s "$serial" shell am instrument -r -w \
        -e class "$selector" \
        -e skidbladnir.failedMachine "$macbook_handle" \
        "${test_package}/androidx.test.runner.AndroidJUnitRunner" &
      instrumentation_pid=$!
      # justify-polling: 100 ms keeps the foreground checkpoint responsive; 100 bounded 200 ms probes plus
      # the shared four-second forced teardown cap the rendezvous at 34 seconds. No device event seam exists.
      for ((attempt = 0; attempt < product_outage_readiness_attempts; attempt++)); do
        probe_status=0
        run_bounded_to_file "$android_probe_timeout_seconds" /dev/null \
          "$adb" -s "$serial" shell run-as "$app_package" ls "$readiness_path" || probe_status=$?
        if [[ "$probe_status" -eq 0 ]]; then
          ready=1
          break
        fi
        if [[ "$probe_status" -eq 124 || "$probe_status" -eq 125 ]]; then
          break
        fi
        sleep "$product_outage_readiness_interval_seconds"
      done
      if [[ -z "$ready" ]]; then
        if wait_for_instrumentation; then
          instrumentation_status=0
        else
          instrumentation_status=$?
        fi
        cat "$instrumentation_output_file"
        rm -f "$instrumentation_output_file"
        instrumentation_output_file=''
        printf '%s never reached its healthy two-machine checkpoint (instrumentation status %s)\n' \
          "$proof_name" "$instrumentation_status" >&2
        return 1
      fi

      service_restore_required=1
      bootout_macbook_service || return 1
      wait_for_macbook_gateway down
      if wait_for_instrumentation; then
        instrumentation_status=0
      else
        instrumentation_status=$?
      fi
      cat "$instrumentation_output_file"
      if [[ "$instrumentation_status" -ne 0 ]] ||
        ! assert_one_executed_test "$proof_name" "$instrumentation_output_file"; then
        rm -f "$instrumentation_output_file"
        instrumentation_output_file=''
        printf '%s failed (instrumentation status %s)\n' "$proof_name" "$instrumentation_status" >&2
        return 1
      fi
      rm -f "$instrumentation_output_file"
      instrumentation_output_file=''
    }

    wait_for_macbook_gateway() {
      local expected_state="$1"
      local attempt
      # justify-polling: 100 ms observes fast launchd recovery without visible delay; 50 bounded 200 ms
      # loopback probes cap recovery at 15 seconds. Fixed cadence is appropriate at this short local boundary.
      for ((attempt = 0; attempt < macbook_gateway_health_attempts; attempt++)); do
        if curl --fail --silent \
          --connect-timeout "$macbook_gateway_connect_timeout_seconds" \
          --max-time "$macbook_gateway_probe_timeout_seconds" \
          'http://127.0.0.1:7341/healthz' >/dev/null 2>&1; then
          [[ "$expected_state" == 'up' ]] && return
        else
          [[ "$expected_state" == 'down' ]] && return
        fi
        sleep "$macbook_gateway_health_interval_seconds"
      done
      printf 'MacBook gateway did not become %s\n' "$expected_state" >&2
      return 1
    }

    paired_lifetime_digests() {
      local macbook_digest
      local devbox_digest
      macbook_digest="$(machine_lifetime_digest "$macbook_origin" "$macbook_bearer_file" "$macbook_handle")" ||
        return 1
      devbox_digest="$(machine_lifetime_digest "$devbox_origin" "$devbox_bearer_file" "$devbox_handle")" ||
        return 1
      printf '%s %s\n' "$macbook_digest" "$devbox_digest"
    }

    paired_lifetime_digest="$(paired_lifetime_digests)" ||
      not_run product 'Both paired gateways must answer a read-only inventory GET before the journey'

    service_restore_required=''
    test_package_installed=''
    instrumentation_pid=''
    instrumentation_output_file=''
    cleanup_product() {
      local exit_status=$?
      trap - EXIT HUP INT TERM
      if [[ -n "$service_restore_required" ]]; then
        restore_macbook_product_service || exit_status=1
      fi
      if [[ -n "$instrumentation_pid" ]]; then
        run_bounded_to_file "$android_cleanup_timeout_seconds" /dev/null \
          "$adb" -s "$serial" shell am force-stop "$app_package" || exit_status=1
        wait_for_instrumentation >/dev/null 2>&1 || true
      fi
      if [[ -n "$instrumentation_output_file" && -f "$instrumentation_output_file" ]]; then
        rm -f "$instrumentation_output_file" || exit_status=1
      fi
      if [[ -n "$service_restore_required" ]]; then
        (cd "$repo_dir" && ./scripts/install-macbook verify) || exit_status=1
        [[ "$(sed -n '1p' "$macbook_handle_path" 2>/dev/null || true)" == "$macbook_handle" ]] || exit_status=1
      fi
      [[ "$(paired_lifetime_digests 2>/dev/null || true)" == "$paired_lifetime_digest" ]] || exit_status=1
      if [[ -n "$test_package_installed" ]]; then
        "$adb" -s "$serial" uninstall "$test_package" >/dev/null || exit_status=1
      fi
      current_pairing_digest="$(
        "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" 2>/dev/null |
          content_digest
      )"
      [[ "$current_pairing_digest" == "$pairing_digest" ]] || exit_status=1
      exit "$exit_status"
    }
    trap cleanup_product EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    run macbook-product-preflight "$repo_dir/scripts/install-macbook" verify
    cd "$repo_dir/android"
    run android-product-build env ANDROID_HOME="$android_sdk" \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" ./gradlew \
      -Pskidbladnir.android.testBuildType=deviceDebug \
      :app:assembleDeviceDebug :app:assembleDeviceDebugAndroidTest --no-daemon
    run android-product-signatures env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" "$app_apk" "$test_apk"
    run android-product-app "$adb" -s "$serial" install -r -t "$app_apk"
    run android-product-tests "$adb" -s "$serial" install -r -t "$test_apk"
    test_package_installed=1

    run_exact_product_test healthy-production-ui \
      'dev.niels.skidbladnir.MultiMachineUiInstrumentedTest#twoHealthyPairingsRenderAndRouteThroughTheProductionUi' \
      -e skidbladnir.multiMachineUi true \
      -e skidbladnir.devboxMachine "$devbox_handle" \
      -e skidbladnir.macbookMachine "$macbook_handle"

    run_coordinated_outage_test

    restore_macbook_product_service
    run macbook-product-recovery "$repo_dir/scripts/install-macbook" verify
    [[ "$(sed -n '1p' "$macbook_handle_path")" == "$macbook_handle" ]] || {
      printf 'MacBook recovery changed the machine handle\n' >&2
      exit 1
    }
    [[ "$(paired_lifetime_digests)" == "$paired_lifetime_digest" ]] || {
      printf 'Recovery changed the exact tmux lifetime inventory of a paired machine\n' >&2
      exit 1
    }
    run_exact_product_test recovered-production-ui \
      'dev.niels.skidbladnir.MultiMachineUiInstrumentedTest#twoHealthyPairingsRenderAndRouteThroughTheProductionUi' \
      -e skidbladnir.multiMachineUi true \
      -e skidbladnir.devboxMachine "$devbox_handle" \
      -e skidbladnir.macbookMachine "$macbook_handle"
    service_restore_required=''

    "$adb" -s "$serial" uninstall "$test_package" >/dev/null
    test_package_installed=''
    current_pairing_digest="$(
      "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
        content_digest
    )"
    [[ "$current_pairing_digest" == "$pairing_digest" ]] || {
      printf 'Physical product journey changed the encrypted pairing state\n' >&2
      exit 1
    }
    trap - EXIT HUP INT TERM
    run android-product-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  live)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run live 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run live 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run live 'Live tmux proofs refuse an invoking tmux client'
    fi
    if [[ "$(uname -s)" != 'Linux' ]]; then
      not_run live 'The grouped-session proof is Linux-only; use integration for cross-host tmux acceptance'
    fi
    if [[ ! -x "$pinned_tmux" ]]; then
      not_run live "Pinned ${pinned_tmux} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run grouped-tmux go test -tags=live ./tests/live \
      -run '^(TestTmuxGroupedBehavior|TestRegisteredLiveTmuxCommandRejectsSecondarySocketSelectors)$' -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1
    ;;
  devbox | macbook)
    run_publication_gate "$gate" "$@"
    ;;
  verify)
    "$0" static
    "$repo_dir/scripts/build"
    "$0" unit
    ;;
  full)
    "$0" verify
    not_run full 'Run integration, live, devbox, macbook, provision, platform, and product separately after explicit approval for each external boundary'
    ;;
  '')
    printf 'usage: %s {static|unit|verify|full|provision --allow-device-mutation --allow-machine-provisioning|platform --allow-device-mutation|product --allow-device-mutation --allow-two-host-read-only-tmux --allow-macbook-service-restart|{integration|live} --allow-isolated-tmux-mutation|devbox --allow-live-devbox-publication|macbook --allow-live-macbook-publication}\n' "$0" >&2
    exit 64
    ;;
  *)
    printf 'unknown test gate: %s\n' "$gate" >&2
    exit 64
    ;;
esac
