#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
gate="${1:-}"
shift || true

case "$(uname -s)" in
  Darwin)
    android_sdk="${ANDROID_HOME:-/Users/nnandal/Library/Android/sdk}"
    tmux_path='/opt/homebrew/bin/tmux'
    digest_command=(shasum -a 256)
    android_signing_config='/Users/nnandal/.config/skidbladnir/android-signing.properties'
    if [[ -z "${JAVA_HOME:-}" ]]; then
      export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    fi
    ;;
  Linux)
    android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
    tmux_path='/usr/bin/tmux'
    digest_command=(sha256sum)
    android_signing_config='/home/niels/.config/skidbladnir/android-signing.properties'
    ;;
  *)
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Only Linux and Darwin hosts are supported"}\n' "${gate:-unknown}"
    exit 2
    ;;
esac

run() {
  printf '==> %s\n' "$1"
  shift
  "$@"
}

not_run() {
  printf '{"gate":"%s","status":"NOT_RUN","reason":"%s"}\n' "$1" "$2"
  exit 2
}

content_digest() {
  "${digest_command[@]}" | cut -d ' ' -f 1
}

pinned_android_release_values() {
  local checkout="$1"
  local pin="$checkout/assets/skidbladnir/release-pin.json"
  [[ -f "$pin" && ! -L "$pin" ]] || return 1
  jq -er '
    if type == "object" and keys == [
      "androidApkSha256",
      "androidSigningCertAssetSha256",
      "darwinArm64Sha256",
      "linuxAmd64Sha256",
      "sha256SumsAssetSha256",
      "sourceSha",
      "version"
    ] and
      (.version | type == "string" and test("^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")) and
      (.sourceSha | type == "string" and test("^[0-9a-f]{40}$")) and
      ([
        .androidApkSha256,
        .androidSigningCertAssetSha256,
        .darwinArm64Sha256,
        .linuxAmd64Sha256,
        .sha256SumsAssetSha256
      ] | all(type == "string" and test("^[0-9a-f]{64}$")))
    then [.androidApkSha256, .androidSigningCertAssetSha256, .version] | @tsv
    else error("release pin is pending or invalid")
    end
  ' "$pin"
}

android_release_matches_pin() {
  local checkout="$1"
  local apk="$2"
  local values expected_apk expected_signer_asset _version
  values="$(pinned_android_release_values "$checkout")" || return 1
  IFS=$'\t' read -r expected_apk expected_signer_asset _version <<<"$values"
  [[ -n "$expected_apk" && -n "$expected_signer_asset" ]] || return 1
  [[ "$(content_digest <"$apk")" == "$expected_apk" ]] || return 1
  [[ "$(content_digest <"$repo_dir/android/app-signing-cert.sha256")" == "$expected_signer_asset" ]]
}

installed_android_package_path() {
  local output="$1"
  [[ "$output" =~ ^package:(/[^[:space:][:cntrl:]]+[.]apk)$ ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

optional_installed_android_package_path() {
  local adb="$1"
  local serial="$2"
  local app_package="$3"
  local output_file
  local output
  local status=0
  output_file="$(mktemp -t skidbladnir-optional-package.XXXXXX)"
  if run_bounded_to_file "$android_preflight_timeout_seconds" "$output_file" \
    "$adb" -s "$serial" shell pm path "$app_package"; then
    status=0
  else
    status=$?
  fi
  output="$(tr -d '\r' <"$output_file")"
  /bin/unlink "$output_file" || return 1
  if [[ "$status" == 1 && -z "$output" ]]; then
    return 0
  fi
  [[ "$status" == 0 ]] || return 1
  installed_android_package_path "$output" >/dev/null || return 1
  printf '%s\n' "$output"
}

android_apk_matches_digest() {
  local apk="$1"
  local expected="$2"
  [[ -f "$apk" && ! -L "$apk" && "$expected" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$(content_digest <"$apk")" == "$expected" ]]
}

android_apk_version_code() {
  local apk="$1"
  local apkanalyzer
  local version_code
  [[ -f "$apk" && ! -L "$apk" ]] || return 1
  apkanalyzer="$({
    find "$android_sdk" -path '*/bin/apkanalyzer' -type f 2>/dev/null || true
  } | sort | tail -n 1)"
  [[ -x "$apkanalyzer" ]] || return 1
  version_code="$($apkanalyzer manifest version-code "$apk")" || return 1
  [[ "$version_code" =~ ^[1-9][0-9]{0,9}$ ]] || return 1
  ((10#$version_code <= 2100000000)) || return 1
  printf '%s\n' "$version_code"
}

android_apk_version_name() {
  local apk="$1"
  local apkanalyzer
  local version_name
  [[ -f "$apk" && ! -L "$apk" ]] || return 1
  apkanalyzer="$({
    find "$android_sdk" -path '*/bin/apkanalyzer' -type f 2>/dev/null || true
  } | sort | tail -n 1)"
  [[ -x "$apkanalyzer" ]] || return 1
  version_name="$($apkanalyzer manifest version-name "$apk")" || return 1
  [[ "$version_name" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || return 1
  printf '%s\n' "$version_name"
}

android_update_candidate_is_distinct_newer() {
  local installed_digest="$1"
  local installed_version_code="$2"
  local candidate_digest="$3"
  local candidate_version_code="$4"
  [[ "$installed_digest" =~ ^[0-9a-f]{64}$ &&
    "$candidate_digest" =~ ^[0-9a-f]{64}$ &&
    "$installed_version_code" =~ ^[1-9][0-9]{0,9}$ &&
    "$candidate_version_code" =~ ^[1-9][0-9]{0,9}$ ]] || return 1
  [[ "$installed_digest" != "$candidate_digest" ]] || return 1
  ((10#$candidate_version_code > 10#$installed_version_code))
}

android_platform_release_values() {
  local declared_dev_checkout="$1"
  local release_apk="$2"
  local declared_source_checkout="$3"
  local dev_checkout source_checkout pin_relative pin release_values
  local expected_apk_digest _signer_asset_digest release_version source_sha
  local expected_version_name expected_version_code observed_version_name observed_version_code
  dev_checkout="$(cd "$declared_dev_checkout" && pwd -P)" || return 1
  source_checkout="$(cd "$declared_source_checkout" && pwd -P)" || return 1
  [[ "$(git -C "$dev_checkout" rev-parse --show-toplevel 2>/dev/null)" == "$dev_checkout" &&
    "$(git -C "$source_checkout" rev-parse --show-toplevel 2>/dev/null)" == "$source_checkout" ]] || return 1
  pin_relative='assets/skidbladnir/release-pin.json'
  pin="$dev_checkout/$pin_relative"
  [[ -f "$pin" && ! -L "$pin" ]] || return 1
  git -C "$dev_checkout" cat-file -e "HEAD:$pin_relative" 2>/dev/null || return 1
  git -C "$dev_checkout" diff --quiet HEAD -- "$pin_relative" || return 1
  cmp -s "$pin" <(git -C "$dev_checkout" show "HEAD:$pin_relative") || return 1
  release_values="$(pinned_android_release_values "$dev_checkout")" || return 1
  IFS=$'\t' read -r expected_apk_digest _signer_asset_digest release_version \
    <<<"$release_values"
  source_sha="$(jq -er '.sourceSha | select(type == "string" and test("^[0-9a-f]{40}$"))' "$pin")" ||
    return 1
  [[ "$(git -C "$source_checkout" rev-parse HEAD)" == "$source_sha" &&
    -z "$(git -C "$source_checkout" status --porcelain=v1 --untracked-files=all)" ]] || return 1
  android_release_matches_pin "$dev_checkout" "$release_apk" || return 1
  read -r expected_version_name expected_version_code \
    < <("$source_checkout/scripts/check-release" --android-version "$release_version") || return 1
  observed_version_name="$(android_apk_version_name "$release_apk")" || return 1
  observed_version_code="$(android_apk_version_code "$release_apk")" || return 1
  [[ "$observed_version_name" == "$expected_version_name" &&
    "$observed_version_code" == "$expected_version_code" ]] || return 1
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$expected_apk_digest" "$release_version" "$expected_version_name" \
    "$expected_version_code" "$source_sha"
}

android_platform_companion_matches_release() {
  local companion_apk="$1"
  local release_digest="$2"
  local version_name="$3"
  local version_code="$4"
  [[ -f "$companion_apk" && ! -L "$companion_apk" &&
    "$release_digest" =~ ^[0-9a-f]{64}$ &&
    "$(content_digest <"$companion_apk")" != "$release_digest" &&
    "$(android_apk_version_name "$companion_apk")" == "$version_name" &&
    "$(android_apk_version_code "$companion_apk")" == "$version_code" ]]
}

android_platform_restore_owned_state() {
  local failed=0 test_package_path test_package_path_after
  if [[ "${platform_test_package_installed:-0}" == 1 ]]; then
    if ! test_package_path="$(optional_installed_android_package_path \
      "$platform_adb" "$platform_serial" "$platform_test_package")"; then
      printf 'Could not inspect the test-only Android package\n' >&2
      failed=1
    elif [[ -z "$test_package_path" ]]; then
      platform_test_package_installed=0
    elif ! installed_android_package_path "$test_package_path" >/dev/null ||
      ! "$platform_adb" -s "$platform_serial" uninstall "$platform_test_package" >/dev/null; then
      printf 'Could not uninstall the test-only Android package\n' >&2
      failed=1
    elif ! test_package_path_after="$(optional_installed_android_package_path \
        "$platform_adb" "$platform_serial" "$platform_test_package")"; then
      printf 'Could not verify removal of the test-only Android package\n' >&2
      failed=1
    elif [[ -z "$test_package_path_after" ]]; then
      platform_test_package_installed=0
    else
      printf 'Could not uninstall the test-only Android package\n' >&2
      failed=1
    fi
  fi
  if [[ "${platform_app_replaced:-0}" == 1 ]]; then
    if "$platform_adb" -s "$platform_serial" install -r "$platform_release_apk" >/dev/null &&
      verify_installed_android_signer \
        "$platform_adb" "$platform_serial" "$platform_app_package" \
        "$platform_expected_apk_digest"; then
      platform_app_replaced=0
    else
      printf 'Could not restore and verify the exact Android release APK\n' >&2
      failed=1
    fi
  fi
  return "$failed"
}

android_platform_create_release_snapshot() {
  local snapshot_dir
  snapshot_dir="$(mktemp -d -t skidbladnir-platform-release.XXXXXX)" || return 1
  [[ -d "$snapshot_dir" && ! -L "$snapshot_dir" ]] || return 1
  printf '%s/release.apk\n' "$snapshot_dir"
}

android_platform_remove_release_snapshot() {
  local snapshot_dir="${platform_release_snapshot_dir:-}"
  if [[ ! -f "$platform_release_snapshot" || -L "$platform_release_snapshot" ]]; then
    printf 'Android platform release snapshot boundary is not a regular file\n' >&2
    return 1
  fi
  if [[ -n "$snapshot_dir" &&
    ( ! -d "$snapshot_dir" || -L "$snapshot_dir" ||
      "$platform_release_snapshot" != "$snapshot_dir/release.apk" ) ]]; then
    printf 'Android platform release snapshot directory boundary is invalid\n' >&2
    return 1
  fi
  /bin/unlink "$platform_release_snapshot" || return 1
  platform_release_snapshot=''
  if [[ -n "$snapshot_dir" ]]; then
    rmdir "$snapshot_dir" || {
      printf 'Could not remove the Android platform release snapshot directory\n' >&2
      return 1
    }
    platform_release_snapshot_dir=''
  fi
}

android_platform_cleanup() {
  local exit_status=$?
  trap - EXIT
  trap '' HUP INT TERM
  if [[ -n "${platform_instrumentation_output_file:-}" ]]; then
    if [[ -f "$platform_instrumentation_output_file" &&
      ! -L "$platform_instrumentation_output_file" ]]; then
      /bin/unlink "$platform_instrumentation_output_file" || exit_status=1
    elif [[ -e "$platform_instrumentation_output_file" ||
      -L "$platform_instrumentation_output_file" ]]; then
      printf 'Android platform evidence boundary is not a regular file\n' >&2
      exit_status=1
    fi
    platform_instrumentation_output_file=''
  fi
  android_platform_restore_owned_state || exit_status=1
  if [[ -n "${platform_release_snapshot:-}" &&
    "${platform_app_replaced:-0}" == 0 ]]; then
    android_platform_remove_release_snapshot || exit_status=1
  elif [[ -n "${platform_release_snapshot:-}" ]]; then
    printf 'Exact release recovery APK retained at %s\n' "$platform_release_snapshot" >&2
  fi
  exit "$exit_status"
}

android_release_helper_self_test() {
  local fixture expected wrong candidate
  [[ "$(installed_android_package_path 'package:/data/app/example/base.apk')" == \
    '/data/app/example/base.apk' ]] || return 1
  if installed_android_package_path ''; then
    printf 'Absent Android package was accepted\n' >&2
    return 1
  fi
  if installed_android_package_path $'package:/data/app/one/base.apk\npackage:/data/app/two/split.apk'; then
    printf 'Split or duplicate Android package output was accepted\n' >&2
    return 1
  fi
  fixture="$(mktemp -t skidbladnir-apk-digest.XXXXXX)"
  printf 'fixture-apk\n' >"$fixture"
  expected="$(content_digest <"$fixture")"
  android_apk_matches_digest "$fixture" "$expected" || return 1
  if [[ "$expected" == 0* ]]; then
    wrong="1${expected:1}"
  else
    wrong="0${expected:1}"
  fi
  if android_apk_matches_digest "$fixture" "$wrong"; then
    printf 'Wrong Android APK digest was accepted\n' >&2
    return 1
  fi
  candidate="${expected%?}0"
  if [[ "$candidate" == "$expected" ]]; then
    candidate="${expected%?}1"
  fi
  android_update_candidate_is_distinct_newer "$expected" 100 "$candidate" 101 || return 1
  if android_update_candidate_is_distinct_newer "$expected" 100 "$expected" 101; then
    printf 'Same Android APK was accepted as an update\n' >&2
    return 1
  fi
  if android_update_candidate_is_distinct_newer "$expected" 100 "$candidate" 100 ||
    android_update_candidate_is_distinct_newer "$expected" 100 "$candidate" 99; then
    printf 'Non-newer Android APK was accepted as an update\n' >&2
    return 1
  fi
  /bin/unlink "$fixture"
  printf 'Installed Android release policy passed: path, digest, distinct, and newer cases\n'
}

android_platform_helper_self_test() (
  set -euo pipefail
  local fixture source_checkout dev_checkout release_apk companion_apk
  local source_sha apk_digest signer_digest values
  local cleanup_status snapshot_probe snapshot_probe_dir
  fixture="$(mktemp -d /tmp/skidbladnir-platform-policy.XXXXXX)"
  case "$fixture" in
    /tmp/skidbladnir-platform-policy.* | /private/tmp/skidbladnir-platform-policy.*) ;;
    *) printf 'Unexpected Android platform policy fixture path\n' >&2; return 1 ;;
  esac
  trap '/bin/rm -R -- "$fixture"' EXIT HUP INT TERM
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'OK (2 tests)' \
    'INSTRUMENTATION_CODE: -1' >"$fixture/complete-instrumentation"
  assert_complete_instrumentation \
    android-platform-fixture 2 0 "$fixture/complete-instrumentation" || {
    printf 'Android platform policy rejected a complete instrumentation run\n' >&2
    return 1
  }
  for rejected_status in -4 -3 -2 -1 2; do
    printf '%s\n' \
      'INSTRUMENTATION_STATUS_CODE: 1' \
      "INSTRUMENTATION_STATUS_CODE: $rejected_status" \
      'OK (1 test)' \
      'INSTRUMENTATION_CODE: -1' >"$fixture/rejected-instrumentation"
    if assert_complete_instrumentation \
      android-platform-fixture 1 0 "$fixture/rejected-instrumentation" >/dev/null 2>&1; then
      printf 'Android platform policy accepted terminal status %s\n' "$rejected_status" >&2
      return 1
    fi
  done
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'OK (1 test)' \
    'INSTRUMENTATION_CODE: -1' >"$fixture/incomplete-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/incomplete-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted a missing test outcome\n' >&2
    return 1
  fi
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'OK (1 test)' \
    'INSTRUMENTATION_CODE: -1' >"$fixture/extra-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/extra-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted an extra test outcome\n' >&2
    return 1
  fi
  if assert_complete_instrumentation \
    android-platform-fixture 2 1 "$fixture/complete-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted a failed instrumentation process\n' >&2
    return 1
  fi
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'INSTRUMENTATION_CODE: -1' >"$fixture/missing-summary-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/missing-summary-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted a missing final summary\n' >&2
    return 1
  fi
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'OK (1 test)' \
    'OK (1 test)' \
    'INSTRUMENTATION_CODE: -1' >"$fixture/duplicate-summary-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/duplicate-summary-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted duplicate final summaries\n' >&2
    return 1
  fi
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'OK (1 test)' >"$fixture/missing-completion-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/missing-completion-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted a missing instrumentation completion code\n' >&2
    return 1
  fi
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'OK (1 test)' \
    'INSTRUMENTATION_CODE: 0' >"$fixture/wrong-completion-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/wrong-completion-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted a wrong instrumentation completion code\n' >&2
    return 1
  fi
  printf '%s\n' \
    'INSTRUMENTATION_STATUS_CODE: 1' \
    'INSTRUMENTATION_STATUS_CODE: 0' \
    'OK (1 test)' \
    'INSTRUMENTATION_CODE: -1' \
    'INSTRUMENTATION_CODE: -1' >"$fixture/duplicate-completion-instrumentation"
  if assert_complete_instrumentation \
    android-platform-fixture 1 0 "$fixture/duplicate-completion-instrumentation" >/dev/null 2>&1; then
    printf 'Android platform policy accepted duplicate instrumentation completion codes\n' >&2
    return 1
  fi
  snapshot_probe="$(android_platform_create_release_snapshot)"
  snapshot_probe_dir="${snapshot_probe%/*}"
  [[ "$snapshot_probe" == "$snapshot_probe_dir/release.apk" &&
    -d "$snapshot_probe_dir" && ! -L "$snapshot_probe_dir" ]] || {
    printf 'Android platform recovery snapshot is not a private APK path\n' >&2
    return 1
  }
  printf 'snapshot probe\n' >"$snapshot_probe"
  platform_release_snapshot="$snapshot_probe"
  platform_release_snapshot_dir="$snapshot_probe_dir"
  android_platform_remove_release_snapshot
  [[ ! -e "$snapshot_probe" && ! -d "$snapshot_probe_dir" ]] || {
    printf 'Android platform recovery snapshot was not removed exactly\n' >&2
    return 1
  }
  source_checkout="$fixture/source"
  dev_checkout="$fixture/dev-server"
  release_apk="$fixture/skidbladnir-android.apk"
  mkdir -p "$source_checkout/scripts" "$dev_checkout/assets/skidbladnir"
  printf 'source fixture\n' >"$source_checkout/fixture"
  install -m 0755 "$repo_dir/scripts/check-release" "$source_checkout/scripts/check-release"
  git -C "$source_checkout" init -q
  git -C "$source_checkout" add fixture scripts/check-release
  git -C "$source_checkout" -c user.name=Skidbladnir -c user.email=fixture@example.invalid \
    -c commit.gpgsign=false commit -qm 'source fixture'
  source_sha="$(git -C "$source_checkout" rev-parse HEAD)"
  printf 'release apk fixture\n' >"$release_apk"
  apk_digest="$(content_digest <"$release_apk")"
  signer_digest="$(content_digest <"$repo_dir/android/app-signing-cert.sha256")"
  jq -S -n \
    --arg apk "$apk_digest" \
    --arg signer "$signer_digest" \
    --arg source "$source_sha" \
    '{
      androidApkSha256:$apk,
      androidSigningCertAssetSha256:$signer,
      darwinArm64Sha256:("0" * 64),
      linuxAmd64Sha256:("1" * 64),
      sha256SumsAssetSha256:("2" * 64),
      sourceSha:$source,
      version:"v0.2.2"
    }' >"$dev_checkout/assets/skidbladnir/release-pin.json"
  git -C "$dev_checkout" init -q
  git -C "$dev_checkout" add assets/skidbladnir/release-pin.json
  git -C "$dev_checkout" -c user.name=Skidbladnir -c user.email=fixture@example.invalid \
    -c commit.gpgsign=false commit -qm 'pin fixture'

  values="$(
    android_apk_version_name() { printf '0.2.2\n'; }
    android_apk_version_code() { printf '2002\n'; }
    android_platform_release_values "$dev_checkout" "$release_apk" "$source_checkout"
  )"
  [[ "$values" == "$apk_digest"$'\t''v0.2.2'$'\t''0.2.2'$'\t''2002'$'\t'"$source_sha" ]] || {
    printf 'Android platform release values were not bound to the exact pin and source\n' >&2
    return 1
  }
  if (
    android_apk_version_name() { printf '0.2.1\n'; }
    android_apk_version_code() { printf '2002\n'; }
    android_platform_release_values "$dev_checkout" "$release_apk" "$source_checkout" >/dev/null
  ); then
    printf 'Android platform policy accepted mismatched APK metadata\n' >&2
    return 1
  fi
  companion_apk="$fixture/app-deviceDebug.apk"
  printf 'same-version companion fixture\n' >"$companion_apk"
  (
    android_apk_version_name() { printf '0.2.2\n'; }
    android_apk_version_code() { printf '2002\n'; }
    android_platform_companion_matches_release \
      "$companion_apk" "$apk_digest" 0.2.2 2002
  ) || {
    printf 'Android platform policy rejected the same-version companion\n' >&2
    return 1
  }
  if (
    android_apk_version_name() { printf '0.2.1\n'; }
    android_apk_version_code() { printf '2002\n'; }
    android_platform_companion_matches_release \
      "$companion_apk" "$apk_digest" 0.2.2 2002
  ); then
    printf 'Android platform policy accepted mismatched companion metadata\n' >&2
    return 1
  fi
  if (
    android_apk_version_name() { printf '0.2.2\n'; }
    android_apk_version_code() { printf '2001\n'; }
    android_platform_companion_matches_release \
      "$companion_apk" "$apk_digest" 0.2.2 2002
  ); then
    printf 'Android platform policy accepted a mismatched companion version code\n' >&2
    return 1
  fi
  if (
    android_apk_version_name() { printf '0.2.2\n'; }
    android_apk_version_code() { printf '2002\n'; }
    android_platform_companion_matches_release \
      "$release_apk" "$apk_digest" 0.2.2 2002
  ); then
    printf 'Android platform policy accepted the release as its own companion\n' >&2
    return 1
  fi
  jq '.sourceSha = ("0" * 40)' "$dev_checkout/assets/skidbladnir/release-pin.json" \
    >"$fixture/release-pin.next.json"
  mv "$fixture/release-pin.next.json" "$dev_checkout/assets/skidbladnir/release-pin.json"
  git -C "$dev_checkout" add assets/skidbladnir/release-pin.json
  git -C "$dev_checkout" -c user.name=Skidbladnir -c user.email=fixture@example.invalid \
    -c commit.gpgsign=false commit -qm 'mismatched source fixture'
  if (
    android_apk_version_name() { printf '0.2.2\n'; }
    android_apk_version_code() { printf '2002\n'; }
    android_platform_release_values "$dev_checkout" "$release_apk" "$source_checkout" >/dev/null
  ); then
    printf 'Android platform policy accepted a source mismatch\n' >&2
    return 1
  fi

  cat >"$fixture/adb" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$SKIDBLADNIR_TEST_PLATFORM_CALLS"
case "$*" in
  *' shell pm path test')
    if [ -f "$SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE" ]; then
      printf 'package:/data/app/test/base.apk\n'
    else
      exit 1
    fi
    ;;
  *' uninstall test')
    /bin/unlink "$SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE" || exit 1
    ;;
  *' install -r '*)
    last_argument=''
    for argument in "$@"; do
      last_argument="$argument"
    done
    case "$last_argument" in
      *.apk) ;;
      *) exit 64 ;;
    esac
    if [ "${SKIDBLADNIR_TEST_FAIL_PLATFORM_RESTORE:-}" = 1 ]; then exit 1; fi
    ;;
esac
EOF
  chmod 0755 "$fixture/adb"
  export SKIDBLADNIR_TEST_PLATFORM_CALLS="$fixture/platform-calls"
  export SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE="$fixture/test-package-installed"
  : >"$SKIDBLADNIR_TEST_PLATFORM_CALLS"
  : >"$SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE"
  [[ "$(optional_installed_android_package_path "$fixture/adb" serial test)" == \
    'package:/data/app/test/base.apk' ]] || {
    printf 'Android platform policy rejected an installed optional package\n' >&2
    return 1
  }
  /bin/unlink "$SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE"
  [[ -z "$(optional_installed_android_package_path "$fixture/adb" serial test)" ]] || {
    printf 'Android platform policy rejected an absent optional package\n' >&2
    return 1
  }
  : >"$SKIDBLADNIR_TEST_PLATFORM_CALLS"
  : >"$SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE"
  printf 'temporary evidence\n' >"$fixture/platform-output"
  cp "$release_apk" "$fixture/release-snapshot.apk"
  cp "$release_apk" "$fixture/retained-release-snapshot.apk"
  /bin/unlink "$release_apk"
  set +e
  (
    platform_adb="$fixture/adb"
    platform_serial=serial
    platform_app_package=app
    platform_test_package='test'
    platform_release_apk="$fixture/release-snapshot.apk"
    platform_expected_apk_digest="$apk_digest"
    platform_test_package_installed=1
    platform_app_replaced=1
    platform_instrumentation_output_file="$fixture/platform-output"
    platform_release_snapshot="$fixture/release-snapshot.apk"
    platform_release_snapshot_dir=''
    # shellcheck disable=SC2317,SC2329 # Invoked indirectly by Android platform cleanup.
    verify_installed_android_signer() {
      printf 'verify %s %s\n' "$3" "$4" >>"$SKIDBLADNIR_TEST_PLATFORM_CALLS"
    }
    trap android_platform_cleanup EXIT
    exit 130
  )
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" == 130 && ! -e "$fixture/platform-output" &&
    ! -e "$fixture/release-snapshot.apk" ]] || {
    printf 'Android platform signal cleanup did not preserve status or remove owned files\n' >&2
    return 1
  }
  [[ "$(cat "$SKIDBLADNIR_TEST_PLATFORM_CALLS")" == \
    $'-s serial shell pm path test\n-s serial uninstall test\n-s serial shell pm path test\n-s serial install -r '"$fixture/release-snapshot.apk"$'\nverify app '"$apk_digest" ]] || {
    printf 'Android platform cleanup did not restore its exact owned boundary\n' >&2
    return 1
  }

  : >"$SKIDBLADNIR_TEST_PLATFORM_CALLS"
  export SKIDBLADNIR_TEST_FAIL_PLATFORM_RESTORE=1
  : >"$SKIDBLADNIR_TEST_PLATFORM_PACKAGE_STATE"
  set +e
  (
    platform_adb="$fixture/adb"
    platform_serial=serial
    platform_app_package=app
    platform_test_package='test'
    platform_release_apk="$fixture/retained-release-snapshot.apk"
    platform_expected_apk_digest="$apk_digest"
    platform_test_package_installed=1
    platform_app_replaced=1
    platform_instrumentation_output_file=''
    platform_release_snapshot="$fixture/retained-release-snapshot.apk"
    platform_release_snapshot_dir=''
    # shellcheck disable=SC2317,SC2329 # Invoked indirectly by Android platform cleanup.
    verify_installed_android_signer() { return 0; }
    trap android_platform_cleanup EXIT
    exit 0
  ) 2>"$fixture/restore-failure"
  cleanup_status=$?
  set -e
  unset SKIDBLADNIR_TEST_FAIL_PLATFORM_RESTORE
  [[ "$cleanup_status" == 1 && -f "$fixture/retained-release-snapshot.apk" ]] || {
    printf 'Android platform cleanup masked a failed release restoration\n' >&2
    return 1
  }
  printf 'Android platform release and cleanup policy passed\n'
)

verify_installed_android_signer() {
  local adb="$1"
  local serial="$2"
  local app_package="$3"
  local expected_apk_digest="${4:-}"
  local evidence_file="${5:-}"
  local apk_size
  local apk_size_output
  local package_path
  local package_output
  local installed_apk
  local installed_digest
  local installed_version_code
  local transfer_timeout_seconds
  package_output="$(mktemp -t skidbladnir-package-path.XXXXXX)"
  if ! run_bounded_to_file "$android_preflight_timeout_seconds" "$package_output" \
    "$adb" -s "$serial" shell pm path "$app_package"; then
    rm -f "$package_output"
    return 1
  fi
  package_path="$(tr -d '\r' < "$package_output")"
  rm -f "$package_output"
  package_path="$(installed_android_package_path "$package_path")" || return 1
  apk_size_output="$(mktemp -t skidbladnir-package-size.XXXXXX)"
  if ! run_bounded_to_file "$android_preflight_timeout_seconds" "$apk_size_output" \
    "$adb" -s "$serial" shell stat -c %s "$package_path"; then
    rm -f "$apk_size_output"
    return 1
  fi
  apk_size="$(tr -d '\r\n' < "$apk_size_output")"
  rm -f "$apk_size_output"
  [[ "$apk_size" =~ ^[0-9]+$ ]] || return 1
  ((apk_size > 0 && apk_size <= android_apk_max_bytes)) || return 1
  # Size the wireless transfer budget from a conservative minimum sustained rate plus fixed ADB
  # setup/reap allowance. This remains bounded without making a real 31 MiB APK race a lab timer.
  transfer_timeout_seconds=$((
    android_apk_pull_overhead_seconds +
      (apk_size + android_apk_pull_minimum_rate_bytes_per_second - 1) /
        android_apk_pull_minimum_rate_bytes_per_second
  ))
  installed_apk="$(mktemp -t skidbladnir-installed.XXXXXX)"
  if ! run_bounded_to_file "$transfer_timeout_seconds" /dev/null \
    "$adb" -s "$serial" pull "$package_path" "$installed_apk"; then
    rm -f "$installed_apk"
    return 1
  fi
  if ! "$repo_dir/scripts/check-android-signing" --public-apk "$installed_apk"; then
    rm -f "$installed_apk"
    return 1
  fi
  if [[ -n "$expected_apk_digest" ]] &&
    ! android_apk_matches_digest "$installed_apk" "$expected_apk_digest"; then
    rm -f "$installed_apk"
    return 1
  fi
  if [[ -n "$evidence_file" ]]; then
    [[ -f "$evidence_file" && ! -L "$evidence_file" ]] || {
      rm -f "$installed_apk"
      return 1
    }
    installed_digest="$(content_digest <"$installed_apk")" || {
      rm -f "$installed_apk"
      return 1
    }
    installed_version_code="$(android_apk_version_code "$installed_apk")" || {
      rm -f "$installed_apk"
      return 1
    }
    printf '%s\t%s\n' "$installed_digest" "$installed_version_code" \
      >"$evidence_file" || {
      rm -f "$installed_apk"
      return 1
    }
  fi
  rm -f "$installed_apk"
}

android_instrumentation_timeout_seconds=90
android_preflight_timeout_seconds=20
android_apk_pull_overhead_seconds=30
android_apk_pull_minimum_rate_bytes_per_second=262144
android_apk_max_bytes=268435456
android_process_termination_grace_seconds=2
android_process_reap_timeout_seconds=2

bounded_runner_source="$(sed -n '/^# BOUNDED_RUNNER_BEGIN$/,/^# BOUNDED_RUNNER_END$/p' "$0" | sed '1d;$d')"
bounded_runner_test_source="$(sed -n '/^# BOUNDED_RUNNER_TEST_BEGIN$/,/^# BOUNDED_RUNNER_TEST_END$/p' "$0" | sed '1d;$d')"

run_bounded_to_file() {
  local timeout_seconds="$1"
  local output_file="$2"
  shift 2
  python3 -c "$bounded_runner_source" \
    "$timeout_seconds" \
    "$android_process_termination_grace_seconds" \
    "$android_process_reap_timeout_seconds" \
    "$output_file" \
    "$@"
}

assert_complete_instrumentation() {
  local proof_name="$1"
  local expected_tests="$2"
  local command_status="$3"
  local output_file="$4"
  local status_events
  local started_tests
  local passed_tests
  local unpassed_tests
  local final_summaries
  local completion_events
  local successful_completions
  status_events="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE:' "$output_file" || true)"
  started_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: 1[[:space:]]*$' "$output_file" || true)"
  passed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: 0[[:space:]]*$' "$output_file" || true)"
  unpassed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: -[0-9]+[[:space:]]*$' "$output_file" || true)"
  final_summaries="$(grep -c -E "^OK \(${expected_tests} tests?\)[[:space:]]*$" "$output_file" || true)"
  completion_events="$(grep -c -E '^INSTRUMENTATION_CODE:' "$output_file" || true)"
  successful_completions="$(grep -c -E '^INSTRUMENTATION_CODE: -1[[:space:]]*$' "$output_file" || true)"
  if [[ "$command_status" -ne 0 || "$status_events" -ne $((expected_tests * 2)) ||
    "$started_tests" -ne "$expected_tests" ||
    "$passed_tests" -ne "$expected_tests" || "$unpassed_tests" -ne 0 ||
    "$final_summaries" -ne 1 || "$completion_events" -ne 1 ||
    "$successful_completions" -ne 1 ]]; then
    printf '%s did not execute exactly %s passing tests (status %s, events %s, started %s, passed %s, not passed %s, summaries %s, completions %s, successful completions %s)\n' \
      "$proof_name" "$expected_tests" "$command_status" "$status_events" "$started_tests" \
      "$passed_tests" "$unpassed_tests" "$final_summaries" "$completion_events" \
      "$successful_completions" >&2
    return 1
  fi
}

: <<'SKIDBLADNIR_BOUNDED_RUNNER'
# BOUNDED_RUNNER_BEGIN
import os
import signal
import subprocess
import sys
import time

timeout_seconds = float(sys.argv[1])
termination_grace_seconds = float(sys.argv[2])
reap_timeout_seconds = float(sys.argv[3])
output_path = sys.argv[4]
command = sys.argv[5:]
child = None
pending_signal = None
stopping = False


def signal_owned_processes(signum: int) -> None:
    if child is None or child.returncode is not None:
        return
    try:
        os.killpg(child.pid, signum)
    except ProcessLookupError:
        pass
    except PermissionError:
        # Some platform clients detach from the new process group or cross an OS-owned helper
        # boundary. Never signal a different group: retain ownership by targeting only the direct
        # child that Popen created and that this controller can reap.
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass


def stop_child() -> bool:
    global stopping
    if child is None or child.returncode is not None:
        return True
    stopping = True
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal_owned_processes(signal.SIGTERM)
    # Keep the direct child unreaped as a non-reusable process-group anchor while descendants get grace.
    time.sleep(termination_grace_seconds)
    signal_owned_processes(signal.SIGKILL)
    try:
        child.wait(timeout=reap_timeout_seconds)
        return True
    except subprocess.TimeoutExpired:
        print("bounded child could not be reaped after SIGKILL", file=sys.stderr)
        return False


def forward_signal(signum: int, _frame: object) -> None:
    global pending_signal
    if stopping:
        return
    if child is None:
        pending_signal = signum
        return
    if not stop_child():
        raise SystemExit(125)
    raise SystemExit(128 + signum)


signal.signal(signal.SIGHUP, forward_signal)
signal.signal(signal.SIGINT, forward_signal)
signal.signal(signal.SIGTERM, forward_signal)

with open(output_path, "wb") as output:
    if pending_signal is not None:
        raise SystemExit(128 + pending_signal)
    child = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=output,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    if pending_signal is not None:
        if not stop_child():
            raise SystemExit(125)
        raise SystemExit(128 + pending_signal)

    try:
        status = child.wait(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        if not stop_child():
            raise SystemExit(125)
        print(f"bounded command exceeded {timeout_seconds:g} seconds", file=sys.stderr)
        raise SystemExit(124)

raise SystemExit(status)
# BOUNDED_RUNNER_END
SKIDBLADNIR_BOUNDED_RUNNER

: <<'SKIDBLADNIR_BOUNDED_RUNNER_TEST'
# BOUNDED_RUNNER_TEST_BEGIN
import os
import signal
import subprocess
import sys
import tempfile
import time

runner_source = sys.argv[1]
owner_timeout_seconds = 5
owner_reap_timeout_seconds = 2
descendant_reap_timeout_seconds = 2
descendant_reap_interval_seconds = 0.01


def invoke(command_timeout: float, command: list[str]) -> tuple[int, str, str]:
    with tempfile.TemporaryDirectory(prefix="skidbladnir-bounded-runner-") as directory:
        output_path = os.path.join(directory, "output")
        identities_path = os.path.join(directory, "identities")
        environment = os.environ.copy()
        environment["SKIDBLADNIR_RUNNER_TEST_READY"] = os.path.join(directory, "ready")
        environment["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"] = identities_path
        owner = subprocess.Popen(
            [
                sys.executable,
                "-c",
                runner_source,
                str(command_timeout),
                "0.2",
                "0.2",
                output_path,
                *command,
            ],
            env=environment,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        try:
            status = owner.wait(timeout=owner_timeout_seconds)
        except subprocess.TimeoutExpired:
            if os.path.exists(identities_path):
                fields = open(identities_path, encoding="utf-8").read().split()
                if fields:
                    try:
                        os.killpg(int(fields[0]), signal.SIGKILL)
                    except ProcessLookupError:
                        pass
            os.killpg(owner.pid, signal.SIGKILL)
            owner.wait(timeout=owner_reap_timeout_seconds)
            raise
        with open(output_path, encoding="utf-8") as output:
            if owner.stderr is not None:
                owner.stderr.read()
            identities = open(identities_path, encoding="utf-8").read() if os.path.exists(identities_path) else ""
            return status, output.read(), identities


status, _, _ = invoke(1, [sys.executable, "-c", "raise SystemExit(23)"])
if status != 23:
    raise AssertionError(f"bounded runner returned {status}, expected 23")

descendant_program = """
import os
import subprocess
import sys
import time

descendant_source = '''
import os
import signal
import time

signal.signal(signal.SIGTERM, signal.SIG_IGN)
open(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"], "w", encoding="utf-8").close()
time.sleep(60)
'''
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "w", encoding="utf-8") as identities:
    identities.write(str(os.getpid()) + " ")
    identities.flush()
descendant = subprocess.Popen([sys.executable, "-c", descendant_source])
while not os.path.exists(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"]):
    time.sleep(0.005)
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "a", encoding="utf-8") as identities:
    identities.write(str(descendant.pid))
print(os.getpid(), descendant.pid, flush=True)
time.sleep(60)
"""
status, output, identity_output = invoke(1, [sys.executable, "-c", descendant_program])
owned_pids = []


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


try:
    invalid_identity = False
    for value in identity_output.split():
        try:
            owned_pids.append(int(value))
        except ValueError:
            invalid_identity = True
            break
    if invalid_identity or len(owned_pids) != 2 or any(pid <= 0 for pid in owned_pids):
        raise AssertionError(f"bounded runner published invalid owned identities: {identity_output!r}")
    if [int(value) for value in output.split()] != owned_pids:
        raise AssertionError("bounded runner output did not match its owned identities")
    if status != 124:
        raise AssertionError(f"bounded runner returned {status}, expected timeout 124")
    deadline = time.monotonic() + descendant_reap_timeout_seconds
    # justify-polling: the reparented descendant has no waitable handle; 10 ms observes prompt cleanup
    # while the two-second cap absorbs scheduler delay without slowing this host-only regression.
    while time.monotonic() < deadline:
        if all(not process_exists(pid) for pid in owned_pids):
            break
        time.sleep(descendant_reap_interval_seconds)
    else:
        raise AssertionError("bounded runner left an owned process alive")
finally:
    if owned_pids and any(process_exists(pid) for pid in owned_pids):
        try:
            os.killpg(owned_pids[0], signal.SIGKILL)
        except ProcessLookupError:
            pass
        cleanup_deadline = time.monotonic() + descendant_reap_timeout_seconds
        while time.monotonic() < cleanup_deadline and any(process_exists(pid) for pid in owned_pids):
            time.sleep(descendant_reap_interval_seconds)
# BOUNDED_RUNNER_TEST_END
SKIDBLADNIR_BOUNDED_RUNNER_TEST

