#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
gate="${1:-}"
shift || true

case "$(uname -s)" in
  Darwin)
    android_sdk="${ANDROID_HOME:-/Users/nnandal/Library/Android/sdk}"
    pinned_tmux='/opt/homebrew/bin/tmux'
    digest_command=(shasum -a 256)
    android_signing_config='/Users/nnandal/.config/skidbladnir/android-signing.properties'
    if [[ -z "${JAVA_HOME:-}" ]]; then
      export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    fi
    ;;
  Linux)
    android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
    pinned_tmux='/usr/bin/tmux'
    digest_command=(sha256sum)
    android_signing_config='/home/niels/.config/skidbladnir/android-signing.properties'
    ;;
  *)
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Only Linux and Darwin hosts are supported"}\n' "${gate:-unknown}"
    exit 2
    ;;
esac

run() {
  printf '==> %s\n' "$1"
  shift
  "$@"
}

not_run() {
  printf '{"gate":"%s","status":"NOT_RUN","reason":"%s"}\n' "$1" "$2"
  exit 2
}

content_digest() {
  "${digest_command[@]}" | cut -d ' ' -f 1
}

pinned_android_release_values() {
  local checkout="$1"
  local pin="$checkout/assets/skidbladnir/release-pin.json"
  [[ -f "$pin" && ! -L "$pin" ]] || return 1
  jq -er '
    if type == "object" and keys == [
      "androidApkSha256",
      "androidSigningCertAssetSha256",
      "darwinArm64Sha256",
      "linuxAmd64Sha256",
      "sha256SumsAssetSha256",
      "sourceSha",
      "version"
    ] and
      (.version | type == "string" and test("^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")) and
      (.sourceSha | type == "string" and test("^[0-9a-f]{40}$")) and
      ([
        .androidApkSha256,
        .androidSigningCertAssetSha256,
        .darwinArm64Sha256,
        .linuxAmd64Sha256,
        .sha256SumsAssetSha256
      ] | all(type == "string" and test("^[0-9a-f]{64}$")))
    then [.androidApkSha256, .androidSigningCertAssetSha256, .version] | @tsv
    else error("release pin is pending or invalid")
    end
  ' "$pin"
}

android_release_matches_pin() {
  local checkout="$1"
  local apk="$2"
  local values expected_apk expected_signer_asset _version
  values="$(pinned_android_release_values "$checkout")" || return 1
  IFS=$'\t' read -r expected_apk expected_signer_asset _version <<<"$values"
  [[ -n "$expected_apk" && -n "$expected_signer_asset" ]] || return 1
  [[ "$(content_digest <"$apk")" == "$expected_apk" ]] || return 1
  [[ "$(content_digest <"$repo_dir/android/app-signing-cert.sha256")" == "$expected_signer_asset" ]]
}

installed_android_package_path() {
  local output="$1"
  [[ "$output" =~ ^package:(/[^[:space:][:cntrl:]]+[.]apk)$ ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

android_apk_matches_digest() {
  local apk="$1"
  local expected="$2"
  [[ -f "$apk" && ! -L "$apk" && "$expected" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$(content_digest <"$apk")" == "$expected" ]]
}

android_apk_version_code() {
  local apk="$1"
  local apkanalyzer
  local version_code
  [[ -f "$apk" && ! -L "$apk" ]] || return 1
  apkanalyzer="$({
    find "$android_sdk" -path '*/bin/apkanalyzer' -type f 2>/dev/null || true
  } | sort | tail -n 1)"
  [[ -x "$apkanalyzer" ]] || return 1
  version_code="$($apkanalyzer manifest version-code "$apk")" || return 1
  [[ "$version_code" =~ ^[1-9][0-9]{0,9}$ ]] || return 1
  ((10#$version_code <= 2100000000)) || return 1
  printf '%s\n' "$version_code"
}

android_update_candidate_is_distinct_newer() {
  local installed_digest="$1"
  local installed_version_code="$2"
  local candidate_digest="$3"
  local candidate_version_code="$4"
  [[ "$installed_digest" =~ ^[0-9a-f]{64}$ &&
    "$candidate_digest" =~ ^[0-9a-f]{64}$ &&
    "$installed_version_code" =~ ^[1-9][0-9]{0,9}$ &&
    "$candidate_version_code" =~ ^[1-9][0-9]{0,9}$ ]] || return 1
  [[ "$installed_digest" != "$candidate_digest" ]] || return 1
  ((10#$candidate_version_code > 10#$installed_version_code))
}

android_release_helper_self_test() {
  local fixture expected wrong candidate
  [[ "$(installed_android_package_path 'package:/data/app/example/base.apk')" == \
    '/data/app/example/base.apk' ]] || return 1
  if installed_android_package_path ''; then
    printf 'Absent Android package was accepted\n' >&2
    return 1
  fi
  if installed_android_package_path $'package:/data/app/one/base.apk\npackage:/data/app/two/split.apk'; then
    printf 'Split or duplicate Android package output was accepted\n' >&2
    return 1
  fi
  fixture="$(mktemp -t skidbladnir-apk-digest.XXXXXX)"
  printf 'fixture-apk\n' >"$fixture"
  expected="$(content_digest <"$fixture")"
  android_apk_matches_digest "$fixture" "$expected" || return 1
  if [[ "$expected" == 0* ]]; then
    wrong="1${expected:1}"
  else
    wrong="0${expected:1}"
  fi
  if android_apk_matches_digest "$fixture" "$wrong"; then
    printf 'Wrong Android APK digest was accepted\n' >&2
    return 1
  fi
  candidate="${expected%?}0"
  if [[ "$candidate" == "$expected" ]]; then
    candidate="${expected%?}1"
  fi
  android_update_candidate_is_distinct_newer "$expected" 100 "$candidate" 101 || return 1
  if android_update_candidate_is_distinct_newer "$expected" 100 "$expected" 101; then
    printf 'Same Android APK was accepted as an update\n' >&2
    return 1
  fi
  if android_update_candidate_is_distinct_newer "$expected" 100 "$candidate" 100 ||
    android_update_candidate_is_distinct_newer "$expected" 100 "$candidate" 99; then
    printf 'Non-newer Android APK was accepted as an update\n' >&2
    return 1
  fi
  /bin/unlink "$fixture"
  printf 'Installed Android release policy passed: path, digest, distinct, and newer cases\n'
}

verify_installed_android_signer() {
  local adb="$1"
  local serial="$2"
  local app_package="$3"
  local expected_apk_digest="${4:-}"
  local evidence_file="${5:-}"
  local apk_size
  local apk_size_output
  local package_path
  local package_output
  local installed_apk
  local installed_digest
  local installed_version_code
  local transfer_timeout_seconds
  package_output="$(mktemp -t skidbladnir-package-path.XXXXXX)"
  if ! run_bounded_to_file "$android_preflight_timeout_seconds" "$package_output" \
    "$adb" -s "$serial" shell pm path "$app_package"; then
    rm -f "$package_output"
    return 1
  fi
  package_path="$(tr -d '\r' < "$package_output")"
  rm -f "$package_output"
  package_path="$(installed_android_package_path "$package_path")" || return 1
  apk_size_output="$(mktemp -t skidbladnir-package-size.XXXXXX)"
  if ! run_bounded_to_file "$android_preflight_timeout_seconds" "$apk_size_output" \
    "$adb" -s "$serial" shell stat -c %s "$package_path"; then
    rm -f "$apk_size_output"
    return 1
  fi
  apk_size="$(tr -d '\r\n' < "$apk_size_output")"
  rm -f "$apk_size_output"
  [[ "$apk_size" =~ ^[0-9]+$ ]] || return 1
  ((apk_size > 0 && apk_size <= android_apk_max_bytes)) || return 1
  # Size the wireless transfer budget from a conservative minimum sustained rate plus fixed ADB
  # setup/reap allowance. This remains bounded without making a real 31 MiB APK race a lab timer.
  transfer_timeout_seconds=$((
    android_apk_pull_overhead_seconds +
      (apk_size + android_apk_pull_minimum_rate_bytes_per_second - 1) /
        android_apk_pull_minimum_rate_bytes_per_second
  ))
  installed_apk="$(mktemp -t skidbladnir-installed.XXXXXX)"
  if ! run_bounded_to_file "$transfer_timeout_seconds" /dev/null \
    "$adb" -s "$serial" pull "$package_path" "$installed_apk"; then
    rm -f "$installed_apk"
    return 1
  fi
  if ! "$repo_dir/scripts/check-android-signing" --public-apk "$installed_apk"; then
    rm -f "$installed_apk"
    return 1
  fi
  if [[ -n "$expected_apk_digest" ]] &&
    ! android_apk_matches_digest "$installed_apk" "$expected_apk_digest"; then
    rm -f "$installed_apk"
    return 1
  fi
  if [[ -n "$evidence_file" ]]; then
    [[ -f "$evidence_file" && ! -L "$evidence_file" ]] || {
      rm -f "$installed_apk"
      return 1
    }
    installed_digest="$(content_digest <"$installed_apk")" || {
      rm -f "$installed_apk"
      return 1
    }
    installed_version_code="$(android_apk_version_code "$installed_apk")" || {
      rm -f "$installed_apk"
      return 1
    }
    printf '%s\t%s\n' "$installed_digest" "$installed_version_code" \
      >"$evidence_file" || {
      rm -f "$installed_apk"
      return 1
    }
  fi
  rm -f "$installed_apk"
}

android_instrumentation_timeout_seconds=90
android_preflight_timeout_seconds=20
android_apk_pull_overhead_seconds=30
android_apk_pull_minimum_rate_bytes_per_second=262144
android_apk_max_bytes=268435456
android_process_termination_grace_seconds=2
android_process_reap_timeout_seconds=2

bounded_runner_source="$(sed -n '/^# BOUNDED_RUNNER_BEGIN$/,/^# BOUNDED_RUNNER_END$/p' "$0" | sed '1d;$d')"
bounded_runner_test_source="$(sed -n '/^# BOUNDED_RUNNER_TEST_BEGIN$/,/^# BOUNDED_RUNNER_TEST_END$/p' "$0" | sed '1d;$d')"

run_bounded_to_file() {
  local timeout_seconds="$1"
  local output_file="$2"
  shift 2
  python3 -c "$bounded_runner_source" \
    "$timeout_seconds" \
    "$android_process_termination_grace_seconds" \
    "$android_process_reap_timeout_seconds" \
    "$output_file" \
    "$@"
}

assert_one_executed_test() {
  local proof_name="$1"
  local output_file="$2"
  local passed_tests
  local unpassed_tests
  passed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: 0[[:space:]]*$' "$output_file" || true)"
  unpassed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: -[0-9]+[[:space:]]*$' "$output_file" || true)"
  if [[ "$passed_tests" -ne 1 || "$unpassed_tests" -ne 0 ]]; then
    printf '%s did not execute exactly one passing test (passed %s, not passed %s)\n' \
      "$proof_name" "$passed_tests" "$unpassed_tests" >&2
    return 1
  fi
}

: <<'SKIDBLADNIR_BOUNDED_RUNNER'
# BOUNDED_RUNNER_BEGIN
import os
import signal
import subprocess
import sys
import time

timeout_seconds = float(sys.argv[1])
termination_grace_seconds = float(sys.argv[2])
reap_timeout_seconds = float(sys.argv[3])
output_path = sys.argv[4]
command = sys.argv[5:]
child = None
pending_signal = None
stopping = False


def signal_owned_processes(signum: int) -> None:
    if child is None or child.returncode is not None:
        return
    try:
        os.killpg(child.pid, signum)
    except ProcessLookupError:
        pass
    except PermissionError:
        # Some platform clients detach from the new process group or cross an OS-owned helper
        # boundary. Never signal a different group: retain ownership by targeting only the direct
        # child that Popen created and that this controller can reap.
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass


def stop_child() -> bool:
    global stopping
    if child is None or child.returncode is not None:
        return True
    stopping = True
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal_owned_processes(signal.SIGTERM)
    # Keep the direct child unreaped as a non-reusable process-group anchor while descendants get grace.
    time.sleep(termination_grace_seconds)
    signal_owned_processes(signal.SIGKILL)
    try:
        child.wait(timeout=reap_timeout_seconds)
        return True
    except subprocess.TimeoutExpired:
        print("bounded child could not be reaped after SIGKILL", file=sys.stderr)
        return False


def forward_signal(signum: int, _frame: object) -> None:
    global pending_signal
    if stopping:
        return
    if child is None:
        pending_signal = signum
        return
    if not stop_child():
        raise SystemExit(125)
    raise SystemExit(128 + signum)


signal.signal(signal.SIGHUP, forward_signal)
signal.signal(signal.SIGINT, forward_signal)
signal.signal(signal.SIGTERM, forward_signal)

with open(output_path, "wb") as output:
    if pending_signal is not None:
        raise SystemExit(128 + pending_signal)
    child = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=output,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    if pending_signal is not None:
        if not stop_child():
            raise SystemExit(125)
        raise SystemExit(128 + pending_signal)

    try:
        status = child.wait(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        if not stop_child():
            raise SystemExit(125)
        print(f"bounded command exceeded {timeout_seconds:g} seconds", file=sys.stderr)
        raise SystemExit(124)

raise SystemExit(status)
# BOUNDED_RUNNER_END
SKIDBLADNIR_BOUNDED_RUNNER

: <<'SKIDBLADNIR_BOUNDED_RUNNER_TEST'
# BOUNDED_RUNNER_TEST_BEGIN
import os
import signal
import subprocess
import sys
import tempfile
import time

runner_source = sys.argv[1]
owner_timeout_seconds = 5
owner_reap_timeout_seconds = 2
descendant_reap_timeout_seconds = 2
descendant_reap_interval_seconds = 0.01


def invoke(command_timeout: float, command: list[str]) -> tuple[int, str, str]:
    with tempfile.TemporaryDirectory(prefix="skidbladnir-bounded-runner-") as directory:
        output_path = os.path.join(directory, "output")
        identities_path = os.path.join(directory, "identities")
        environment = os.environ.copy()
        environment["SKIDBLADNIR_RUNNER_TEST_READY"] = os.path.join(directory, "ready")
        environment["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"] = identities_path
        owner = subprocess.Popen(
            [
                sys.executable,
                "-c",
                runner_source,
                str(command_timeout),
                "0.2",
                "0.2",
                output_path,
                *command,
            ],
            env=environment,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        try:
            status = owner.wait(timeout=owner_timeout_seconds)
        except subprocess.TimeoutExpired:
            if os.path.exists(identities_path):
                fields = open(identities_path, encoding="utf-8").read().split()
                if fields:
                    try:
                        os.killpg(int(fields[0]), signal.SIGKILL)
                    except ProcessLookupError:
                        pass
            os.killpg(owner.pid, signal.SIGKILL)
            owner.wait(timeout=owner_reap_timeout_seconds)
            raise
        with open(output_path, encoding="utf-8") as output:
            if owner.stderr is not None:
                owner.stderr.read()
            identities = open(identities_path, encoding="utf-8").read() if os.path.exists(identities_path) else ""
            return status, output.read(), identities


status, _, _ = invoke(1, [sys.executable, "-c", "raise SystemExit(23)"])
if status != 23:
    raise AssertionError(f"bounded runner returned {status}, expected 23")

descendant_program = """
import os
import subprocess
import sys
import time

descendant_source = '''
import os
import signal
import time

signal.signal(signal.SIGTERM, signal.SIG_IGN)
open(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"], "w", encoding="utf-8").close()
time.sleep(60)
'''
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "w", encoding="utf-8") as identities:
    identities.write(str(os.getpid()) + " ")
    identities.flush()
descendant = subprocess.Popen([sys.executable, "-c", descendant_source])
while not os.path.exists(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"]):
    time.sleep(0.005)
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "a", encoding="utf-8") as identities:
    identities.write(str(descendant.pid))
print(os.getpid(), descendant.pid, flush=True)
time.sleep(60)
"""
status, output, identity_output = invoke(1, [sys.executable, "-c", descendant_program])
owned_pids = []


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


try:
    invalid_identity = False
    for value in identity_output.split():
        try:
            owned_pids.append(int(value))
        except ValueError:
            invalid_identity = True
            break
    if invalid_identity or len(owned_pids) != 2 or any(pid <= 0 for pid in owned_pids):
        raise AssertionError(f"bounded runner published invalid owned identities: {identity_output!r}")
    if [int(value) for value in output.split()] != owned_pids:
        raise AssertionError("bounded runner output did not match its owned identities")
    if status != 124:
        raise AssertionError(f"bounded runner returned {status}, expected timeout 124")
    deadline = time.monotonic() + descendant_reap_timeout_seconds
    # justify-polling: the reparented descendant has no waitable handle; 10 ms observes prompt cleanup
    # while the two-second cap absorbs scheduler delay without slowing this host-only regression.
    while time.monotonic() < deadline:
        if all(not process_exists(pid) for pid in owned_pids):
            break
        time.sleep(descendant_reap_interval_seconds)
    else:
        raise AssertionError("bounded runner left an owned process alive")
finally:
    if owned_pids and any(process_exists(pid) for pid in owned_pids):
        try:
            os.killpg(owned_pids[0], signal.SIGKILL)
        except ProcessLookupError:
            pass
        cleanup_deadline = time.monotonic() + descendant_reap_timeout_seconds
        while time.monotonic() < cleanup_deadline and any(process_exists(pid) for pid in owned_pids):
            time.sleep(descendant_reap_interval_seconds)
# BOUNDED_RUNNER_TEST_END
SKIDBLADNIR_BOUNDED_RUNNER_TEST

case "$gate" in
  static)
    cd "$repo_dir"
    run diff-check git diff --check
    # justify-override: SC2016 — the single-quoted text is the inner Bash process's own source, and
    # expanding it out here would resolve $files against this shell instead of the one that sets it.
    # shellcheck disable=SC2016
    run gofmt-test bash -c 'files=$(gofmt -l -- .); test -z "$files" || { printf "%s\n" "$files" >&2; exit 1; }'
    run bash-syntax bash -n scripts/build scripts/check-android-signing scripts/check-go-toolchain scripts/check-release scripts/check-release-source scripts/release scripts/render-release-notes scripts/test
    run shell-indentation awk \
      '/^[[:blank:]]*\t/ { printf "%s:%d: tab indentation\n", FILENAME, FNR; found = 1 }
       END { exit found ? 1 : 0 }' \
      scripts/build scripts/check-android-signing scripts/check-go-toolchain scripts/check-release scripts/check-release-source scripts/release scripts/render-release-notes scripts/test
    # justify-override: SC2016 — the single-quoted text is the inner POSIX shell's own source, and
    # expanding it out here would resolve $file before the inner loop ever binds it.
    # shellcheck disable=SC2016
    run executable-static sh -c 'for file do test -x "$file" || exit 1; done' sh \
      scripts/build scripts/check-android-signing scripts/check-codex-config scripts/check-go-toolchain scripts/check-release scripts/check-release-source scripts/release scripts/render-release-notes scripts/test
    run shellcheck shellcheck scripts/build scripts/check-android-signing scripts/check-go-toolchain scripts/check-release scripts/check-release-source scripts/release scripts/render-release-notes scripts/test
    run bounded-runner-static python3 -c \
      'import sys; compile(sys.argv[1], "bounded-runner", "exec")' "$bounded_runner_source"
    run bounded-runner-behavior python3 -c "$bounded_runner_test_source" "$bounded_runner_source"
    run catalogue-static ./scripts/check-catalogue
    run terminal-assets-static ./scripts/check-terminal-assets
    run ornament-static ./scripts/check-ornament
    run go-mod-verify go mod verify
    run go-vet go vet ./...
    run go-vet-integration go vet -tags=integration ./tests/integration ./internal/machine ./internal/process ./internal/pressure
    run go-vet-live go vet -tags=live ./tests/live
    run integration-compile go test -tags=integration -c -o /dev/null ./tests/integration
    run integration-host-compile go test -tags=integration -c -o /dev/null ./internal/machine ./internal/process ./internal/pressure
    run live-compile go test -tags=live -c -o /dev/null ./tests/live
    run android-static ./scripts/build android-static
    ;;
  unit)
    cd "$repo_dir"
    run go-unit go test ./cmd/... ./internal/...
    run codex-config-unit /usr/bin/python3 scripts/check-codex-config --self-test
    run android-signing-unit ./scripts/check-android-signing --self-test
    run go-toolchain-unit ./scripts/check-go-toolchain --self-test
    run release-unit bash ./scripts/check-release --self-test
    run release-notes-unit bash ./scripts/render-release-notes --self-test
    run release-source-unit bash ./scripts/check-release-source --self-test
    run release-worktree-unit bash ./scripts/release --self-test
    run installed-android-release-unit android_release_helper_self_test
    run android-unit ./scripts/build android-unit
    ;;
  integration)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run integration 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run integration 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run integration 'Integration tests refuse an invoking tmux client'
    fi
    if [[ ! -x "$pinned_tmux" ]]; then
      not_run integration "Pinned ${pinned_tmux} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run host-kernel-contracts go test -tags=integration ./internal/machine ./internal/process ./internal/pressure -count=1
    run tmux-control-plane go test -tags=integration ./tests/integration -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1 \
      -skidbladnir-tmux-path="$pinned_tmux"
    ;;
  platform)
    if [[ "${1:-}" != '--allow-device-mutation' || "$#" -ne 1 ]]; then
      not_run platform 'Pass --allow-device-mutation only after explicit current-turn user approval'
    fi
    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run platform 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run platform 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run platform 'Connected device is not SM-S906W on API 36'
    fi
    app_package='dev.niels.skidbladnir'
    test_package='dev.niels.skidbladnir.test'
    app_apk="$repo_dir/android/app/build/outputs/apk/deviceDebug/app-deviceDebug.apk"
    test_apk="$repo_dir/android/app/build/outputs/apk/androidTest/deviceDebug/app-deviceDebug-androidTest.apk"
    run android-signing-preflight env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" --config-only
    verify_installed_android_signer "$adb" "$serial" "$app_package" ||
      not_run platform 'Installed app does not carry the pinned Android signing identity'
    pairing_preferences='shared_prefs/skidbladnir.machines.xml'
    pairing_digest=''
    if "$adb" -s "$serial" shell run-as "$app_package" ls "$pairing_preferences" >/dev/null 2>&1; then
      pairing_digest="$(
        "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
          content_digest
      )"
    fi
    "$adb" -s "$serial" shell input keyevent KEYCODE_WAKEUP >/dev/null
    "$adb" -s "$serial" shell wm dismiss-keyguard >/dev/null
    if "$adb" -s "$serial" shell dumpsys window policy | grep -q 'mIsShowing=true'; then
      not_run platform 'Connected Android device must be awake and unlocked'
    fi
    cd "$repo_dir/android"
    run android-platform-build env ANDROID_HOME="$android_sdk" \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" ./gradlew \
      -Pskidbladnir.android.testBuildType=deviceDebug \
      :app:assembleDeviceDebug :app:assembleDeviceDebugAndroidTest --no-daemon
    run android-platform-signatures env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" "$app_apk" "$test_apk"
    run android-platform-app "$adb" -s "$serial" install -r -t "$app_apk"
    run android-platform-tests "$adb" -s "$serial" install -r -t "$test_apk"
    instrumentation_status=0
    instrumentation_output_file="$(mktemp -t skidbladnir-platform.XXXXXX)"
    run_bounded_to_file "$android_instrumentation_timeout_seconds" "$instrumentation_output_file" \
      "$adb" -s "$serial" shell am instrument -w \
      "${test_package}/androidx.test.runner.AndroidJUnitRunner" || instrumentation_status=$?
    instrumentation_output="$(<"$instrumentation_output_file")"
    rm -f "$instrumentation_output_file"
    printf '%s\n' "$instrumentation_output"
    "$adb" -s "$serial" uninstall "$test_package" >/dev/null || {
      printf 'could not uninstall the test-only Android package\n' >&2
      exit 1
    }
    # Pin discovery to the checked-in suite so partial instrumentation cannot
    # false-green as a complete platform gate.
    platform_expected_tests="$(grep -c '@Test' \
      "$repo_dir"/android/app/src/androidTest/java/dev/niels/skidbladnir/*.kt | \
      awk -F: '{ total += $2 } END { print total }')"
    if [[ "$instrumentation_status" -ne 0 ]] ||
      ! grep -Eq "^OK \(${platform_expected_tests} tests?\)$" <<<"$instrumentation_output"; then
      printf 'Android instrumentation failed or ran fewer than %s tests\n' "$platform_expected_tests" >&2
      exit 1
    fi
    if [[ -n "$pairing_digest" ]]; then
      current_pairing_digest="$(
        "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
          content_digest
      )"
      [[ "$current_pairing_digest" == "$pairing_digest" ]] || {
        printf 'Android instrumentation changed the encrypted pairing state\n' >&2
        exit 1
      }
    fi
    run android-platform-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  product)
    if [[ "${1:-}" != '--allow-device-mutation' ||
      "${2:-}" != '--allow-three-host-inventory-reconciliation' ||
      "${3:-}" != '--allow-one-host-service-restart' || "$#" -ne 3 ]]; then
      not_run product 'Pass the device, bounded three-host inventory-reconciliation, and one-host restart capabilities only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_THREE_HOST_PRODUCT_JOURNEY:-}" != 'three-host-product-v1' ||
      "${SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE:-}" != 'one-host-outage-v1' ]]; then
      not_run product 'Set both exact product and one-host-outage capabilities after explicit current-turn approval'
    fi
    if [[ "$(uname -s)" != 'Darwin' ]]; then
      not_run product 'The physical three-host outage journey must run on the MacBook'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run product 'The three-host journey refuses inherited tmux socket state'
    fi

    release_apk="${SKIDBLADNIR_RELEASE_APK:-}"
    dev_server_checkout="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    fleet_operator="$dev_server_checkout/skidbladnir"
    if [[ ! -f "$release_apk" || -L "$release_apk" ]]; then
      not_run product 'Set SKIDBLADNIR_RELEASE_APK to the regular signed release APK'
    fi
    if [[ ! -x "$fleet_operator" ]]; then
      not_run product 'Set SKIDBLADNIR_DEV_SERVER_CHECKOUT to a checkout with the fleet operator'
    fi
    if ! android_release_matches_pin "$dev_server_checkout" "$release_apk"; then
      not_run product 'Release APK does not match the complete published dev-server release pin'
    fi
    release_values="$(pinned_android_release_values "$dev_server_checkout")"
    IFS=$'\t' read -r expected_apk_digest _signer_asset_digest release_version \
      <<<"$release_values"
    run android-signing-preflight env \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" --config-only
    run release-apk-signature env \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" "$release_apk"

    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run product 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run product 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run product 'Connected device is not SM-S906W on API 36'
    fi

    app_package='dev.niels.skidbladnir'
    baseline_lifetime=''
    after_lifetime=''
    service_restore_required=''
    preupdate_evidence=''
    physical_confirmation() {
      local expected="$1"
      local prompt="$2"
      local response=''
      printf '%s\nType %s to confirm: ' "$prompt" "$expected"
      IFS= read -r response
      [[ "$response" == "$expected" ]] || {
        printf 'Physical product confirmation was not accepted.\n' >&2
        return 1
      }
    }
    fleet_lifetime_valid() {
      awk '
        BEGIN { valid = 1 }
        NR == 1 && NF == 2 && $1 == "Local" && $2 ~ /^[0-9a-f]{64}$/ { next }
        NR == 2 && NF == 2 && $1 == "DevServer" && $2 ~ /^[0-9a-f]{64}$/ { next }
        NR == 3 && NF == 2 && $1 == "Arch" && $2 ~ /^[0-9a-f]{64}$/ { next }
        { valid = 0 }
        END { exit valid && NR == 3 ? 0 : 1 }
      '
    }
    restore_product_gateway() {
      if [[ -n "$service_restore_required" ]]; then
        "$fleet_operator" recover Local || return
        service_restore_required=''
      fi
    }
    cleanup_product() {
      local exit_status=$?
      trap - EXIT HUP INT TERM
      if [[ -n "$preupdate_evidence" && -f "$preupdate_evidence" &&
        ! -L "$preupdate_evidence" ]]; then
        /bin/unlink "$preupdate_evidence" || exit_status=1
      fi
      restore_product_gateway || exit_status=1
      exit "$exit_status"
    }
    trap cleanup_product EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    run fleet-doctor "$fleet_operator" doctor
    baseline_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    printf '%s\n' "$baseline_lifetime" | fleet_lifetime_valid || {
      printf 'Fleet operator returned invalid lifetime evidence.\n' >&2
      exit 1
    }

    installed_path="$("$adb" -s "$serial" shell pm path "$app_package" | tr -d '\r')"
    if [[ "$installed_path" != package:* || "$installed_path" == *$'\n'* ]]; then
      not_run product \
        'The S22+ must begin with an existing signed installation and connected fleet so update preservation can be proved'
    fi
    preupdate_evidence="$(mktemp -t skidbladnir-preupdate.XXXXXX)"
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" '' "$preupdate_evidence" || {
      printf 'Pre-update app does not carry the pinned production signing identity.\n' >&2
      exit 1
    }
    IFS=$'\t' read -r installed_apk_digest installed_version_code \
      <"$preupdate_evidence"
    candidate_version_code="$(android_apk_version_code "$release_apk")" || {
      printf 'Candidate release APK has no valid version code.\n' >&2
      exit 1
    }
    android_update_candidate_is_distinct_newer \
      "$installed_apk_digest" "$installed_version_code" \
      "$expected_apk_digest" "$candidate_version_code" || {
      printf 'Candidate APK must be byte-distinct and newer than the installed signed release.\n' >&2
      exit 1
    }
    /bin/unlink "$preupdate_evidence"
    preupdate_evidence=''
    run android-preupdate-launch "$adb" -s "$serial" shell am start -n \
      "${app_package}/.MainActivity"
    physical_confirmation PREUPDATE_FLEET \
      'Confirm that the existing app renders Arch, Devbox, and MacBook before the update.'

    run release-apk-install "$adb" -s "$serial" install -r "$release_apk"
    installed_path="$("$adb" -s "$serial" shell pm path "$app_package" | tr -d '\r')"
    [[ "$installed_path" == package:* && "$installed_path" != *$'\n'* ]] || {
      printf 'Release APK is not installed as the production package.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" "$expected_apk_digest" || {
      printf 'Installed release APK does not match the pinned digest and signing identity.\n' >&2
      exit 1
    }
    run android-product-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    physical_confirmation UPDATE_PRESERVED \
      "Confirm that $release_version opens with the same Arch, Devbox, and MacBook fleet before a new invite."
    printf '%s\n' 'On the S22+, tap Reconnect fleet, then scan the fresh QR below.'
    run fleet-invite "$fleet_operator" invite
    physical_confirmation RECONNECTED \
      'Confirm that Arch, Devbox, and MacBook all render and each can be selected without retargeting.'
    run android-product-force-stop "$adb" -s "$serial" shell am force-stop "$app_package"
    run android-product-recreate "$adb" -s "$serial" shell am start -n \
      "${app_package}/.MainActivity"
    physical_confirmation PROCESS_RESTORED \
      'Confirm that process recreation restores the same three fleet identities and machine-bound routing.'

    service_restore_required=1
    run one-host-outage "$fleet_operator" outage Local
    physical_confirmation OUTAGE_ISOLATED \
      'Confirm that MacBook is unavailable while Arch and Devbox still render and remain selectable.'
    run one-host-recovery "$fleet_operator" recover Local
    service_restore_required=''
    run recovered-fleet-doctor "$fleet_operator" doctor
    physical_confirmation RECOVERED \
      'Confirm that Arch, Devbox, and MacBook all render and remain bound to their original labels.'

    after_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    printf '%s\n' "$after_lifetime" | fleet_lifetime_valid || {
      printf 'Fleet operator returned invalid recovery lifetime evidence.\n' >&2
      exit 1
    }
    [[ "$after_lifetime" == "$baseline_lifetime" ]] || {
      printf 'The product journey changed a host tmux lifetime inventory.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" "$expected_apk_digest" || {
      printf 'Installed release digest or signing identity changed during the journey.\n' >&2
      exit 1
    }
    trap - EXIT HUP INT TERM
    run android-product-leave-open "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  second-phone)
    if [[ "${1:-}" != '--allow-device-mutation' ||
      "${2:-}" != '--allow-three-host-inventory-reconciliation' || "$#" -ne 2 ]]; then
      not_run second-phone 'Pass the device and bounded three-host inventory-reconciliation capabilities only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_SECOND_PHONE_PRODUCT_JOURNEY:-}" != 'second-phone-product-v1' ]]; then
      not_run second-phone 'Set the exact second-phone capability after explicit current-turn approval'
    fi
    if [[ "$(uname -s)" != 'Darwin' ]]; then
      not_run second-phone 'The second-phone distribution journey must run on the MacBook'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run second-phone 'The second-phone journey refuses inherited tmux socket state'
    fi

    second_phone_model="${SKIDBLADNIR_SECOND_PHONE_MODEL:-}"
    if [[ -z "$second_phone_model" || "$second_phone_model" == 'SM-S906W' ||
      ! "$second_phone_model" =~ ^[A-Za-z0-9._+-]{1,64}$ ]]; then
      not_run second-phone 'Name the non-S22+ API 36 phone in SKIDBLADNIR_SECOND_PHONE_MODEL'
    fi
    dev_server_checkout="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    fleet_operator="$dev_server_checkout/skidbladnir"
    if [[ ! -x "$fleet_operator" ]]; then
      not_run second-phone 'Set SKIDBLADNIR_DEV_SERVER_CHECKOUT to a checkout with the fleet operator'
    fi
    release_values="$(pinned_android_release_values "$dev_server_checkout")" ||
      not_run second-phone 'The complete published dev-server release pin is unavailable'
    IFS=$'\t' read -r expected_apk_digest expected_signer_asset_digest release_version \
      <<<"$release_values"
    if [[ "$(content_digest <"$repo_dir/android/app-signing-cert.sha256")" != "$expected_signer_asset_digest" ]]; then
      not_run second-phone 'The dev-server signer asset pin differs from this source signer pin'
    fi
    public_apk_url="https://github.com/NielsdaWheelz/skidbladnir/releases/download/$release_version/skidbladnir-android.apk"

    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run second-phone 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run second-phone 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != "$second_phone_model" || "$api" != '36' ]]; then
      not_run second-phone 'Connected device does not match the named API 36 second phone'
    fi
    if [[ -n "$("$adb" -s "$serial" shell pm path dev.niels.skidbladnir | tr -d '\r\n')" ]]; then
      not_run second-phone 'The named second phone must begin without Skíðblaðnir installed'
    fi

    run fleet-doctor "$fleet_operator" doctor
    baseline_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    printf '%s\n' "$baseline_lifetime" | awk '
      BEGIN { valid = 1 }
      NR == 1 && NF == 2 && $1 == "Local" && $2 ~ /^[0-9a-f]{64}$/ { next }
      NR == 2 && NF == 2 && $1 == "DevServer" && $2 ~ /^[0-9a-f]{64}$/ { next }
      NR == 3 && NF == 2 && $1 == "Arch" && $2 ~ /^[0-9a-f]{64}$/ { next }
      { valid = 0 }
      END { exit valid && NR == 3 ? 0 : 1 }
    ' || {
      printf 'Fleet operator returned invalid lifetime evidence.\n' >&2
      exit 1
    }

    printf 'Opening the exact public GitHub APK: %s\n' "$public_apk_url"
    run second-phone-public-download "$adb" -s "$serial" shell am start \
      -a android.intent.action.VIEW -d "$public_apk_url"
    printf '%s\n' \
      'On the phone, complete the browser download and Android package installation from this URL.'
    printf '%s' 'Type PUBLIC_APK_INSTALLED after Android reports installation complete: '
    IFS= read -r confirmation
    [[ "$confirmation" == 'PUBLIC_APK_INSTALLED' ]] || {
      printf 'Public APK installation confirmation was not accepted.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" dev.niels.skidbladnir "$expected_apk_digest" || {
      printf 'Installed APK does not match the public release digest and signing identity.\n' >&2
      exit 1
    }
    run second-phone-launch "$adb" -s "$serial" shell am start -n \
      'dev.niels.skidbladnir/.MainActivity'
    printf '%s\n' 'On the named second phone, sign in to Tailscale, tap Connect, then scan the QR below.'
    run second-phone-invite "$fleet_operator" invite
    printf '%s\n' \
      'Confirm that this newly installed app renders Arch, Devbox, and MacBook and each can be selected.'
    printf '%s' 'Type SECOND_PHONE_CONNECTED to confirm: '
    IFS= read -r confirmation
    [[ "$confirmation" == 'SECOND_PHONE_CONNECTED' ]] || {
      printf 'Second-phone physical confirmation was not accepted.\n' >&2
      exit 1
    }

    after_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    [[ "$after_lifetime" == "$baseline_lifetime" ]] || {
      printf 'The second-phone journey changed a host tmux lifetime inventory.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" dev.niels.skidbladnir "$expected_apk_digest" || {
      printf 'Installed release digest or signing identity changed during the journey.\n' >&2
      exit 1
    }
    run second-phone-leave-open "$adb" -s "$serial" shell am start -n \
      'dev.niels.skidbladnir/.MainActivity'
    ;;
  live)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run live 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run live 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run live 'Live tmux proofs refuse an invoking tmux client'
    fi
    if [[ "$(uname -s)" != 'Linux' ]]; then
      not_run live 'The grouped-session proof is Linux-only; use integration for cross-host tmux acceptance'
    fi
    if [[ ! -x "$pinned_tmux" ]]; then
      not_run live "Pinned ${pinned_tmux} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run grouped-tmux go test -tags=live ./tests/live \
      -run '^(TestTmuxGroupedBehavior|TestRegisteredLiveTmuxCommandRejectsSecondarySocketSelectors)$' -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1
    ;;
  release)
    if [[ "${1:-}" != '--allow-release-verification' || -z "${2:-}" || "$#" -ne 2 ]]; then
      not_run release 'Pass --allow-release-verification TAG only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_RELEASE_VERIFICATION:-}" != 'signed-assets-v1' ]]; then
      not_run release 'Set SKIDBLADNIR_ALLOW_RELEASE_VERIFICATION=signed-assets-v1 after explicitly approving the signed release build'
    fi
    release_tag="$2"
    release_source_evidence="$("$repo_dir/scripts/check-release-source" "$release_tag")" ||
      not_run release 'Public-repository, exact-main, unused-tag, or exact-SHA hosted verify evidence is unavailable'
    IFS=$'\t' read -r release_sha release_run_id <<<"$release_source_evidence"
    [[ "$release_sha" =~ ^[0-9a-f]{40}$ && "$release_run_id" =~ ^[0-9]+$ ]] || {
      printf 'Release source preflight returned invalid evidence.\n' >&2
      exit 1
    }
    release_staging="$(mktemp -d -t skidbladnir-release-gate.XXXXXX)"
    case "$release_staging" in
      /tmp/skidbladnir-release-gate.* | /private/tmp/skidbladnir-release-gate.*) ;;
      *) printf 'Unexpected release-gate staging directory\n' >&2; exit 1 ;;
    esac
    trap 'rm -R -- "$release_staging"' EXIT HUP INT TERM
    run signed-release-assets "$repo_dir/scripts/build" release-assets \
      "$release_tag" "$release_sha" "$release_staging/assets"
    ;;
  published-release)
    if [[ "${1:-}" != '--allow-public-release-read' || -z "${2:-}" ||
      -z "${3:-}" || "$#" -ne 3 ]]; then
      not_run published-release \
        'Pass --allow-public-release-read TAG SOURCE_SHA only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_PUBLIC_RELEASE_READ:-}" != 'public-release-v1' ]]; then
      not_run published-release \
        'Set SKIDBLADNIR_ALLOW_PUBLIC_RELEASE_READ=public-release-v1 after explicit approval'
    fi
    published_tag="$2"
    published_sha="$3"
    "$repo_dir/scripts/check-release" --android-version "$published_tag" >/dev/null || {
      printf 'Published release tag is not canonical.\n' >&2
      exit 1
    }
    [[ "$published_sha" =~ ^[0-9a-f]{40}$ ]] || {
      printf 'Published release source must be one exact lowercase SHA.\n' >&2
      exit 1
    }
    for command in gh git jq; do
      command -v "$command" >/dev/null ||
        not_run published-release "Required public-release command is unavailable: $command"
    done
    gh auth status >/dev/null 2>&1 ||
      not_run published-release 'GitHub authentication is unavailable'
    published_repo='NielsdaWheelz/skidbladnir'
    [[ "$(gh repo view --repo "$published_repo" --json nameWithOwner,visibility \
      --jq '[.nameWithOwner,.visibility] | join(" ")')" == "$published_repo PUBLIC" ]] || {
      printf 'Published-release repository is not the exact public repository.\n' >&2
      exit 1
    }
    published_metadata="$(gh release view "$published_tag" --repo "$published_repo" \
      --json tagName,targetCommitish,isDraft,isPrerelease,isImmutable,assets,body)" ||
      not_run published-release 'The named public release is unavailable'
    jq -e --arg tag "$published_tag" --arg sha "$published_sha" '
      .tagName == $tag and .targetCommitish == $sha and
      .isDraft == false and .isPrerelease == false and .isImmutable == true and
      (.body | contains("Source: `" + $sha + "`") and
        contains("## Install") and contains("## Assets") and
        contains("## Known limits")) and
      ([.assets[].name] | sort) == [
        "SHA256SUMS",
        "android-signing-cert.sha256",
        "skidbladnir-android.apk",
        "skidbladnir-darwin-arm64.tar.gz",
        "skidbladnir-linux-amd64.tar.gz"
      ]
    ' <<<"$published_metadata" >/dev/null || {
      printf 'Public release is not immutable, final, exact-SHA, and exact-five-assets.\n' >&2
      exit 1
    }
    remote_tags="$(git ls-remote --tags "https://github.com/$published_repo.git" \
      "refs/tags/$published_tag" "refs/tags/$published_tag^{}")"
    remote_tag_sha="$(awk -v base="refs/tags/$published_tag" \
      '$2 == base { direct = $1 } $2 == base "^{}" { peeled = $1 }
       END { print peeled != "" ? peeled : direct }' <<<"$remote_tags")"
    [[ "$remote_tag_sha" == "$published_sha" ]] || {
      printf 'Public Git tag does not resolve to the declared exact source SHA.\n' >&2
      exit 1
    }
    published_staging="$(mktemp -d -t skidbladnir-published-release.XXXXXX)"
    case "$published_staging" in
      /tmp/skidbladnir-published-release.* | /private/tmp/skidbladnir-published-release.*) ;;
      *) printf 'Unexpected published-release staging directory\n' >&2; exit 1 ;;
    esac
    trap 'rm -R -- "$published_staging"' EXIT HUP INT TERM
    published_source="$published_staging/source"
    published_assets="$published_staging/assets"
    mkdir "$published_assets"
    run public-release-source git clone --quiet --depth 1 --single-branch \
      --branch "$published_tag" "https://github.com/$published_repo.git" \
      "$published_source"
    [[ "$(git -C "$published_source" rev-parse HEAD)" == "$published_sha" &&
      -z "$(git -C "$published_source" status --porcelain=v1 --untracked-files=all)" &&
      "$(git -C "$published_source" remote get-url origin)" == \
        "https://github.com/$published_repo.git" ]] || {
      printf 'Public release source checkout is not the clean exact published SHA.\n' >&2
      exit 1
    }
    "$published_source/scripts/check-release" --android-version "$published_tag" \
      >/dev/null || {
      printf 'Exact public source rejects the published release tag.\n' >&2
      exit 1
    }
    run public-release-download gh release download "$published_tag" \
      --repo "$published_repo" --dir "$published_assets"
    run public-release-assets "$published_source/scripts/check-release" \
      --public-assets "$published_assets" "$published_tag" "$published_sha"
    published_declared_dev_server="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    published_dev_server="$(cd "$published_declared_dev_server" && pwd -P)" || {
      printf 'Published release requires an available dev-server checkout.\n' >&2
      exit 1
    }
    published_pin_relative='assets/skidbladnir/release-pin.json'
    published_pin="$published_dev_server/$published_pin_relative"
    [[ -f "$published_pin" && ! -L "$published_pin" ]] || {
      printf 'Published release requires one regular dev-server release pin.\n' >&2
      exit 1
    }
    [[ "$(git -C "$published_dev_server" rev-parse --show-toplevel)" == \
        "$published_dev_server" ]] || {
      printf 'Published release requires the root of one dev-server Git checkout.\n' >&2
      exit 1
    }
    case "$(git -C "$published_dev_server" remote get-url origin)" in
      git@github.com:NielsdaWheelz/dev-server.git | \
        https://github.com/NielsdaWheelz/dev-server.git) ;;
      *)
        printf 'Published release requires the canonical dev-server origin.\n' >&2
        exit 1
        ;;
    esac
    if ! git -C "$published_dev_server" cat-file -e \
      "HEAD:$published_pin_relative" 2>/dev/null ||
      ! git -C "$published_dev_server" diff --quiet HEAD -- \
        "$published_pin_relative" ||
      ! cmp -s "$published_pin" \
        <(git -C "$published_dev_server" show "HEAD:$published_pin_relative"); then
      printf 'dev-server release pin must be tracked and byte-exact at its current HEAD.\n' >&2
      exit 1
    fi
    published_expected_pin="$(
      jq -nS \
        --arg version "$published_tag" \
        --arg sourceSha "$published_sha" \
        --arg androidApkSha256 "$(awk '$2 == "skidbladnir-android.apk" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg androidSigningCertAssetSha256 "$(awk '$2 == "android-signing-cert.sha256" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg darwinArm64Sha256 "$(awk '$2 == "skidbladnir-darwin-arm64.tar.gz" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg linuxAmd64Sha256 "$(awk '$2 == "skidbladnir-linux-amd64.tar.gz" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg sha256SumsAssetSha256 "$("${digest_command[@]}" "$published_assets/SHA256SUMS" | awk '{ print $1 }')" \
        '{
          androidApkSha256: $androidApkSha256,
          androidSigningCertAssetSha256: $androidSigningCertAssetSha256,
          darwinArm64Sha256: $darwinArm64Sha256,
          linuxAmd64Sha256: $linuxAmd64Sha256,
          sha256SumsAssetSha256: $sha256SumsAssetSha256,
          sourceSha: $sourceSha,
          version: $version
        }'
    )"
    cmp -s "$published_pin" <(printf '%s\n' "$published_expected_pin") || {
      printf 'dev-server does not pin the exact public tag, source, and all five asset digests.\n' >&2
      exit 1
    }
    published_body="$(jq -r '.body' <<<"$published_metadata")"
    # shellcheck disable=SC2016 # Backticks are literal release-note Markdown.
    published_run_id="$(sed -n 's/^- Verify run: `\([1-9][0-9]*\)`$/\1/p' \
      <<<"$published_body")"
    [[ "$published_run_id" =~ ^[1-9][0-9]*$ ]] || {
      printf 'Public release notes do not identify exactly one hosted verify run.\n' >&2
      exit 1
    }
    published_verify_run="$(gh run view "$published_run_id" \
      --repo "$published_repo" \
      --json headSha,conclusion,status,workflowName)" ||
      not_run published-release 'The release-noted hosted verify run is unavailable'
    jq -e --arg sha "$published_sha" '
      .headSha == $sha and .workflowName == "verify" and
      .status == "completed" and .conclusion == "success"
    ' <<<"$published_verify_run" >/dev/null || {
      printf 'Release-noted hosted verify run is not successful for the exact source SHA.\n' >&2
      exit 1
    }
    published_expected_body="$(
      "$published_source/scripts/render-release-notes" \
        "$published_tag" "$published_sha" "$published_run_id" "$published_assets"
    )" || {
      printf 'Exact public source could not render release notes from the assets.\n' >&2
      exit 1
    }
    [[ "$published_body" == "$published_expected_body" ]] || {
      printf 'Public release notes differ from the exact-source deterministic contract.\n' >&2
      exit 1
    }
    ;;
  verify)
    "$0" static
    "$repo_dir/scripts/build"
    "$0" unit
    ;;
  full)
    "$0" verify
    not_run full 'Run release, published-release, integration, live, platform, product, and second-phone separately after explicit approval for each external boundary'
    ;;
  '')
    printf 'usage: %s {static|unit|verify|full|release --allow-release-verification TAG|published-release --allow-public-release-read TAG SOURCE_SHA|platform --allow-device-mutation|product --allow-device-mutation --allow-three-host-inventory-reconciliation --allow-one-host-service-restart|second-phone --allow-device-mutation --allow-three-host-inventory-reconciliation|{integration|live} --allow-isolated-tmux-mutation}\n' "$0" >&2
    exit 64
    ;;
  *)
    printf 'unknown test gate: %s\n' "$gate" >&2
    exit 64
    ;;
esac
