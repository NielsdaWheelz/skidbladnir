#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
gate="${1:-}"
shift || true
android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
acceptance_mode="${SKIDBLADNIR_ACCEPTANCE:-0}"
acceptance_reason=""

emit_acceptance_result() {
  exit_code="$?"
  if [[ "$exit_code" -eq 0 ]]; then
    printf '{"gate":"%s","status":"PASS"}\n' "$gate" >&3
    return
  fi
  if [[ -z "$acceptance_reason" ]]; then
    acceptance_reason='declared gate failed'
  fi
  if [[ "$exit_code" -eq 2 ]]; then
    printf '{"gate":"%s","status":"NOT_RUN","reason":"%s"}\n' "$gate" "$acceptance_reason" >&3
    return
  fi
  printf '{"gate":"%s","status":"FAIL","reason":"%s"}\n' "$gate" "$acceptance_reason" >&3
}

case "$acceptance_mode" in
  0) ;;
  1)
    exec 3>&1
    exec 1>&2
    trap emit_acceptance_result EXIT
    ;;
  *)
    printf 'SKIDBLADNIR_ACCEPTANCE must be 0 or 1\n' >&2
    exit 64
    ;;
esac

run() {
  printf '==> %s\n' "$1"
  shift
  "$@"
}

not_run() {
  acceptance_reason="$2"
  if [[ "$acceptance_mode" -eq 0 ]]; then
    printf '{"gate":"%s","status":"NOT_RUN","reason":"%s"}\n' "$1" "$2"
  fi
  exit 2
}

case "$gate" in
  static)
    cd "$repo_dir"
    run diff-check git diff --check
    run gofmt-test bash -c 'files=$(gofmt -l -- .); test -z "$files" || { printf "%s\n" "$files" >&2; exit 1; }'
    run contract go run ./cmd/skidbladnir-contract verify
    run go-mod-verify go mod verify
    run go-vet go vet ./...
    run android-static ./scripts/build android-static
    ;;
  unit)
    cd "$repo_dir"
    run go-unit go test ./cmd/... ./internal/... ./generated/...
    ;;
  integration)
    not_run integration 'P1-P3 integration surface is not implemented'
    ;;
  component)
    not_run component 'No host-side Compose/WebView component runtime is implemented before P5'
    ;;
  system)
    cd "$repo_dir"
    run p0-hook-system go test -tags=system ./internal/hooks
    not_run system 'P3-P4 system surface is not implemented'
    ;;
  platform)
    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run platform 'Pinned Android SDK adb is unavailable'
    fi
    mapfile -t devices < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run platform 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run platform 'Connected device is not SM-S906W on API 36'
    fi
    cd "$repo_dir/android"
    run android-platform env ANDROID_HOME="$android_sdk" ANDROID_SERIAL="$serial" ./gradlew :app:connectedDebugAndroidTest --no-daemon
    ;;
  live)
    not_run live 'P1-P7 live gateway, hook, tmux, terminal, and recovery surfaces are not implemented'
    ;;
  upgrade-live)
    for required_directory in /home/niels/src /home/niels/.codex-personal /home/niels/.codex-work /home/niels/.codex-work2; do
      if [[ ! -d "$required_directory" ]]; then
        not_run upgrade-live "Required target directory is unavailable: $required_directory"
      fi
    done
    if ! command -v tmux >/dev/null 2>&1; then
      not_run upgrade-live 'tmux is unavailable on the target host'
    fi
    cd "$repo_dir"
    run p0-direct-tui-contract go run ./cmd/skidbladnir-contract verify
    run p0-direct-tui-upgrade-live go test -tags=live ./tests/live -run '^(TestDirectTUIAcrossProfiles|TestDirectTUIHookOrigin|TestDirectTUILifecycle|TestTmuxGroupedBehavior)$' -count=1
    ;;
  e2e)
    not_run e2e 'P7 end-to-end surface is not implemented'
    ;;
  verify)
    "$0" static
    "$repo_dir/scripts/build"
    "$0" unit
    "$0" integration
    "$0" component
    "$0" system
    ;;
  full)
    "$0" verify
    "$0" platform
    "$0" live
    "$0" e2e
    ;;
  proof)
    proof_id="${1:-}"
    cd "$repo_dir"
    case "$proof_id" in
      p0-codex-pin)
        run "$proof_id" go run ./cmd/skidbladnir-contract verify
        ;;
      p0-profile-direct-tui)
        run "$proof_id" go test -tags=live ./tests/live -run '^TestDirectTUIAcrossProfiles$' -count=1
        ;;
      p0-hook-origin)
        run "$proof_id" go test -tags=live ./tests/live -run '^TestDirectTUIHookOrigin$' -count=1
        ;;
      p0-hook-identity)
        run "$proof_id" go test -tags=live ./tests/live -run '^TestDirectTUIHookIdentity$' -count=1
        ;;
      p0-tui-lifecycle)
        run "$proof_id" go test -tags=live ./tests/live -run '^TestDirectTUILifecycle$' -count=1
        ;;
      p0-tmux-handoff)
        run "$proof_id" go test -tags=live ./tests/live -run '^TestTmuxGroupedBehavior$' -count=1
        ;;
      p0-tui-keys)
        run "$proof_id" go test -tags=live ./tests/live -run '^TestDirectTUIKeys$' -count=1
        ;;
      p0-android-terminal)
        "$0" platform
        ;;
      '')
        printf 'usage: %s proof PROOF_ID\n' "$0" >&2
        exit 64
        ;;
      *)
        not_run proof "Proof is not implemented: $proof_id"
        ;;
    esac
    ;;
  accept)
    case "${1:-}" in
      p0|core|upgrade)
        go run ./cmd/skidbladnir-contract accept "${1}"
        ;;
      *)
        printf 'usage: %s accept {p0|core|upgrade}\n' "$0" >&2
        exit 64
        ;;
    esac
    ;;
  '')
    printf 'usage: %s {static|unit|integration|component|system|platform|live|upgrade-live|e2e|verify|full|proof PROOF_ID|accept {p0|core|upgrade}}\n' "$0" >&2
    exit 64
    ;;
  *)
    printf 'unknown test gate: %s\n' "$gate" >&2
    exit 64
    ;;
esac
