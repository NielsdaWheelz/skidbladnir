    run android-platform-app "$adb" -s "$serial" install -r -t "$app_apk"
    run android-platform-tests "$adb" -s "$serial" install -r -t "$test_apk"
    instrumentation_status=0
    instrumentation_output_file="$(mktemp -t skidbladnir-platform.XXXXXX)"
    run_bounded_to_file "$android_instrumentation_timeout_seconds" "$instrumentation_output_file" \
      "$adb" -s "$serial" shell am instrument -w \
      -e notClass dev.niels.skidbladnir.MachineProvisioningInstrumentedTest \
      "${test_package}/androidx.test.runner.AndroidJUnitRunner" || instrumentation_status=$?
