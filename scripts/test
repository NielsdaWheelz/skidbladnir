#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
gate="${1:-}"
shift || true

case "$(uname -s)" in
  Darwin)
    android_sdk="${ANDROID_HOME:-/Users/nnandal/Library/Android/sdk}"
    pinned_tmux='/opt/homebrew/bin/tmux'
    digest_command=(shasum -a 256)
    android_signing_config='/Users/nnandal/.config/skidbladnir/android-signing.properties'
    if [[ -z "${JAVA_HOME:-}" ]]; then
      export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    fi
    ;;
  Linux)
    android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
    pinned_tmux='/usr/bin/tmux'
    digest_command=(sha256sum)
    android_signing_config='/home/niels/.config/skidbladnir/android-signing.properties'
    ;;
  *)
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Only Linux and Darwin hosts are supported"}\n' "${gate:-unknown}"
    exit 2
    ;;
esac

run() {
  printf '==> %s\n' "$1"
  shift
  "$@"
}

not_run() {
  printf '{"gate":"%s","status":"NOT_RUN","reason":"%s"}\n' "$1" "$2"
  exit 2
}

content_digest() {
  "${digest_command[@]}" | cut -d ' ' -f 1
}

verify_installed_android_signer() {
  local adb="$1"
  local serial="$2"
  local app_package="$3"
  local apk_size
  local apk_size_output
  local package_path
  local package_output
  local installed_apk
  local transfer_timeout_seconds
  package_output="$(mktemp -t skidbladnir-package-path.XXXXXX)"
  if ! run_bounded_to_file "$android_preflight_timeout_seconds" "$package_output" \
    "$adb" -s "$serial" shell pm path "$app_package"; then
    rm -f "$package_output"
    return 1
  fi
  package_path="$(tr -d '\r' < "$package_output")"
  rm -f "$package_output"
  [[ -n "$package_path" ]] || return 0
  [[ "$package_path" == package:* && "$package_path" != *$'\n'* ]] || return 1
  package_path="${package_path#package:}"
  apk_size_output="$(mktemp -t skidbladnir-package-size.XXXXXX)"
  if ! run_bounded_to_file "$android_preflight_timeout_seconds" "$apk_size_output" \
    "$adb" -s "$serial" shell stat -c %s "$package_path"; then
    rm -f "$apk_size_output"
    return 1
  fi
  apk_size="$(tr -d '\r\n' < "$apk_size_output")"
  rm -f "$apk_size_output"
  [[ "$apk_size" =~ ^[0-9]+$ ]] || return 1
  ((apk_size > 0 && apk_size <= android_apk_max_bytes)) || return 1
  # Size the wireless transfer budget from a conservative minimum sustained rate plus fixed ADB
  # setup/reap allowance. This remains bounded without making a real 31 MiB APK race a lab timer.
  transfer_timeout_seconds=$((
    android_apk_pull_overhead_seconds +
      (apk_size + android_apk_pull_minimum_rate_bytes_per_second - 1) /
        android_apk_pull_minimum_rate_bytes_per_second
  ))
  installed_apk="$(mktemp -t skidbladnir-installed.XXXXXX)"
  if ! run_bounded_to_file "$transfer_timeout_seconds" /dev/null \
    "$adb" -s "$serial" pull "$package_path" "$installed_apk"; then
    rm -f "$installed_apk"
    return 1
  fi
  if ! SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
    "$repo_dir/scripts/check-android-signing" "$installed_apk"; then
    rm -f "$installed_apk"
    return 1
  fi
  rm -f "$installed_apk"
}

run_publication_gate() {
  local gate_name="$1"
  shift
  local gate_label
  local approval_flag
  local capability_variable
  local capability_value
  local required_uname
  local home_directory
  local installer
  case "$gate_name" in
    devbox)
      gate_label='Devbox'
      approval_flag='--allow-live-devbox-publication'
      capability_variable='SKIDBLADNIR_ALLOW_DEVBOX_PUBLICATION'
      capability_value='devbox-publication-v1'
      required_uname='Linux'
      home_directory='/home/niels'
      installer='./scripts/install-devbox'
      ;;
    macbook)
      gate_label='MacBook'
      approval_flag='--allow-live-macbook-publication'
      capability_variable='SKIDBLADNIR_ALLOW_MACBOOK_PUBLICATION'
      capability_value='macbook-publication-v1'
      required_uname='Darwin'
      home_directory='/Users/nnandal'
      installer='./scripts/install-macbook'
      ;;
    *)
      printf 'unknown publication gate: %s\n' "$gate_name" >&2
      exit 64
      ;;
  esac
  if [[ "${1:-}" != "$approval_flag" || "$#" -ne 1 ]]; then
    not_run "$gate_name" "Pass ${approval_flag} only after explicit current-turn user approval"
  fi
  if [[ "${!capability_variable:-}" != "$capability_value" ]]; then
    not_run "$gate_name" "Set ${capability_variable}=${capability_value} after explicitly approving the live ${gate_label} install"
  fi
  if [[ "$(uname -s)" != "$required_uname" ]]; then
    not_run "$gate_name" "The ${gate_label} publication gate must run on its ${required_uname} target"
  fi
  if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
    not_run "$gate_name" "${gate_label} publication refuses inherited tmux socket state"
  fi

  local loopback_origin='http://127.0.0.1:7341'
  local handle_path="${home_directory}/.config/skidbladnir/machine-handle"
  local bearer_path="${home_directory}/.config/skidbladnir/bearer"
  local before_handle=''
  local installed_handle
  local installed_lifetime_digest
  if [[ -f "$handle_path" && ! -L "$handle_path" ]]; then
    before_handle="$(sed -n '1p' "$handle_path")"
  fi
  cd "$repo_dir"
  run "${gate_name}-install" "$installer" install
  installed_handle="$(sed -n '1p' "$handle_path")"
  [[ -z "$before_handle" || "$installed_handle" == "$before_handle" ]] || {
    printf '%s install changed the existing machine handle\n' "$gate_label" >&2
    exit 1
  }
  installed_lifetime_digest="$(machine_lifetime_digest "$loopback_origin" "$bearer_path" "$installed_handle")"
  run "${gate_name}-reinstall" "$installer" install
  [[ "$(sed -n '1p' "$handle_path")" == "$installed_handle" ]] || {
    printf '%s reinstall changed the machine handle\n' "$gate_label" >&2
    exit 1
  }
  [[ "$(machine_lifetime_digest "$loopback_origin" "$bearer_path" "$installed_handle")" == "$installed_lifetime_digest" ]] || {
    printf '%s reinstall changed the exact tmux lifetime inventory\n' "$gate_label" >&2
    exit 1
  }
}

machine_lifetime_digest() {
  local origin="$1"
  local bearer_file="$2"
  local handle="$3"
  # One read-only inventory GET normalized to the exact tmux lifetimes a machine publishes, so
  # comparing this digest before and after a gate proves no production session was created,
  # renamed, or killed on that machine.
  curl --fail --silent --show-error \
    --header @<(sed 's/^/Authorization: Bearer /' "$bearer_file") \
    --header "Skidbladnir-Machine: ${handle}" \
    "${origin}/v1/sessions" |
    jq -e -c '
      if (.sessions | type) != "array" then
        error("session inventory array required")
      else
        {machine, sessions: ([.sessions[] | {id,tmuxName,identityToken}] | sort_by(.id,.tmuxName,.identityToken))}
      end
    ' |
    content_digest
}

android_instrumentation_timeout_seconds=90
android_preflight_timeout_seconds=20
android_apk_pull_overhead_seconds=30
android_apk_pull_minimum_rate_bytes_per_second=262144
android_apk_max_bytes=268435456
android_cleanup_timeout_seconds=5
android_process_termination_grace_seconds=2
android_process_reap_timeout_seconds=2
android_probe_timeout_seconds=0.2
product_outage_readiness_attempts=100
product_outage_readiness_interval_seconds=0.1
macbook_gateway_health_attempts=50
macbook_gateway_health_interval_seconds=0.1
macbook_gateway_connect_timeout_seconds=0.1
macbook_gateway_probe_timeout_seconds=0.2

bounded_runner_source="$(sed -n '/^# BOUNDED_RUNNER_BEGIN$/,/^# BOUNDED_RUNNER_END$/p' "$0" | sed '1d;$d')"
bounded_runner_test_source="$(sed -n '/^# BOUNDED_RUNNER_TEST_BEGIN$/,/^# BOUNDED_RUNNER_TEST_END$/p' "$0" | sed '1d;$d')"

run_bounded_to_file() {
  local timeout_seconds="$1"
  local output_file="$2"
  shift 2
  python3 -c "$bounded_runner_source" \
    "$timeout_seconds" \
    "$android_process_termination_grace_seconds" \
    "$android_process_reap_timeout_seconds" \
    "$output_file" \
    "$@"
}

assert_one_executed_test() {
  local proof_name="$1"
  local output_file="$2"
  local passed_tests
  local unpassed_tests
  passed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: 0[[:space:]]*$' "$output_file" || true)"
  unpassed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: -[0-9]+[[:space:]]*$' "$output_file" || true)"
  if [[ "$passed_tests" -ne 1 || "$unpassed_tests" -ne 0 ]]; then
    printf '%s did not execute exactly one passing test (passed %s, not passed %s)\n' \
      "$proof_name" "$passed_tests" "$unpassed_tests" >&2
    return 1
  fi
}

: <<'SKIDBLADNIR_BOUNDED_RUNNER'
# BOUNDED_RUNNER_BEGIN
import os
import signal
import subprocess
import sys
import time

timeout_seconds = float(sys.argv[1])
termination_grace_seconds = float(sys.argv[2])
reap_timeout_seconds = float(sys.argv[3])
output_path = sys.argv[4]
command = sys.argv[5:]
child = None
pending_signal = None
stopping = False


def signal_owned_processes(signum: int) -> None:
    if child is None or child.returncode is not None:
        return
    try:
        os.killpg(child.pid, signum)
    except ProcessLookupError:
        pass
    except PermissionError:
        # Some platform clients detach from the new process group or cross an OS-owned helper
        # boundary. Never signal a different group: retain ownership by targeting only the direct
        # child that Popen created and that this controller can reap.
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass


def stop_child() -> bool:
    global stopping
    if child is None or child.returncode is not None:
        return True
    stopping = True
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal_owned_processes(signal.SIGTERM)
    # Keep the direct child unreaped as a non-reusable process-group anchor while descendants get grace.
    time.sleep(termination_grace_seconds)
    signal_owned_processes(signal.SIGKILL)
    try:
        child.wait(timeout=reap_timeout_seconds)
        return True
    except subprocess.TimeoutExpired:
        print("bounded child could not be reaped after SIGKILL", file=sys.stderr)
        return False


def forward_signal(signum: int, _frame: object) -> None:
    global pending_signal
    if stopping:
        return
    if child is None:
        pending_signal = signum
        return
    if not stop_child():
        raise SystemExit(125)
    raise SystemExit(128 + signum)


signal.signal(signal.SIGHUP, forward_signal)
signal.signal(signal.SIGINT, forward_signal)
signal.signal(signal.SIGTERM, forward_signal)

with open(output_path, "wb") as output:
    if pending_signal is not None:
        raise SystemExit(128 + pending_signal)
    child = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=output,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    if pending_signal is not None:
        if not stop_child():
            raise SystemExit(125)
        raise SystemExit(128 + pending_signal)

    try:
        status = child.wait(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        if not stop_child():
            raise SystemExit(125)
        print(f"bounded command exceeded {timeout_seconds:g} seconds", file=sys.stderr)
        raise SystemExit(124)

raise SystemExit(status)
# BOUNDED_RUNNER_END
SKIDBLADNIR_BOUNDED_RUNNER

: <<'SKIDBLADNIR_BOUNDED_RUNNER_TEST'
# BOUNDED_RUNNER_TEST_BEGIN
import os
import signal
import subprocess
import sys
import tempfile
import time

runner_source = sys.argv[1]
owner_timeout_seconds = 5
owner_reap_timeout_seconds = 2
descendant_reap_timeout_seconds = 2
descendant_reap_interval_seconds = 0.01


def invoke(command_timeout: float, command: list[str]) -> tuple[int, str, str]:
    with tempfile.TemporaryDirectory(prefix="skidbladnir-bounded-runner-") as directory:
        output_path = os.path.join(directory, "output")
        identities_path = os.path.join(directory, "identities")
        environment = os.environ.copy()
        environment["SKIDBLADNIR_RUNNER_TEST_READY"] = os.path.join(directory, "ready")
        environment["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"] = identities_path
        owner = subprocess.Popen(
            [
                sys.executable,
                "-c",
                runner_source,
                str(command_timeout),
                "0.2",
                "0.2",
                output_path,
                *command,
            ],
            env=environment,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        try:
            status = owner.wait(timeout=owner_timeout_seconds)
        except subprocess.TimeoutExpired:
            if os.path.exists(identities_path):
                fields = open(identities_path, encoding="utf-8").read().split()
                if fields:
                    try:
                        os.killpg(int(fields[0]), signal.SIGKILL)
                    except ProcessLookupError:
                        pass
            os.killpg(owner.pid, signal.SIGKILL)
            owner.wait(timeout=owner_reap_timeout_seconds)
            raise
        with open(output_path, encoding="utf-8") as output:
            if owner.stderr is not None:
                owner.stderr.read()
            identities = open(identities_path, encoding="utf-8").read() if os.path.exists(identities_path) else ""
            return status, output.read(), identities


status, _, _ = invoke(1, [sys.executable, "-c", "raise SystemExit(23)"])
if status != 23:
    raise AssertionError(f"bounded runner returned {status}, expected 23")

descendant_program = """
import os
import subprocess
import sys
import time

descendant_source = '''
import os
import signal
import time

signal.signal(signal.SIGTERM, signal.SIG_IGN)
open(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"], "w", encoding="utf-8").close()
time.sleep(60)
'''
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "w", encoding="utf-8") as identities:
    identities.write(str(os.getpid()) + " ")
    identities.flush()
descendant = subprocess.Popen([sys.executable, "-c", descendant_source])
while not os.path.exists(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"]):
    time.sleep(0.005)
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "a", encoding="utf-8") as identities:
    identities.write(str(descendant.pid))
print(os.getpid(), descendant.pid, flush=True)
time.sleep(60)
"""
status, output, identity_output = invoke(1, [sys.executable, "-c", descendant_program])
owned_pids = []


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


try:
    invalid_identity = False
    for value in identity_output.split():
        try:
            owned_pids.append(int(value))
        except ValueError:
            invalid_identity = True
            break
    if invalid_identity or len(owned_pids) != 2 or any(pid <= 0 for pid in owned_pids):
        raise AssertionError(f"bounded runner published invalid owned identities: {identity_output!r}")
    if [int(value) for value in output.split()] != owned_pids:
        raise AssertionError("bounded runner output did not match its owned identities")
    if status != 124:
        raise AssertionError(f"bounded runner returned {status}, expected timeout 124")
    deadline = time.monotonic() + descendant_reap_timeout_seconds
    # justify-polling: the reparented descendant has no waitable handle; 10 ms observes prompt cleanup
    # while the two-second cap absorbs scheduler delay without slowing this host-only regression.
    while time.monotonic() < deadline:
        if all(not process_exists(pid) for pid in owned_pids):
            break
        time.sleep(descendant_reap_interval_seconds)
    else:
        raise AssertionError("bounded runner left an owned process alive")
finally:
    if owned_pids and any(process_exists(pid) for pid in owned_pids):
        try:
            os.killpg(owned_pids[0], signal.SIGKILL)
        except ProcessLookupError:
            pass
        cleanup_deadline = time.monotonic() + descendant_reap_timeout_seconds
        while time.monotonic() < cleanup_deadline and any(process_exists(pid) for pid in owned_pids):
            time.sleep(descendant_reap_interval_seconds)
# BOUNDED_RUNNER_TEST_END
SKIDBLADNIR_BOUNDED_RUNNER_TEST

case "$gate" in
  static)
    cd "$repo_dir"
    run diff-check git diff --check
    # justify-override: SC2016 — the single-quoted text is the inner Bash process's own source, and
    # expanding it out here would resolve $files against this shell instead of the one that sets it.
    # shellcheck disable=SC2016
    run gofmt-test bash -c 'files=$(gofmt -l -- .); test -z "$files" || { printf "%s\n" "$files" >&2; exit 1; }'
    run bash-syntax bash -n scripts/build scripts/check-android-signing scripts/check-go-toolchain scripts/install-devbox scripts/install-macbook scripts/test
    run sh-syntax /bin/sh -n deploy/devbox/skid-notify deploy/macbook/skid-notify
    run shell-indentation awk \
      '/^[[:blank:]]*\t/ { printf "%s:%d: tab indentation\n", FILENAME, FNR; found = 1 }
       END { exit found ? 1 : 0 }' \
      scripts/build scripts/check-android-signing scripts/check-go-toolchain scripts/install-devbox scripts/install-macbook scripts/test \
      deploy/devbox/skid-notify deploy/macbook/skid-notify
    # justify-override: SC2016 — the single-quoted text is the inner POSIX shell's own source, and
    # expanding it out here would resolve $file before the inner loop ever binds it.
    # shellcheck disable=SC2016
    run executable-static sh -c 'for file do test -x "$file" || exit 1; done' sh \
      scripts/build scripts/check-android-signing scripts/check-codex-config scripts/check-go-toolchain scripts/test scripts/install-devbox scripts/install-macbook \
      deploy/devbox/skid-notify deploy/macbook/skid-notify
    run shellcheck shellcheck scripts/build scripts/check-android-signing scripts/check-go-toolchain scripts/install-devbox scripts/install-macbook scripts/test deploy/devbox/skid-notify deploy/macbook/skid-notify
    run bounded-runner-static python3 -c \
      'import sys; compile(sys.argv[1], "bounded-runner", "exec")' "$bounded_runner_source"
    run bounded-runner-behavior python3 -c "$bounded_runner_test_source" "$bounded_runner_source"
    run launchd-static python3 -c 'import plistlib,sys; plistlib.load(open(sys.argv[1], "rb"))' deploy/launchd/dev.niels.skidbladnir.plist
    run hook-json sh -c 'jq -e . "$@" >/dev/null' sh deploy/devbox/status-hooks.json deploy/macbook/status-hooks.json
    run catalogue-static ./scripts/check-catalogue
    run terminal-assets-static ./scripts/check-terminal-assets
    run go-mod-verify go mod verify
    run go-vet go vet ./...
    run go-vet-integration go vet -tags=integration ./tests/integration ./internal/machine ./internal/process ./internal/pressure
    run go-vet-live go vet -tags=live ./tests/live
    run integration-compile go test -tags=integration -c -o /dev/null ./tests/integration
    run integration-host-compile go test -tags=integration -c -o /dev/null ./internal/machine ./internal/process ./internal/pressure
    run live-compile go test -tags=live -c -o /dev/null ./tests/live
    run android-static ./scripts/build android-static
    ;;
  unit)
    cd "$repo_dir"
    run go-unit go test ./cmd/... ./internal/...
    run codex-config-unit /usr/bin/python3 scripts/check-codex-config --self-test
    run android-signing-unit ./scripts/check-android-signing --self-test
    run go-toolchain-unit ./scripts/check-go-toolchain --self-test
    run android-unit ./scripts/build android-unit
    ;;
  integration)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run integration 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run integration 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run integration 'Integration tests refuse an invoking tmux client'
    fi
    if [[ ! -x "$pinned_tmux" ]]; then
      not_run integration "Pinned ${pinned_tmux} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run host-kernel-contracts go test -tags=integration ./internal/machine ./internal/process ./internal/pressure -count=1
    run tmux-control-plane go test -tags=integration ./tests/integration -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1
    ;;
  provision)
    if [[ "${1:-}" != '--allow-device-mutation' || "${2:-}" != '--allow-machine-provisioning' || "$#" -ne 2 ]]; then
      not_run provision 'Pass the device and machine-provisioning capabilities only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_MACHINE_PROVISIONING:-}" != 'fixed-two-machine-v1' ]]; then
      not_run provision 'Set SKIDBLADNIR_ALLOW_MACHINE_PROVISIONING=fixed-two-machine-v1 after explicit approval'
    fi
    if [[ "$(uname -s)" != 'Darwin' ]]; then
      not_run provision 'Physical Android provisioning must run from the MacBook'
    fi
    adb="$android_sdk/platform-tools/adb"
    [[ -x "$adb" ]] || not_run provision 'Pinned Android SDK adb is unavailable'
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    [[ "${#devices[@]}" -eq 1 ]] || not_run provision 'Exactly one connected Android device is required'
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    [[ "$model" == 'SM-S906W' && "$api" == '36' ]] ||
      not_run provision 'Connected device is not SM-S906W on API 36'

    app_package='dev.niels.skidbladnir'
    test_package='dev.niels.skidbladnir.test'
    pairing_preferences='shared_prefs/skidbladnir.machines.xml'
    staging_relative='cache/skidbladnir-machine-provisioning.json'
    app_apk="$repo_dir/android/app/build/outputs/apk/deviceDebug/app-deviceDebug.apk"
    test_apk="$repo_dir/android/app/build/outputs/apk/androidTest/deviceDebug/app-deviceDebug-androidTest.apk"
    devbox_handle="${SKIDBLADNIR_DEVBOX_MACHINE_HANDLE:-}"
    macbook_handle="${SKIDBLADNIR_MACBOOK_MACHINE_HANDLE:-}"
    devbox_origin="${SKIDBLADNIR_DEVBOX_ORIGIN:-}"
    macbook_origin="${SKIDBLADNIR_MACBOOK_ORIGIN:-}"
    devbox_bearer_file="${SKIDBLADNIR_DEVBOX_BEARER_FILE:-}"
    macbook_bearer_file='/Users/nnandal/.config/skidbladnir/bearer'
    machine_handle_pattern='^mh-[0-9a-f]{32}$'
    machine_origin_pattern='^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?:8443$'
    if [[ ! "$devbox_handle" =~ $machine_handle_pattern || ! "$macbook_handle" =~ $machine_handle_pattern ||
      "$devbox_handle" == "$macbook_handle" ]]; then
      not_run provision 'Two distinct canonical machine handles are required'
    fi
    if [[ ! "$devbox_origin" =~ $machine_origin_pattern || ! "$macbook_origin" =~ $machine_origin_pattern ||
      "$devbox_origin" == "$macbook_origin" ]]; then
      not_run provision 'Two distinct canonical Tailnet HTTPS origins are required'
    fi
    for bearer_file in "$devbox_bearer_file" "$macbook_bearer_file"; do
      [[ -f "$bearer_file" && ! -L "$bearer_file" && "$(stat -f '%Lp' "$bearer_file")" == '600' ]] ||
        not_run provision 'Both gateway bearer files must be regular non-symlink mode-0600 files'
    done
    run android-signing-preflight env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" --config-only
    verify_installed_android_signer "$adb" "$serial" "$app_package" ||
      not_run provision 'Installed app does not carry the pinned Android signing identity'
    if "$adb" -s "$serial" shell run-as "$app_package" ls "$pairing_preferences" >/dev/null 2>&1; then
      not_run provision 'The production machine collection already exists; provisioning is create-only'
    fi
    machine_lifetime_digest 'http://127.0.0.1:7341' "$macbook_bearer_file" "$macbook_handle" >/dev/null ||
      not_run provision 'The installed MacBook gateway did not authenticate its requested handle'
    machine_lifetime_digest "$devbox_origin" "$devbox_bearer_file" "$devbox_handle" >/dev/null ||
      not_run provision 'The installed Devbox gateway did not authenticate its requested handle'

    cd "$repo_dir/android"
    run android-provision-build env ANDROID_HOME="$android_sdk" \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" ./gradlew \
      -Pskidbladnir.android.testBuildType=deviceDebug \
      :app:assembleDeviceDebug :app:assembleDeviceDebugAndroidTest --no-daemon
    run android-provision-signatures env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" "$app_apk" "$test_apk"
    run android-provision-app "$adb" -s "$serial" install -r -t "$app_apk"
    run android-provision-tests "$adb" -s "$serial" install -r -t "$test_apk"

    provision_input="$(mktemp -t skidbladnir-machine-provisioning.XXXXXX)"
    chmod 600 "$provision_input"
    provision_staged=''
    provision_test_installed=1
    cleanup_provision() {
      local exit_code=$?
      trap - EXIT HUP INT TERM
      if [[ -n "$provision_staged" ]]; then
        run_bounded_to_file "$android_cleanup_timeout_seconds" /dev/null \
          "$adb" -s "$serial" shell run-as "$app_package" rm -f "$staging_relative" || exit_code=1
      fi
