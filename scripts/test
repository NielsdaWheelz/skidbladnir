#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
gate="${1:-}"
shift || true

case "$(uname -s)" in
  Darwin)
    android_sdk="${ANDROID_HOME:-/Users/nnandal/Library/Android/sdk}"
    pinned_tmux='/opt/homebrew/bin/tmux'
    digest_command=(shasum -a 256)
    if [[ -z "${JAVA_HOME:-}" ]]; then
      export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    fi
    ;;
  Linux)
    android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
    pinned_tmux='/usr/bin/tmux'
    digest_command=(sha256sum)
    ;;
  *)
    printf '{"gate":"%s","status":"NOT_RUN","reason":"Only Linux and Darwin hosts are supported"}\n' "${gate:-unknown}"
    exit 2
    ;;
esac

run() {
  printf '==> %s\n' "$1"
  shift
  "$@"
}

not_run() {
  printf '{"gate":"%s","status":"NOT_RUN","reason":"%s"}\n' "$1" "$2"
  exit 2
}

content_digest() {
  "${digest_command[@]}" | cut -d ' ' -f 1
}

run_publication_gate() {
  local gate_name="$1"
  shift
  local gate_label
  local approval_flag
  local capability_variable
  local capability_value
  local required_uname
  local home_directory
  local installer
  case "$gate_name" in
    devbox)
      gate_label='Devbox'
      approval_flag='--allow-live-devbox-publication'
      capability_variable='SKIDBLADNIR_ALLOW_DEVBOX_PUBLICATION'
      capability_value='devbox-publication-v1'
      required_uname='Linux'
      home_directory='/home/niels'
      installer='./scripts/install-devbox'
      ;;
    macbook)
      gate_label='MacBook'
      approval_flag='--allow-live-macbook-publication'
      capability_variable='SKIDBLADNIR_ALLOW_MACBOOK_PUBLICATION'
      capability_value='macbook-publication-v1'
      required_uname='Darwin'
      home_directory='/Users/nnandal'
      installer='./scripts/install-macbook'
      ;;
    *)
      printf 'unknown publication gate: %s\n' "$gate_name" >&2
      exit 64
      ;;
  esac
  if [[ "${1:-}" != "$approval_flag" || "$#" -ne 1 ]]; then
    not_run "$gate_name" "Pass ${approval_flag} only after explicit current-turn user approval"
  fi
  if [[ "${!capability_variable:-}" != "$capability_value" ]]; then
    not_run "$gate_name" "Set ${capability_variable}=${capability_value} after explicitly approving the live ${gate_label} install"
  fi
  if [[ "$(uname -s)" != "$required_uname" ]]; then
    not_run "$gate_name" "The ${gate_label} publication gate must run on its ${required_uname} target"
  fi
  if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
    not_run "$gate_name" "${gate_label} publication refuses inherited tmux socket state"
  fi

  local loopback_origin='http://127.0.0.1:7341'
  local handle_path="${home_directory}/.config/skidbladnir/machine-handle"
  local bearer_path="${home_directory}/.config/skidbladnir/bearer"
  local before_handle=''
  local installed_handle
  local installed_lifetime_digest
  if [[ -f "$handle_path" && ! -L "$handle_path" ]]; then
    before_handle="$(sed -n '1p' "$handle_path")"
  fi
  cd "$repo_dir"
  run "${gate_name}-install" "$installer" install
  installed_handle="$(sed -n '1p' "$handle_path")"
  [[ -z "$before_handle" || "$installed_handle" == "$before_handle" ]] || {
    printf '%s install changed the existing machine handle\n' "$gate_label" >&2
    exit 1
  }
  installed_lifetime_digest="$(machine_lifetime_digest "$loopback_origin" "$bearer_path" "$installed_handle")"
  run "${gate_name}-reinstall" "$installer" install
  [[ "$(sed -n '1p' "$handle_path")" == "$installed_handle" ]] || {
    printf '%s reinstall changed the machine handle\n' "$gate_label" >&2
    exit 1
  }
  [[ "$(machine_lifetime_digest "$loopback_origin" "$bearer_path" "$installed_handle")" == "$installed_lifetime_digest" ]] || {
    printf '%s reinstall changed the exact tmux lifetime inventory\n' "$gate_label" >&2
    exit 1
  }
}

machine_lifetime_digest() {
  local origin="$1"
  local bearer_file="$2"
  local handle="$3"
  # One read-only inventory GET normalized to the exact tmux lifetimes a machine publishes, so
  # comparing this digest before and after a gate proves no production session was created,
  # renamed, or killed on that machine.
  curl --fail --silent --show-error \
    --header @<(sed 's/^/Authorization: Bearer /' "$bearer_file") \
    --header "Skidbladnir-Machine: ${handle}" \
    "${origin}/v1/sessions" |
    jq -e -c '
      if (.sessions | type) != "array" then
        error("session inventory array required")
      else
        {machine, sessions: ([.sessions[] | {id,name,identityToken}] | sort_by(.id,.name,.identityToken))}
      end
    ' |
    content_digest
}

android_instrumentation_timeout_seconds=90
android_cleanup_timeout_seconds=5
android_process_termination_grace_seconds=2
android_process_reap_timeout_seconds=2
android_probe_timeout_seconds=0.2
product_outage_readiness_attempts=100
product_outage_readiness_interval_seconds=0.1
macbook_gateway_health_attempts=50
macbook_gateway_health_interval_seconds=0.1
macbook_gateway_connect_timeout_seconds=0.1
macbook_gateway_probe_timeout_seconds=0.2

bounded_runner_source="$(sed -n '/^# BOUNDED_RUNNER_BEGIN$/,/^# BOUNDED_RUNNER_END$/p' "$0" | sed '1d;$d')"
bounded_runner_test_source="$(sed -n '/^# BOUNDED_RUNNER_TEST_BEGIN$/,/^# BOUNDED_RUNNER_TEST_END$/p' "$0" | sed '1d;$d')"

run_bounded_to_file() {
  local timeout_seconds="$1"
  local output_file="$2"
  shift 2
  python3 -c "$bounded_runner_source" \
    "$timeout_seconds" \
    "$android_process_termination_grace_seconds" \
    "$android_process_reap_timeout_seconds" \
    "$output_file" \
    "$@"
}

: <<'SKIDBLADNIR_BOUNDED_RUNNER'
# BOUNDED_RUNNER_BEGIN
import os
import signal
import subprocess
import sys
import time

timeout_seconds = float(sys.argv[1])
termination_grace_seconds = float(sys.argv[2])
reap_timeout_seconds = float(sys.argv[3])
output_path = sys.argv[4]
command = sys.argv[5:]
child = None
pending_signal = None
stopping = False


def stop_child() -> bool:
    global stopping
    if child is None or child.returncode is not None:
        return True
    stopping = True
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    try:
        os.killpg(child.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    # Keep the direct child unreaped as a non-reusable process-group anchor while descendants get grace.
    time.sleep(termination_grace_seconds)
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        child.wait(timeout=reap_timeout_seconds)
        return True
    except subprocess.TimeoutExpired:
        print("bounded child could not be reaped after SIGKILL", file=sys.stderr)
        return False


def forward_signal(signum: int, _frame: object) -> None:
    global pending_signal
    if stopping:
        return
    if child is None:
        pending_signal = signum
        return
    if not stop_child():
        raise SystemExit(125)
    raise SystemExit(128 + signum)


signal.signal(signal.SIGHUP, forward_signal)
signal.signal(signal.SIGINT, forward_signal)
signal.signal(signal.SIGTERM, forward_signal)

with open(output_path, "wb") as output:
    if pending_signal is not None:
        raise SystemExit(128 + pending_signal)
    child = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=output,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    if pending_signal is not None:
        if not stop_child():
            raise SystemExit(125)
        raise SystemExit(128 + pending_signal)

    try:
        status = child.wait(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        if not stop_child():
            raise SystemExit(125)
        print(f"bounded command exceeded {timeout_seconds:g} seconds", file=sys.stderr)
        raise SystemExit(124)

raise SystemExit(status)
# BOUNDED_RUNNER_END
SKIDBLADNIR_BOUNDED_RUNNER

: <<'SKIDBLADNIR_BOUNDED_RUNNER_TEST'
# BOUNDED_RUNNER_TEST_BEGIN
import os
import signal
import subprocess
import sys
import tempfile
import time

runner_source = sys.argv[1]
owner_timeout_seconds = 5
owner_reap_timeout_seconds = 2
descendant_reap_timeout_seconds = 2
descendant_reap_interval_seconds = 0.01


def invoke(command_timeout: float, command: list[str]) -> tuple[int, str, str]:
    with tempfile.TemporaryDirectory(prefix="skidbladnir-bounded-runner-") as directory:
        output_path = os.path.join(directory, "output")
        identities_path = os.path.join(directory, "identities")
        environment = os.environ.copy()
        environment["SKIDBLADNIR_RUNNER_TEST_READY"] = os.path.join(directory, "ready")
        environment["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"] = identities_path
        owner = subprocess.Popen(
            [
                sys.executable,
                "-c",
                runner_source,
                str(command_timeout),
                "0.2",
                "0.2",
                output_path,
                *command,
            ],
            env=environment,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        try:
            status = owner.wait(timeout=owner_timeout_seconds)
        except subprocess.TimeoutExpired:
            if os.path.exists(identities_path):
                fields = open(identities_path, encoding="utf-8").read().split()
                if fields:
                    try:
                        os.killpg(int(fields[0]), signal.SIGKILL)
                    except ProcessLookupError:
                        pass
            os.killpg(owner.pid, signal.SIGKILL)
            owner.wait(timeout=owner_reap_timeout_seconds)
            raise
        with open(output_path, encoding="utf-8") as output:
            if owner.stderr is not None:
                owner.stderr.read()
            identities = open(identities_path, encoding="utf-8").read() if os.path.exists(identities_path) else ""
            return status, output.read(), identities


status, _, _ = invoke(1, [sys.executable, "-c", "raise SystemExit(23)"])
if status != 23:
    raise AssertionError(f"bounded runner returned {status}, expected 23")

descendant_program = """
import os
import subprocess
import sys
import time

descendant_source = '''
import os
import signal
import time

signal.signal(signal.SIGTERM, signal.SIG_IGN)
open(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"], "w", encoding="utf-8").close()
time.sleep(60)
'''
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "w", encoding="utf-8") as identities:
    identities.write(str(os.getpid()) + " ")
    identities.flush()
descendant = subprocess.Popen([sys.executable, "-c", descendant_source])
while not os.path.exists(os.environ["SKIDBLADNIR_RUNNER_TEST_READY"]):
    time.sleep(0.005)
with open(os.environ["SKIDBLADNIR_RUNNER_TEST_IDENTITIES"], "a", encoding="utf-8") as identities:
    identities.write(str(descendant.pid))
print(os.getpid(), descendant.pid, flush=True)
time.sleep(60)
"""
status, output, identity_output = invoke(1, [sys.executable, "-c", descendant_program])
owned_pids = []


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


try:
    invalid_identity = False
    for value in identity_output.split():
        try:
            owned_pids.append(int(value))
        except ValueError:
            invalid_identity = True
            break
    if invalid_identity or len(owned_pids) != 2 or any(pid <= 0 for pid in owned_pids):
        raise AssertionError(f"bounded runner published invalid owned identities: {identity_output!r}")
    if [int(value) for value in output.split()] != owned_pids:
        raise AssertionError("bounded runner output did not match its owned identities")
    if status != 124:
        raise AssertionError(f"bounded runner returned {status}, expected timeout 124")
    deadline = time.monotonic() + descendant_reap_timeout_seconds
    # justify-polling: the reparented descendant has no waitable handle; 10 ms observes prompt cleanup
    # while the two-second cap absorbs scheduler delay without slowing this host-only regression.
    while time.monotonic() < deadline:
        if all(not process_exists(pid) for pid in owned_pids):
            break
        time.sleep(descendant_reap_interval_seconds)
    else:
        raise AssertionError("bounded runner left an owned process alive")
finally:
    if owned_pids and any(process_exists(pid) for pid in owned_pids):
        try:
            os.killpg(owned_pids[0], signal.SIGKILL)
        except ProcessLookupError:
            pass
        cleanup_deadline = time.monotonic() + descendant_reap_timeout_seconds
        while time.monotonic() < cleanup_deadline and any(process_exists(pid) for pid in owned_pids):
            time.sleep(descendant_reap_interval_seconds)
# BOUNDED_RUNNER_TEST_END
SKIDBLADNIR_BOUNDED_RUNNER_TEST

case "$gate" in
  static)
    cd "$repo_dir"
    run diff-check git diff --check
    # justify-override: SC2016 — the single-quoted text is the inner Bash process's own source, and
    # expanding it out here would resolve $files against this shell instead of the one that sets it.
    # shellcheck disable=SC2016
    run gofmt-test bash -c 'files=$(gofmt -l -- .); test -z "$files" || { printf "%s\n" "$files" >&2; exit 1; }'
    run bash-syntax bash -n scripts/build scripts/install-devbox scripts/install-macbook scripts/test
    run sh-syntax /bin/sh -n deploy/devbox/skid-notify deploy/macbook/skid-notify
    run shell-indentation awk \
      '/^[[:blank:]]*\t/ { printf "%s:%d: tab indentation\n", FILENAME, FNR; found = 1 }
       END { exit found ? 1 : 0 }' \
      scripts/build scripts/install-devbox scripts/install-macbook scripts/test \
      deploy/devbox/skid-notify deploy/macbook/skid-notify
    # justify-override: SC2016 — the single-quoted text is the inner POSIX shell's own source, and
    # expanding it out here would resolve $file before the inner loop ever binds it.
    # shellcheck disable=SC2016
    run executable-static sh -c 'for file do test -x "$file" || exit 1; done' sh \
      scripts/build scripts/test scripts/install-devbox scripts/install-macbook \
      deploy/devbox/skid-notify deploy/macbook/skid-notify
    run shellcheck shellcheck scripts/build scripts/install-devbox scripts/install-macbook scripts/test deploy/devbox/skid-notify deploy/macbook/skid-notify
    run bounded-runner-static python3 -c \
      'import sys; compile(sys.argv[1], "bounded-runner", "exec")' "$bounded_runner_source"
    run bounded-runner-behavior python3 -c "$bounded_runner_test_source" "$bounded_runner_source"
    run launchd-static python3 -c 'import plistlib,sys; plistlib.load(open(sys.argv[1], "rb"))' deploy/launchd/dev.niels.skidbladnir.plist
    run hook-json sh -c 'jq -e . "$@" >/dev/null' sh deploy/devbox/status-hooks.json deploy/macbook/status-hooks.json
    run catalogue-static ./scripts/check-catalogue
    run terminal-assets-static ./scripts/check-terminal-assets
    run go-mod-verify go mod verify
    run go-vet go vet ./...
    run integration-compile go test -tags=integration -c -o /dev/null ./tests/integration
    run integration-host-compile go test -tags=integration -c -o /dev/null ./internal/machine ./internal/process ./internal/pressure
    run live-compile go test -tags=live -c -o /dev/null ./tests/live
    run android-static ./scripts/build android-static
    ;;
  unit)
    cd "$repo_dir"
    run go-unit go test ./cmd/... ./internal/...
    run android-unit ./scripts/build android-unit
    ;;
  integration)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run integration 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run integration 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run integration 'Integration tests refuse an invoking tmux client'
    fi
    if [[ ! -x "$pinned_tmux" ]]; then
      not_run integration "Pinned ${pinned_tmux} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run host-kernel-contracts go test -tags=integration ./internal/machine ./internal/process ./internal/pressure -count=1
    run tmux-control-plane go test -tags=integration ./tests/integration -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1
    ;;
  platform)
    if [[ "${1:-}" != '--allow-device-mutation' || "$#" -ne 1 ]]; then
      not_run platform 'Pass --allow-device-mutation only after explicit current-turn user approval'
    fi
    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run platform 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run platform 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run platform 'Connected device is not SM-S906W on API 36'
    fi
    app_package='dev.niels.skidbladnir'
    test_package='dev.niels.skidbladnir.test'
    app_apk="$repo_dir/android/app/build/outputs/apk/debug/app-debug.apk"
    test_apk="$repo_dir/android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"
    pairing_preferences='shared_prefs/skidbladnir.machines.xml'
    pairing_digest=''
    if "$adb" -s "$serial" shell run-as "$app_package" ls "$pairing_preferences" >/dev/null 2>&1; then
      pairing_digest="$(
        "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
          content_digest
      )"
    fi
    "$adb" -s "$serial" shell input keyevent KEYCODE_WAKEUP >/dev/null
    "$adb" -s "$serial" shell wm dismiss-keyguard >/dev/null
    if "$adb" -s "$serial" shell dumpsys window policy | grep -q 'mIsShowing=true'; then
      not_run platform 'Connected Android device must be awake and unlocked'
    fi
    cd "$repo_dir/android"
    run android-platform-build env ANDROID_HOME="$android_sdk" ./gradlew \
      :app:assembleDebug :app:assembleDebugAndroidTest --no-daemon
    run android-platform-app "$adb" -s "$serial" install -r -t "$app_apk"
    run android-platform-tests "$adb" -s "$serial" install -r -t "$test_apk"
    instrumentation_status=0
    instrumentation_output_file="$(mktemp -t skidbladnir-platform.XXXXXX)"
    run_bounded_to_file "$android_instrumentation_timeout_seconds" "$instrumentation_output_file" \
      "$adb" -s "$serial" shell am instrument -w \
      "${test_package}/androidx.test.runner.AndroidJUnitRunner" || instrumentation_status=$?
    instrumentation_output="$(<"$instrumentation_output_file")"
    rm -f "$instrumentation_output_file"
    printf '%s\n' "$instrumentation_output"
    "$adb" -s "$serial" uninstall "$test_package" >/dev/null || {
      printf 'could not uninstall the test-only Android package\n' >&2
      exit 1
    }
    if [[ "$instrumentation_status" -ne 0 ]] ||
      ! grep -Eq '^OK \([1-9][0-9]* tests?\)$' <<<"$instrumentation_output"; then
      printf 'Android instrumentation failed\n' >&2
      exit 1
    fi
    if [[ -n "$pairing_digest" ]]; then
      current_pairing_digest="$(
        "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
          content_digest
      )"
      [[ "$current_pairing_digest" == "$pairing_digest" ]] || {
        printf 'Android instrumentation changed the encrypted pairing state\n' >&2
        exit 1
      }
    fi
    run android-platform-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  product)
    if [[ "${1:-}" != '--allow-device-mutation' || "${2:-}" != '--allow-two-host-read-only-tmux' ||
      "${3:-}" != '--allow-macbook-service-restart' || "$#" -ne 3 ]]; then
      not_run product 'Pass the device, read-only two-host tmux, and MacBook restart capabilities only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_TWO_HOST_PRODUCT_JOURNEY:-}" != 'two-host-product-v1' ||
      "${SKIDBLADNIR_ALLOW_MACBOOK_OUTAGE:-}" != 'macbook-outage-v1' ]]; then
      not_run product 'Set both exact product and MacBook-outage capabilities after explicit approval'
    fi
    if [[ "$(uname -s)" != 'Darwin' ]]; then
      not_run product 'The physical two-host outage journey must run on the MacBook'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run product 'The two-host journey refuses inherited tmux socket state'
    fi
    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run product 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run product 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run product 'Connected device is not SM-S906W on API 36'
    fi
    devbox_handle="${SKIDBLADNIR_DEVBOX_MACHINE_HANDLE:-}"
    macbook_handle="${SKIDBLADNIR_MACBOOK_MACHINE_HANDLE:-}"
    machine_handle_pattern='^mh-[0-9a-f]{32}$'
    if [[ ! "$devbox_handle" =~ $machine_handle_pattern || ! "$macbook_handle" =~ $machine_handle_pattern ||
      "$devbox_handle" == "$macbook_handle" ]]; then
      not_run product 'Two distinct canonical machine handles are required'
    fi
    # The journey's destructive UI surface targets whichever pairing sorts first, so the read-only
    # promise this gate is approved under can only be kept by fingerprinting both production tmux
    # servers. The MacBook is observed over its loopback gateway; the Devbox needs its own origin and
    # bearer, and without them the two-host guarantee is unobservable and the gate is NOT_RUN.
    macbook_origin='http://127.0.0.1:7341'
    macbook_bearer_file='/Users/nnandal/.config/skidbladnir/bearer'
    devbox_origin="${SKIDBLADNIR_DEVBOX_ORIGIN:-}"
    devbox_bearer_file="${SKIDBLADNIR_DEVBOX_BEARER_FILE:-}"
    machine_origin_pattern='^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?:8443$'
    if [[ ! "$devbox_origin" =~ $machine_origin_pattern ]]; then
      not_run product 'Set SKIDBLADNIR_DEVBOX_ORIGIN to the paired Devbox HTTPS :8443 origin'
    fi
    if [[ ! -f "$devbox_bearer_file" || -L "$devbox_bearer_file" ]]; then
      not_run product 'Set SKIDBLADNIR_DEVBOX_BEARER_FILE to the Devbox bearer readable on this host'
    fi
    app_package='dev.niels.skidbladnir'
    test_package='dev.niels.skidbladnir.test'
    app_apk="$repo_dir/android/app/build/outputs/apk/debug/app-debug.apk"
    test_apk="$repo_dir/android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"
    pairing_preferences='shared_prefs/skidbladnir.machines.xml'
    macbook_handle_path='/Users/nnandal/.config/skidbladnir/machine-handle'
    launch_domain='gui/501'
    launch_label='dev.niels.skidbladnir'
    launch_plist='/Users/nnandal/Library/LaunchAgents/dev.niels.skidbladnir.plist'
    if ! "$adb" -s "$serial" shell run-as "$app_package" ls "$pairing_preferences" >/dev/null 2>&1; then
      not_run product 'The production app has no paired-machine inventory'
    fi
    [[ -f "$macbook_handle_path" && ! -L "$macbook_handle_path" ]] ||
      not_run product 'The installed MacBook machine handle is unavailable'
    [[ "$(sed -n '1p' "$macbook_handle_path")" == "$macbook_handle" ]] ||
      not_run product 'The requested MacBook handle does not match the installed service'
    pairing_digest="$(
      "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
        content_digest
    )"
    "$adb" -s "$serial" shell input keyevent KEYCODE_WAKEUP >/dev/null
    "$adb" -s "$serial" shell wm dismiss-keyguard >/dev/null
    if "$adb" -s "$serial" shell dumpsys window policy | grep -q 'mIsShowing=true'; then
      not_run product 'Connected Android device must be awake and unlocked'
    fi

    # Both exact journeys run the instrumentation in raw mode (-r) because only the raw protocol
    # reports a per-test outcome: INSTRUMENTATION_STATUS_CODE: 0 for a test that actually ran and
    # passed, and a negative code for error (-1), failure (-2), ignored (-3), and assumption-skipped
    # (-4). JUnit counts an assumption-skipped test as successful and the pretty summary still reads
    # "OK (1 test)", so only this per-test evidence keeps a NOT_RUN journey from reading as a pass.
    assert_one_executed_test() {
      local proof_name="$1"
      local output_file="$2"
      local passed_tests
      local unpassed_tests
      passed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: 0[[:space:]]*$' "$output_file" || true)"
      unpassed_tests="$(grep -c -E '^INSTRUMENTATION_STATUS_CODE: -[0-9]+[[:space:]]*$' "$output_file" || true)"
      if [[ "$passed_tests" -ne 1 || "$unpassed_tests" -ne 0 ]]; then
        printf '%s did not execute exactly one passing test (passed %s, not passed %s)\n' \
          "$proof_name" "$passed_tests" "$unpassed_tests" >&2
        return 1
      fi
    }

    run_exact_product_test() {
      local proof_name="$1"
      local selector="$2"
      shift 2
      local instrumentation_status=0
      local output_file
      output_file="$(mktemp -t skidbladnir-product-exact.XXXXXX)"
      run_bounded_to_file "$android_instrumentation_timeout_seconds" "$output_file" \
        "$adb" -s "$serial" shell am instrument -r -w \
        -e class "$selector" \
        "$@" \
        "${test_package}/androidx.test.runner.AndroidJUnitRunner" || instrumentation_status=$?
      cat "$output_file"
      if [[ "$instrumentation_status" -ne 0 ]] || ! assert_one_executed_test "$proof_name" "$output_file"; then
        rm -f "$output_file"
        printf '%s failed (instrumentation status %s)\n' "$proof_name" "$instrumentation_status" >&2
        return 1
      fi
      rm -f "$output_file"
    }

    wait_for_instrumentation() {
      local child_pid="$instrumentation_pid"
      local child_status=0
      [[ -n "$child_pid" ]] || return 125
      if wait "$child_pid"; then
        child_status=0
      else
        child_status=$?
      fi
      instrumentation_pid=''
      return "$child_status"
    }

    bootout_macbook_service() {
      # launchctl reports EINPROGRESS (36) while the plist's graceful ExitTimeOut shutdown is still
      # running and ESRCH (3) or 113 once the job is already gone, so its exit status cannot stand in
      # for teardown; wait_for_macbook_gateway owns that fact. Any other status is a real failure.
      local bootout_status=0
      local bootout_output
      bootout_output="$(launchctl bootout "${launch_domain}/${launch_label}" 2>&1)" || bootout_status=$?
      case "$bootout_status" in
        0 | 3 | 36 | 113) ;;
        *)
          printf 'could not boot out the MacBook LaunchAgent (status %s): %s\n' \
            "$bootout_status" "$bootout_output" >&2
          return 1
          ;;
      esac
    }

    restore_macbook_product_service() {
      if ! launchctl print "${launch_domain}/${launch_label}" >/dev/null 2>&1; then
        launchctl bootstrap "$launch_domain" "$launch_plist" || return 1
      fi
      launchctl kickstart -k "${launch_domain}/${launch_label}" || return 1
      wait_for_macbook_gateway up
    }

    run_coordinated_outage_test() {
      local proof_name='isolated-macbook-outage'
      local selector='dev.niels.skidbladnir.MultiMachineUiInstrumentedTest#genuinelyUnavailablePairingDisablesMachineMutations'
      local readiness_path='cache/skidbladnir-multi-machine-outage-ready'
      local ready=''
      local attempt
      local instrumentation_status=0
      "$adb" -s "$serial" shell run-as "$app_package" rm -f "$readiness_path"
      instrumentation_output_file="$(mktemp -t skidbladnir-product.XXXXXX)"
      python3 -c "$bounded_runner_source" \
        "$android_instrumentation_timeout_seconds" \
        "$android_process_termination_grace_seconds" \
        "$android_process_reap_timeout_seconds" \
        "$instrumentation_output_file" \
        "$adb" -s "$serial" shell am instrument -r -w \
        -e class "$selector" \
        -e skidbladnir.failedMachine "$macbook_handle" \
        "${test_package}/androidx.test.runner.AndroidJUnitRunner" &
      instrumentation_pid=$!
      # justify-polling: 100 ms keeps the foreground checkpoint responsive; 100 bounded 200 ms probes plus
      # the shared four-second forced teardown cap the rendezvous at 34 seconds. No device event seam exists.
      for ((attempt = 0; attempt < product_outage_readiness_attempts; attempt++)); do
        probe_status=0
        run_bounded_to_file "$android_probe_timeout_seconds" /dev/null \
          "$adb" -s "$serial" shell run-as "$app_package" ls "$readiness_path" || probe_status=$?
        if [[ "$probe_status" -eq 0 ]]; then
          ready=1
          break
        fi
        if [[ "$probe_status" -eq 124 || "$probe_status" -eq 125 ]]; then
          break
        fi
        sleep "$product_outage_readiness_interval_seconds"
      done
      if [[ -z "$ready" ]]; then
        if wait_for_instrumentation; then
          instrumentation_status=0
        else
          instrumentation_status=$?
        fi
        cat "$instrumentation_output_file"
        rm -f "$instrumentation_output_file"
        instrumentation_output_file=''
        printf '%s never reached its healthy two-machine checkpoint (instrumentation status %s)\n' \
          "$proof_name" "$instrumentation_status" >&2
        return 1
      fi

      service_restore_required=1
      bootout_macbook_service || return 1
      wait_for_macbook_gateway down
      if wait_for_instrumentation; then
        instrumentation_status=0
      else
        instrumentation_status=$?
      fi
      cat "$instrumentation_output_file"
      if [[ "$instrumentation_status" -ne 0 ]] ||
        ! assert_one_executed_test "$proof_name" "$instrumentation_output_file"; then
        rm -f "$instrumentation_output_file"
        instrumentation_output_file=''
        printf '%s failed (instrumentation status %s)\n' "$proof_name" "$instrumentation_status" >&2
        return 1
      fi
      rm -f "$instrumentation_output_file"
      instrumentation_output_file=''
    }

    wait_for_macbook_gateway() {
      local expected_state="$1"
      local attempt
      # justify-polling: 100 ms observes fast launchd recovery without visible delay; 50 bounded 200 ms
      # loopback probes cap recovery at 15 seconds. Fixed cadence is appropriate at this short local boundary.
      for ((attempt = 0; attempt < macbook_gateway_health_attempts; attempt++)); do
        if curl --fail --silent \
          --connect-timeout "$macbook_gateway_connect_timeout_seconds" \
          --max-time "$macbook_gateway_probe_timeout_seconds" \
          'http://127.0.0.1:7341/healthz' >/dev/null 2>&1; then
          [[ "$expected_state" == 'up' ]] && return
        else
          [[ "$expected_state" == 'down' ]] && return
        fi
        sleep "$macbook_gateway_health_interval_seconds"
      done
      printf 'MacBook gateway did not become %s\n' "$expected_state" >&2
      return 1
    }

    paired_lifetime_digests() {
      local macbook_digest
      local devbox_digest
      macbook_digest="$(machine_lifetime_digest "$macbook_origin" "$macbook_bearer_file" "$macbook_handle")" ||
        return 1
      devbox_digest="$(machine_lifetime_digest "$devbox_origin" "$devbox_bearer_file" "$devbox_handle")" ||
        return 1
      printf '%s %s\n' "$macbook_digest" "$devbox_digest"
    }

    paired_lifetime_digest="$(paired_lifetime_digests)" ||
      not_run product 'Both paired gateways must answer a read-only inventory GET before the journey'

    service_restore_required=''
    test_package_installed=''
    instrumentation_pid=''
    instrumentation_output_file=''
    cleanup_product() {
      local exit_status=$?
      trap - EXIT HUP INT TERM
      if [[ -n "$service_restore_required" ]]; then
        restore_macbook_product_service || exit_status=1
      fi
      if [[ -n "$instrumentation_pid" ]]; then
        run_bounded_to_file "$android_cleanup_timeout_seconds" /dev/null \
          "$adb" -s "$serial" shell am force-stop "$app_package" || exit_status=1
        wait_for_instrumentation >/dev/null 2>&1 || true
      fi
      if [[ -n "$instrumentation_output_file" && -f "$instrumentation_output_file" ]]; then
        rm -f "$instrumentation_output_file" || exit_status=1
      fi
      if [[ -n "$service_restore_required" ]]; then
        (cd "$repo_dir" && ./scripts/install-macbook verify) || exit_status=1
        [[ "$(sed -n '1p' "$macbook_handle_path" 2>/dev/null || true)" == "$macbook_handle" ]] || exit_status=1
      fi
      [[ "$(paired_lifetime_digests 2>/dev/null || true)" == "$paired_lifetime_digest" ]] || exit_status=1
      if [[ -n "$test_package_installed" ]]; then
        "$adb" -s "$serial" uninstall "$test_package" >/dev/null || exit_status=1
      fi
      current_pairing_digest="$(
        "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" 2>/dev/null |
          content_digest
      )"
      [[ "$current_pairing_digest" == "$pairing_digest" ]] || exit_status=1
      exit "$exit_status"
    }
    trap cleanup_product EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    run macbook-product-preflight "$repo_dir/scripts/install-macbook" verify
    cd "$repo_dir/android"
    run android-product-build env ANDROID_HOME="$android_sdk" ./gradlew \
      :app:assembleDebug :app:assembleDebugAndroidTest --no-daemon
    run android-product-app "$adb" -s "$serial" install -r -t "$app_apk"
    run android-product-tests "$adb" -s "$serial" install -r -t "$test_apk"
    test_package_installed=1

    run_exact_product_test healthy-production-ui \
      'dev.niels.skidbladnir.MultiMachineUiInstrumentedTest#twoHealthyPairingsRenderAndRouteThroughTheProductionUi' \
      -e skidbladnir.multiMachineUi true \
      -e skidbladnir.devboxMachine "$devbox_handle" \
      -e skidbladnir.macbookMachine "$macbook_handle"

    run_coordinated_outage_test

    restore_macbook_product_service
    run macbook-product-recovery "$repo_dir/scripts/install-macbook" verify
    [[ "$(sed -n '1p' "$macbook_handle_path")" == "$macbook_handle" ]] || {
      printf 'MacBook recovery changed the machine handle\n' >&2
      exit 1
    }
    [[ "$(paired_lifetime_digests)" == "$paired_lifetime_digest" ]] || {
      printf 'Recovery changed the exact tmux lifetime inventory of a paired machine\n' >&2
      exit 1
    }
    run_exact_product_test recovered-production-ui \
      'dev.niels.skidbladnir.MultiMachineUiInstrumentedTest#twoHealthyPairingsRenderAndRouteThroughTheProductionUi' \
      -e skidbladnir.multiMachineUi true \
      -e skidbladnir.devboxMachine "$devbox_handle" \
      -e skidbladnir.macbookMachine "$macbook_handle"
    service_restore_required=''

    "$adb" -s "$serial" uninstall "$test_package" >/dev/null
    test_package_installed=''
    current_pairing_digest="$(
      "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
        content_digest
    )"
    [[ "$current_pairing_digest" == "$pairing_digest" ]] || {
      printf 'Physical product journey changed the encrypted pairing state\n' >&2
      exit 1
    }
    trap - EXIT HUP INT TERM
    run android-product-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  live)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run live 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run live 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run live 'Live tmux proofs refuse an invoking tmux client'
    fi
    if [[ "$(uname -s)" != 'Linux' ]]; then
      not_run live 'The grouped-session proof is Linux-only; use integration for cross-host tmux acceptance'
    fi
    if [[ ! -x "$pinned_tmux" ]]; then
      not_run live "Pinned ${pinned_tmux} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run grouped-tmux go test -tags=live ./tests/live \
      -run '^(TestTmuxGroupedBehavior|TestRegisteredLiveTmuxCommandRejectsSecondarySocketSelectors)$' -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1
    ;;
  devbox | macbook)
    run_publication_gate "$gate" "$@"
    ;;
  verify)
    "$0" static
    "$repo_dir/scripts/build"
    "$0" unit
    ;;
  full)
    "$0" verify
    not_run full 'Run integration, live, devbox, macbook, platform, and product separately after explicit approval for each external boundary'
    ;;
  '')
    printf 'usage: %s {static|unit|verify|full|platform --allow-device-mutation|product --allow-device-mutation --allow-two-host-read-only-tmux --allow-macbook-service-restart|{integration|live} --allow-isolated-tmux-mutation|devbox --allow-live-devbox-publication|macbook --allow-live-macbook-publication}\n' "$0" >&2
    exit 64
    ;;
  *)
    printf 'unknown test gate: %s\n' "$gate" >&2
    exit 64
    ;;
esac
