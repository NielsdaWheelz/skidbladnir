        rm -f "$provision_input" || exit_code=1
      fi
      exit "$exit_code"
    }
    trap cleanup_provision EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    python3 - "$provision_input" \
      "$devbox_handle" "$devbox_origin" "$devbox_bearer_file" \
      "$macbook_handle" "$macbook_origin" "$macbook_bearer_file" <<'PY'
import base64
import json
import os
import re
import sys

output, devbox_handle, devbox_origin, devbox_bearer_path, macbook_handle, macbook_origin, macbook_bearer_path = sys.argv[1:]


def bearer(path: str) -> str:
    with open(path, encoding="ascii") as source:
        value = source.read().rstrip("\n")
    if not re.fullmatch(r"[A-Za-z0-9_-]{43}", value):
        raise SystemExit("gateway bearer is not canonical")
    decoded = base64.urlsafe_b64decode(value + "=")
    if len(decoded) != 32 or base64.urlsafe_b64encode(decoded).decode("ascii").rstrip("=") != value:
        raise SystemExit("gateway bearer is not canonical")
    return value


devbox_bearer = bearer(devbox_bearer_path)
macbook_bearer = bearer(macbook_bearer_path)
if devbox_bearer == macbook_bearer:
    raise SystemExit("gateway bearers must be distinct")
payload = {
    "machines": [
        {"handle": devbox_handle, "label": "Devbox", "origin": devbox_origin, "bearer": devbox_bearer},
        {"handle": macbook_handle, "label": "MacBook", "origin": macbook_origin, "bearer": macbook_bearer},
    ]
}
descriptor = os.open(output, os.O_WRONLY | os.O_TRUNC, 0o600)
with os.fdopen(descriptor, "w", encoding="utf-8") as destination:
    json.dump(payload, destination, separators=(",", ":"), sort_keys=True)
PY
    provision_staged=1
    python3 - "$adb" "$serial" "$provision_input" <<'PY'
import subprocess
import sys

adb, serial, input_path = sys.argv[1:]
with open(input_path, "rb") as source:
    subprocess.run(
        [
            adb,
            "-s",
            serial,
            "shell",
            "run-as dev.niels.skidbladnir sh -c 'umask 077; "
            "cat > cache/skidbladnir-machine-provisioning.json'",
        ],
        stdin=source,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=True,
        timeout=20,
    )
PY
    rm -f "$provision_input"
    provision_input=''
