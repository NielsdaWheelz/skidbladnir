    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run provider-live \
        'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_PROVIDER_LIVE_TESTS:-}" != 'provider-live-v1' ]]; then
      not_run provider-live \
        'Set SKIDBLADNIR_ALLOW_PROVIDER_LIVE_TESTS=provider-live-v1 after explicitly approving real provider launches'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run provider-live 'Provider-live proof refuses an invoking tmux client'
    fi
    if [[ ! -x "$tmux_path" ]]; then
      not_run provider-live "Configured ${tmux_path} is unavailable on the target host"
    fi
    provider_live_release_tag="${SKIDBLADNIR_PROVIDER_LIVE_RELEASE_TAG:-}"
    provider_live_source_sha="${SKIDBLADNIR_PROVIDER_LIVE_SOURCE_SHA:-}"
    if [[ -z "$provider_live_release_tag" || -z "$provider_live_source_sha" ]]; then
      not_run provider-live \
        'Set SKIDBLADNIR_PROVIDER_LIVE_RELEASE_TAG and SKIDBLADNIR_PROVIDER_LIVE_SOURCE_SHA to the exact installed candidate'
    fi
    cd "$repo_dir"
    run provider-live-harness go test -tags='integration providerlive' ./tests/integration \
      -run '^(TestProviderLiveLaunchersEnforceOfflineInputBoundary|TestProviderLiveFailClosedScriptsTerminateOwnedProcessGroup)$' -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1 \
      -skidbladnir-tmux-path="$tmux_path"
    run installed-provider-identity go test -tags='integration providerlive' ./tests/integration \
      -run '^TestInstalledProviderHooksProjectTheApprovedPlatformSample$' -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1 \
      -skidbladnir-tmux-path="$tmux_path" \
      -skidbladnir-provider-live-capability=provider-live-cli-v1 \
      -skidbladnir-provider-live-release-tag="$provider_live_release_tag" \
      -skidbladnir-provider-live-source-sha="$provider_live_source_sha"
    ;;
  platform)
    if [[ "${1:-}" != '--allow-device-mutation' || "$#" -ne 1 ]]; then
      not_run platform 'Pass --allow-device-mutation only after explicit current-turn user approval'
    fi
    platform_declared_release_apk="${SKIDBLADNIR_RELEASE_APK:-}"
    platform_dev_checkout="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    if [[ ! -f "$platform_declared_release_apk" || -L "$platform_declared_release_apk" ]]; then
      not_run platform 'Set SKIDBLADNIR_RELEASE_APK to the regular pinned release APK'
    fi
    platform_release_snapshot="$(android_platform_create_release_snapshot)" ||
      not_run platform 'Could not create the private Android release recovery boundary'
    platform_release_snapshot_dir="${platform_release_snapshot%/*}"
    platform_release_apk="$platform_release_snapshot"
    platform_adb=''
    platform_serial=''
    platform_app_package=''
    platform_test_package=''
    platform_test_package_installed=0
    platform_app_replaced=0
    platform_instrumentation_output_file=''
    trap android_platform_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    install -m 0600 "$platform_declared_release_apk" "$platform_release_apk"
    platform_release_values="$(
      android_platform_release_values \
        "$platform_dev_checkout" "$platform_release_apk" "$repo_dir"
    )" || not_run platform \
      'Release APK, committed dev-server pin, APK metadata, and clean exact source SHA must agree'
    IFS=$'\t' read -r platform_expected_apk_digest _platform_release_version \
      platform_version_name platform_version_code _platform_source_sha \
      <<<"$platform_release_values"
    run android-signing-preflight env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" --config-only
    run android-platform-release-signature \
      "$repo_dir/scripts/check-android-signing" --public-apk "$platform_release_apk"
    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run platform 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run platform 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run platform 'Connected device is not SM-S906W on API 36'
    fi
    app_package='dev.niels.skidbladnir'
    test_package='dev.niels.skidbladnir.test'
    app_apk="$repo_dir/android/app/build/outputs/apk/deviceDebug/app-deviceDebug.apk"
    test_apk="$repo_dir/android/app/build/outputs/apk/androidTest/deviceDebug/app-deviceDebug-androidTest.apk"
    platform_adb="$adb"
    platform_serial="$serial"
    platform_app_package="$app_package"
    platform_test_package="$test_package"
    platform_instrumentation_output_file="$(mktemp -t skidbladnir-platform-installed.XXXXXX)"
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" '' "$platform_instrumentation_output_file" ||
      not_run platform 'The S22+ must begin with an installation carrying the pinned signing identity'
    IFS=$'\t' read -r platform_installed_apk_digest platform_installed_version_code \
      <"$platform_instrumentation_output_file"
    /bin/unlink "$platform_instrumentation_output_file"
    platform_instrumentation_output_file=''
    existing_test_package="$(optional_installed_android_package_path \
      "$adb" "$serial" "$test_package")" ||
      not_run platform 'Could not inspect the optional test-only Android package'
    if [[ "$platform_installed_apk_digest" == "$platform_expected_apk_digest" ]]; then
      if [[ -n "$existing_test_package" ]]; then
        not_run platform 'The test-only Android package must be absent before this gate owns it'
      fi
    elif [[ "$platform_installed_version_code" == "$platform_version_code" ]]; then
      platform_app_replaced=1
      if [[ -n "$existing_test_package" ]]; then
        if ! installed_android_package_path "$existing_test_package" >/dev/null ||
          ! verify_installed_android_signer "$adb" "$serial" "$test_package"; then
          run android-platform-interrupted-app-restore android_platform_restore_owned_state
          not_run platform 'A pre-existing test package does not carry the pinned signing identity'
        fi
        platform_test_package_installed=1
      fi
      run android-platform-interrupted-restore android_platform_restore_owned_state
      printf 'Recovered an interrupted same-version platform run to the exact pinned release\n'
    else
      not_run platform 'The S22+ must carry the exact pinned release; run product first'
    fi
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" "$platform_expected_apk_digest" || {
      printf 'The S22+ does not carry the exact pinned release after platform recovery\n' >&2
      exit 1
    }
    "$adb" -s "$serial" shell input keyevent KEYCODE_WAKEUP >/dev/null
    "$adb" -s "$serial" shell wm dismiss-keyguard >/dev/null
    if "$adb" -s "$serial" shell dumpsys window policy | grep -q 'mIsShowing=true'; then
      not_run platform 'Connected Android device must be awake and unlocked'
    fi
    cd "$repo_dir/android"
    run android-platform-build env ANDROID_HOME="$android_sdk" \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" ./gradlew \
      -Pskidbladnir.android.testBuildType=deviceDebug \
      -Pskidbladnir.versionName="$platform_version_name" \
      -Pskidbladnir.versionCode="$platform_version_code" \
      :app:assembleDeviceDebug :app:assembleDeviceDebugAndroidTest --no-daemon
    run android-platform-signatures env SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" "$app_apk" "$test_apk"
    android_platform_companion_matches_release \
      "$app_apk" "$platform_expected_apk_digest" \
      "$platform_version_name" "$platform_version_code" || {
      printf 'Android platform build is not a byte-distinct same-version release companion\n' >&2
      exit 1
    }
    platform_app_replaced=1
    run android-platform-app "$adb" -s "$serial" install -r -t "$app_apk"
    pairing_preferences='shared_prefs/skidbladnir.machines.xml'
    # The product gate owns release-to-release installation preservation. Once
    # deviceDebug is installed, this digest owns the instrumentation boundary.
    "$adb" -s "$serial" shell run-as "$app_package" ls "$pairing_preferences" >/dev/null 2>&1 || {
      printf 'Android platform instrumentation requires the product-proven encrypted fleet\n' >&2
      exit 1
    }
    pairing_digest="$(
      "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
        content_digest
    )"
    [[ "$pairing_digest" =~ ^[0-9a-f]{64}$ ]] || {
      printf 'Android platform pairing digest is invalid\n' >&2
      exit 1
    }
    platform_test_package_installed=1
    run android-platform-tests "$adb" -s "$serial" install -r -t "$test_apk"
    instrumentation_status=0
    platform_instrumentation_output_file="$(mktemp -t skidbladnir-platform.XXXXXX)"
    run_bounded_to_file "$android_instrumentation_timeout_seconds" "$platform_instrumentation_output_file" \
      "$adb" -s "$serial" shell am instrument -r -w \
      "${test_package}/androidx.test.runner.AndroidJUnitRunner" || instrumentation_status=$?
    instrumentation_output="$(<"$platform_instrumentation_output_file")"
    printf '%s\n' "$instrumentation_output"
    # Pin discovery to the checked-in suite so partial instrumentation cannot
    # false-green as a complete platform gate.
    platform_expected_tests="$(grep -c '@Test' \
      "$repo_dir"/android/app/src/androidTest/java/dev/niels/skidbladnir/*.kt | \
      awk -F: '{ total += $2 } END { print total }')"
    if ! assert_complete_instrumentation android-platform "$platform_expected_tests" \
      "$instrumentation_status" "$platform_instrumentation_output_file"; then
      printf 'Android instrumentation failed, skipped, or did not pass exactly %s tests\n' \
        "$platform_expected_tests" >&2
      exit 1
    fi
    /bin/unlink "$platform_instrumentation_output_file"
    platform_instrumentation_output_file=''
    current_pairing_digest="$(
      "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
        content_digest
    )"
    [[ "$current_pairing_digest" == "$pairing_digest" ]] || {
      printf 'Android instrumentation changed the encrypted pairing state\n' >&2
      exit 1
    }
    run android-platform-restore android_platform_restore_owned_state
    android_platform_remove_release_snapshot
    trap - EXIT HUP INT TERM
    run android-platform-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  product)
    if [[ "${1:-}" != '--allow-device-mutation' ||
      "${2:-}" != '--allow-three-host-inventory-reconciliation' ||
      "${3:-}" != '--allow-one-host-service-restart' ||
      "${4:-}" != '--allow-terminal-open-detach' || "$#" -ne 4 ]]; then
      not_run product 'Pass the device, bounded three-host inventory-reconciliation, one-host restart, and terminal open/detach capabilities only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_THREE_HOST_PRODUCT_JOURNEY:-}" != 'three-host-product-v1' ||
      "${SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE:-}" != 'one-host-outage-v1' ||
      "${SKIDBLADNIR_ALLOW_TERMINAL_PRODUCT_JOURNEY:-}" != 'terminal-open-detach-v1' ]]; then
      not_run product 'Set the exact product, one-host-outage, and terminal open/detach capabilities after explicit current-turn approval'
    fi
    if [[ "$(uname -s)" != 'Darwin' ]]; then
      not_run product 'The physical three-host outage journey must run on the MacBook'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run product 'The three-host journey refuses inherited tmux socket state'
    fi

    release_apk="${SKIDBLADNIR_RELEASE_APK:-}"
    dev_server_checkout="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    fleet_operator="$dev_server_checkout/skidbladnir"
    if [[ ! -f "$release_apk" || -L "$release_apk" ]]; then
      not_run product 'Set SKIDBLADNIR_RELEASE_APK to the regular signed release APK'
    fi
    if [[ ! -x "$fleet_operator" ]]; then
      not_run product 'Set SKIDBLADNIR_DEV_SERVER_CHECKOUT to a checkout with the fleet operator'
    fi
    if ! android_release_matches_pin "$dev_server_checkout" "$release_apk"; then
      not_run product 'Release APK does not match the complete published dev-server release pin'
    fi
    release_values="$(pinned_android_release_values "$dev_server_checkout")"
    IFS=$'\t' read -r expected_apk_digest _signer_asset_digest release_version \
      <<<"$release_values"
    run android-signing-preflight env \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" --config-only
    run release-apk-signature env \
      SKIDBLADNIR_ANDROID_SIGNING_CONFIG="$android_signing_config" \
      "$repo_dir/scripts/check-android-signing" "$release_apk"

    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run product 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run product 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != 'SM-S906W' || "$api" != '36' ]]; then
      not_run product 'Connected device is not SM-S906W on API 36'
    fi

    app_package='dev.niels.skidbladnir'
    baseline_lifetime=''
    after_lifetime=''
    service_restore_required=''
    terminal_cleanup_required=''
    preupdate_evidence=''
    physical_confirmation() {
      local expected="$1"
      local prompt="$2"
      local response=''
      printf '%s\nType %s to confirm: ' "$prompt" "$expected"
      IFS= read -r response
      [[ "$response" == "$expected" ]] || {
        printf 'Physical product confirmation was not accepted.\n' >&2
        return 1
      }
    }
    fleet_lifetime_valid() {
      awk '
        BEGIN { valid = 1 }
        NR == 1 && NF == 2 && $1 == "Local" && $2 ~ /^[0-9a-f]{64}$/ { next }
        NR == 2 && NF == 2 && $1 == "DevServer" && $2 ~ /^[0-9a-f]{64}$/ { next }
        NR == 3 && NF == 2 && $1 == "Arch" && $2 ~ /^[0-9a-f]{64}$/ { next }
        { valid = 0 }
        END { exit valid && NR == 3 ? 0 : 1 }
      '
    }
    restore_product_gateway() {
      if [[ -n "$service_restore_required" ]]; then
        "$fleet_operator" recover Local || return
        service_restore_required=''
      fi
    }
    close_product_terminal() {
      if [[ -n "$terminal_cleanup_required" ]]; then
        "$adb" -s "$serial" shell am force-stop "$app_package" >/dev/null || return
        terminal_cleanup_required=''
      fi
    }
    cleanup_product() {
      local exit_status=$?
      trap - EXIT HUP INT TERM
      if [[ -n "$preupdate_evidence" && -f "$preupdate_evidence" &&
        ! -L "$preupdate_evidence" ]]; then
        /bin/unlink "$preupdate_evidence" || exit_status=1
      fi
      close_product_terminal || exit_status=1
      restore_product_gateway || exit_status=1
      exit "$exit_status"
    }
    trap cleanup_product EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    run fleet-doctor "$fleet_operator" doctor
    baseline_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    printf '%s\n' "$baseline_lifetime" | fleet_lifetime_valid || {
      printf 'Fleet operator returned invalid lifetime evidence.\n' >&2
      exit 1
    }

    installed_path="$("$adb" -s "$serial" shell pm path "$app_package" | tr -d '\r')"
    if [[ "$installed_path" != package:* || "$installed_path" == *$'\n'* ]]; then
      not_run product \
        'The S22+ must begin with an existing signed installation and connected fleet so update preservation can be proved'
    fi
    preupdate_evidence="$(mktemp -t skidbladnir-preupdate.XXXXXX)"
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" '' "$preupdate_evidence" || {
      printf 'Pre-update app does not carry the pinned production signing identity.\n' >&2
      exit 1
    }
    IFS=$'\t' read -r installed_apk_digest installed_version_code \
      <"$preupdate_evidence"
    candidate_version_code="$(android_apk_version_code "$release_apk")" || {
      printf 'Candidate release APK has no valid version code.\n' >&2
      exit 1
    }
    android_update_candidate_is_distinct_newer \
      "$installed_apk_digest" "$installed_version_code" \
      "$expected_apk_digest" "$candidate_version_code" || {
      printf 'Candidate APK must be byte-distinct and newer than the installed signed release.\n' >&2
      exit 1
    }
    /bin/unlink "$preupdate_evidence"
    preupdate_evidence=''
    run android-preupdate-launch "$adb" -s "$serial" shell am start -n \
      "${app_package}/.MainActivity"
    physical_confirmation PREUPDATE_FLEET \
      'Confirm that the existing app renders Arch, Devbox, and MacBook before the update.'

    run release-apk-install "$adb" -s "$serial" install -r "$release_apk"
    installed_path="$("$adb" -s "$serial" shell pm path "$app_package" | tr -d '\r')"
    [[ "$installed_path" == package:* && "$installed_path" != *$'\n'* ]] || {
      printf 'Release APK is not installed as the production package.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" "$expected_apk_digest" || {
      printf 'Installed release APK does not match the pinned digest and signing identity.\n' >&2
      exit 1
    }
    run android-product-launch "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    physical_confirmation UPDATE_PRESERVED \
      "Confirm that $release_version opens with the same Arch, Devbox, and MacBook fleet before a new invite."
    printf '%s\n' 'On the S22+, tap Reconnect fleet, then scan the fresh QR below.'
    run fleet-invite "$fleet_operator" invite
    physical_confirmation RECONNECTED \
      'Confirm that All renders no pressure rails. Select Arch, Devbox, and MacBook one at a time; exactly the selected machine renders its compact rail, and that rail opens only its own details with CPU, status words, and evaluated or NO DATA evidence. No details sheet shows Unsupported or a second history band.'
    terminal_cleanup_required=1
    physical_confirmation TERMINAL_UNOBSTRUCTED \
      'Open an existing tmux session on one machine, confirm its terminal viewport and key deck remain usable, detach and return to the dashboard, then confirm that machine remains selected and its pressure rail and details remain tappable.'
    run android-product-force-stop "$adb" -s "$serial" shell am force-stop "$app_package"
    terminal_cleanup_required=''
    run android-product-recreate "$adb" -s "$serial" shell am start -n \
      "${app_package}/.MainActivity"
    physical_confirmation PROCESS_RESTORED \
      'Confirm that process recreation restores the same three fleet identities and machine-bound routing; All has no pressure rails, and each machine filter reveals only its own rail.'

    physical_confirmation OUTAGE_ARMED \
      'Select MacBook, open one existing session Kill confirmation, verify Confirm is enabled, and leave the confirmation open without activating it.'
    service_restore_required=1
    run one-host-outage "$fleet_operator" outage Local
    physical_confirmation OUTAGE_FENCED \
      'Confirm the open MacBook Kill action becomes disabled while Cancel remains available, then dismiss it. All keeps the MacBook exception notice and no pressure rails; MacBook Kill stays disabled and New dwarf stays visually cold and disabled with stale retained pressure or a header-only unavailable rail; Arch and Devbox remain fresh, actionable, and render only their own pressure.'
    run one-host-recovery "$fleet_operator" recover Local
    service_restore_required=''
    run recovered-fleet-doctor "$fleet_operator" doctor
    physical_confirmation RECOVERED \
      'Confirm that Arch, Devbox, and MacBook all return to fresh pressure under their own filters, remain bound to their original labels, and leave All free of pressure rails.'

    after_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    printf '%s\n' "$after_lifetime" | fleet_lifetime_valid || {
      printf 'Fleet operator returned invalid recovery lifetime evidence.\n' >&2
      exit 1
    }
    [[ "$after_lifetime" == "$baseline_lifetime" ]] || {
      printf 'The product journey changed a host tmux lifetime inventory.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" "$app_package" "$expected_apk_digest" || {
      printf 'Installed release digest or signing identity changed during the journey.\n' >&2
      exit 1
    }
    trap - EXIT HUP INT TERM
    run android-product-leave-open "$adb" -s "$serial" shell am start -n "${app_package}/.MainActivity"
    ;;
  second-phone)
    if [[ "${1:-}" != '--allow-device-mutation' ||
      "${2:-}" != '--allow-three-host-inventory-reconciliation' || "$#" -ne 2 ]]; then
      not_run second-phone 'Pass the device and bounded three-host inventory-reconciliation capabilities only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_SECOND_PHONE_PRODUCT_JOURNEY:-}" != 'second-phone-product-v1' ]]; then
      not_run second-phone 'Set the exact second-phone capability after explicit current-turn approval'
    fi
    if [[ "$(uname -s)" != 'Darwin' ]]; then
      not_run second-phone 'The second-phone distribution journey must run on the MacBook'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run second-phone 'The second-phone journey refuses inherited tmux socket state'
    fi

    second_phone_model="${SKIDBLADNIR_SECOND_PHONE_MODEL:-}"
    if [[ -z "$second_phone_model" || "$second_phone_model" == 'SM-S906W' ||
      ! "$second_phone_model" =~ ^[A-Za-z0-9._+-]{1,64}$ ]]; then
      not_run second-phone 'Name the non-S22+ API 36 phone in SKIDBLADNIR_SECOND_PHONE_MODEL'
    fi
    dev_server_checkout="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    fleet_operator="$dev_server_checkout/skidbladnir"
    if [[ ! -x "$fleet_operator" ]]; then
      not_run second-phone 'Set SKIDBLADNIR_DEV_SERVER_CHECKOUT to a checkout with the fleet operator'
    fi
    release_values="$(pinned_android_release_values "$dev_server_checkout")" ||
      not_run second-phone 'The complete published dev-server release pin is unavailable'
    IFS=$'\t' read -r expected_apk_digest expected_signer_asset_digest release_version \
      <<<"$release_values"
    if [[ "$(content_digest <"$repo_dir/android/app-signing-cert.sha256")" != "$expected_signer_asset_digest" ]]; then
      not_run second-phone 'The dev-server signer asset pin differs from this source signer pin'
    fi
    public_apk_url="https://github.com/NielsdaWheelz/skidbladnir/releases/download/$release_version/skidbladnir-android.apk"

    adb="$android_sdk/platform-tools/adb"
    if [[ ! -x "$adb" ]]; then
      not_run second-phone 'Pinned Android SDK adb is unavailable'
    fi
    devices=()
    while IFS= read -r device; do
      devices+=("$device")
    done < <("$adb" devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    if [[ "${#devices[@]}" -ne 1 ]]; then
      not_run second-phone 'Exactly one connected Android device is required'
    fi
    serial="${devices[0]}"
    model="$("$adb" -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    api="$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ "$model" != "$second_phone_model" || "$api" != '36' ]]; then
      not_run second-phone 'Connected device does not match the named API 36 second phone'
    fi
    if [[ -n "$("$adb" -s "$serial" shell pm path dev.niels.skidbladnir | tr -d '\r\n')" ]]; then
      not_run second-phone 'The named second phone must begin without Skíðblaðnir installed'
    fi

    run fleet-doctor "$fleet_operator" doctor
    baseline_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    printf '%s\n' "$baseline_lifetime" | awk '
      BEGIN { valid = 1 }
      NR == 1 && NF == 2 && $1 == "Local" && $2 ~ /^[0-9a-f]{64}$/ { next }
      NR == 2 && NF == 2 && $1 == "DevServer" && $2 ~ /^[0-9a-f]{64}$/ { next }
      NR == 3 && NF == 2 && $1 == "Arch" && $2 ~ /^[0-9a-f]{64}$/ { next }
      { valid = 0 }
      END { exit valid && NR == 3 ? 0 : 1 }
    ' || {
      printf 'Fleet operator returned invalid lifetime evidence.\n' >&2
      exit 1
    }

    printf 'Opening the exact public GitHub APK: %s\n' "$public_apk_url"
    run second-phone-public-download "$adb" -s "$serial" shell am start \
      -a android.intent.action.VIEW -d "$public_apk_url"
    printf '%s\n' \
      'On the phone, complete the browser download and Android package installation from this URL.'
    printf '%s' 'Type PUBLIC_APK_INSTALLED after Android reports installation complete: '
    IFS= read -r confirmation
    [[ "$confirmation" == 'PUBLIC_APK_INSTALLED' ]] || {
      printf 'Public APK installation confirmation was not accepted.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" dev.niels.skidbladnir "$expected_apk_digest" || {
      printf 'Installed APK does not match the public release digest and signing identity.\n' >&2
      exit 1
    }
    run second-phone-launch "$adb" -s "$serial" shell am start -n \
      'dev.niels.skidbladnir/.MainActivity'
    printf '%s\n' 'On the named second phone, sign in to Tailscale, tap Connect, then scan the QR below.'
    run second-phone-invite "$fleet_operator" invite
    printf '%s\n' \
      'Confirm that this newly installed app renders Arch, Devbox, and MacBook and each can be selected.'
    printf '%s' 'Type SECOND_PHONE_CONNECTED to confirm: '
    IFS= read -r confirmation
    [[ "$confirmation" == 'SECOND_PHONE_CONNECTED' ]] || {
      printf 'Second-phone physical confirmation was not accepted.\n' >&2
      exit 1
    }

    after_lifetime="$("$fleet_operator" reconcile-lifetime-digests)"
    [[ "$after_lifetime" == "$baseline_lifetime" ]] || {
      printf 'The second-phone journey changed a host tmux lifetime inventory.\n' >&2
      exit 1
    }
    verify_installed_android_signer \
      "$adb" "$serial" dev.niels.skidbladnir "$expected_apk_digest" || {
      printf 'Installed release digest or signing identity changed during the journey.\n' >&2
      exit 1
    }
    run second-phone-leave-open "$adb" -s "$serial" shell am start -n \
      'dev.niels.skidbladnir/.MainActivity'
    ;;
  live)
    if [[ "${1:-}" != '--allow-isolated-tmux-mutation' || "$#" -ne 1 ]]; then
      not_run live 'Pass --allow-isolated-tmux-mutation only after explicit current-turn user approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS:-}" != 'isolated-v1' ]]; then
      not_run live 'Set SKIDBLADNIR_ALLOW_ISOLATED_TMUX_TESTS=isolated-v1 after explicitly approving tmux tests'
    fi
    if [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" || -n "${TMUX_TMPDIR:-}" ]]; then
      not_run live 'Live tmux proofs refuse an invoking tmux client'
    fi
    if [[ "$(uname -s)" != 'Linux' ]]; then
      not_run live 'The grouped-session proof is Linux-only; use integration for cross-host tmux acceptance'
    fi
    if [[ ! -x "$tmux_path" ]]; then
      not_run live "Configured ${tmux_path} is unavailable on the target host"
    fi
    cd "$repo_dir"
    run grouped-tmux go test -tags=live ./tests/live \
      -run '^(TestTmuxGroupedBehavior|TestRegisteredLiveTmuxCommandRejectsSecondarySocketSelectors)$' -count=1 -args \
      -skidbladnir-isolated-tmux-capability=isolated-cli-v1
    ;;
  release)
    if [[ "${1:-}" != '--allow-release-verification' || -z "${2:-}" || "$#" -ne 2 ]]; then
      not_run release 'Pass --allow-release-verification TAG only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_RELEASE_VERIFICATION:-}" != 'signed-assets-v1' ]]; then
      not_run release 'Set SKIDBLADNIR_ALLOW_RELEASE_VERIFICATION=signed-assets-v1 after explicitly approving the signed release build'
    fi
    release_tag="$2"
    release_source_evidence="$("$repo_dir/scripts/check-release-source" "$release_tag")" ||
      not_run release 'Public-repository, exact-main, unused-tag, or exact-SHA hosted verify evidence is unavailable'
    IFS=$'\t' read -r release_sha release_run_id <<<"$release_source_evidence"
    [[ "$release_sha" =~ ^[0-9a-f]{40}$ && "$release_run_id" =~ ^[0-9]+$ ]] || {
      printf 'Release source preflight returned invalid evidence.\n' >&2
      exit 1
    }
    release_staging="$(mktemp -d /tmp/skidbladnir-release-gate.XXXXXX)"
    case "$release_staging" in
      /tmp/skidbladnir-release-gate.* | /private/tmp/skidbladnir-release-gate.*) ;;
      *) printf 'Unexpected release-gate staging directory\n' >&2; exit 1 ;;
    esac
    trap 'rm -R -- "$release_staging"' EXIT HUP INT TERM
    run signed-release-assets "$repo_dir/scripts/build" release-assets \
      "$release_tag" "$release_sha" "$release_staging/assets"
    ;;
  published-release)
    if [[ "${1:-}" != '--allow-public-release-read' || -z "${2:-}" ||
      -z "${3:-}" || "$#" -ne 3 ]]; then
      not_run published-release \
        'Pass --allow-public-release-read TAG SOURCE_SHA only after explicit current-turn approval'
    fi
    if [[ "${SKIDBLADNIR_ALLOW_PUBLIC_RELEASE_READ:-}" != 'public-release-v1' ]]; then
      not_run published-release \
        'Set SKIDBLADNIR_ALLOW_PUBLIC_RELEASE_READ=public-release-v1 after explicit approval'
    fi
    published_tag="$2"
    published_sha="$3"
    "$repo_dir/scripts/check-release" --android-version "$published_tag" >/dev/null || {
      printf 'Published release tag is not canonical.\n' >&2
      exit 1
    }
    [[ "$published_sha" =~ ^[0-9a-f]{40}$ ]] || {
      printf 'Published release source must be one exact lowercase SHA.\n' >&2
      exit 1
    }
    for command in gh git jq; do
      command -v "$command" >/dev/null ||
        not_run published-release "Required public-release command is unavailable: $command"
    done
    gh auth status >/dev/null 2>&1 ||
      not_run published-release 'GitHub authentication is unavailable'
    published_repo='NielsdaWheelz/skidbladnir'
    [[ "$(gh repo view "$published_repo" --json nameWithOwner,visibility \
      --jq '[.nameWithOwner,.visibility] | join(" ")')" == "$published_repo PUBLIC" ]] || {
      printf 'Published-release repository is not the exact public repository.\n' >&2
      exit 1
    }
    published_metadata="$(gh release view "$published_tag" --repo "$published_repo" \
      --json tagName,targetCommitish,isDraft,isPrerelease,isImmutable,assets,body)" ||
      not_run published-release 'The named public release is unavailable'
    jq -e --arg tag "$published_tag" --arg sha "$published_sha" '
      .tagName == $tag and .targetCommitish == $sha and
      .isDraft == false and .isPrerelease == false and .isImmutable == true and
      (.body | contains("Source: `" + $sha + "`") and
        contains("## Install") and contains("## Assets") and
        contains("## Known limits")) and
      ([.assets[].name] | sort) == [
        "SHA256SUMS",
        "android-signing-cert.sha256",
        "skidbladnir-android.apk",
        "skidbladnir-darwin-arm64.tar.gz",
        "skidbladnir-linux-amd64.tar.gz"
      ]
    ' <<<"$published_metadata" >/dev/null || {
      printf 'Public release is not immutable, final, exact-SHA, and exact-five-assets.\n' >&2
      exit 1
    }
    remote_tags="$(git ls-remote --tags "https://github.com/$published_repo.git" \
      "refs/tags/$published_tag" "refs/tags/$published_tag^{}")"
    remote_tag_sha="$(awk -v base="refs/tags/$published_tag" \
      '$2 == base { direct = $1 } $2 == base "^{}" { peeled = $1 }
       END { print (peeled != "" ? peeled : direct) }' <<<"$remote_tags")"
    [[ "$remote_tag_sha" == "$published_sha" ]] || {
      printf 'Public Git tag does not resolve to the declared exact source SHA.\n' >&2
      exit 1
    }
    published_staging="$(mktemp -d /tmp/skidbladnir-published-release.XXXXXX)"
    case "$published_staging" in
      /tmp/skidbladnir-published-release.* | /private/tmp/skidbladnir-published-release.*) ;;
      *) printf 'Unexpected published-release staging directory\n' >&2; exit 1 ;;
    esac
    trap 'rm -R -- "$published_staging"' EXIT HUP INT TERM
    published_source="$published_staging/source"
    published_assets="$published_staging/assets"
    mkdir "$published_assets"
    run public-release-source env \
      GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
      git clone --quiet --depth 1 --single-branch \
      --branch "$published_tag" "https://github.com/$published_repo.git" \
      "$published_source"
    [[ "$(git -C "$published_source" rev-parse HEAD)" == "$published_sha" &&
      -z "$(git -C "$published_source" status --porcelain=v1 --untracked-files=all)" &&
      "$(git -C "$published_source" config --get remote.origin.url)" == \
        "https://github.com/$published_repo.git" ]] || {
      printf 'Public release source checkout is not the clean exact published SHA.\n' >&2
      exit 1
    }
    "$published_source/scripts/check-release" --android-version "$published_tag" \
      >/dev/null || {
      printf 'Exact public source rejects the published release tag.\n' >&2
      exit 1
    }
    run public-release-download gh release download "$published_tag" \
      --repo "$published_repo" --dir "$published_assets"
    run public-release-assets "$published_source/scripts/check-release" \
      --public-assets "$published_assets" "$published_tag" "$published_sha"
    published_declared_dev_server="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-/Users/nnandal/Documents/code/dev-server}"
    published_dev_server="$(cd "$published_declared_dev_server" && pwd -P)" || {
      printf 'Published release requires an available dev-server checkout.\n' >&2
      exit 1
    }
    published_pin_relative='assets/skidbladnir/release-pin.json'
    published_pin="$published_dev_server/$published_pin_relative"
    [[ -f "$published_pin" && ! -L "$published_pin" ]] || {
      printf 'Published release requires one regular dev-server release pin.\n' >&2
      exit 1
    }
    [[ "$(git -C "$published_dev_server" rev-parse --show-toplevel)" == \
        "$published_dev_server" ]] || {
      printf 'Published release requires the root of one dev-server Git checkout.\n' >&2
      exit 1
    }
    case "$(git -C "$published_dev_server" remote get-url origin)" in
      git@github.com:NielsdaWheelz/dev-server.git | \
        https://github.com/NielsdaWheelz/dev-server.git) ;;
      *)
        printf 'Published release requires the canonical dev-server origin.\n' >&2
        exit 1
        ;;
    esac
    if ! git -C "$published_dev_server" cat-file -e \
      "HEAD:$published_pin_relative" 2>/dev/null ||
      ! git -C "$published_dev_server" diff --quiet HEAD -- \
        "$published_pin_relative" ||
      ! cmp -s "$published_pin" \
        <(git -C "$published_dev_server" show "HEAD:$published_pin_relative"); then
      printf 'dev-server release pin must be tracked and byte-exact at its current HEAD.\n' >&2
      exit 1
    fi
    published_expected_pin="$(
      jq -nS \
        --arg version "$published_tag" \
        --arg sourceSha "$published_sha" \
        --arg androidApkSha256 "$(awk '$2 == "skidbladnir-android.apk" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg androidSigningCertAssetSha256 "$(awk '$2 == "android-signing-cert.sha256" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg darwinArm64Sha256 "$(awk '$2 == "skidbladnir-darwin-arm64.tar.gz" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg linuxAmd64Sha256 "$(awk '$2 == "skidbladnir-linux-amd64.tar.gz" { print $1 }' "$published_assets/SHA256SUMS")" \
        --arg sha256SumsAssetSha256 "$("${digest_command[@]}" "$published_assets/SHA256SUMS" | awk '{ print $1 }')" \
        '{
          androidApkSha256: $androidApkSha256,
          androidSigningCertAssetSha256: $androidSigningCertAssetSha256,
          darwinArm64Sha256: $darwinArm64Sha256,
          linuxAmd64Sha256: $linuxAmd64Sha256,
          sha256SumsAssetSha256: $sha256SumsAssetSha256,
          sourceSha: $sourceSha,
          version: $version
        }'
    )"
    cmp -s "$published_pin" <(printf '%s\n' "$published_expected_pin") || {
      printf 'dev-server does not pin the exact public tag, source, and all five asset digests.\n' >&2
      exit 1
    }
    published_body="$(jq -r '.body' <<<"$published_metadata")"
    # shellcheck disable=SC2016 # Backticks are literal release-note Markdown.
    published_run_id="$(sed -n 's/^- Verify run: `\([1-9][0-9]*\)`$/\1/p' \
      <<<"$published_body")"
    [[ "$published_run_id" =~ ^[1-9][0-9]*$ ]] || {
      printf 'Public release notes do not identify exactly one hosted verify run.\n' >&2
      exit 1
    }
    published_verify_run="$(gh run view "$published_run_id" \
      --repo "$published_repo" \
      --json headSha,conclusion,status,workflowName)" ||
      not_run published-release 'The release-noted hosted verify run is unavailable'
    jq -e --arg sha "$published_sha" '
      .headSha == $sha and .workflowName == "verify" and
      .status == "completed" and .conclusion == "success"
    ' <<<"$published_verify_run" >/dev/null || {
      printf 'Release-noted hosted verify run is not successful for the exact source SHA.\n' >&2
      exit 1
    }
    published_expected_body="$(
      "$published_source/scripts/render-release-notes" \
        "$published_tag" "$published_sha" "$published_run_id" "$published_assets"
    )" || {
      printf 'Exact public source could not render release notes from the assets.\n' >&2
      exit 1
    }
    [[ "$published_body" == "$published_expected_body" ]] || {
      printf 'Public release notes differ from the exact-source deterministic contract.\n' >&2
      exit 1
    }
    ;;
  verify)
    "$0" static
    "$repo_dir/scripts/build"
    "$0" unit
    ;;
  full)
    "$0" verify
    not_run full 'Run release, published-release, integration, provider-live, live, platform, product, and second-phone separately after explicit approval for each external boundary'
    ;;
  '')
    printf 'usage: %s {static|unit|verify|full|release --allow-release-verification TAG|published-release --allow-public-release-read TAG SOURCE_SHA|platform --allow-device-mutation|product --allow-device-mutation --allow-three-host-inventory-reconciliation --allow-one-host-service-restart --allow-terminal-open-detach|second-phone --allow-device-mutation --allow-three-host-inventory-reconciliation|{integration|live} --allow-isolated-tmux-mutation|provider-live --allow-isolated-tmux-mutation --allow-provider-launch}\n' "$0" >&2
    exit 64
    ;;
  *)
    printf 'unknown test gate: %s\n' "$gate" >&2
    exit 64
    ;;
esac
