      not_run product 'The production app has no paired-machine inventory'
    fi
    [[ -f "$macbook_handle_path" && ! -L "$macbook_handle_path" ]] ||
      not_run product 'The installed MacBook machine handle is unavailable'
    [[ "$(sed -n '1p' "$macbook_handle_path")" == "$macbook_handle" ]] ||
      not_run product 'The requested MacBook handle does not match the installed service'
    pairing_digest="$(
      "$adb" -s "$serial" exec-out run-as "$app_package" cat "$pairing_preferences" |
        content_digest
