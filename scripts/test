      not_run product 'Installed app does not carry the pinned Android signing identity'
    pairing_preferences='shared_prefs/skidbladnir.machines.xml'
    macbook_handle_path='/Users/nnandal/.config/skidbladnir/machine-handle'
    launch_domain='gui/501'
    launch_label='dev.niels.skidbladnir'
    launch_plist='/Users/nnandal/Library/LaunchAgents/dev.niels.skidbladnir.plist'
