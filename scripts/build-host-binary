#!/usr/bin/env bash
set -euo pipefail

# usage: build-host-binary SOURCE_DIR TAG SHA PLATFORM PACKAGE ABSOLUTE_OUTPUT
# the one release go recipe, shared by scripts/release and check-release --reproduce.
# the toolchain must be in go.mod's go family at or above its patch: go enforces the
# floor, and this also refuses a newer minor that ci never ran.
cd "$1"
case "$4" in
  linux-amd64) export GOOS=linux GOARCH=amd64 CGO_ENABLED=0 ;;
  darwin-arm64) export GOOS=darwin GOARCH=arm64 CGO_ENABLED=1 MACOSX_DEPLOYMENT_TARGET=26.0 ;;
  *) printf 'unknown release platform: %s\n' "$4" >&2; exit 64 ;;
esac
export GOTOOLCHAIN=local
floor="$(awk '$1 == "go" { print $2 }' go.mod)"
version="$(go env GOVERSION)"
patch="${version#"go${floor%.*}."}"
if [[ ! "$patch" =~ ^[0-9]+$ ]] || ((patch < ${floor##*.})); then
  printf 'resolved Go toolchain %s is outside supported family %s at or above its patch floor\n' "$version" "$floor" >&2
  exit 1
fi
go build -buildvcs=false -mod=readonly -trimpath \
  -ldflags "-s -w -X main.releaseVersion=$2 -X main.releaseSHA=$3" -o "$6" "$5"
chmod 0755 "$6"
