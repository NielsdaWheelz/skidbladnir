#!/usr/bin/env bash
set -euo pipefail
umask 077

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

file_mode() {
  case "$(uname -s)" in
  Darwin) stat -f '%Lp' "$1" ;;
  Linux) stat -c '%a' "$1" ;;
  *) return 1 ;;
  esac
}

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    die 'missing SHA-256 command: install sha256sum or shasum'
  fi
}

sha256_file() {
  [[ -f "$1" && ! -L "$1" ]] || return 1
  sha256_stream <"$1"
}

json_is_single_and_duplicate_free() {
  local value="$1"
  local raw_paths semantic_paths
  raw_paths="$(printf '%s' "$value" | jq --stream -c 'select(length == 2) | .[0]')" || return
  semantic_paths="$(printf '%s' "$value" | jq -c 'tostream | select(length == 2) | .[0]')" || return
  [[ "$(LC_ALL=C sort <<<"$raw_paths")" == "$(LC_ALL=C sort <<<"$semantic_paths")" ]] || return
  [[ "$(printf '%s' "$value" | jq -es 'length')" == 1 ]]
}

tracked_file_at_head() {
  local checkout="$1"
  local relative="$2"
  local resolved top file
  resolved="$(cd "$checkout" && pwd -P)" || return 1
  top="$(git -C "$resolved" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$top" == "$resolved" ]] || return 1
  file="$resolved/$relative"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  git -C "$resolved" cat-file -e "HEAD:$relative" 2>/dev/null || return 1
  git -C "$resolved" diff --quiet HEAD -- "$relative" || return 1
  cmp -s "$file" <(git -C "$resolved" show "HEAD:$relative")
}

secret_value() (
  set +x
  local file="$1"
  local pattern="$2"
  local value framed
  [[ -f "$file" && ! -L "$file" && -O "$file" &&
    "$(file_mode "$file" 2>/dev/null)" == 600 ]] || return 1
  value="$(cat "$file")" || return
  framed="$(cat "$file" && printf .)" || return
  [[ "$framed" == "$value"$'\n.' && "$value" =~ $pattern ]] || return 1
  printf '%s' "$value"
)

credential_digest() (
  set +x
  local config_dir="$HOME/.config/skidbladnir"
  local bearer handle
  bearer="$(secret_value "$config_dir/bearer" '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$')" ||
    die 'Skíðblaðnir bearer is absent, malformed, symlinked, or not mode 0600'
  handle="$(secret_value "$config_dir/machine-handle" '^mh-[0-9a-f]{32}$')" ||
    die 'Skíðblaðnir machine handle is absent, malformed, symlinked, or not mode 0600'
  {
    printf 'skidbladnir-fleet-credentials-v1\0%s\0' "$handle"
    printf '%s' "$bearer"
  } | sha256_stream
)

authenticated_get() (
  set +x
  local endpoint="$1"
  local config_dir="$HOME/.config/skidbladnir"
  local bearer handle max_filesize url
  case "$endpoint" in
  pressure)
    url='http://127.0.0.1:7341/v1/pressure'
    max_filesize=262144
    ;;
  sessions)
    url='http://127.0.0.1:7341/v1/sessions'
    max_filesize=1048576
    ;;
  *) return 64 ;;
  esac
  bearer="$(secret_value "$config_dir/bearer" '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$')" || return
  handle="$(secret_value "$config_dir/machine-handle" '^mh-[0-9a-f]{32}$')" || return
  {
    printf 'silent\nshow-error\nfail\nconnect-timeout = 2\nmax-time = 5\n'
    printf 'max-filesize = %s\n' "$max_filesize"
    printf 'header = "Authorization: Bearer %s"\n' "$bearer"
    printf 'header = "Skidbladnir-Machine: %s"\n' "$handle"
    printf 'url = "%s"\n' "$url"
  } | curl -q --noproxy '*' --config -
)

release_identity_digest() {
  local platform="$1"
  local share="$HOME/.local/share/skidbladnir"
  local relative generation artifact platform_key manifest manifest_bytes values
  local version source binary_identity
  case "$platform" in
  Darwin) platform_key=darwin-arm64 ;;
  Linux) platform_key=linux-amd64 ;;
  *) return 64 ;;
  esac
  [[ -L "$share/current" ]] || return 1
  relative="$(readlink "$share/current")" || return
  [[ "$relative" =~ ^releases/(v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))-([0-9a-f]{64})$ ]] ||
    return 1
  artifact="${BASH_REMATCH[5]}"
  generation="$share/$relative"
  manifest="$generation/release.json"
  [[ -d "$generation" && ! -L "$generation" &&
    -x "$generation/skidbladnir" && ! -L "$generation/skidbladnir" &&
    -f "$manifest" && ! -L "$manifest" ]] || return 1
  manifest_bytes="$(LC_ALL=C wc -c <"$manifest" | tr -d '[:space:]')" || return
  [[ "$manifest_bytes" =~ ^[1-9][0-9]*$ && "$manifest_bytes" -le 4096 ]] || return 1
  json_is_single_and_duplicate_free "$(cat "$manifest")" || return
  values="$(jq -er --arg platform "$platform_key" '
    if type == "object" and keys == ["platform", "sourceSha", "version"] and
      .platform == $platform and
      (.version | type == "string" and test("^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")) and
      (.sourceSha | type == "string" and test("^[0-9a-f]{40}$"))
    then [.version, .sourceSha] | @tsv else error("invalid release manifest") end
  ' "$manifest" 2>/dev/null)" || return
  IFS=$'\t' read -r version source <<<"$values"
  [[ "$relative" == "releases/$version-$artifact" ]] || return 1
  binary_identity="$("$generation/skidbladnir" version 2>/dev/null)" || return
  [[ "$binary_identity" == "$version $source" ]] || return 1
  printf 'skidbladnir-fleet-release-v2\0%s\0%s\0%s\0%s' \
    "$version" "$source" "$platform_key" "$artifact" | sha256_stream
}

active_runtime_is_current() {
  local share="$HOME/.local/share/skidbladnir"
  local relative generation name expected active
  [[ -L "$share/current" ]] || return 1
  relative="$(readlink "$share/current")" || return
  [[ "$relative" =~ ^releases/v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-[0-9a-f]{64}$ ]] ||
    return 1
  generation="$share/$relative"
  [[ -d "$generation" && ! -L "$generation" ]] || return 1
  [[ "$(file_mode "$generation" 2>/dev/null)" == 700 ]] || return 1
  for name in skidbladnir characters.json release.json host-config.json; do
    [[ -f "$generation/$name" && ! -L "$generation/$name" ]] || return 1
  done
  [[ "$(file_mode "$generation/skidbladnir" 2>/dev/null)" == 755 &&
    "$(file_mode "$generation/characters.json" 2>/dev/null)" == 644 &&
    "$(file_mode "$generation/release.json" 2>/dev/null)" == 644 &&
    "$(file_mode "$generation/host-config.json" 2>/dev/null)" == 600 ]] || return 1
  expected="$({
    for name in skidbladnir characters.json release.json host-config.json; do
      printf '%s\0%s\n' "$name" "$(sha256_file "$generation/$name")" || return
    done
  } | sha256_stream)" || return
  active="$(secret_value "$HOME/.local/state/dev-server/active/skid.runtime.sha256" \
    '^[0-9a-f]{64}$')" || return
  [[ "$active" == "$expected" ]]
}

candidate_release_digest() {
  local checkout="$1"
  local pin="$checkout/assets/skidbladnir/release-pin.json"
  local platform="$2"
  local platform_key value bytes identity version source artifact
  case "$platform" in
  Darwin) platform_key=darwin-arm64 ;;
  Linux) platform_key=linux-amd64 ;;
  *) return 64 ;;
  esac
  tracked_file_at_head "$checkout" assets/skidbladnir/release-pin.json ||
    die 'dev-server release pin must be tracked and byte-exact at checkout HEAD'
  bytes="$(LC_ALL=C wc -c <"$pin" | tr -d '[:space:]')"
  [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 ]] ||
    die 'dev-server release pin is not bounded'
  value="$(cat "$pin")" || die 'could not read the dev-server release pin'
  json_is_single_and_duplicate_free "$value" || die 'dev-server release pin JSON is invalid'
  identity="$(printf '%s' "$value" | jq -er --arg platform "$platform_key" '
    def canonical_version:
      type == "string" and test("^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$");
    def exact_artifact($name; $version):
      type == "object" and keys == ["sha256", "url"] and
      (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      .url == ("https://github.com/NielsdaWheelz/skidbladnir/releases/download/" +
        $version + "/skidbladnir-" + $name + ".tar.gz");
    .version as $version |
    if type == "object" and keys == ["artifacts", "schemaVersion", "sourceSha", "version"] and
      .schemaVersion == 1 and
      (.version | canonical_version) and
      (.sourceSha | type == "string" and test("^[0-9a-f]{40}$")) and
      (.artifacts | type == "object" and keys == ["darwin-arm64", "linux-amd64"] and
        (."darwin-arm64" | exact_artifact("darwin-arm64"; $version)) and
        (."linux-amd64" | exact_artifact("linux-amd64"; $version)))
    then [.version, .sourceSha, .artifacts[$platform].sha256] | @tsv
    else error("invalid release pin") end
  ' 2>/dev/null)" || die 'dev-server release pin schema is invalid'
  IFS=$'\t' read -r version source artifact <<<"$identity"
  printf 'skidbladnir-fleet-release-v2\0%s\0%s\0%s\0%s' \
    "$version" "$source" "$platform_key" "$artifact" | sha256_stream
}

candidate_checkout_commit() {
  local checkout="$1"
  local commit status
  commit="$(git -C "$checkout" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" ||
    die 'dev-server candidate is not a Git commit'
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die 'dev-server candidate commit is invalid'
  status="$(git -C "$checkout" status --porcelain=v1 --untracked-files=all)" ||
    die 'could not inspect the dev-server candidate checkout'
  [[ -z "$status" ]] || die 'dev-server candidate checkout must be clean for acceptance'
  printf '%s\n' "$commit"
}

service_state() {
  local platform="$1"
  local output bytes
  case "$platform" in
  Darwin)
    if output="$(launchctl print "gui/$(id -u)/dev.niels.skidbladnir" 2>&1)"; then
      bytes="$(LC_ALL=C printf '%s' "$output" | wc -c | tr -d '[:space:]')"
      [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 65536 &&
        "$(grep -Fc "path = $HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist" \
          <<<"$output")" == 1 ]] || return 1
      if [[ "$(grep -Ec '^[[:space:]]*state = running$' <<<"$output")" == 1 ]]; then
        printf 'running\n'
      elif [[ "$(grep -Ec '^[[:space:]]*state = (waiting|exited)$' <<<"$output")" == 1 ]]; then
        printf 'loaded\n'
      else
        return 1
      fi
    else
      bytes="$(LC_ALL=C printf '%s' "$output" | wc -c | tr -d '[:space:]')"
      [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 &&
        "$(grep -Fc 'Could not find service "dev.niels.skidbladnir" in domain for user gui:' <<<"$output")" == 1 ]] ||
        return 1
      printf 'inactive\n'
    fi
    ;;
  Linux)
    output="$(systemctl --user show skidbladnir.service \
      --property=LoadState --property=ActiveState 2>&1)" || return
    bytes="$(LC_ALL=C printf '%s' "$output" | wc -c | tr -d '[:space:]')"
    [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 &&
      "$(grep -Ec '^LoadState=loaded$' <<<"$output")" == 1 ]] || return 1
    if [[ "$(grep -Ec '^ActiveState=active$' <<<"$output")" == 1 ]]; then
      printf 'running\n'
    elif [[ "$(grep -Ec '^ActiveState=(inactive|failed)$' <<<"$output")" == 1 ]]; then
      printf 'inactive\n'
    else
      return 1
    fi
    ;;
  *) return 64 ;;
  esac
}

service_definition_is_current() {
  local platform="$1"
  local launcher="$HOME/.local/bin/skidbladnir-launch"
  local definition active expected fragment launcher_digest definition_digest
  case "$platform" in
  Darwin) definition="$HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist" ;;
  Linux) definition="$HOME/.config/systemd/user/skidbladnir.service" ;;
  *) return 64 ;;
  esac
  [[ -f "$launcher" && ! -L "$launcher" && -O "$launcher" &&
    "$(file_mode "$launcher" 2>/dev/null)" == 755 &&
    -f "$definition" && ! -L "$definition" && -O "$definition" &&
    "$(file_mode "$definition" 2>/dev/null)" == 644 ]] || return 1
  launcher_digest="$(sha256_file "$launcher")" || return
  definition_digest="$(sha256_file "$definition")" || return
  expected="$(printf 'launcher\0%s\nunit\0%s\n' \
    "$launcher_digest" "$definition_digest" | sha256_stream)" || return
  active="$(secret_value "$HOME/.local/state/dev-server/active/skid.unit.sha256" \
    '^[0-9a-f]{64}$')" || return
  [[ "$active" == "$expected" ]] || return 1
  if [[ "$platform" == Linux ]]; then
    fragment="$(systemctl --user show skidbladnir.service \
      --property=FragmentPath --value 2>/dev/null)" || return
    [[ "$fragment" == "$definition" ]]
  fi
}

service_is_active() {
  local platform="$1"
  service_definition_is_current "$platform" || return
  case "$platform" in
  Darwin)
    local definition="$HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist"
    local state
    state="$(launchctl print "gui/$(id -u)/dev.niels.skidbladnir" 2>/dev/null)" || return
    [[ "$(grep -Fc "path = $definition" <<<"$state")" == 1 ]] &&
      [[ "$(grep -Ec '^[[:space:]]*state = running$' <<<"$state")" == 1 ]]
    ;;
  Linux)
    systemctl --user is-enabled --quiet skidbladnir.service &&
      [[ "$(service_state Linux)" == running ]] &&
      [[ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" == yes ]]
    ;;
  *) return 64 ;;
  esac
}

private_serve_origin() {
  local status serve dns_name key
  status="$(TAILSCALE_BE_CLI=1 tailscale status --json 2>/dev/null)" || return
  serve="$(TAILSCALE_BE_CLI=1 tailscale serve status --json 2>/dev/null)" || return
  json_is_single_and_duplicate_free "$status" || return
  json_is_single_and_duplicate_free "$serve" || return
  dns_name="$(printf '%s' "$status" | jq -er '
    if type == "object" and .BackendState == "Running" and
      (.Self | type == "object") and
      (.Self.DNSName | type == "string" and test("^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+\\.$"))
    then .Self.DNSName | rtrimstr(".") else error("invalid Tailscale status") end
  ' 2>/dev/null)" || return
  key="$dns_name:8443"
  printf '%s' "$serve" | jq -e --arg key "$key" '
    type == "object" and .TCP["8443"] == {"HTTPS":true} and
    ([((.Web // {}) | to_entries[]) | select(.key | endswith(":8443"))] as $owned |
      ($owned | length == 1) and
      ($owned[0].key == $key) and
      ($owned[0].value.Handlers == {"/v1":{"Proxy":"http://127.0.0.1:7341/v1"}}) and
      (((.AllowFunnel // {})[$key] // false) == false) and
      ([((.AllowFunnel // {}) | to_entries[]) |
        select((.key | endswith(":8443")) and .value == true)] | length == 0))
  ' >/dev/null 2>&1 || return
  printf 'https://%s:8443/\n' "$dns_name"
}

validate_host() {
  case "$1" in
  macbook | devbox | arch) ;;
  *) return 1 ;;
  esac
}

validate_host_platform() {
  case "$1:$2" in
  Darwin:macbook | Linux:devbox | Linux:arch) ;;
  *) return 1 ;;
  esac
}

verify_host() {
  local platform="$1"
  local label="$2"
  local expected_handle origin pressure pressure_bytes runtime
  validate_host_platform "$platform" "$label" || return 64
  [[ "$(uname -s)" == "$platform" ]] || {
    printf 'error: %s runtime platform does not match %s\n' "$label" "$platform" >&2
    return 1
  }
  expected_handle="$(secret_value "$HOME/.config/skidbladnir/machine-handle" '^mh-[0-9a-f]{32}$')" || {
    printf 'error: %s machine handle is invalid\n' "$label" >&2
    return 1
  }
  secret_value "$HOME/.config/skidbladnir/bearer" \
    '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$' >/dev/null || {
    printf 'error: %s bearer is invalid\n' "$label" >&2
    return 1
  }
  service_is_active "$platform" || {
    printf 'error: %s gateway service is not enabled and active\n' "$label" >&2
    return 1
  }
  active_runtime_is_current || {
    printf 'error: %s active runtime identity does not match the current generation\n' "$label" >&2
    return 1
  }
  runtime="$(release_identity_digest "$platform")" || {
    printf 'error: %s installed release identity is invalid\n' "$label" >&2
    return 1
  }
  [[ "$runtime" =~ ^[0-9a-f]{64}$ ]] || return 1
  origin="$(private_serve_origin)" || {
    printf 'error: %s private Tailscale Serve mapping is invalid or unavailable\n' "$label" >&2
    return 1
  }
  pressure="$(authenticated_get pressure 2>/dev/null)" || {
    printf 'error: %s authenticated pressure endpoint is unavailable\n' "$label" >&2
    return 1
  }
  pressure_bytes="$(LC_ALL=C printf '%s' "$pressure" | wc -c | tr -d '[:space:]')"
  [[ "$pressure_bytes" =~ ^[1-9][0-9]*$ && "$pressure_bytes" -le 262144 ]] || {
    printf 'error: %s pressure response is not bounded\n' "$label" >&2
    return 1
  }
  if ! json_is_single_and_duplicate_free "$pressure" ||
    ! printf '%s' "$pressure" | jq -e '
      type == "object" and keys == ["current", "history", "unsupported"] and
      (.current | type == "object" and
        keys == ["level", "missing", "phase", "reasons", "sampledAt", "signals"] and
        (.sampledAt | type == "string" and length > 0) and
        (.level == "Normal" or .level == "Warm" or .level == "Hot" or .level == "Unknown") and
        (.phase == "Steady" or .phase == "Recovering") and
        (.reasons | type == "array" and all(.[]; type == "string")) and
        (.signals | type == "object") and
        (.missing | type == "array" and all(.[]; type == "string"))) and
      (.history | type == "array" and all(.[];
        type == "object" and keys == ["level", "sampledAt"] and
        (.sampledAt | type == "string" and length > 0) and
        (.level == "Normal" or .level == "Warm" or .level == "Hot" or .level == "Unknown"))) and
      (.unsupported | type == "array" and all(.[]; type == "string"))
    ' >/dev/null 2>&1; then
    printf 'error: %s pressure response is invalid\n' "$label" >&2
    return 1
  fi
  printf '%s\t%s\t%s\t%s\n' "$expected_handle" "$platform" "$runtime" "$origin"
}

lifetime_digest() {
  local platform="$1"
  local label="$2"
  local handle inventory inventory_bytes canonical
  validate_host_platform "$platform" "$label" || return 64
  [[ "$(uname -s)" == "$platform" ]] || return 1
  handle="$(secret_value "$HOME/.config/skidbladnir/machine-handle" '^mh-[0-9a-f]{32}$')" || return
  inventory="$(authenticated_get sessions 2>/dev/null)" || return
  inventory_bytes="$(LC_ALL=C printf '%s' "$inventory" | wc -c | tr -d '[:space:]')"
  [[ "$inventory_bytes" =~ ^[1-9][0-9]*$ && "$inventory_bytes" -le 1048576 ]] || return 1
  json_is_single_and_duplicate_free "$inventory" || return
  canonical="$(printf '%s' "$inventory" | jq -ceS \
    --arg handle "$handle" --arg platform "$platform" '
      def valid_session:
        . as $session |
        type == "object" and
        has("tmuxId") and has("identityToken") and
        (.tmuxId | type == "string" and test("^\\$[0-9]+$")) and
        (.identityToken | type == "string" and
          test("^v1-[0-9a-f]{32}\\.[1-9][0-9]*\\.[1-9][0-9]*\\.[0-9]+$")) and
        ((.identityToken | capture("\\.(?<id>[0-9]+)$").id) == ($session.tmuxId | ltrimstr("$")));
      if type == "object" and keys == ["machine", "observedAt", "profiles", "sessions"] and
        (.machine | type == "object" and keys == ["handle", "platform"] and
          .handle == $handle and .platform == $platform) and
        (.observedAt | type == "string" and length > 0) and
        (.profiles | type == "array") and
        (.sessions | type == "array" and all(.[]; valid_session)) and
        ([.sessions[].tmuxId] | unique | length) == (.sessions | length) and
        ([.sessions[].identityToken] | unique | length) == (.sessions | length)
      then .sessions | map({tmuxId, identityToken}) | sort_by(.tmuxId, .identityToken)
      else error("invalid lifetime inventory") end
    ' 2>/dev/null)" || return
  printf '%s\n' "$canonical" | sha256_stream
}

host_snapshot() {
  local platform="$1"
  local label="$2"
  local credentials lifetime
  credentials="$(credential_digest)" || return
  lifetime="$(lifetime_digest "$platform" "$label")" || return
  [[ "$credentials" =~ ^[0-9a-f]{64}$ && "$lifetime" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\t%s\n' "$credentials" "$lifetime"
}

boot_identity_digest() {
  local platform="$1"
  local identity
  [[ "$(uname -s)" == "$platform" ]] || return 1
  case "$platform" in
  Darwin)
    identity="$(sysctl -n kern.boottime)" || return
    ;;
  Linux)
    identity="$(cat /proc/sys/kernel/random/boot_id)" || return
    [[ "$identity" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
      return 1
    ;;
  *) return 64 ;;
  esac
  [[ -n "$identity" && "${#identity}" -le 256 ]] || return 1
  printf 'skidbladnir-fleet-boot-v1\0%s\0%s' "$platform" "$identity" | sha256_stream
}

reboot_checkpoint() {
  printf '%s/.local/state/skidbladnir/fleet-reboot.json\n' "$HOME"
}

private_state_dir() {
  local state_dir="$HOME/.local/state/skidbladnir"
  if [[ -e "$state_dir" || -L "$state_dir" ]]; then
    [[ -d "$state_dir" && ! -L "$state_dir" && -O "$state_dir" &&
      "$(file_mode "$state_dir" 2>/dev/null)" == 700 ]] ||
      die 'Skíðblaðnir state directory is not a user-owned mode-0700 directory'
  else
    install -d -m 0700 "$state_dir"
  fi
  printf '%s\n' "$state_dir"
}

release_operator_lock() {
  local status=$?
  trap - EXIT HUP INT TERM
  [[ -z "$operator_lock" ]] || /bin/unlink "$operator_lock" 2>/dev/null || status=1
  exit "$status"
}

acquire_operator_lock() {
  local state_dir
  require_command shlock
  state_dir="$(private_state_dir)" || return
  operator_lock="$state_dir/fleet-operator.lock"
  if ! shlock -f "$operator_lock" -p "$$"; then
    operator_lock=''
    printf 'NOT_RUN  fleet.operator another stateful fleet operation is active\n' >&2
    return 2
  fi
  trap release_operator_lock EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

prepare_reboot() (
  set +x
  local platform="$1"
  local label="$2"
  local checkpoint state_dir temporary=''
  local boot credentials release
  validate_host_platform "$platform" "$label" || return 64
  verify_host "$platform" "$label" >/dev/null || return
  boot="$(boot_identity_digest "$platform")" || die "could not read $label boot identity"
  credentials="$(credential_digest)" || die "could not read $label credential identity"
  release="$(release_identity_digest "$platform")" || die "could not read $label release identity"
  checkpoint="$(reboot_checkpoint)"
  state_dir="$(private_state_dir)" || return
  [[ ! -e "$checkpoint" && ! -L "$checkpoint" ]] ||
    die "a reboot checkpoint already exists on $label"
  temporary="$(mktemp "$state_dir/.fleet-reboot.XXXXXX")"
  trap '[[ -z "$temporary" ]] || /bin/unlink "$temporary" 2>/dev/null || true' EXIT
  jq -nS --arg platform "$platform" --arg label "$label" \
    --arg boot "$boot" --arg credentials "$credentials" --arg release "$release" '
      {
        schemaVersion: 1,
        platform: $platform,
        label: $label,
        bootDigest: $boot,
        credentialsDigest: $credentials,
        releaseIdentityDigest: $release
      }
    ' >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$checkpoint"
  temporary=''
  trap - EXIT
  printf 'PASS  fleet.reboot.prepare %s reboot checkpoint is ready\n' "$label"
)

verify_reboot() (
  set +x
  local platform="$1"
  local label="$2"
  local checkpoint value value_bytes parsed
  local prior_boot prior_credentials prior_release
  local current_boot current_credentials current_release
  validate_host_platform "$platform" "$label" || return 64
  checkpoint="$(reboot_checkpoint)"
  [[ -f "$checkpoint" && ! -L "$checkpoint" && -O "$checkpoint" &&
    "$(file_mode "$checkpoint" 2>/dev/null)" == 600 ]] ||
    die "reboot checkpoint is absent or invalid on $label"
  value="$(cat "$checkpoint")"
  value_bytes="$(LC_ALL=C printf '%s' "$value" | wc -c | tr -d '[:space:]')"
  [[ "$value_bytes" =~ ^[1-9][0-9]*$ && "$value_bytes" -le 2048 ]] ||
    die "reboot checkpoint size is invalid on $label"
  json_is_single_and_duplicate_free "$value" || die "reboot checkpoint JSON is invalid on $label"
  parsed="$(printf '%s' "$value" | jq -er --arg platform "$platform" --arg label "$label" '
    if type == "object" and
      keys == ["bootDigest", "credentialsDigest", "label", "platform", "releaseIdentityDigest", "schemaVersion"] and
      .schemaVersion == 1 and .platform == $platform and .label == $label and
      (.bootDigest | type == "string" and test("^[0-9a-f]{64}$")) and
      (.credentialsDigest | type == "string" and test("^[0-9a-f]{64}$")) and
      (.releaseIdentityDigest | type == "string" and test("^[0-9a-f]{64}$"))
    then [.bootDigest, .credentialsDigest, .releaseIdentityDigest] | @tsv
    else error("invalid reboot checkpoint") end
  ' 2>/dev/null)" || die "reboot checkpoint schema is invalid on $label"
  IFS=$'\t' read -r prior_boot prior_credentials prior_release <<<"$parsed"
  current_boot="$(boot_identity_digest "$platform")" || die "could not read $label boot identity"
  if [[ "$current_boot" == "$prior_boot" ]]; then
    printf 'NOT_RUN  fleet.reboot %s boot identity has not changed; reboot before verification\n' "$label" >&2
    return 2
  fi
  current_release="$(release_identity_digest "$platform")" || die "could not read $label release identity"
  [[ "$current_release" == "$prior_release" ]] || die "release identity changed across reboot on $label"
  verify_host "$platform" "$label" >/dev/null || return
  current_credentials="$(credential_digest)" || die "could not read $label credential identity"
  [[ "$current_credentials" == "$prior_credentials" ]] || die "credentials changed across reboot on $label"
  /bin/unlink "$checkpoint"
  printf 'PASS  fleet.reboot %s reboot persistence preserved release, credentials, and gateway intent\n' "$label"
)

apply_and_require_noop() {
  local entrypoint="$1"
  local target="$2"
  local second result_lines
  "$entrypoint" apply
  second="$("$entrypoint" apply)" || {
    printf '%s\n' "$second"
    die "$target second apply failed"
  }
  printf '%s\n' "$second"
  result_lines="$(printf '%s\n' "$second" | grep -E \
    '^(INSTALLED|UPDATED|CHANGED|STARTED|RELOADED|RESTARTED|DEFERRED|ACTION|UP TO DATE|ERROR)  ' || true)"
  [[ "$result_lines" == "UP TO DATE  $target" ]] ||
    die "$target second apply was not an exact no-op"
}

verified_release_from_evidence() {
  local evidence="$1"
  local handle platform release origin extra
  IFS=$'\t' read -r handle platform release origin extra <<<"$evidence"
  [[ "$handle" =~ ^mh-[0-9a-f]{32}$ &&
    ("$platform" == Darwin || "$platform" == Linux) ]] || return 1
  [[ "$release" =~ ^[0-9a-f]{64}$ && "$origin" == https://*:8443/ && -z "$extra" ]] || return 1
  printf '%s\n' "$release"
}

apply_arch_twice() {
  local expected_commit="$1"
  local checkout="$HOME/src/personal/dev-server"
  local workstation="$HOME/src/personal/dev-server/workstation"
  [[ -f "$workstation" && ! -L "$workstation" && -x "$workstation" ]] ||
    die 'arch dev-server workstation checkout is unavailable'
  [[ "$(candidate_checkout_commit "$checkout")" == "$expected_commit" ]] ||
    die 'arch dev-server checkout does not match the accepted candidate'
  apply_and_require_noop "$workstation" arch
  [[ "$(candidate_checkout_commit "$checkout")" == "$expected_commit" ]] ||
    die 'arch dev-server checkout changed during acceptance'
}

accept_arch() {
  local expected_commit="$1"
  local expected_release="$2"
  local checkout="$HOME/src/personal/dev-server"
  local before after evidence observed_release
  [[ "$(candidate_release_digest "$checkout" Linux)" == "$expected_release" ]] ||
    die 'arch release pin does not match the accepted candidate'
  before="$(host_snapshot Linux arch)" || die 'arch acceptance precondition failed'
  apply_arch_twice "$expected_commit"
  evidence="$(verify_host Linux arch)" || die 'arch gateway verification failed after apply'
  observed_release="$(verified_release_from_evidence "$evidence")" ||
    die 'arch gateway returned invalid release evidence'
  [[ "$observed_release" == "$expected_release" ]] ||
    die 'arch active release does not match the accepted candidate'
  after="$(host_snapshot Linux arch)" || die 'arch acceptance postcondition failed'
  [[ "$after" == "$before" ]] || {
    [[ "${after%%$'\t'*}" == "${before%%$'\t'*}" ]] || die 'arch credentials changed during acceptance'
    die 'arch reconciled tmux lifetime changed during acceptance'
  }
  printf 'PASS  fleet.accept-host arch identity-preserving apply completed twice; credentials, lifetime, and service intent hold\n'
}

change_service() {
  local action="$1"
  local platform="$2"
  local label="$3"
  local before after state
  validate_host_platform "$platform" "$label" || return 64
  before="$(credential_digest)" || die "$label credentials are invalid"
  state="$(service_state "$platform")" ||
    die "$label gateway service state could not be observed"
  service_definition_is_current "$platform" ||
    die "$label gateway service definition does not match durable installer intent"
  case "$action:$platform" in
  outage:Darwin)
    if [[ "$state" == running || "$state" == loaded ]]; then
      launchctl bootout "gui/$(id -u)/dev.niels.skidbladnir"
    fi
    state="$(service_state Darwin)" ||
      die 'MacBook gateway service state could not be observed after outage'
    [[ "$state" == inactive ]] || die 'MacBook gateway remained loaded after outage'
    ;;
  recover:Darwin)
    if [[ "$state" == inactive ]]; then
      launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist"
    elif [[ "$state" == loaded ]]; then
      launchctl kickstart "gui/$(id -u)/dev.niels.skidbladnir"
    fi
    verify_host Darwin macbook >/dev/null || die 'macbook gateway did not recover'
    ;;
  outage:Linux)
    if [[ "$state" == running ]]; then
      systemctl --user stop skidbladnir.service
    fi
    state="$(service_state Linux)" ||
      die "$label gateway service state could not be observed after outage"
    [[ "$state" == inactive ]] || die "$label gateway remained active after outage"
    ;;
  recover:Linux)
    if [[ "$state" == inactive ]]; then
      systemctl --user start skidbladnir.service
    fi
    verify_host Linux "$label" >/dev/null || die "$label gateway did not recover"
    ;;
  *) return 64 ;;
  esac
  after="$(credential_digest)" || die "$label credentials are invalid after service action"
  [[ "$after" == "$before" ]] || die "$label credentials changed during service action"
  if [[ "$action" == outage ]]; then
    printf 'Gateway outage active on %s. tmux and Tailscale Serve were not touched.\n' "$label"
  else
    printf 'Gateway recovered on %s. tmux and Tailscale Serve were not touched.\n' "$label"
  fi
}

host_main() {
  local action="${1:-}"
  local platform="${2:-}"
  local label="${3:-}"
  [[ "${SKIDBLADNIR_FLEET_TRANSPORT:-}" == fleet-host-v1 ]] || return 64
  validate_host_platform "$platform" "$label" || return 64
  case "$action" in
  verify)
    [[ $# -eq 3 ]] || return 64
    verify_host "$platform" "$label"
    ;;
  lifetime)
    [[ $# -eq 3 ]] || return 64
    lifetime_digest "$platform" "$label"
    ;;
  snapshot)
    [[ $# -eq 3 ]] || return 64
    host_snapshot "$platform" "$label"
    ;;
  accept)
    [[ $# -eq 9 && "$platform:$label" == Linux:arch &&
      "${4:-}" == --allow-host-apply &&
      "${5:-}" == --allow-inventory-reconciliation &&
      "${6:-}" == --candidate-commit && "${7:-}" =~ ^[0-9a-f]{40}$ &&
      "${8:-}" == --release-identity && "${9:-}" =~ ^[0-9a-f]{64}$ &&
      "${SKIDBLADNIR_ALLOW_HOST_ACCEPTANCE:-}" == host-acceptance-v1 ]] || return 64
    accept_arch "$7" "$9"
    ;;
  prepare-reboot | verify-reboot)
    [[ $# -eq 4 && "${4:-}" == --allow-reboot-acceptance &&
      "${SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE:-}" == reboot-acceptance-v1 ]] || return 64
    "${action/-reboot/_reboot}" "$platform" "$label"
    ;;
  outage | recover)
    [[ $# -eq 4 && "${4:-}" == --allow-service-lifecycle &&
      "${SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE:-}" == one-host-outage-v1 ]] || return 64
    change_service "$action" "$platform" "$label"
    ;;
  *) return 64 ;;
  esac
}

fleet_ssh() {
  local label="$1"
  shift
  case "$label" in
  devbox)
    local config="$HOME/.ssh/config.d/dev-server"
    [[ -f "$config" && ! -L "$config" && -O "$config" &&
      "$(file_mode "$config" 2>/dev/null)" == 600 ]] ||
      die 'managed devbox SSH config is unavailable or not mode 0600'
    ssh -F "$config" -T -o BatchMode=yes -o RequestTTY=no -o ConnectTimeout=10 \
      -o ConnectionAttempts=1 dev-server "$@"
    ;;
  arch)
    ssh -T -o BatchMode=yes -o RequestTTY=no -o ConnectTimeout=10 -o ConnectionAttempts=1 \
      nnandal@arch "$@"
    ;;
  *) return 64 ;;
  esac
}

remote_host() {
  local action="$1"
  local label="$2"
  shift 2
  [[ -f "$fleet_source" && ! -L "$fleet_source" ]] || die 'fleet operator source is unavailable'
  case "$action" in
  verify | lifetime | snapshot)
    [[ $# -eq 0 ]] || return 64
    fleet_ssh "$label" env SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
      bash -s -- _host "$action" Linux "$label" <"$fleet_source"
    ;;
  accept)
    [[ $# -eq 6 && "${1:-}" == --allow-host-apply &&
      "${2:-}" == --allow-inventory-reconciliation &&
      "${3:-}" == --candidate-commit && "${4:-}" =~ ^[0-9a-f]{40}$ &&
      "${5:-}" == --release-identity && "${6:-}" =~ ^[0-9a-f]{64}$ &&
      "${SKIDBLADNIR_ALLOW_HOST_ACCEPTANCE:-}" == host-acceptance-v1 ]] || return 64
    fleet_ssh "$label" env \
      SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
      SKIDBLADNIR_ALLOW_HOST_ACCEPTANCE=host-acceptance-v1 \
      bash -s -- _host accept Linux "$label" "$@" <"$fleet_source"
    ;;
  prepare-reboot | verify-reboot)
    [[ $# -eq 1 && "${1:-}" == --allow-reboot-acceptance &&
      "${SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE:-}" == reboot-acceptance-v1 ]] || return 64
    fleet_ssh "$label" env \
      SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
      SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE=reboot-acceptance-v1 \
      bash -s -- _host "$action" Linux "$label" "$@" <"$fleet_source"
    ;;
  outage | recover)
    [[ $# -eq 1 && "${1:-}" == --allow-service-lifecycle &&
      "${SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE:-}" == one-host-outage-v1 ]] || return 64
    fleet_ssh "$label" env \
      SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
      SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE=one-host-outage-v1 \
      bash -s -- _host "$action" Linux "$label" "$@" <"$fleet_source"
    ;;
  *) return 64 ;;
  esac
}

fleet_evidence() {
  local expected_darwin_release="$1"
  local expected_linux_release="$2"
  local local_result='' devbox_result='' arch_result=''
  local identity_separator=$'\t'
  local local_handle local_platform local_runtime local_origin
  local devbox_handle devbox_platform devbox_runtime devbox_origin
  local arch_handle arch_platform arch_runtime arch_origin
  local failures=0
  local_result="$(verify_host Darwin macbook)" || failures=$((failures + 1))
  devbox_result="$(remote_host verify devbox)" || failures=$((failures + 1))
  arch_result="$(remote_host verify arch)" || failures=$((failures + 1))
  if ((failures > 0)); then
    printf 'error: fleet gateway verification failed on %d host%s\n' \
      "$failures" "$([[ "$failures" == 1 ]] || printf s)" >&2
    return 1
  fi
  [[ "$local_result" =~ ^mh-[0-9a-f]{32}${identity_separator}Darwin${identity_separator}[0-9a-f]{64}${identity_separator}https://[a-z0-9.-]+:8443/$ &&
    "$devbox_result" =~ ^mh-[0-9a-f]{32}${identity_separator}Linux${identity_separator}[0-9a-f]{64}${identity_separator}https://[a-z0-9.-]+:8443/$ &&
    "$arch_result" =~ ^mh-[0-9a-f]{32}${identity_separator}Linux${identity_separator}[0-9a-f]{64}${identity_separator}https://[a-z0-9.-]+:8443/$ ]] ||
    die 'fixed-fleet verification returned invalid host identity'
  IFS=$'\t' read -r local_handle local_platform local_runtime local_origin <<<"$local_result"
  IFS=$'\t' read -r devbox_handle devbox_platform devbox_runtime devbox_origin <<<"$devbox_result"
  IFS=$'\t' read -r arch_handle arch_platform arch_runtime arch_origin <<<"$arch_result"
  [[ "$local_platform" == Darwin && "$devbox_platform" == Linux && "$arch_platform" == Linux ]] ||
    die 'fixed-fleet verification returned invalid platforms'
  [[ "$devbox_runtime" == "$arch_runtime" ]] ||
    die 'fixed-fleet Linux release identities differ'
  [[ "$local_runtime" == "$expected_darwin_release" &&
    "$devbox_runtime" == "$expected_linux_release" ]] ||
    die 'fixed-fleet active artifacts do not match the dev-server release pin'
  [[ "$local_handle" != "$devbox_handle" && "$local_handle" != "$arch_handle" &&
    "$devbox_handle" != "$arch_handle" ]] || die 'fixed-fleet machine handles are not unique'
  [[ "$local_origin" != "$devbox_origin" && "$local_origin" != "$arch_origin" &&
    "$devbox_origin" != "$arch_origin" ]] || die 'fixed-fleet Serve origins are not unique'
  printf '%s\t%s\n%s\t%s\n%s\t%s\n' \
    "$local_handle" "$local_origin" \
    "$devbox_handle" "$devbox_origin" \
    "$arch_handle" "$arch_origin"
}

verify_fleet() {
  local expected_darwin_release="$1"
  local expected_linux_release="$2"
  fleet_evidence "$expected_darwin_release" "$expected_linux_release" >/dev/null || return
  printf 'PASS  fleet.verify macbook gateway available\n'
  printf 'PASS  fleet.verify devbox gateway available\n'
  printf 'PASS  fleet.verify arch gateway available\n'
  printf 'Fleet gateway verification: pass.\n'
}

invite_call() {
  local label="$1"
  case "$label" in
  macbook)
    "$HOME/.local/share/skidbladnir/current/skidbladnir" pairing-invite create
    ;;
  devbox | arch)
    # justify-override: SC2016 — HOME belongs to the fixed remote host, never the operator shell.
    # shellcheck disable=SC2016
    fleet_ssh "$label" '$HOME/.local/share/skidbladnir/current/skidbladnir pairing-invite create'
    ;;
  *) return 64 ;;
  esac
}

bounded_invite_call() {
  local label="$1"
  local had_errexit=0
  local -a statuses
  [[ $- == *e* ]] && had_errexit=1
  set +e
  invite_call "$label" 2>/dev/null | LC_ALL=C head -c 4097
  statuses=("${PIPESTATUS[@]}")
  ((had_errexit == 0)) || set -e
  ((statuses[0] == 0 && statuses[1] == 0))
}

invite_response_is_valid() {
  local response="$1"
  local platform="$2"
  local handle="$3"
  local bytes now
  bytes="$(LC_ALL=C printf '%s' "$response" | wc -c | tr -d '[:space:]')"
  [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 ]] || return 1
  json_is_single_and_duplicate_free "$response" || return
  now="$(date -u '+%s')" || return
  [[ "$now" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s' "$response" | jq -e --arg platform "$platform" --arg handle "$handle" --argjson now "$now" '
    type == "object" and keys == ["expiresAt", "machine", "pairingInviteToken"] and
    (.pairingInviteToken | type == "string" and test("^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$")) and
    (.expiresAt | type == "string" and
      test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$")) and
    ((.expiresAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $expiry |
      $expiry > $now and $expiry <= ($now + 300)) and
    (.machine | type == "object" and keys == ["handle", "platform"] and
      .handle == $handle and
      .platform == $platform)
  ' >/dev/null 2>&1
}

invite() (
  set +x
  local expected_darwin_release="$1"
  local expected_linux_release="$2"
  local arch_response='' devbox_response='' local_response=''
  local evidence local_line devbox_line arch_line
  local local_handle local_origin devbox_handle devbox_origin arch_handle arch_origin
  local arch_status=0 devbox_status=0 local_status=0 payload bytes
  evidence="$(fleet_evidence "$expected_darwin_release" "$expected_linux_release")" || return
  local_line="$(printf '%s\n' "$evidence" | sed -n '1p')"
  devbox_line="$(printf '%s\n' "$evidence" | sed -n '2p')"
  arch_line="$(printf '%s\n' "$evidence" | sed -n '3p')"
  IFS=$'\t' read -r local_handle local_origin <<<"$local_line"
  IFS=$'\t' read -r devbox_handle devbox_origin <<<"$devbox_line"
  IFS=$'\t' read -r arch_handle arch_origin <<<"$arch_line"
  [[ "$local_handle" =~ ^mh-[0-9a-f]{32}$ && "$devbox_handle" =~ ^mh-[0-9a-f]{32}$ &&
    "$arch_handle" =~ ^mh-[0-9a-f]{32}$ ]] || die 'fleet verification returned invalid invitation identities'
  if arch_response="$(bounded_invite_call arch)"; then :; else arch_status=$?; fi
  if devbox_response="$(bounded_invite_call devbox)"; then :; else devbox_status=$?; fi
  if local_response="$(bounded_invite_call macbook)"; then :; else local_status=$?; fi
  if ((arch_status != 0 || devbox_status != 0 || local_status != 0)) ||
    ! invite_response_is_valid "$arch_response" Linux "$arch_handle" ||
    ! invite_response_is_valid "$devbox_response" Linux "$devbox_handle" ||
    ! invite_response_is_valid "$local_response" Darwin "$local_handle"; then
    die "Couldn't create the whole fleet invite. Nothing was displayed. Run scripts/fleet invite again."
  fi
  payload="$(printf '%s\n%s\n%s\n' \
    "$arch_response" "$devbox_response" "$local_response" | jq -sc \
    --arg archOrigin "$arch_origin" \
    --arg devboxOrigin "$devbox_origin" \
    --arg localOrigin "$local_origin" '
      .[0] as $arch | .[1] as $devbox | .[2] as $local |
      {
        kind: "skidbladnir.fleet-invite.v1",
        machines: [
          {label: "Arch", origin: $archOrigin, machineHandle: $arch.machine.handle,
            pairingInviteToken: $arch.pairingInviteToken},
          {label: "Devbox", origin: $devboxOrigin, machineHandle: $devbox.machine.handle,
            pairingInviteToken: $devbox.pairingInviteToken},
          {label: "MacBook", origin: $localOrigin, machineHandle: $local.machine.handle,
            pairingInviteToken: $local.pairingInviteToken}
        ]
      }
    ')" || die 'could not render fleet invitation'
  printf '%s' "$payload" | jq -e '
    (.machines | map(.machineHandle) | unique | length) == 3 and
    (.machines | map(.pairingInviteToken) | unique | length) == 3
  ' >/dev/null || die 'fleet invitation responses are not unique'
  bytes="$(LC_ALL=C printf '%s' "$payload" | wc -c | tr -d '[:space:]')"
  [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 ]] ||
    die 'fleet invitation exceeds the 4096-byte QR limit'
  printf '%s\n' \
    'Fleet invite ready. It expires in 5 minutes and works once. On the phone, open Skíðblaðnir and tap Connect.'
  printf '%s' "$payload" | qrencode -t ANSIUTF8
)

reconciled_lifetimes() {
  local local_digest devbox_digest arch_digest
  local_digest="$(lifetime_digest Darwin macbook)" ||
    die 'could not reconcile the macbook tmux lifetime'
  devbox_digest="$(remote_host lifetime devbox)" ||
    die 'could not reconcile the devbox tmux lifetime'
  arch_digest="$(remote_host lifetime arch)" ||
    die 'could not reconcile the arch tmux lifetime'
  [[ "$local_digest" =~ ^[0-9a-f]{64}$ && "$devbox_digest" =~ ^[0-9a-f]{64}$ &&
    "$arch_digest" =~ ^[0-9a-f]{64}$ ]] || die 'fleet lifetime evidence is invalid'
  printf 'macbook %s\ndevbox %s\narch %s\n' "$local_digest" "$devbox_digest" "$arch_digest"
}

accept_host() {
  local label="$1"
  local expected_commit="$2"
  local expected_release="$3"
  local before after before_credentials after_credentials evidence observed_release
  case "$label" in
  macbook)
    before="$(host_snapshot Darwin macbook)" || die 'macbook acceptance precondition failed'
    apply_and_require_noop "$dev_server_checkout/workstation" macbook
    evidence="$(verify_host Darwin macbook)" || die 'macbook gateway verification failed after apply'
    after="$(host_snapshot Darwin macbook)" || die 'macbook acceptance postcondition failed'
    ;;
  devbox)
    before="$(remote_host snapshot devbox)" || die 'devbox acceptance precondition failed'
    apply_and_require_noop "$dev_server_checkout/devbox" devbox
    evidence="$(remote_host verify devbox)" || die 'devbox gateway verification failed after apply'
    after="$(remote_host snapshot devbox)" || die 'devbox acceptance postcondition failed'
    ;;
  arch)
    remote_host accept arch \
      --allow-host-apply --allow-inventory-reconciliation \
      --candidate-commit "$expected_commit" --release-identity "$expected_release"
    return
    ;;
  *) return 64 ;;
  esac
  observed_release="$(verified_release_from_evidence "$evidence")" ||
    die "$label gateway returned invalid release evidence"
  [[ "$observed_release" == "$expected_release" ]] ||
    die "$label active release does not match the accepted candidate"
  [[ "$(candidate_checkout_commit "$dev_server_checkout")" == "$expected_commit" ]] ||
    die 'dev-server candidate checkout changed during acceptance'
  before_credentials="${before%%$'\t'*}"
  after_credentials="${after%%$'\t'*}"
  [[ "$after_credentials" == "$before_credentials" ]] ||
    die "$label credentials changed during acceptance"
  [[ "$after" == "$before" ]] || die "$label reconciled tmux lifetime changed during acceptance"
  printf 'PASS  fleet.accept-host %s identity-preserving apply completed twice; credentials, lifetime, and service intent hold\n' "$label"
}

usage() {
  cat <<'EOF'
Usage: scripts/fleet <command>

Commands:
  verify
  invite
  reconcile-lifetime-digests
  accept-host <macbook|devbox|arch> --allow-host-apply --allow-inventory-reconciliation
  prepare-reboot <macbook|devbox|arch> --allow-reboot-acceptance
  verify-reboot <macbook|devbox|arch> --allow-reboot-acceptance
  outage <macbook|devbox|arch> --allow-service-lifecycle
  recover <macbook|devbox|arch> --allow-service-lifecycle

verify, invite, and accept-host require SKIDBLADNIR_DEV_SERVER_CHECKOUT naming
the exact local dev-server checkout with its release pin tracked and byte-exact
at HEAD. accept-host also requires the whole candidate checkout to be clean and
SKIDBLADNIR_ALLOW_HOST_ACCEPTANCE=host-acceptance-v1.
prepare-reboot and verify-reboot require
SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE=reboot-acceptance-v1.
outage and recover require SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE=one-host-outage-v1.
EOF
}

require_checkout() {
  local declared="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-}"
  [[ "$declared" == /* && -d "$declared" && ! -L "$declared" ]] ||
    die 'SKIDBLADNIR_DEV_SERVER_CHECKOUT must name an absolute, non-symlink directory'
  dev_server_checkout="$(cd "$declared" && pwd -P)"
  [[ -f "$dev_server_checkout/workstation" && ! -L "$dev_server_checkout/workstation" &&
    -x "$dev_server_checkout/workstation" &&
    -f "$dev_server_checkout/devbox" && ! -L "$dev_server_checkout/devbox" &&
    -x "$dev_server_checkout/devbox" ]] ||
    die 'SKIDBLADNIR_DEV_SERVER_CHECKOUT lacks executable workstation and devbox entrypoints'
}

main() {
  local command="${1:-}"
  local expected_commit expected_release expected_darwin_release expected_linux_release
  if [[ "$command" == _host ]]; then
    shift
    host_main "$@"
    return
  fi
  case "$command" in
  help | -h | --help)
    [[ $# -eq 1 ]] || {
      usage >&2
      return 64
    }
    usage
    return
    ;;
  '')
    usage >&2
    return 64
    ;;
  verify | invite | reconcile-lifetime-digests)
    [[ $# -eq 1 ]] || {
      usage >&2
      return 64
    }
    ;;
  accept-host)
    if [[ $# -ne 4 || "${2:-}" != macbook && "${2:-}" != devbox && "${2:-}" != arch ||
      "${3:-}" != --allow-host-apply || "${4:-}" != --allow-inventory-reconciliation ||
      "${SKIDBLADNIR_ALLOW_HOST_ACCEPTANCE:-}" != host-acceptance-v1 ]]; then
      printf 'NOT_RUN  fleet.accept-host exact apply and inventory-reconciliation capability is required; no host was touched\n' >&2
      return 64
    fi
    ;;
  prepare-reboot | verify-reboot)
    if [[ $# -ne 3 ]] || ! validate_host "${2:-}" ||
      [[ "${3:-}" != --allow-reboot-acceptance ||
        "${SKIDBLADNIR_ALLOW_REBOOT_ACCEPTANCE:-}" != reboot-acceptance-v1 ]]; then
      printf 'NOT_RUN  fleet.reboot exact reboot-acceptance capability is required; no checkpoint was changed\n' >&2
      return 64
    fi
    ;;
  outage | recover)
    if [[ $# -ne 3 ]] || ! validate_host "${2:-}" ||
      [[ "${3:-}" != --allow-service-lifecycle ||
        "${SKIDBLADNIR_ALLOW_ONE_HOST_OUTAGE:-}" != one-host-outage-v1 ]]; then
      printf 'NOT_RUN  fleet.service-lifecycle exact one-host capability is required; no service was touched\n' >&2
      return 64
    fi
    ;;
  *)
    usage >&2
    return 64
    ;;
  esac
  [[ "$(uname -s)" == Darwin ]] || die 'scripts/fleet is the MacBook-only fixed-fleet operator'
  case "$command" in
  invite | accept-host | prepare-reboot | verify-reboot | outage | recover)
    acquire_operator_lock || return
    ;;
  esac
  case "$command" in
  verify)
    require_checkout
    require_command git
    require_command jq
    require_command curl
    require_command ssh
    expected_darwin_release="$(candidate_release_digest "$dev_server_checkout" Darwin)" || return
    expected_linux_release="$(candidate_release_digest "$dev_server_checkout" Linux)" || return
    fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
    verify_fleet "$expected_darwin_release" "$expected_linux_release"
    ;;
  invite)
    require_checkout
    require_command git
    require_command jq
    require_command curl
    require_command ssh
    require_command qrencode
    expected_darwin_release="$(candidate_release_digest "$dev_server_checkout" Darwin)" || return
    expected_linux_release="$(candidate_release_digest "$dev_server_checkout" Linux)" || return
    fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
    invite "$expected_darwin_release" "$expected_linux_release"
    ;;
  reconcile-lifetime-digests)
    require_command jq
    require_command curl
    require_command ssh
    fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
    reconciled_lifetimes
    ;;
  accept-host)
    require_checkout
    require_command git
    require_command jq
    require_command curl
    require_command ssh
    expected_commit="$(candidate_checkout_commit "$dev_server_checkout")" || return
    if [[ "$2" == macbook ]]; then
      expected_release="$(candidate_release_digest "$dev_server_checkout" Darwin)" || return
    else
      expected_release="$(candidate_release_digest "$dev_server_checkout" Linux)" || return
    fi
    fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
    accept_host "$2" "$expected_commit" "$expected_release"
    ;;
  prepare-reboot | verify-reboot)
    if [[ "$2" == macbook ]]; then
      require_command jq
      require_command curl
      "${command/-reboot/_reboot}" Darwin macbook
    else
      require_command ssh
      fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
      remote_host "$command" "$2" --allow-reboot-acceptance
    fi
    ;;
  outage | recover)
    if [[ "$2" == macbook ]]; then
      change_service "$command" Darwin macbook
    else
      require_command ssh
      fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
      remote_host "$command" "$2" --allow-service-lifecycle
    fi
    ;;
  *)
    usage >&2
    return 64
    ;;
  esac
}

dev_server_checkout=''
fleet_source=''
operator_lock=''
main "$@"
