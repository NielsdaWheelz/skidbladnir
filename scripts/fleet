#!/usr/bin/env bash
set -euo pipefail
umask 077
macos_tailscale_app='/Applications/Tailscale.app'

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

file_mode() {
  case "$(uname -s)" in
  Darwin) stat -f '%Lp' "$1" ;;
  Linux) stat -c '%a' "$1" ;;
  *) return 1 ;;
  esac
}

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    die 'missing SHA-256 command: install sha256sum or shasum'
  fi
}

sha256_file() {
  [[ -f "$1" && ! -L "$1" ]] || return 1
  sha256_stream <"$1"
}

json_is_single_and_duplicate_free() {
  local value="$1"
  local raw_paths semantic_paths
  raw_paths="$(printf '%s' "$value" | jq --stream -c 'select(length == 2) | .[0]')" || return
  semantic_paths="$(printf '%s' "$value" | jq -c 'tostream | select(length == 2) | .[0]')" || return
  [[ "$(LC_ALL=C sort <<<"$raw_paths")" == "$(LC_ALL=C sort <<<"$semantic_paths")" ]] || return
  [[ "$(printf '%s' "$value" | jq -es 'length')" == 1 ]]
}

tracked_file_at_head() {
  local checkout="$1"
  local relative="$2"
  local resolved top file
  resolved="$(cd "$checkout" && pwd -P)" || return 1
  top="$(git -C "$resolved" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$top" == "$resolved" ]] || return 1
  file="$resolved/$relative"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  git -C "$resolved" cat-file -e "HEAD:$relative" 2>/dev/null || return 1
  git -C "$resolved" diff --quiet HEAD -- "$relative" || return 1
  cmp -s "$file" <(git -C "$resolved" show "HEAD:$relative")
}

secret_value() (
  set +x
  local file="$1"
  local pattern="$2"
  local value framed
  [[ -f "$file" && ! -L "$file" && -O "$file" &&
    "$(file_mode "$file" 2>/dev/null)" == 600 ]] || return 1
  value="$(cat "$file")" || return
  framed="$(cat "$file" && printf .)" || return
  [[ "$framed" == "$value"$'\n.' && "$value" =~ $pattern ]] || return 1
  printf '%s' "$value"
)

authenticated_get() (
  set +x
  local config_dir="$HOME/.config/skidbladnir"
  local bearer handle
  bearer="$(secret_value "$config_dir/bearer" '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$')" || return
  handle="$(secret_value "$config_dir/machine-handle" '^mh-[0-9a-f]{32}$')" || return
  {
    printf 'silent\nshow-error\nfail\nconnect-timeout = 2\nmax-time = 5\n'
    printf 'max-filesize = 262144\n'
    printf 'header = "Authorization: Bearer %s"\n' "$bearer"
    printf 'header = "Skidbladnir-Machine: %s"\n' "$handle"
    printf 'url = "http://127.0.0.1:7341/v1/pressure"\n'
  } | curl -q --noproxy '*' --config -
)

release_identity_digest() {
  local platform="$1"
  local share="$HOME/.local/share/skidbladnir"
  local relative generation runtime_identity platform_key manifest manifest_bytes values
  local version source binary_identity
  case "$platform" in
  Darwin) platform_key=darwin-arm64 ;;
  Linux) platform_key=linux-amd64 ;;
  *) return 64 ;;
  esac
  [[ -L "$share/current" ]] || return 1
  relative="$(readlink "$share/current")" || return
  [[ "$relative" =~ ^releases/(v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))-([0-9a-f]{64})$ ]] ||
    return 1
  runtime_identity="${BASH_REMATCH[5]}"
  generation="$share/$relative"
  manifest="$generation/release.json"
  [[ -d "$generation" && ! -L "$generation" &&
    -x "$generation/skidbladnir" && ! -L "$generation/skidbladnir" &&
    -f "$manifest" && ! -L "$manifest" ]] || return 1
  manifest_bytes="$(LC_ALL=C wc -c <"$manifest" | tr -d '[:space:]')" || return
  [[ "$manifest_bytes" =~ ^[1-9][0-9]*$ && "$manifest_bytes" -le 4096 ]] || return 1
  json_is_single_and_duplicate_free "$(cat "$manifest")" || return
  values="$(jq -er --arg platform "$platform_key" '
    if type == "object" and keys == ["platform", "sourceSha", "version"] and
      .platform == $platform and
      (.version | type == "string" and test("^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")) and
      (.sourceSha | type == "string" and test("^[0-9a-f]{40}$"))
    then [.version, .sourceSha] | @tsv else error("invalid release manifest") end
  ' "$manifest" 2>/dev/null)" || return
  IFS=$'\t' read -r version source <<<"$values"
  [[ "$relative" == "releases/$version-$runtime_identity" ]] || return 1
  binary_identity="$("$generation/skidbladnir" version 2>/dev/null)" || return
  [[ "$binary_identity" == "$version $source" ]] || return 1
  printf 'skidbladnir-fleet-release-v3\0%s\0%s\0%s' \
    "$version" "$source" "$platform_key" | sha256_stream
}

active_runtime_is_current() {
  local share="$HOME/.local/share/skidbladnir"
  local relative generation name mode digest expected active
  local -a files=(
    skidbladnir characters.json release.json host-config.json
    providers/native-control providers/provider-command providers/shell-init
    providers/claude-agent-identity/.claude-plugin/plugin.json
    providers/claude-agent-identity/hooks/hooks.json
    providers/claude-agent-identity/bin/agent-hook
  )
  [[ -L "$share/current" ]] || return 1
  relative="$(readlink "$share/current")" || return
  [[ "$relative" =~ ^releases/v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-[0-9a-f]{64}$ ]] ||
    return 1
  generation="$share/$relative"
  [[ -d "$generation" && ! -L "$generation" ]] || return 1
  [[ "$(file_mode "$generation" 2>/dev/null)" == 700 ]] || return 1
  for name in "${files[@]}"; do
    [[ -f "$generation/$name" && ! -L "$generation/$name" ]] || return 1
    case "$name" in
    skidbladnir | providers/native-control | providers/provider-command | providers/claude-agent-identity/bin/agent-hook) mode=755 ;;
    host-config.json) mode=600 ;;
    *) mode=644 ;;
    esac
    [[ "$(file_mode "$generation/$name" 2>/dev/null)" == "$mode" ]] || return 1
  done
  expected="$({
    for name in "${files[@]}"; do
      digest="$(sha256_file "$generation/$name")" || return
      printf '%s\0%s\n' "$name" "$digest" || return
    done
  } | sha256_stream)" || return
  active="$(secret_value "$HOME/.local/state/dev-server/active/skid.runtime.sha256" \
    '^[0-9a-f]{64}$')" || return
  [[ "$active" == "$expected" && "${relative##*-}" == "$expected" ]]
}

candidate_release_digest() {
  local checkout="$1"
  local pin="$checkout/assets/skidbladnir/release-pin.json"
  local platform="$2"
  local platform_key value bytes identity version source
  case "$platform" in
  Darwin) platform_key=darwin-arm64 ;;
  Linux) platform_key=linux-amd64 ;;
  *) return 64 ;;
  esac
  tracked_file_at_head "$checkout" assets/skidbladnir/release-pin.json ||
    die 'dev-server release pin must be tracked and byte-exact at checkout HEAD'
  bytes="$(LC_ALL=C wc -c <"$pin" | tr -d '[:space:]')"
  [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 ]] ||
    die 'dev-server release pin is not bounded'
  value="$(cat "$pin")" || die 'could not read the dev-server release pin'
  json_is_single_and_duplicate_free "$value" || die 'dev-server release pin JSON is invalid'
  identity="$(printf '%s' "$value" | jq -er '
    def canonical_version:
      type == "string" and test("^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$");
    def exact_artifact($name; $version):
      type == "object" and keys == ["sha256", "url"] and
      (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      .url == ("https://github.com/NielsdaWheelz/skidbladnir/releases/download/" +
        $version + "/skidbladnir-" + $name + ".tar.gz");
    .version as $version |
    if type == "object" and keys == ["artifacts", "schemaVersion", "sourceSha", "version"] and
      .schemaVersion == 1 and
      (.version | canonical_version) and
      (.sourceSha | type == "string" and test("^[0-9a-f]{40}$")) and
      (.artifacts | type == "object" and keys == ["darwin-arm64", "linux-amd64"] and
        (."darwin-arm64" | exact_artifact("darwin-arm64"; $version)) and
        (."linux-amd64" | exact_artifact("linux-amd64"; $version)))
    then [.version, .sourceSha] | @tsv
    else error("invalid release pin") end
  ' 2>/dev/null)" || die 'dev-server release pin schema is invalid'
  IFS=$'\t' read -r version source <<<"$identity"
  printf 'skidbladnir-fleet-release-v3\0%s\0%s\0%s' \
    "$version" "$source" "$platform_key" | sha256_stream
}

service_definition_is_current() {
  local platform="$1"
  local launcher="$HOME/.local/bin/skidbladnir-launch"
  local definition active expected fragment launcher_digest definition_digest
  case "$platform" in
  Darwin) definition="$HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist" ;;
  Linux) definition="$HOME/.config/systemd/user/skidbladnir.service" ;;
  *) return 64 ;;
  esac
  [[ -f "$launcher" && ! -L "$launcher" && -O "$launcher" &&
    "$(file_mode "$launcher" 2>/dev/null)" == 755 &&
    -f "$definition" && ! -L "$definition" && -O "$definition" &&
    "$(file_mode "$definition" 2>/dev/null)" == 644 ]] || return 1
  launcher_digest="$(sha256_file "$launcher")" || return
  definition_digest="$(sha256_file "$definition")" || return
  expected="$(printf 'launcher\0%s\nunit\0%s\n' \
    "$launcher_digest" "$definition_digest" | sha256_stream)" || return
  active="$(secret_value "$HOME/.local/state/dev-server/active/skid.unit.sha256" \
    '^[0-9a-f]{64}$')" || return
  [[ "$active" == "$expected" ]] || return 1
  if [[ "$platform" == Linux ]]; then
    fragment="$(systemctl --user show skidbladnir.service \
      --property=FragmentPath --value 2>/dev/null)" || return
    [[ "$fragment" == "$definition" ]]
  fi
}

service_is_active() {
  local platform="$1"
  service_definition_is_current "$platform" || return
  case "$platform" in
  Darwin)
    local definition="$HOME/Library/LaunchAgents/dev.niels.skidbladnir.plist"
    local state
    state="$(launchctl print "gui/$(id -u)/dev.niels.skidbladnir" 2>/dev/null)" || return
    [[ "$(grep -Fc "path = $definition" <<<"$state")" == 1 ]] &&
      [[ "$(grep -Ec '^[[:space:]]*state = running$' <<<"$state")" == 1 ]]
    ;;
  Linux)
    local output bytes
    systemctl --user is-enabled --quiet skidbladnir.service || return
    output="$(systemctl --user show skidbladnir.service \
      --property=LoadState --property=ActiveState 2>&1)" || return
    bytes="$(LC_ALL=C printf '%s' "$output" | wc -c | tr -d '[:space:]')"
    [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 &&
      "$(grep -Ec '^LoadState=loaded$' <<<"$output")" == 1 &&
      "$(grep -Ec '^ActiveState=active$' <<<"$output")" == 1 &&
      "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" == yes ]]
    ;;
  *) return 64 ;;
  esac
}

tailscale_cli() {
  local platform="$1"
  local cli receipt

  case "$platform" in
  Darwin)
    cli="$macos_tailscale_app/Contents/MacOS/Tailscale"
    receipt="$macos_tailscale_app/Contents/_MASReceipt/receipt"
    [[ -d "$macos_tailscale_app" && ! -L "$macos_tailscale_app" &&
      -f "$receipt" && ! -L "$receipt" ]] || return 1
    ;;
  Linux) cli="$(command -v tailscale 2>/dev/null)" || return ;;
  *) return 64 ;;
  esac
  [[ -f "$cli" && ! -L "$cli" && -x "$cli" ]] || return 1
  printf '%s\n' "$cli"
}

private_serve_origin() {
  local platform="$1"
  local status serve dns_name key cli
  cli="$(tailscale_cli "$platform")" || return
  status="$(TAILSCALE_BE_CLI=1 "$cli" status --json 2>/dev/null)" || return
  serve="$(TAILSCALE_BE_CLI=1 "$cli" serve status --json 2>/dev/null)" || return
  json_is_single_and_duplicate_free "$status" || return
  json_is_single_and_duplicate_free "$serve" || return
  dns_name="$(printf '%s' "$status" | jq -er '
    if type == "object" and .BackendState == "Running" and
      (.Self | type == "object") and
      (.Self.DNSName | type == "string" and test("^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+\\.$"))
    then .Self.DNSName | rtrimstr(".") else error("invalid Tailscale status") end
  ' 2>/dev/null)" || return
  key="$dns_name:8443"
  printf '%s' "$serve" | jq -e --arg key "$key" '
    type == "object" and .TCP["8443"] == {"HTTPS":true} and
    ([((.Web // {}) | to_entries[]) | select(.key | endswith(":8443"))] as $owned |
      ($owned | length == 1) and
      ($owned[0].key == $key) and
      ($owned[0].value.Handlers == {"/v1":{"Proxy":"http://127.0.0.1:7341/v1"}}) and
      (((.AllowFunnel // {})[$key] // false) == false) and
      ([((.AllowFunnel // {}) | to_entries[]) |
        select((.key | endswith(":8443")) and .value == true)] | length == 0))
  ' >/dev/null 2>&1 || return
  printf 'https://%s:8443/\n' "$dns_name"
}

validate_host_platform() {
  case "$1:$2" in
  Darwin:macbook | Linux:devbox | Linux:arch) ;;
  *) return 1 ;;
  esac
}

verify_host() {
  local platform="$1"
  local label="$2"
  local expected_handle origin pressure pressure_bytes runtime
  validate_host_platform "$platform" "$label" || return 64
  [[ "$(uname -s)" == "$platform" ]] || {
    printf 'error: %s runtime platform does not match %s\n' "$label" "$platform" >&2
    return 1
  }
  expected_handle="$(secret_value "$HOME/.config/skidbladnir/machine-handle" '^mh-[0-9a-f]{32}$')" || {
    printf 'error: %s machine handle is invalid\n' "$label" >&2
    return 1
  }
  secret_value "$HOME/.config/skidbladnir/bearer" \
    '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$' >/dev/null || {
    printf 'error: %s bearer is invalid\n' "$label" >&2
    return 1
  }
  service_is_active "$platform" || {
    printf 'error: %s gateway service is not enabled and active\n' "$label" >&2
    return 1
  }
  active_runtime_is_current || {
    printf 'error: %s active runtime identity does not match the current generation\n' "$label" >&2
    return 1
  }
  runtime="$(release_identity_digest "$platform")" || {
    printf 'error: %s installed release identity is invalid\n' "$label" >&2
    return 1
  }
  [[ "$runtime" =~ ^[0-9a-f]{64}$ ]] || return 1
  origin="$(private_serve_origin "$platform")" || {
    printf 'error: %s private Tailscale Serve mapping is invalid or unavailable\n' "$label" >&2
    return 1
  }
  pressure="$(authenticated_get 2>/dev/null)" || {
    printf 'error: %s authenticated pressure endpoint is unavailable\n' "$label" >&2
    return 1
  }
  pressure_bytes="$(LC_ALL=C printf '%s' "$pressure" | wc -c | tr -d '[:space:]')"
  [[ "$pressure_bytes" =~ ^[1-9][0-9]*$ && "$pressure_bytes" -le 262144 ]] || {
    printf 'error: %s pressure response is not bounded\n' "$label" >&2
    return 1
  }
  if ! json_is_single_and_duplicate_free "$pressure" ||
    ! printf '%s' "$pressure" | jq -e '
      type == "object" and keys == ["current", "history", "unsupported"] and
      (.current | type == "object" and
        keys == ["level", "missing", "phase", "reasons", "sampledAt", "signals"] and
        (.sampledAt | type == "string" and length > 0) and
        (.level == "Normal" or .level == "Warm" or .level == "Hot" or .level == "Unknown") and
        (.phase == "Steady" or .phase == "Recovering") and
        (.reasons | type == "array" and all(.[]; type == "string")) and
        (.signals | type == "object") and
        (.missing | type == "array" and all(.[]; type == "string"))) and
      (.history | type == "array" and all(.[];
        type == "object" and keys == ["level", "sampledAt"] and
        (.sampledAt | type == "string" and length > 0) and
        (.level == "Normal" or .level == "Warm" or .level == "Hot" or .level == "Unknown"))) and
      (.unsupported | type == "array" and all(.[]; type == "string"))
    ' >/dev/null 2>&1; then
    printf 'error: %s pressure response is invalid\n' "$label" >&2
    return 1
  fi
  printf '%s\t%s\t%s\t%s\n' "$expected_handle" "$platform" "$runtime" "$origin"
}

# The operator transfers this private configuration once; clients then route
# directly to each peer over HTTPS. Re-run after rotating a host bearer.
client_peer() (
  set +x
  local platform="$1" label="$2" machine origin bearer
  validate_host_platform "$platform" "$label" || return 64
  [[ "$(uname -s)" == "$platform" ]] || return 1
  machine="$(secret_value "$HOME/.config/skidbladnir/machine-handle" '^mh-[0-9a-f]{32}$')" || return
  bearer="$(secret_value "$HOME/.config/skidbladnir/bearer" '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$')" || return
  origin="$(private_serve_origin "$platform")" || return
  printf '%s\n' "$bearer" | jq -Rn --arg label "$label" --arg machine "$machine" --arg origin "$origin" \
    '{label:$label,machine:$machine,origin:$origin,bearer:input}'
)

install_client_config() (
  set -euo pipefail
  set +x
  umask 077
  local config temporary
  config="$HOME/.config/skidbladnir"
  mkdir -p "$config" || return
  temporary="$(mktemp "$config/.client.XXXXXX")" || return
  trap 'rm -f -- "$temporary"' EXIT
  cat >"$temporary" || return
  chmod 0600 "$temporary" || return
  mv -f -- "$temporary" "$config/client.json"
)

provision_clients() (
  set +x
  local temporary command label
  temporary="$(mktemp "${TMPDIR:-/tmp}/skidbladnir-clients.XXXXXX")" || return
  trap 'rm -f -- "$temporary"' EXIT
  {
    client_peer Darwin macbook || exit 1
    remote_host client-peer devbox || exit 1
    remote_host client-peer arch || exit 1
  } | jq -s '{peers:.}' >"$temporary" || return
  jq -e '
    (.peers | map(.label)) == ["macbook", "devbox", "arch"] and
    all(.peers[];
      (.machine | type == "string" and test("^mh-[0-9a-f]{32}$")) and
      (.bearer | type == "string" and test("^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$")) and
      (.origin | type == "string" and test("^https://[a-z0-9.-]+:8443/$"))) and
    (.peers | map(.machine) | unique | length) == 3 and
    (.peers | map(.origin) | unique | length) == 3 and
    (.peers | map(.bearer) | unique | length) == 3
  ' "$temporary" >/dev/null 2>&1 || die 'fleet client identities, origins, or credentials are invalid or not unique'
  install_client_config <"$temporary" || return
  for label in devbox arch; do
    command="$(declare -f install_client_config)"
    command+=$'\ninstall_client_config'
    printf -v command 'bash -c %q' "$command"
    fleet_ssh "$label" "$command" <"$temporary" || return
  done
  printf 'private peer configuration installed on macbook, devbox, and arch\n'
)

host_main() {
  local action="${1:-}"
  local platform="${2:-}"
  local label="${3:-}"
  [[ "${SKIDBLADNIR_FLEET_TRANSPORT:-}" == fleet-host-v1 ]] || return 64
  [[ $# -eq 3 ]] || return 64
  validate_host_platform "$platform" "$label" || return 64
  case "$action" in
  client-peer)
    client_peer "$platform" "$label"
    ;;
  verify)
    verify_host "$platform" "$label"
    ;;
  *) return 64 ;;
  esac
}

fleet_ssh() {
  local label="$1"
  shift
  case "$label" in
  devbox)
    local config="$HOME/.ssh/config.d/dev-server"
    [[ -f "$config" && ! -L "$config" && -O "$config" &&
      "$(file_mode "$config" 2>/dev/null)" == 600 ]] ||
      die 'managed devbox SSH config is unavailable or not mode 0600'
    ssh -F "$config" -T -o BatchMode=yes -o RequestTTY=no -o ConnectTimeout=10 \
      -o ConnectionAttempts=1 dev-server "$@"
    ;;
  arch)
    ssh -T -o BatchMode=yes -o RequestTTY=no -o ConnectTimeout=10 -o ConnectionAttempts=1 \
      nnandal@arch "$@"
    ;;
  *) return 64 ;;
  esac
}

remote_host() {
  local action="$1"
  local label="$2"
  [[ $# -eq 2 ]] || return 64
  [[ -f "$fleet_source" && ! -L "$fleet_source" ]] || die 'fleet operator source is unavailable'
  case "$action" in
  verify | client-peer)
    fleet_ssh "$label" env SKIDBLADNIR_FLEET_TRANSPORT=fleet-host-v1 \
      bash -s -- _host "$action" Linux "$label" <"$fleet_source"
    ;;
  *) return 64 ;;
  esac
}

verify_fleet() {
  local expected_darwin_release="$1"
  local expected_linux_release="$2"
  local local_result='' devbox_result='' arch_result=''
  local identity_separator=$'\t'
  local local_handle local_platform local_release local_origin
  local devbox_handle devbox_platform devbox_release devbox_origin
  local arch_handle arch_platform arch_release arch_origin
  local failures=0
  local_result="$(verify_host Darwin macbook)" || failures=$((failures + 1))
  devbox_result="$(remote_host verify devbox)" || failures=$((failures + 1))
  arch_result="$(remote_host verify arch)" || failures=$((failures + 1))
  if ((failures > 0)); then
    printf 'error: fleet gateway verification failed on %d host%s\n' \
      "$failures" "$([[ "$failures" == 1 ]] || printf s)" >&2
    return 1
  fi
  [[ "$local_result" =~ ^mh-[0-9a-f]{32}${identity_separator}Darwin${identity_separator}[0-9a-f]{64}${identity_separator}https://[a-z0-9.-]+:8443/$ &&
    "$devbox_result" =~ ^mh-[0-9a-f]{32}${identity_separator}Linux${identity_separator}[0-9a-f]{64}${identity_separator}https://[a-z0-9.-]+:8443/$ &&
    "$arch_result" =~ ^mh-[0-9a-f]{32}${identity_separator}Linux${identity_separator}[0-9a-f]{64}${identity_separator}https://[a-z0-9.-]+:8443/$ ]] ||
    die 'fixed-fleet verification returned invalid host identity'
  IFS=$'\t' read -r local_handle local_platform local_release local_origin <<<"$local_result"
  IFS=$'\t' read -r devbox_handle devbox_platform devbox_release devbox_origin <<<"$devbox_result"
  IFS=$'\t' read -r arch_handle arch_platform arch_release arch_origin <<<"$arch_result"
  [[ "$local_platform" == Darwin && "$devbox_platform" == Linux && "$arch_platform" == Linux ]] ||
    die 'fixed-fleet verification returned invalid platforms'
  [[ "$devbox_release" == "$arch_release" ]] ||
    die 'fixed-fleet Linux release identities differ'
  [[ "$local_release" == "$expected_darwin_release" &&
    "$devbox_release" == "$expected_linux_release" ]] ||
    die 'fixed-fleet release identities do not match the dev-server release pin'
  [[ "$local_handle" != "$devbox_handle" && "$local_handle" != "$arch_handle" &&
    "$devbox_handle" != "$arch_handle" ]] || die 'fixed-fleet machine handles are not unique'
  [[ "$local_origin" != "$devbox_origin" && "$local_origin" != "$arch_origin" &&
    "$devbox_origin" != "$arch_origin" ]] || die 'fixed-fleet Serve origins are not unique'
  printf 'PASS  fleet.verify macbook gateway available\n'
  printf 'PASS  fleet.verify devbox gateway available\n'
  printf 'PASS  fleet.verify arch gateway available\n'
  printf 'Fleet gateway verification: pass.\n'
}

invite_response_is_valid() {
  local response="$1"
  local platform="$2"
  local handle="$3"
  local bytes
  bytes="$(LC_ALL=C printf '%s' "$response" | wc -c | tr -d '[:space:]')"
  [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 ]] || return 1
  json_is_single_and_duplicate_free "$response" || return
  # The gateway owns expiry; comparing wall clocks across machines rejects valid invites.
  printf '%s' "$response" | jq -e --arg platform "$platform" --arg handle "$handle" '
    type == "object" and keys == ["expiresAt", "machine", "pairingInviteToken"] and
    (.pairingInviteToken | type == "string" and test("^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$")) and
    (.expiresAt | type == "string" and
      test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$")) and
    (.expiresAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | type == "number") and
    (.machine | type == "object" and keys == ["handle", "platform"] and
      .handle == $handle and
      .platform == $platform)
  ' >/dev/null 2>&1
}

invite() (
  set +x
  local config_file="$HOME/.config/skidbladnir/client.json"
  local config peers label origin handle bearer display_label platform response
  local machines='[]' payload bytes
  [[ -f "$config_file" && ! -L "$config_file" && "$(file_mode "$config_file")" == 600 ]] ||
    die 'invite requires ~/.config/skidbladnir/client.json with mode 0600, as used by skid'
  config="$(cat "$config_file")" || return
  json_is_single_and_duplicate_free "$config" 2>/dev/null || die 'client configuration is invalid'
  peers="$(printf '%s' "$config" | jq -er '
    .peers | map(select(.label | ascii_downcase | IN("arch", "devbox", "macbook"))) |
    map(.label |= ascii_downcase | .origin |= (ascii_downcase | rtrimstr("/") + "/")) |
    sort_by(.label) |
    if map(.label) == ["arch", "devbox", "macbook"] and
      all(.[];
        (.machine | type == "string" and test("^mh-[0-9a-f]{32}$")) and
        (.bearer | type == "string" and test("^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$")) and
        (.origin | test("^https://([a-z0-9.-]+|\\[[0-9a-f:.]+\\]):8443/$"))) and
      (map(.machine) | unique | length) == 3 and
      (map(.origin) | unique | length) == 3
    then .[] | [.label, .origin, .machine, .bearer] | @tsv
    else error("invalid fleet peers") end
  ' 2>/dev/null)" || die 'client configuration must contain distinct arch, devbox, and macbook peers'

  while IFS=$'\t' read -r label origin handle bearer; do
    case "$label" in
    arch)
      display_label=Arch
      platform=Linux
      ;;
    devbox)
      display_label=Devbox
      platform=Linux
      ;;
    macbook)
      display_label=MacBook
      platform=Darwin
      ;;
    esac
    # Credentials travel over stdin, never through process arguments or files.
    response="$(
      {
        printf 'silent\nfail\nconnect-timeout = 5\nmax-time = 10\nmax-filesize = 4096\n'
        printf 'request = "POST"\nwrite-out = "\\n%%{http_code}"\n'
        printf 'header = "Authorization: Bearer %s"\n' "$bearer"
        printf 'header = "Skidbladnir-Machine: %s"\n' "$handle"
        printf 'url = "%sv1/pairing-invites"\n' "$origin"
      } | curl -q --noproxy '*' --config - 2>/dev/null | LC_ALL=C head -c 4101
    )" || die "$label invitation failed; check its connection and client credentials, then rerun scripts/fleet invite"
    [[ "$response" == *$'\n201' ]] || die "$label did not create an invitation; rerun scripts/fleet invite"
    response="${response%$'\n201'}"
    invite_response_is_valid "$response" "$platform" "$handle" 2>/dev/null ||
      die "$label returned an invalid invitation; rerun scripts/fleet invite"
    machines="$(printf '%s\n%s\n' "$machines" "$response" | jq -cs \
      --arg label "$display_label" --arg origin "$origin" --arg handle "$handle" '
        .[0] + [{label:$label, origin:$origin, machineHandle:$handle,
          pairingInviteToken:.[1].pairingInviteToken}]
      ')" || return
  done <<<"$peers"
  payload="$(printf '%s' "$machines" | jq -c '{kind:"skidbladnir.fleet-invite.v1", machines:.}')" || return
  printf '%s' "$payload" | jq -e '
    (.machines | map(.machineHandle) | unique | length) == 3 and
    (.machines | map(.pairingInviteToken) | unique | length) == 3
  ' >/dev/null || die 'fleet invitation responses are not unique'
  bytes="$(LC_ALL=C printf '%s' "$payload" | wc -c | tr -d '[:space:]')"
  [[ "$bytes" =~ ^[1-9][0-9]*$ && "$bytes" -le 4096 ]] ||
    die 'fleet invitation exceeds the 4096-byte QR limit'
  printf '%s\n' \
    'fleet invite ready; valid for up to 5 minutes, once. scan with connect or reconnect fleet in the app.'
  printf '%s' "$payload" | qrencode -t ANSIUTF8
)

usage() {
  cat <<'EOF'
usage: scripts/fleet <verify|invite|provision-clients>

invite uses ~/.config/skidbladnir/client.json on linux or macos; requires jq,
curl, qrencode, and a tailnet connection. it prints one qr and exits.

verify and provision-clients run on the macbook and use the managed devbox
ssh config. provision-clients copies private credentials to macbook, devbox,
and arch; it requires tailscale and ssh, not a deployment checkout.

verify requires SKIDBLADNIR_DEV_SERVER_CHECKOUT naming the exact local dev-server
checkout with its release pin tracked and byte-exact at HEAD.
EOF
}

require_checkout() {
  local declared="${SKIDBLADNIR_DEV_SERVER_CHECKOUT:-}"
  [[ "$declared" == /* && -d "$declared" && ! -L "$declared" ]] ||
    die 'SKIDBLADNIR_DEV_SERVER_CHECKOUT must name an absolute, non-symlink directory'
  dev_server_checkout="$(cd "$declared" && pwd -P)"
}

main() {
  local command="${1:-}"
  local expected_darwin_release expected_linux_release
  if [[ "$command" == _host ]]; then
    shift
    host_main "$@"
    return
  fi
  [[ $# -eq 1 ]] || {
    usage >&2
    return 64
  }
  case "$command" in
  help | -h | --help)
    usage
    return
    ;;
  verify | invite | provision-clients) ;;
  *)
    usage >&2
    return 64
    ;;
  esac
  require_command jq
  if [[ "$command" == invite ]]; then
    require_command curl
    require_command qrencode
    invite
    return
  fi
  [[ "$(uname -s)" == Darwin ]] || die 'this fleet command requires the MacBook'
  require_command ssh
  fleet_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/fleet"
  case "$command" in
  verify)
    require_checkout
    require_command git
    require_command curl
    expected_darwin_release="$(candidate_release_digest "$dev_server_checkout" Darwin)" || return
    expected_linux_release="$(candidate_release_digest "$dev_server_checkout" Linux)" || return
    verify_fleet "$expected_darwin_release" "$expected_linux_release"
    ;;
  provision-clients)
    provision_clients
    ;;
  esac
}

dev_server_checkout=''
fleet_source=''
main "$@"
