#!/usr/bin/env bash
# Rebuild android/app/src/main/assets/terminal/vendor/xterm-6.0.0-skidbladnir.js
# from xterm.js tag 6.0.0 (commit f447274f430fd22513f6adbf9862d19524471c04) plus
# android/xterm-6.0.0-skidbladnir.patch. The patch's src/, test/ and typings/
# hunks add the semantic wheel/tap/selection input API. Its package.json,
# package-lock.json and addon-ligatures hunks are a build-only toolchain refresh,
# once an audit remediation; its eslint/nyc/axios/qs bumps only keep the
# manifests in step with the lock. The committed bytes depend on the webpack and
# terser versions it pins; the tag's own lock yields different bytes. Lint is not
# maintained in the patched tree. Git and npm user config are ignored so only the
# pinned inputs reach the build. To check reproducibility, run this and
# `git diff` the bundle.
#
# The other vendored files are verbatim upstream copies:
# xterm-6.0.0.css and xterm-6.0.0.LICENSE from npm @xterm/xterm@6.0.0;
# xterm-addon-fit-0.11.0.{js,LICENSE} from npm @xterm/addon-fit@0.11.0;
# JetBrainsMono-{Regular,Bold}.woff2 and OFL.txt (as JetBrainsMono-2.304.LICENSE)
# from fonts/webfonts/ of the JetBrains Mono v2.304 release zip.
set -euo pipefail
(( $# == 0 )) || { printf 'usage: scripts/build-terminal-xterm\n' >&2; exit 2; }
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 NPM_CONFIG_USERCONFIG=/dev/null

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source_dir="$(mktemp -d)"
trap 'rm -rf -- "$source_dir"' EXIT
node=(mise exec node@22.23.2 --)

git -C "$source_dir" init --quiet
git -C "$source_dir" fetch --quiet --depth 1 https://github.com/xtermjs/xterm.js.git \
  f447274f430fd22513f6adbf9862d19524471c04
git -C "$source_dir" checkout --quiet --detach FETCH_HEAD
git -C "$source_dir" apply "$repo_dir/android/xterm-6.0.0-skidbladnir.patch"
cd "$source_dir"
"${node[@]}" npm ci --ignore-scripts --no-audit --no-fund
"${node[@]}" npm run build
"${node[@]}" node_modules/.bin/webpack --config webpack.config.js
cp lib/xterm.js "$repo_dir/android/app/src/main/assets/terminal/vendor/xterm-6.0.0-skidbladnir.js"
