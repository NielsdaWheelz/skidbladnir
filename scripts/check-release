#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

case "$(uname -s)" in
  Darwin)
    android_sdk="${ANDROID_HOME:-/Users/nnandal/Library/Android/sdk}"
    digest_command=(shasum -a 256)
    native_archive='skidbladnir-darwin-arm64.tar.gz'
    ;;
  Linux)
    android_sdk="${ANDROID_HOME:-/home/niels/Android/Sdk}"
    digest_command=(sha256sum)
    native_archive='skidbladnir-linux-amd64.tar.gz'
    ;;
  *)
    printf 'Release checks support only Linux and Darwin\n' >&2
    exit 1
    ;;
esac

parse_tag() {
  local tag="$1"
  local major
  local minor
  local patch
  [[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || return 1
  major="${BASH_REMATCH[1]}"
  minor="${BASH_REMATCH[2]}"
  patch="${BASH_REMATCH[3]}"
  ((${#major} <= 4 && ${#minor} <= 3 && ${#patch} <= 3)) || return 1
  ((10#$major <= 2100 && 10#$minor <= 999 && 10#$patch <= 999)) || return 1
  release_version_name="${major}.${minor}.${patch}"
  release_version_code=$((10#$major * 1000000 + 10#$minor * 1000 + 10#$patch))
  ((release_version_code > 1 && release_version_code <= 2100000000))
}

validate_sha() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

validate_release_source() {
  local requested_dir
  local source_root
  requested_dir="$(cd "$1" && pwd -P)" || return 1
  source_root="$(git -C "$requested_dir" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$source_root" == "$requested_dir" &&
    "$(git -C "$source_root" rev-parse HEAD 2>/dev/null)" == "$2" &&
    -z "$(git -C "$source_root" status --porcelain=v1 --untracked-files=all)" ]]
}

validate_manifest_file() {
  local manifest_file="$1"
  local tag="$2"
  local sha="$3"
  local platform="$4"
  local observed_keys
  [[ -f "$manifest_file" && ! -L "$manifest_file" ]] || return 1
  observed_keys="$(
    jq --stream -er '
      if length == 1 then empty
      elif length == 2 and (.[0] | length) == 1 then .[0][0]
      else "__SKIDBLADNIR_INVALID_NESTING__"
      end
    ' "$manifest_file" | LC_ALL=C sort
  )" || return 1
  [[ "$observed_keys" == $'platform\nsourceSha\nversion' ]] || return 1
  jq -e \
    --arg tag "$tag" \
    --arg sha "$sha" \
    --arg platform "$platform" \
    'type == "object" and
     keys == ["platform", "sourceSha", "version"] and
     .version == $tag and .sourceSha == $sha and .platform == $platform' \
    "$manifest_file" >/dev/null
}

file_mode() {
  case "$(uname -s)" in
    Darwin) stat -f '%Lp' "$1" ;;
    Linux) stat -c '%a' "$1" ;;
  esac
}

extract_release_archive() (
  set -euo pipefail
  local archive="$1"
  local destination="$2"
  shift 2
  # The private staging directory is the confidentiality boundary. Preserve the
  # release's owned member modes instead of inheriting an operator's umask.
  umask 022
  tar -xzf "$archive" -C "$destination" "$@"
)

find_apkanalyzer() {
  local candidate
  while IFS= read -r candidate; do
    [[ -x "$candidate" ]] && printf '%s\n' "$candidate"
  done < <(find "$android_sdk" -path '*/bin/apkanalyzer' -type f 2>/dev/null | sort)
}

verify_archive_metadata() {
  python3 - "$1" "$2" <<'PY'
import pathlib
import sys
import tarfile

expected = {"skidbladnir": (False, 0o755), "characters.json": (False, 0o644),
            "release.json": (False, 0o644)}
if sys.argv[2] == "darwin-arm64":
    for name in ("Skid.app", "Skid.app/Contents", "Skid.app/Contents/MacOS",
                 "Skid.app/Contents/Resources", "Skid.app/Contents/_CodeSignature"):
        expected[name] = (True, 0o755)
    for name in ("Info.plist", "Resources/skid.icns", "_CodeSignature/CodeResources"):
        expected["Skid.app/Contents/" + name] = (False, 0o644)
    expected["Skid.app/Contents/MacOS/skid-notifications"] = (False, 0o755)
seen = set()
with tarfile.open(sys.argv[1], "r:gz") as archive:
    for member in archive:
        name = member.name.rstrip("/")
        if name not in expected or name in seen:
            sys.exit("release archive has unexpected or duplicate members")
        seen.add(name)
        directory, mode = expected[name]
        if (not (member.isdir() if directory else member.isfile()) or
                member.mode != mode):
            sys.exit("release archive member type or mode differs")
        if any(key.startswith(("LIBARCHIVE.xattr.", "SCHILY.xattr.")) for key in member.pax_headers):
            sys.exit(f"{pathlib.Path(sys.argv[1]).name} contains forbidden extended-attribute metadata")
if seen != set(expected):
    sys.exit("release archive is missing required members")
PY
}

verify_go_identity() {
  local binary="$1" goos="$2" goarch="$3" build_info
  build_info="$(GOTOOLCHAIN=local go version -m "$binary")" || return 1
  grep -Fqx $'\tbuild\tGOOS='"$goos" <<<"$build_info" &&
    grep -Fqx $'\tbuild\tGOARCH='"$goarch" <<<"$build_info" &&
    ! grep -Fq $'\tbuild\tvcs=' <<<"$build_info"
}

verify_mac_app() {
  local app="$1" tag="$2" sha="$3" stage="$4" pin observed expected
  [[ "$(uname -s)" == Darwin ]] || {
    printf 'NOT_RUN: native macOS is required to verify the signed app\n' >&2
    return 2
  }
  pin="$(cat "$source_dir/macos/app-signing-cert.sha256")"
  [[ "$pin" =~ ^[0-9a-f]{64}$ && "$(wc -l <"$source_dir/macos/app-signing-cert.sha256" | tr -d ' ')" == 1 ]] || return 1
  cmp -s "$source_dir/macos/app-signing-cert.sha256" "$repo_dir/macos/app-signing-cert.sha256" || return 1
  codesign --verify --strict "$app" >/dev/null 2>&1 || return 1
  codesign --display --extract-certificates="$stage/mac-cert" "$app" >/dev/null 2>&1 || return 1
  [[ -f "$stage/mac-cert0" ]] || return 1
  observed="$("${digest_command[@]}" "$stage/mac-cert0" | awk '{print $1}')"
  [[ "$observed" == "$pin" ]] || return 1
  python3 - "$app/Contents/Info.plist" "$tag" "$sha" "$source_dir" "$reproduce" <<'PY' || return 1
import pathlib, plistlib, sys
with open(sys.argv[1], "rb") as stream:
    value = plistlib.load(stream)
if any(value.get(key) != expected for key, expected in {
        "CFBundleIdentifier": "dev.niels.skidbladnir",
        "CFBundleExecutable": "skid-notifications",
        "CFBundleIconFile": "skid", "CFBundleShortVersionString": sys.argv[2][1:],
        "CFBundleVersion": sys.argv[2][1:], "SkidSourceSHA": sys.argv[3]}.items()):
    raise SystemExit("signed mac app identity differs from release")
if sys.argv[5]:
    expected = plistlib.loads(pathlib.Path(sys.argv[4], "macos/Info.plist").read_bytes())
    expected.update(CFBundleShortVersionString=sys.argv[2][1:],
                    CFBundleVersion=sys.argv[2][1:], SkidSourceSHA=sys.argv[3])
    if value != expected:
        raise SystemExit("signed mac app metadata differs from release source")
PY
  verify_go_identity "$app/Contents/MacOS/skid-notifications" darwin arm64 || return 1
  [[ "$("$app/Contents/MacOS/skid-notifications" version)" == "$tag $sha" ]] || return 1
  if [[ -n "$reproduce" ]]; then
    codesign --display --entitlements "$stage/observed-entitlements.plist" --xml "$app" >/dev/null 2>&1 || return 1
    python3 - "$source_dir/macos/entitlements.plist" "$stage/observed-entitlements.plist" <<'PY' || return 1
import plistlib, sys
with open(sys.argv[1], "rb") as stream:
    expected = plistlib.load(stream)
with open(sys.argv[2], "rb") as stream:
    observed = plistlib.load(stream)
if observed != expected:
    raise SystemExit("signed mac app entitlements differ from release source")
PY
    "$repo_dir/scripts/build-mac-icon" "$source_dir" "$stage/expected-skid.icns" || return 1
    cmp -s "$stage/expected-skid.icns" "$app/Contents/Resources/skid.icns" || return 1
    expected="$stage/expected-notifications"
    (cd "$source_dir" && GOTOOLCHAIN=local GOOS=darwin GOARCH=arm64 CGO_ENABLED=1 \
      go build -buildvcs=false -mod=readonly -trimpath \
        -ldflags "-s -w -X main.releaseVersion=$tag -X main.releaseSHA=$sha" \
        -o "$expected" ./cmd/skid-notifications) || return 1
    cp "$app/Contents/MacOS/skid-notifications" "$stage/observed-notifications" || return 1
    # Apple signing normalizes __LINKEDIT allocation. Match that metadata on
    # private audit copies before stripping; the verified release is untouched.
    codesign --force --sign - --timestamp=none --options 0 \
      --identifier dev.niels.skidbladnir.reproduction \
      "$expected" "$stage/observed-notifications" || return 1
    codesign --remove-signature "$expected" "$stage/observed-notifications" || return 1
    cmp -s "$expected" "$stage/observed-notifications" || return 1
  fi
}

verify_archive() (
  set -euo pipefail
  local archive="$1"
  local tag="$2"
  local sha="$3"
  local platform="$4"
  local goos="$5"
  local goarch="$6"
  local staging_dir
  local expected_binary
  verify_archive_metadata "$archive" "$platform" || return 1
  staging_dir="$(mktemp -d /tmp/skidbladnir-archive-check.XXXXXX)"
  case "$staging_dir" in
    /tmp/skidbladnir-archive-check.* | /private/tmp/skidbladnir-archive-check.*) ;;
    *) printf 'Unexpected archive-check staging directory\n' >&2; return 1 ;;
  esac
  # shellcheck disable=SC2064 # bind the path before function scope unwinds.
  trap "rm -R -- $(printf '%q' "$staging_dir")" EXIT HUP INT TERM
  extract_release_archive "$archive" "$staging_dir"
  [[ -f "$staging_dir/skidbladnir" && ! -L "$staging_dir/skidbladnir" &&
    "$(file_mode "$staging_dir/skidbladnir")" == 755 ]] || {
    printf '%s does not contain one mode-0755 regular binary\n' "$(basename "$archive")" >&2
    return 1
  }
  for member in characters.json release.json; do
    [[ -f "$staging_dir/$member" && ! -L "$staging_dir/$member" &&
      "$(file_mode "$staging_dir/$member")" == 644 ]] || {
      printf '%s member %s is not a mode-0644 regular file\n' "$(basename "$archive")" "$member" >&2
      return 1
    }
  done
  validate_manifest_file "$staging_dir/release.json" "$tag" "$sha" "$platform" || {
    printf '%s has an invalid release manifest\n' "$(basename "$archive")" >&2
    return 1
  }
  cmp -s "$source_dir/catalog/characters.json" "$staging_dir/characters.json" || {
    printf '%s catalogue differs from the exact release source\n' "$(basename "$archive")" >&2
    return 1
  }
  if [[ -n "$reproduce" ]]; then
    expected_binary="$staging_dir/expected-skidbladnir"
    "$repo_dir/scripts/build-host-binary" \
      "$source_dir" "$tag" "$sha" "$goos" "$goarch" "$expected_binary" || {
      printf '%s exact-source binary reproduction failed\n' "$(basename "$archive")" >&2
      return 1
    }
    cmp -s "$expected_binary" "$staging_dir/skidbladnir" || {
      printf '%s binary differs from the exact release source\n' "$(basename "$archive")" >&2
      return 1
    }
  fi
  verify_go_identity "$staging_dir/skidbladnir" "$goos" "$goarch" || return 1
  if [[ "$goos" == darwin ]]; then
    verify_mac_app "$staging_dir/Skid.app" "$tag" "$sha" "$staging_dir"
  fi
)

if [[ "${1:-}" == '--android-version' && "$#" -eq 2 ]]; then
  parse_tag "$2" || {
    printf 'Release tag must be canonical vMAJOR.MINOR.PATCH with a monotonic Android code\n' >&2
    exit 1
  }
  printf '%s %s\n' "$release_version_name" "$release_version_code"
  exit
fi

reproduce=''
source_dir="$repo_dir"
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --reproduce) reproduce=1; shift ;;
    --source)
      [[ "$#" -ge 2 ]] || {
        printf '%s requires a source directory\n' "$1" >&2
        exit 64
      }
      source_dir="$2"
      shift 2
      ;;
    --) shift; break ;;
    -*) printf 'Unknown release-check option: %s\n' "$1" >&2; exit 64 ;;
    *) break ;;
  esac
done
if [[ "$#" -ne 3 ]]; then
  printf 'usage: %s [--reproduce] [--source SOURCE_DIRECTORY] RELEASE_DIRECTORY TAG SOURCE_SHA\n' "$0" >&2
  exit 64
fi

release_dir="$1"
tag="$2"
sha="$3"
parse_tag "$tag" || {
  printf 'Release tag must be canonical vMAJOR.MINOR.PATCH with a monotonic Android code\n' >&2
  exit 1
}
validate_sha "$sha" || {
  printf 'Release source SHA must be one full lowercase Git SHA-1\n' >&2
  exit 1
}
validate_release_source "$source_dir" "$sha" || {
  printf 'Release source must be a clean repository root at the exact source SHA\n' >&2
  exit 1
}
if [[ -n "$reproduce" ]]; then
  GOTOOLCHAIN=local "$source_dir/scripts/check-go-toolchain" >/dev/null
fi
[[ -d "$release_dir" ]] || {
  printf 'Release directory is unavailable\n' >&2
  exit 1
}

expected_assets=$'SHA256SUMS\nandroid-signing-cert.sha256\nskidbladnir-android.apk\nskidbladnir-darwin-arm64.tar.gz\nskidbladnir-linux-amd64.tar.gz'
observed_assets="$(find "$release_dir" -mindepth 1 -maxdepth 1 -exec basename {} \; | LC_ALL=C sort)"
[[ "$observed_assets" == "$expected_assets" ]] || {
  printf 'Release directory does not contain the exact five owned assets\n' >&2
  exit 1
}
[[ -z "$(find "$release_dir" -mindepth 1 -maxdepth 1 ! -type f -print -quit)" ]] || {
  printf 'Every release asset must be a regular file\n' >&2
  exit 1
}

cmp -s "$source_dir/android/app-signing-cert.sha256" "$release_dir/android-signing-cert.sha256" || {
  printf 'Release signer fingerprint differs from the repository pin\n' >&2
  exit 1
}
cmp -s "$source_dir/android/app-signing-cert.sha256" "$repo_dir/android/app-signing-cert.sha256" || {
  printf 'Release source signer differs from the current certificate pin\n' >&2
  exit 1
}

expected_checksum_names=$'android-signing-cert.sha256\nskidbladnir-android.apk\nskidbladnir-darwin-arm64.tar.gz\nskidbladnir-linux-amd64.tar.gz'
awk '
  !/^[0-9a-f]{64}  [A-Za-z0-9._-]+$/ { invalid = 1 }
  END { exit invalid || NR != 4 }
' "$release_dir/SHA256SUMS" || {
  printf 'SHA256SUMS is not the strict four-asset manifest\n' >&2
  exit 1
}
observed_checksum_names="$(awk '{ print $2 }' "$release_dir/SHA256SUMS" | LC_ALL=C sort)"
[[ "$observed_checksum_names" == "$expected_checksum_names" ]] || {
  printf 'SHA256SUMS does not name each non-checksum asset exactly once\n' >&2
  exit 1
}
(cd "$release_dir" && "${digest_command[@]}" -c SHA256SUMS >/dev/null) || {
  printf 'Release checksum verification failed\n' >&2
  exit 1
}

verify_archive "$release_dir/skidbladnir-linux-amd64.tar.gz" "$tag" "$sha" \
  'linux-amd64' linux amd64
verify_archive "$release_dir/skidbladnir-darwin-arm64.tar.gz" "$tag" "$sha" \
  'darwin-arm64' darwin arm64
"$repo_dir/scripts/check-android-signing" --public-apk \
  "$release_dir/skidbladnir-android.apk"

apkanalyzer="$(find_apkanalyzer | tail -n 1)"
[[ -x "$apkanalyzer" ]] || {
  printf 'Android apkanalyzer is unavailable under the configured SDK\n' >&2
  exit 1
}
[[ "$($apkanalyzer manifest version-name "$release_dir/skidbladnir-android.apk")" == "$release_version_name" ]] || {
  printf 'APK versionName does not match the release tag\n' >&2
  exit 1
}
[[ "$($apkanalyzer manifest version-code "$release_dir/skidbladnir-android.apk")" == "$release_version_code" ]] || {
  printf 'APK versionCode does not match the canonical release code\n' >&2
  exit 1
}
[[ "$($apkanalyzer manifest application-id "$release_dir/skidbladnir-android.apk")" == 'dev.niels.skidbladnir' ]] || {
  printf 'APK application id is not the production package\n' >&2
  exit 1
}
[[ "$($apkanalyzer manifest min-sdk "$release_dir/skidbladnir-android.apk")" == 36 &&
  "$($apkanalyzer manifest target-sdk "$release_dir/skidbladnir-android.apk")" == 36 ]] || {
  printf 'APK SDK boundary is not exact API 36\n' >&2
  exit 1
}
[[ "$($apkanalyzer manifest debuggable "$release_dir/skidbladnir-android.apk")" == false ]] || {
  printf 'APK is debuggable instead of a production release\n' >&2
  exit 1
}
if "$apkanalyzer" manifest permissions "$release_dir/skidbladnir-android.apk" |
  grep -Fqx 'android.permission.CAMERA'; then
  printf 'APK unexpectedly requests camera permission\n' >&2
  exit 1
fi

staging_dir="$(mktemp -d /tmp/skidbladnir-release-check.XXXXXX)"
case "$staging_dir" in
  /tmp/skidbladnir-release-check.* | /private/tmp/skidbladnir-release-check.*) ;;
  *) printf 'Unexpected release-check staging directory\n' >&2; exit 1 ;;
esac
trap 'rm -R -- "$staging_dir"' EXIT HUP INT TERM
extract_release_archive "$release_dir/$native_archive" "$staging_dir" skidbladnir
native_version="$("$staging_dir/skidbladnir" version)"
[[ "$native_version" == "$tag $sha" ]] || {
  printf 'Native host binary reports %q, want %s %s\n' "$native_version" "$tag" "$sha" >&2
  exit 1
}

printf 'Release verified: %s at %s\n' "$tag" "$sha"
