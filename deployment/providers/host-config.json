{
  "platform": "@PLATFORM@",
  "tmux": {"path": "@TMUX@", "testedVersion": "@TMUX_VERSION@"},
  "nativeControlPath": "@ROOT@/.local/bin/skidbladnir-provider-runtime-control",
  "profiles": [
    {
      "key": "personal",
      "label": "Codex · Personal",
      "provider": "Codex",
      "command": "@CODEX@",
      "environment": [{"name": "CODEX_HOME", "value": "@ROOT@/.codex"}],
      "foregroundSignatures": [{"executableBase": "codex"}],
      "arguments": ["--yolo"]
    },
    {
      "key": "work",
      "label": "Codex · Work",
      "provider": "Codex",
      "command": "@CODEX@",
      "environment": [{"name": "CODEX_HOME", "value": "@ROOT@/.codex-work"}],
      "foregroundSignatures": [{"executableBase": "codex"}],
      "arguments": ["--yolo"]
    },
    {
      "key": "work2",
      "label": "Codex · Work 2",
      "provider": "Codex",
      "command": "@CODEX@",
      "environment": [{"name": "CODEX_HOME", "value": "@ROOT@/.codex-work2"}],
      "foregroundSignatures": [{"executableBase": "codex"}],
      "arguments": ["--yolo"]
    },
    {
      "key": "claude-work",
      "label": "Claude · Work",
      "provider": "Claude",
      "command": "@CLAUDE@",
      "environment": [{"name": "CLAUDE_CONFIG_DIR", "value": "@ROOT@/.claude-work"}],
      "foregroundSignatures": [{"argument0": "@CLAUDE@"}],
      "arguments": ["--dangerously-skip-permissions", "--plugin-dir", "@ROOT@/.local/share/skidbladnir/claude-agent-identity"]
    }
  ]
}
