#!/bin/bash
set -euo pipefail

# dev-server renders these three assignments with shell quoting, then installs
# this file at current/providers/provider-command. never resolve shared wrappers.
provider_root=@ROOT_SHELL@
codex_command=@CODEX_SHELL@
claude_command=@CLAUDE_SHELL@

account="${1:-}"
[[ "$#" -gt 0 ]] || { printf 'provider account is required\n' >&2; exit 64; }
shift
for name in "${!HERDR_@}"; do
  unset "$name"
done
unset CODEX_HOME CLAUDE_CONFIG_DIR SKIDBLADNIR_SHELL SKIDBLADNIR_AGENT SKIDBLADNIR_CLAUDE_COMMAND

case "$account" in
  codex-personal)
    export CODEX_HOME="$provider_root/.codex" SKIDBLADNIR_AGENT=1
    exec "$codex_command" --yolo "$@"
    ;;
  codex-work | codex-work2)
    export CODEX_HOME="$provider_root/.$account" SKIDBLADNIR_AGENT=1
    exec "$codex_command" --yolo "$@"
    ;;
  claude-personal)
    export SKIDBLADNIR_AGENT=1
    exec "$claude_command" --dangerously-skip-permissions \
      --plugin-dir "$provider_root/.local/share/skidbladnir/claude-agent-identity" "$@"
    ;;
  claude-work)
    export CLAUDE_CONFIG_DIR="$provider_root/.claude-work" SKIDBLADNIR_AGENT=1
    exec "$claude_command" --dangerously-skip-permissions \
      --plugin-dir "$provider_root/.local/share/skidbladnir/claude-agent-identity" "$@"
    ;;
  *) printf 'provider account is invalid\n' >&2; exit 64 ;;
esac
