# shellcheck shell=bash
# source in bash/zsh startup on paired hosts. no action outside a scoped tty.
[[ $- == *i* ]] && : 2>/dev/null </dev/tty || return 0
[[ "${SKIDBLADNIR_SHELL:-}" == 1 || "${SKIDBLADNIR_TERMINAL_CONTEXT:-}" == 1 || -n "${SKIDBLADNIR_CONNECTION:-}" ]] || return 0

_skid_context_helper="$HOME/.local/share/skidbladnir/current/skidbladnir"
if [[ -n "${SKIDBLADNIR_CONNECTION:-}" ]]; then
  _skid_inbound_connection="$SKIDBLADNIR_CONNECTION"
  unset SKIDBLADNIR_CONNECTION
  "$_skid_context_helper" terminal-context register "$_skid_inbound_connection" "$$" >/dev/null 2>&1 || :
  export SKIDBLADNIR_TERMINAL_CONTEXT=1
  unset _skid_inbound_connection
fi

# deployment renders these as shell-quoted absolute native command paths.
_skid_ssh_command=@SSH_SHELL@
_skid_mosh_command=@MOSH_SHELL@
if ! typeset -f ssh >/dev/null 2>&1 && ! alias ssh >/dev/null 2>&1; then
  function ssh {
    local _skid_id
    _skid_id=$("$_skid_context_helper" terminal-context new 2>/dev/null) || _skid_id=
    if [[ -n "$_skid_id" ]]; then
      SKIDBLADNIR_CONNECTION="$_skid_id" "$_skid_ssh_command" "$@"
    else
      "$_skid_ssh_command" "$@"
    fi
  }
fi
if ! typeset -f mosh >/dev/null 2>&1 && ! alias mosh >/dev/null 2>&1; then
  function mosh {
    local _skid_id
    _skid_id=$("$_skid_context_helper" terminal-context new 2>/dev/null) || _skid_id=
    if [[ -n "$_skid_id" ]]; then
      SKIDBLADNIR_CONNECTION="$_skid_id" "$_skid_mosh_command" "$@"
    else
      "$_skid_mosh_command" "$@"
    fi
  }
fi
unset _skid_id
