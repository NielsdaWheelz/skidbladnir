<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher identity stays the ship prow (ornament-pipeline.md "App
     icon"); the flat non-adaptive drawable this replaces is a hard cut, not
     kept alongside this. Monochrome reuses the foreground drawable directly:
     Android tints monochrome layers to a single system color at render time,
     so the gold/bone fill values in that drawable are ignored there and no
     second copy of the geometry is needed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
