+
+import { Terminal } from 'browser/public/Terminal';
+import { ITerminalInitOnlyOptions, ITerminalOptions, IWheelInput } from '@xterm/xterm';
+import { assert } from 'chai';
+import jsdom = require('jsdom');
+
+describe('Browser public Terminal extensions', () => {
+  const validInput = (): IWheelInput => ({
+    deltaLines: -2,
+    clientX: 10,
+    clientY: 20,
+    ctrlKey: false,
+    altKey: false,
+    shiftKey: false
+  });
+
+  async function withDomTerminal(
+    run: (term: Terminal, dom: jsdom.JSDOM) => Promise<void>,
+    options: ITerminalOptions & ITerminalInitOnlyOptions = { scrollback: 0 }
+  ): Promise<void> {
+    const dom = new jsdom.JSDOM('<div id="terminal"></div>', { pretendToBeVisual: true });
+    const hadDocument = Object.prototype.hasOwnProperty.call(global, 'document');
+    const hadWindow = Object.prototype.hasOwnProperty.call(global, 'window');
+    const hadWheelEvent = Object.prototype.hasOwnProperty.call(global, 'WheelEvent');
+    const originalDocument = (global as any).document;
+    const originalWindow = (global as any).window;
+    const originalWheelEvent = (global as any).WheelEvent;
+    (global as any).document = dom.window.document;
+    (global as any).window = dom.window;
+    (global as any).WheelEvent = dom.window.WheelEvent;
+    (dom.window as any).matchMedia = () => ({
+      addListener: () => { },
+      removeListener: () => { }
+    });
+    const term = new Terminal(options);
+    try {
+      await run(term, dom);
+    } finally {
+      term.dispose();
+      if (hadDocument) {
+        (global as any).document = originalDocument;
+      } else {
+        delete (global as any).document;
+      }
+      if (hadWindow) {
+        (global as any).window = originalWindow;
+      } else {
+        delete (global as any).window;
+      }
+      if (hadWheelEvent) {
+        (global as any).WheelEvent = originalWheelEvent;
+      } else {
+        delete (global as any).WheelEvent;
+      }
+      dom.window.close();
+    }
+  }
+
+  function openTerminal(term: Terminal, dom: jsdom.JSDOM): void {
+    term.open(dom.window.document.querySelector('#terminal') as HTMLElement);
+  }
+
+  function installTerminalLayout(dom: jsdom.JSDOM): void {
+    Object.defineProperties(dom.window.HTMLElement.prototype, {
+      offsetWidth: {
+        configurable: true,
+        get(): number {
+          return this.classList.contains('xterm-char-measure-element') ? 320 : 800;
+        }
+      },
+      offsetHeight: {
+        configurable: true,
+        get(): number {
+          return this.classList.contains('xterm-char-measure-element') ? 20 : 480;
+        }
+      }
+    });
+  }
+
+  it('should reject wheel input before open and after disposal', async () => {
+    await withDomTerminal(async (term, dom) => {
+      const data: string[] = [];
+      term.onData(value => data.push(value));
+      assert.throws(() => term.handleWheelInput(validInput()), 'Terminal must be open to handle wheel input');
+      assert.deepEqual(data, []);
+
+      openTerminal(term, dom);
+      await new Promise<void>(resolve => term.write('\x1b[?1h', resolve));
+      term.handleWheelInput(validInput());
+      assert.deepEqual(data, ['\x1bOA']);
+      term.dispose();
+
+      assert.throws(() => term.handleWheelInput(validInput()), 'Terminal must be open to handle wheel input');
+      assert.deepEqual(data, ['\x1bOA']);
+    });
+  });
+
+  it('should validate and route wheel input at the public boundary', async () => {
+    await withDomTerminal(async (term, dom) => {
+      const data: string[] = [];
+      term.onData(value => data.push(value));
+      openTerminal(term, dom);
+      await new Promise<void>(resolve => term.write('\x1b[?1h', resolve));
+
+      const invalidInputs: unknown[] = [
+        { ...validInput(), deltaLines: 0 },
+        { ...validInput(), deltaLines: 1.5 },
+        { ...validInput(), deltaLines: Number.NaN },
+        { ...validInput(), deltaLines: Number.POSITIVE_INFINITY },
+        { ...validInput(), clientX: Number.NEGATIVE_INFINITY },
+        { ...validInput(), clientY: Number.NaN },
+        { ...validInput(), ctrlKey: 0 },
+        { ...validInput(), altKey: undefined },
+        { ...validInput(), shiftKey: null }
+      ];
+      for (const input of invalidInputs) {
+        assert.throws(() => term.handleWheelInput(input as IWheelInput), 'Invalid wheel input');
+      }
+      assert.deepEqual(data, []);
+
+      term.handleWheelInput(validInput());
+      assert.deepEqual(data, ['\x1bOA']);
+    });
+  });
+
+  it('should route one physical DOM wheel through the opened terminal exactly once', async () => {
+    await withDomTerminal(async (term, dom) => {
+      const data: string[] = [];
+      term.onData(value => data.push(value));
+      openTerminal(term, dom);
+      await new Promise<void>(resolve => term.write('\x1b[?1h', resolve));
+      const event = new dom.window.WheelEvent('wheel', {
+        bubbles: true,
